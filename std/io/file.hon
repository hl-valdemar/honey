import "@ffi/c"

File :: struct {
    io Io
    handle Handle
}

FileMode :: enum {
    read_only
    write_only
    read_write
}

OpenError :: enum {
    open_failed
}

CloseError :: enum {
    close_failed
}

#! open a caller-owned handle from a borrowed zero-terminated path; release it with close.
open proc(io Io, path [*;0]u8, mode FileMode) File ! OpenError {
    handle Handle :: try io.vtable.open(io.context, path, mode)
    return File{ io = io, handle = handle }
}

#! close the owned handle, invalidating its borrowed readers and writers.
close proc(file File) void ! CloseError {
    try file.io.vtable.close(file.io.context, file.handle)
}

#! borrow the file handle; the reader must not outlive the open file.
reader proc(file File) Reader {
    return Reader {
        context = file.io.context,
        handle = file.handle,
        read = file.io.vtable.read,
    }
}

#! borrow the file handle; the writer must not outlive the open file.
writer proc(file File) Writer {
    return Writer {
        context = file.io.context,
        handle = file.handle,
        write = file.io.vtable.write,
    }
}

@hide:file
system_read proc(_ ?@mut anyopaque, handle Handle, buffer []mut u8) usize ! ReadError {
    request := buffer.len
    maximum usize :: usize(maxval!(c_long))
    if (request > maximum) request = maximum

    while true {
        count c_long :: c.read(handle.file_desc, buffer.ptr, c_ulong(request))
        if (count >= 0) return usize(count)

        errno c_int :: c.__error()?^
        if (errno == c.EINTR) continue
        if (errno == c.EBADF) return .not_open_for_reading
        return .read_failed
    }
}

@hide:file
system_write proc(_ ?@mut anyopaque, handle Handle, bytes []u8) usize ! WriteError {
    request := bytes.len
    maximum usize :: usize(maxval!(c_long))
    if (request > maximum) request = maximum

    while true {
        count c_long :: c.write(handle.file_desc, bytes.ptr, c_ulong(request))
        if (count >= 0) return usize(count)

        errno c_int :: c.__error()?^
        if (errno == c.EINTR) continue
        if (errno == c.EBADF) return .not_open_for_writing
        return .write_failed
    }
}

@hide:file
system_open proc(_ ?@mut anyopaque, path [*;0]u8, mode FileMode) Handle ! OpenError {
    flags := c.O_RDONLY
    match mode {
        .read_only: flags = c.O_RDONLY
        .write_only: flags = c.O_WRONLY
        .read_write: flags = c.O_RDWR
    }
    while true {
        fd c_int :: c.open(ptrcast!(path), flags)
        if (fd >= 0) return Handle{ file_desc = fd }
        if (c.__error()?^ != c.EINTR) return .open_failed
    }
}

@hide:file
system_close proc(_ ?@mut anyopaque, handle Handle) void ! CloseError {
    if (c.close(handle.file_desc) != 0) return .close_failed
}

@hide:file
system_stdin proc(_ ?@mut anyopaque) Handle {
    return Handle{ file_desc = c_int(Stream.stdin) }
}

@hide:file
system_stdout proc(_ ?@mut anyopaque) Handle {
    return Handle{ file_desc = c_int(Stream.stdout) }
}

@hide:file
system_stderr proc(_ ?@mut anyopaque) Handle {
    return Handle{ file_desc = c_int(Stream.stderr) }
}

@hide:file
system_vtable IoVTable :: IoVTable {
    read = system_read,
    write = system_write,
    open = system_open,
    close = system_close,
    stdin = system_stdin,
    stdout = system_stdout,
    stderr = system_stderr,
}

@hide system proc() Io {
    return Io {
        context = null,
        vtable = &system_vtable,
    }
}
