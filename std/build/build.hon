#! declarative executable configuration for honey build/test/install in root/build.hon.
#! paths are relative to the project root; builds never refresh vendored sources.
#! list fields accept an address-of array literal, such as `&["raylib"]`.
#! config values may use Honey helpers; evaluation cannot call foreign functions.
#! test without a path selects source; install.sh, when present, owns explicit installation.
Linkage :: enum { automatic, static, shared }

BuildConfig :: struct {
    name []u8
    source []u8
    # decimal major.minor[.patch], at least 11.0 for Apple Silicon.
    macos_deployment_target []u8 = "11.0"
    libraries [][]u8 = &[]
    lib_paths [][]u8 = &[]
    includes [][]u8 = &[]
    defines [][]u8 = &[]
    links [][]u8 = &[]
    frameworks [][]u8 = &[]
    rpaths [][]u8 = &[]
    # automatic uses the platform linker search; static/shared select matching library files.
    linkage Linkage = .automatic
}
