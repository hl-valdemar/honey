import "@std/mem"
import "@std/fs"
import "@tests/support"

@hide:file
active_target proc(context @mut support.Context, launcher [;0]u8) [;0]u8 ! support.Error {
    result :: try support.run(context, &["readlink", launcher], {})
    try support.expect(context, result.status == 0 and result.stdout.len > 1, result.stderr)
    return try support.concat(context, &[result.stdout[..result.stdout.len - 1]])
}

installation_preserves_bootstrap_and_recovers_from_failed_upgrades test {
    context := try support.init("user install")
    defer support.deinit(&context)
    installer :: try support.path(&context, context.root, "install.sh")
    prefix :: try support.path(&context, context.temporary, "user prefix")
    prefix_environment :: try support.concat(&context, &["PREFIX=", prefix])
    bootstrap_environment :: try support.concat(&context, &["BOOTSTRAP=", context.compiler])
    launcher :: try support.path(&context, prefix, "bin/honey")
    previous :: try support.path(&context, prefix, "opt/honey/previous")
    original :: try support.run(&context, &["cksum", context.compiler], {})
    try support.expect(&context, original.status == 0, original.stderr)
    first_install :: try support.run(&context, &["/usr/bin/env", prefix_environment, bootstrap_environment, context.compiler, "install", context.root], { timeout_seconds = 300 })
    try support.expect(&context, first_install.status == 0, first_install.stderr)
    first :: try active_target(&context, launcher)
    second_bootstrap :: try support.concat(&context, &["BOOTSTRAP=", launcher])
    upgraded :: try support.run(&context, &["/usr/bin/env", prefix_environment, second_bootstrap, "/bin/sh", installer], { timeout_seconds = 300 })
    try support.expect(&context, upgraded.status == 0, upgraded.stderr)
    second :: try active_target(&context, launcher)
    try support.expect(&context, !mem.eql(first, second) and try fs.kind(context.allocator, first) == .file, "upgrade keeps the previous compiler in a separate installation")
    try support.expect(&context, mem.eql(try active_target(&context, previous), first), "upgrade records the previous installation")
    failed :: try support.run(&context, &["/usr/bin/env", prefix_environment, "BOOTSTRAP=/usr/bin/false", "/bin/sh", installer], {})
    try support.expect(&context, failed.status != 0, "invalid bootstrap unexpectedly installed a compiler")
    try support.expect(&context, mem.eql(try active_target(&context, launcher), second) and mem.eql(try active_target(&context, previous), first), "failed upgrade changes neither active nor rollback compiler")
    restored :: try support.run(&context, &["/usr/bin/env", prefix_environment, "/bin/sh", installer, "rollback"], {})
    try support.expect(&context, restored.status == 0, restored.stderr)
    try support.expect(&context, mem.eql(try active_target(&context, launcher), first) and mem.eql(try active_target(&context, previous), second), "rollback restores the previous compiler and retains the newer one")
    project :: try support.path(&context, context.temporary, "installed project")
    created :: try support.run(&context, &[launcher, "new", project], { cwd = context.temporary })
    try support.expect_result(&context, created, 0, "", "")
    built :: try support.run(&context, &[launcher, "build", project], {})
    try support.expect_result(&context, built, 0, "", "")
    executable :: try support.path(&context, project, "build/app")
    ran :: try support.run(&context, &[executable], {})
    try support.expect_result(&context, ran, 0, "0\n", "")
    installed_project :: try support.run(&context, &["/usr/bin/env", prefix_environment, launcher, "install", project], { cwd = context.temporary, timeout_seconds = 300 })
    try support.expect(&context, installed_project.status == 0, installed_project.stderr)
    installed_application :: try support.path(&context, prefix, "bin/app")
    ran_installed :: try support.run(&context, &[installed_application], {})
    try support.expect_result(&context, ran_installed, 0, "0\n", "")
    unchanged :: try support.run(&context, &["cksum", context.compiler], {})
    try support.expect_result(&context, unchanged, 0, original.stdout, "")
}

installation_refuses_unmanaged_executables test {
    context := try support.init("unmanaged install")
    defer support.deinit(&context)
    installer :: try support.path(&context, context.root, "install.sh")
    prefix :: try support.path(&context, context.temporary, "existing user prefix")
    launcher :: try support.put(&context, prefix, "bin/honey", "user-owned executable\n")
    prefix_environment :: try support.concat(&context, &["PREFIX=", prefix])
    refused :: try support.run(&context, &["/usr/bin/env", prefix_environment, "/bin/sh", installer], {})
    try support.expect(&context, refused.status != 0, "installer replaced an unmanaged executable")
    try support.expect(&context, mem.eql(try support.read(&context, launcher), "user-owned executable\n"), "unmanaged executable contents changed")
}

project_install_builds_upgrades_and_rolls_back test {
    context := try support.init("project install")
    defer support.deinit(&context)
    root :: try support.path(&context, context.temporary, "project ' ; $")
    created :: try support.run(&context, &[context.compiler, "new", root], {})
    try support.expect_result(&context, created, 0, "", "")
    _ = try support.put(&context, root, "build.hon", "import \"@std/build\"\nconfig :: build.BuildConfig{ name = \"installed-app\", source = \"source\" }\n")
    source :: try support.put(&context, root, "source/main.hon", "main proc() i32 { return 41 }\n")
    prefix :: try support.path(&context, context.temporary, "prefix ' ; $")
    environment :: try support.concat(&context, &["PREFIX=", prefix])
    launcher :: try support.path(&context, prefix, "bin/installed-app")
    previous :: try support.path(&context, prefix, "opt/installed-app/previous")
    installer :: try support.path(&context, context.root, "install-project.sh")
    installed :: try support.run(&context, &["/usr/bin/env", environment, context.compiler, "install", root, "-O0"], { cwd = context.temporary, timeout_seconds = 300 })
    try support.expect(&context, installed.status == 0, installed.stderr)
    first :: try active_target(&context, launcher)
    try support.expect(&context, support.has_prefix(first, try support.path(&context, prefix, "opt/installed-app/release.")) and support.has_suffix(first, "/bin/installed-app"), "project installs a versioned executable")
    ran_first :: try support.run(&context, &[launcher], {})
    try support.expect_result(&context, ran_first, 0, "41\n", "")
    try support.write(&context, source, "main proc() i32 { return 42 }\n")
    upgraded :: try support.run(&context, &["/usr/bin/env", environment, context.compiler, "install", "-O2"], { cwd = root, timeout_seconds = 300 })
    try support.expect(&context, upgraded.status == 0, upgraded.stderr)
    second :: try active_target(&context, launcher)
    try support.expect(&context, !mem.eql(first, second) and mem.eql(try active_target(&context, previous), first), "project upgrade preserves previous release")
    ran_second :: try support.run(&context, &[launcher], {})
    try support.expect_result(&context, ran_second, 0, "42\n", "")
    try support.write(&context, source, "main proc( invalid syntax\n")
    failed :: try support.run(&context, &["/usr/bin/env", environment, context.compiler, "install", root], { timeout_seconds = 300 })
    try support.expect(&context, failed.status != 0, "failed build rejects installation")
    try support.expect(&context, mem.eql(try active_target(&context, launcher), second) and mem.eql(try active_target(&context, previous), first), "failed build preserves active and previous release")
    still_active :: try support.run(&context, &[launcher], {})
    try support.expect_result(&context, still_active, 0, "42\n", "")
    restored :: try support.run(&context, &["/usr/bin/env", environment, "/bin/sh", installer, "rollback", "installed-app"], {})
    try support.expect(&context, restored.status == 0, restored.stderr)
    try support.expect(&context, mem.eql(try active_target(&context, launcher), first) and mem.eql(try active_target(&context, previous), second), "generic rollback exchanges releases")
    ran_restored :: try support.run(&context, &[launcher], {})
    try support.expect_result(&context, ran_restored, 0, "41\n", "")
    toggled :: try support.run(&context, &["/usr/bin/env", environment, "/bin/sh", installer, "rollback", "installed-app"], {})
    try support.expect(&context, toggled.status == 0 and mem.eql(try active_target(&context, launcher), second), "rollback can restore the newer release")
}

generic_installer_validates_and_never_runs_candidates test {
    context := try support.init("generic installer safety")
    defer support.deinit(&context)
    installer :: try support.path(&context, context.root, "install-project.sh")
    prefix :: try support.path(&context, context.temporary, "isolated prefix")
    environment :: try support.concat(&context, &["PREFIX=", prefix])
    candidate :: try support.put(&context, context.temporary, "candidate", "#!/bin/sh\nexit 97\n")
    executable :: try support.run(&context, &["chmod", "+x", candidate], {})
    try support.expect_result(&context, executable, 0, "", "")
    for ([".", "..", "nested/name", "-option", "honey", "rollback"]) |name| {
        rejected :: try support.run(&context, &["/usr/bin/env", environment, "/bin/sh", installer, name, candidate], {})
        try support.expect(&context, rejected.status != 0, "generic installer rejects unsafe and reserved names")
    }
    installed :: try support.run(&context, &["/usr/bin/env", environment, "/bin/sh", installer, "safe-app", candidate], {})
    try support.expect(&context, installed.status == 0, installed.stderr)
    launcher :: try support.path(&context, prefix, "bin/safe-app")
    first :: try active_target(&context, launcher)
    try support.expect(&context, mem.eql(try support.read(&context, first), try support.read(&context, candidate)), "installer copies candidate without executing it")
    try support.write(&context, candidate, "#!/bin/sh\nexit 98\n")
    try support.expect(&context, mem.eql(try support.read(&context, first), "#!/bin/sh\nexit 97\n"), "release is independent of the build output")
    lock :: try support.path(&context, prefix, "opt/safe-app/.install-lock")
    try support.directory(&context, lock)
    locked :: try support.run(&context, &["/usr/bin/env", environment, "/bin/sh", installer, "safe-app", candidate], {})
    try support.expect(&context, locked.status != 0 and mem.eql(try active_target(&context, launcher), first), "installation lock preserves launcher")
    removed :: try support.run(&context, &["rmdir", lock], {})
    try support.expect_result(&context, removed, 0, "", "")
    previous :: try support.path(&context, prefix, "opt/safe-app/previous")
    try support.symlink(&context, candidate, previous)
    refused_previous :: try support.run(&context, &["/usr/bin/env", environment, "/bin/sh", installer, "safe-app", candidate], {})
    try support.expect(&context, refused_previous.status != 0 and mem.eql(try active_target(&context, previous), candidate) and mem.eql(try active_target(&context, launcher), first), "unrelated rollback symlink is preserved")
    unrelated :: try support.path(&context, prefix, "bin/unrelated")
    try support.symlink(&context, candidate, unrelated)
    refused_launcher :: try support.run(&context, &["/usr/bin/env", environment, "/bin/sh", installer, "unrelated", candidate], {})
    try support.expect(&context, refused_launcher.status != 0 and mem.eql(try active_target(&context, unrelated), candidate), "unrelated launcher symlink is preserved")
}
