import "@tests/support"
import "@std/mem"
import "@std/fs"

standalone_creation_preserves_local_files test {
    context := try support.init("project creation")
    defer support.deinit(&context)
    root :: try support.path(&context, context.temporary, "game ' ; $")
    created :: try support.run(&context, &[context.compiler, "new", root], { cwd = context.temporary })
    try support.expect(&context, created.status == 0, "new discovers its distribution outside the compiler workspace")
    for (["std/mem/mem.hon", "ffi/c/stdio.hon", "source/main.hon", "build.hon", ".honey-origin"]) |relative| {
        try support.expect(&context, try fs.kind(context.allocator, try support.path(&context, root, relative)) == .file, "new vendors a complete standalone project")
    }
    host :: try support.run(&context, &["/usr/bin/sw_vers", "-productVersion"], {})
    try support.expect(&context, host.status == 0 and host.stdout.len > 1 and host.stdout[host.stdout.len - 1] == '\n', "host product version is available")
    host_version :: host.stdout[..host.stdout.len - 1]
    minimum_version := host_version
    if (support.count(host_version, ".") == 2 and mem.eql(host_version[host_version.len - 2..], ".0")) minimum_version = host_version[..host_version.len - 2]
    expected_minimum :: try support.concat(&context, &[" minos ", minimum_version, "\n"])
    fresh_build :: try support.run(&context, &[context.compiler, "build", root], {})
    try support.expect_result(&context, fresh_build, 0, "", "")
    fresh_executable :: try support.path(&context, root, "build/app")
    fresh_metadata :: try support.run(&context, &["otool", "-l", fresh_executable], {})
    try support.expect(&context, fresh_metadata.status == 0 and support.contains(fresh_metadata.stdout, expected_minimum), "new projects record the host minimum in the executable")
    config :: try support.path(&context, root, "build.hon")
    source :: try support.path(&context, root, "source/main.hon")
    stdlib :: try support.path(&context, root, "std/local-edit.hon")
    ffi :: try support.path(&context, root, "ffi/c/local-edit.hon")
    try support.write(&context, source, "main proc() i32 { return 42 }\n")
    try support.write(&context, stdlib, "# user stdlib customization\n")
    try support.write(&context, ffi, "# user core binding customization\n")
    memory_path :: try support.path(&context, root, "std/mem/mem.hon")
    memory :: try support.read(&context, memory_path)
    modified_memory :: try support.concat(&context, &[memory, "\n# preserved local edit\n"])
    try support.write(&context, memory_path, modified_memory)
    origin :: try support.path(&context, root, ".honey-origin")
    try support.write(&context, origin, "original distribution; locally annotated\n")
    try support.write(&context, config, "import \"@std/build\"\nconfig :: build.BuildConfig{ name = \"app\", source = \"source\", macos_deployment_target = \"11.0\" }\n")
    original :: try support.read(&context, config)
    initialized :: try support.run(&context, &[context.compiler, "init"], { cwd = root })
    try support.expect(&context, initialized.status == 0, "init is non-destructive")
    after :: try support.read(&context, config)
    try support.expect(&context, mem.eql(original, after), "init preserves build.hon")
    try support.expect(&context, try fs.kind(context.allocator, stdlib) == .file and try fs.kind(context.allocator, ffi) == .file, "init preserves modified vendored trees")
    built :: try support.run(&context, &[context.compiler, "build", root, "--debug"], {})
    try support.expect(&context, built.status == 0, "standalone project builds using vendored packages")
    executable :: try support.path(&context, root, "build/app")
    ran :: try support.run(&context, &[executable], {})
    metadata :: try support.run(&context, &["otool", "-l", executable], {})
    try support.expect(&context, metadata.status == 0 and support.contains(metadata.stdout, "cmd LC_BUILD_VERSION\n") and support.contains(metadata.stdout, " minos 11.0\n"), "an explicit lower deployment target survives init and build")
    try support.expect_result(&context, ran, 42, "", "")
    released :: try support.run(&context, &[context.compiler, "build", "--release", root], {})
    try support.expect_result(&context, released, 0, "", "")
    ran_release :: try support.run(&context, &[executable], {})
    try support.expect_result(&context, ran_release, 42, "", "")
    for ["--debug", "--release"] |mode| {
        implicit_root :: try support.run(&context, &[context.compiler, "build", mode], { cwd = root })
        try support.expect_result(&context, implicit_root, 0, "", "")
        ran_implicit :: try support.run(&context, &[executable], {})
        try support.expect_result(&context, ran_implicit, 42, "", "")
    }
    after_build :: try support.read(&context, stdlib)
    try support.expect(&context, mem.eql(after_build, "# user stdlib customization\n"), "build never refreshes vendored sources")
    actual_memory :: try support.read(&context, memory_path)
    try support.expect(&context, mem.eql(actual_memory, modified_memory), "init and build preserve edits to compiler-required stdlib modules")
    actual_origin :: try support.read(&context, origin)
    try support.expect(&context, mem.eql(actual_origin, "original distribution; locally annotated\n"), "provenance is not an integrity lock")
}

public_config_interprets_real_honey_values test {
    context := try support.init("project config")
    defer support.deinit(&context)
    root :: try support.path(&context, context.temporary, "config")
    created :: try support.run(&context, &[context.compiler, "new", root], {})
    try support.expect(&context, created.status == 0, "config project initializes")
    build_file :: try support.path(&context, root, "build.hon")
    try support.write(&context, build_file, "import \"@std/build\"\nname proc() []u8 { return \"configured\" }\nconfig :: build.BuildConfig{ name = $name(), source = \"source\", frameworks = &[\"Cocoa\"], lib_paths = &[\"native libraries\"], rpaths = &[\"@executable_path/../native libraries\"], linkage = .automatic }\n")
    fixture :: try support.path(&context, context.root, "tests/project/interface")
    fixture_executable :: try support.path(&context, context.temporary, "config-interface")
    compiled :: try support.run(&context, &[context.compiler, "build", fixture, "-o", fixture_executable], {})
    try support.expect(&context, compiled.status == 0, "public interface fixture compiles natively")
    interpreted :: try support.run(&context, &[fixture_executable, root, "required"], {})
    try support.expect(&context, interpreted.status == 0 and support.contains(interpreted.stdout, "name=configured\n"), "config uses Honey constant evaluation")
    try support.expect(&context, support.contains(interpreted.stdout, "/source\n") and support.contains(interpreted.stdout, "/build/configured\n"), "public config returns absolute project paths")
    try support.expect(&context, support.contains(interpreted.stdout, "target=arm64-apple-macosx11.0.0\n"), "default config retains the exact macOS 11 target")
    try support.expect(&context, try fs.kind(context.allocator, try support.path(&context, root, "build")) == .missing, "loading a config does not create output directories")
    unconfigured :: try support.path(&context, context.temporary, "no-build-file")
    try support.directory(&context, unconfigured)
    no_file :: try support.run(&context, &[fixture_executable, unconfigured, "optional"], {})
    try support.expect(&context, no_file.status == 0 and mem.eql(no_file.stdout, "name=\nsource=\noutput=\ntarget=arm64-apple-macosx11.0.0\n"), "optional projects without build.hon retain the default target and no linker arguments")
    marker :: try support.path(&context, context.temporary, "marker-only")
    _ = try support.put(&context, marker, "build.hon", "# project-root marker\n")
    absent :: try support.run(&context, &[fixture_executable, marker, "optional"], {})
    try support.expect(&context, absent.status == 0 and mem.eql(absent.stdout, "name=\nsource=\noutput=\ntarget=arm64-apple-macosx11.0.0\n"), "optional marker-only configs retain the default target and need neither config nor std/build")
    try support.expect(&context, try fs.kind(context.allocator, try support.path(&context, marker, "build")) == .missing, "optional reads have no output-directory side effect")
    required_marker :: try support.run(&context, &[fixture_executable, marker, "required"], {})
    try support.expect(&context, required_marker.status != 0 and support.contains(required_marker.stderr, "missing top-level config"), "required project builds reject marker-only configs")
    _ = try support.put(&context, marker, "build.hon", "config ::\n")
    malformed :: try support.run(&context, &[fixture_executable, marker, "optional"], {})
    try support.expect(&context, malformed.status != 0 and support.contains(malformed.stderr, "build config"), "optional mode never ignores malformed config declarations")
    for (["15.0", "15.2.1", "00015.000.000"]) |version, index| {
        config_text :: try support.concat(&context, &["import \"@std/build\"\nconfig :: build.BuildConfig{ name = \"configured\", source = \"source\", macos_deployment_target = \"", version, "\" }\n"])
        try support.write(&context, build_file, config_text)
        configured :: try support.run(&context, &[fixture_executable, root, "required"], {})
        expected :: if (index == 1) "target=arm64-apple-macosx15.2.1\n" else "target=arm64-apple-macosx15.0.0\n"
        try support.expect(&context, configured.status == 0 and support.contains(configured.stdout, expected), "configured deployment versions are normalized into a complete target triple")
    }
    for (["", "10.15", "15", "15.", "15..0", "15.0.", "15.0.0.1", "15.0-beta", "-15.0", "15.0 -Wl,-w", "15.0/../../", "0xf.0", "65536.0", "15.256", "15.0.256", "999999999999999999999999999.0", "15.0\\0unsafe"]) |version| {
        config_text :: try support.concat(&context, &["import \"@std/build\"\nconfig :: build.BuildConfig{ name = \"configured\", source = \"source\", macos_deployment_target = \"", version, "\" }\n"])
        try support.write(&context, build_file, config_text)
        rejected :: try support.run(&context, &[fixture_executable, root, "required"], {})
        try support.expect(&context, rejected.status != 0 and support.contains(rejected.stderr, "config.macos_deployment_target") and support.contains(rejected.stderr, "major.minor[.patch]"), "invalid deployment versions fail with an actionable config diagnostic")
    }
    try support.expect(&context, try fs.kind(context.allocator, try support.path(&context, root, "build")) == .missing, "configured and invalid deployment targets have no output-directory side effects")
}

static_and_shared_native_libraries test {
    context := try support.init("project native links")
    defer support.deinit(&context)
    root :: try support.path(&context, context.temporary, "native game")
    created :: try support.run(&context, &[context.compiler, "new", root], {})
    try support.expect(&context, created.status == 0, "native link project initializes")
    native :: try support.path(&context, root, "native libraries")
    try support.directory(&context, native)
    c_file :: try support.put(&context, native, "answer.c", "#include <CoreFoundation/CoreFoundation.h>\nint honey_project_answer(void) {\n    CFStringRef text = CFStringCreateWithCString(kCFAllocatorDefault, \"honey!!\", kCFStringEncodingUTF8);\n    if (!text) return -1;\n    CFIndex length = CFStringGetLength(text);\n    CFRelease(text);\n    return (int)length * 6;\n}\n")
    object :: try support.path(&context, native, "answer.o")
    compiled :: try support.run(&context, &["clang", "-target", "arm64-apple-macosx11.0.0", "-c", c_file, "-o", object], {})
    try support.expect(&context, compiled.status == 0, "native library fixture compiles")
    archive :: try support.path(&context, native, "libanswer.a")
    archived :: try support.run(&context, &["ar", "rcs", archive, object], {})
    try support.expect(&context, archived.status == 0, "static library fixture archives")
    dynamic :: try support.path(&context, native, "libanswer.dylib")
    shared :: try support.run(&context, &["clang", "-target", "arm64-apple-macosx11.0.0", "-dynamiclib", c_file, "-framework", "CoreFoundation", "-install_name", "@rpath/libanswer.dylib", "-o", dynamic], {})
    try support.expect(&context, shared.status == 0, "shared library fixture compiles")
    _ = try support.put(&context, root, "source/main.hon", "honey_project_answer c_func() c_int\nmain proc() i32 { return i32(honey_project_answer()) }\n")
    for (["automatic", "static", "shared"]) |mode| {
        config_text :: try support.concat(&context, &["import \"@std/build\"\nconfig :: build.BuildConfig{ name = \"native\", source = \"source\", libraries = &[\"answer\"], lib_paths = &[\"native libraries\"], frameworks = &[\"CoreFoundation\"], rpaths = &[\"@executable_path/../native libraries\"], linkage = .", mode, " }\n"])
        _ = try support.put(&context, root, "build.hon", config_text)
        built :: try support.run(&context, &[context.compiler, "build", root], {})
        try support.expect_result(&context, built, 0, "", "")
        executable :: try support.path(&context, root, "build/native")
        ran :: try support.run(&context, &[executable], {})
        try support.expect_result(&context, ran, 42, "", "")
    }
    newer_shared :: try support.run(&context, &["clang", "-target", "arm64-apple-macosx15.0.0", "-dynamiclib", c_file, "-framework", "CoreFoundation", "-install_name", "@rpath/libanswer.dylib", "-o", dynamic], {})
    try support.expect_result(&context, newer_shared, 0, "", "")
    _ = try support.put(&context, root, "build.hon", "import \"@std/build\"\nconfig :: build.BuildConfig{ name = \"native\", source = \"source\", libraries = &[\"answer\"], lib_paths = &[\"native libraries\"], frameworks = &[\"CoreFoundation\"], rpaths = &[\"@executable_path/../native libraries\"], linkage = .shared, macos_deployment_target = \"15.0\" }\n")
    newer_build :: try support.run(&context, &[context.compiler, "build", root], {})
    try support.expect_result(&context, newer_build, 0, "", "")
    executable :: try support.path(&context, root, "build/native")
    metadata :: try support.run(&context, &["otool", "-l", executable], {})
    try support.expect(&context, metadata.status == 0 and support.contains(metadata.stdout, "cmd LC_BUILD_VERSION\n") and support.contains(metadata.stdout, " minos 15.0\n"), "configured executable records macOS 15 and links a macOS 15 native library without warnings")
    _ = try support.put(&context, root, "build.hon", "import \"@std/build\"\nconfig :: build.BuildConfig{ name = \"missing\", source = \"source\", libraries = &[\"honey_absent_library\"], lib_paths = &[\"native libraries\"], linkage = .static, macos_deployment_target = \"15.0\" }\n")
    emitted :: try support.run(&context, &[context.compiler, "emit-llvm", try support.path(&context, root, "source")], {})
    try support.expect(&context, emitted.status == 0 and mem.eql(emitted.stderr, "") and support.contains(emitted.stdout, "target triple = \"arm64-apple-macosx15.0.0\""), "IR emission honors the target without requiring configured native libraries to exist")
    missing :: try support.run(&context, &[context.compiler, "build", root], {})
    try support.expect(&context, missing.status != 0 and support.contains(missing.stderr, "honey_absent_library") and support.contains(missing.stderr, "config.lib_paths"), "missing libraries have actionable diagnostics")
}

installed_bundle_discovery_and_missing_template_errors test {
    context := try support.init("project installed bundle")
    defer support.deinit(&context)
    installation :: try support.path(&context, context.temporary, "installation")
    bin :: try support.path(&context, installation, "bin")
    try support.directory(&context, bin)
    compiler :: try support.path(&context, bin, "honey")
    copied :: try support.run(&context, &["cp", context.compiler, compiler], {})
    try support.expect(&context, copied.status == 0, "installed compiler fixture copies")
    destination :: try support.path(&context, context.temporary, "installed project")
    missing :: try support.run(&context, &[compiler, "new", destination], { cwd = context.temporary })
    try support.expect(&context, missing.status != 0 and support.contains(missing.stderr, "templates not found"), "missing distribution templates fail explicitly")
    unrelated_workspace :: try support.run(&context, &[compiler, "new", destination], { cwd = context.root })
    try support.expect(&context, unrelated_workspace.status != 0 and support.contains(unrelated_workspace.stderr, "templates not found"), "an unrelated checkout cannot supply templates for an installed compiler")
    bundle :: try support.path(&context, installation, "share/honey")
    bundle_ffi :: try support.path(&context, bundle, "ffi")
    try support.directory(&context, bundle_ffi)
    std_source :: try support.path(&context, context.root, "std")
    ffi_source :: try support.path(&context, context.root, "ffi/c")
    copied_std :: try support.run(&context, &["cp", "-R", std_source, bundle], {})
    copied_ffi :: try support.run(&context, &["cp", "-R", ffi_source, bundle_ffi], {})
    try support.expect(&context, copied_std.status == 0 and copied_ffi.status == 0, "installed distribution fixtures copy")
    created :: try support.run(&context, &[compiler, "new", destination], { cwd = context.temporary })
    try support.expect(&context, created.status == 0, "bin/honey discovers ../share/honey without cwd dependencies")
}

test_uses_evaluated_config_source_from_nested_directory test {
    context := try support.init("configured tests")
    defer support.deinit(&context)
    root :: try support.path(&context, context.temporary, "configured project")
    created :: try support.run(&context, &[context.compiler, "new", root], {})
    try support.expect_result(&context, created, 0, "", "")
    _ = try support.put(&context, root, "build.hon",
        `import "@std/build"
        `settings proc() build.BuildConfig {
        `    return build.BuildConfig{ name = "configured", source = "custom checks" }
        `}
        `config :: $settings()
        `
    )
    _ = try support.put(&context, root, "source/ignored.test.hon", "ignored test { unreachable }\n")
    checks :: try support.put(&context, root, "custom checks/configured.test.hon",
        "import \"@std/testing\"\nconfigured test { try testing.expect(true) }\n")
    nested :: try support.path(&context, root, "nested/working directory")
    try support.directory(&context, nested)
    passing :: try support.run(&context, &[context.compiler, "test"], { cwd = nested, timeout_seconds = 300 })
    try support.expect(&context, passing.status == 0 and support.contains(passing.stderr, "configured.test.hon:configured ... ok") and support.contains(passing.stderr, "1 passed, 0 failed\n"), "test resolves evaluated config.source from ancestor project rather than cwd or source")
    try support.write(&context, checks, "import \"@std/testing\"\nconfigured test { try testing.expect(false) }\n")
    failing :: try support.run(&context, &[context.compiler, "test"], { cwd = nested, timeout_seconds = 300 })
    try support.expect(&context, failing.status == 1 and support.contains(failing.stderr, "0 passed, 1 failed\n"), "configured tests propagate failures")
}

configuration_cannot_execute_foreign_commands test {
    context := try support.init("configuration effects")
    defer support.deinit(&context)
    root :: try support.path(&context, context.temporary, "effect check")
    created :: try support.run(&context, &[context.compiler, "new", root], {})
    try support.expect_result(&context, created, 0, "", "")
    _ = try support.put(&context, root, "install.sh", "#!/bin/sh\ntouch recipe-executed\n")
    built :: try support.run(&context, &[context.compiler, "build"], { cwd = root })
    try support.expect_result(&context, built, 0, "", "")
    recipe_marker :: try support.path(&context, root, "recipe-executed")
    try support.expect(&context, try fs.kind(context.allocator, recipe_marker) == .missing, "ordinary builds do not execute installation recipes")
    _ = try support.put(&context, root, "build.hon",
        `import "@std/build"
        `system c_func(command ?*c_char) c_int
        `settings proc() build.BuildConfig {
        `    result :: system("touch configuration-executed")
        `    return build.BuildConfig{ name = if (result == 0) "executed" else "failed", source = "source" }
        `}
        `config :: $settings()
        `
    )
    rejected :: try support.run(&context, &[context.compiler, "build"], { cwd = root })
    marker :: try support.path(&context, root, "configuration-executed")
    try support.expect(&context, rejected.status != 0 and try fs.kind(context.allocator, marker) == .missing, "configuration rejects foreign execution instead of running commands")
}
