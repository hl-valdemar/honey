import "@tests/support"

check_framework proc(context @mut support.Context) void ! support.Error {
    project :: try support.path(context, context.temporary, "honey tests ' ; $")
    _ = try support.put(context, project, "build.hon", "# project root\n")
    for ["std", "ffi"] |package| {
        try support.symlink(context,
            try support.path(context, context.root, package),
            try support.path(context, project, package))
    }
    package :: try support.path(context, project, "app")
    dependency :: try support.path(context, project, "dependency")
    try support.directory(context, package)
    _ = try support.put(context, project, "unrelated/value.hon", "expect proc(value bool) bool { return value }\n")
    value :: try support.put(context, dependency, "value.hon", "value proc() i16 { return 42 }\n")
    dependency_tests :: try support.put(context, dependency, "value.test.hon",
        `import "@std/testing"
        `dependency_check test { try testing.expect_equal(i16(42), value()) }
        `
    )
    source :: try support.put(context, package, "main.hon",
        `import "@dependency"
        `test import "@dependency"
        `main proc() i16 { return dependency.value() }
        `
    )
    checks :: try support.put(context, package, "checks.test.hon",
        `assertions :: import "@std/testing"
        `import "@std/debug"
        `First :: enum { first }
        `Second :: enum { second }
        `first proc() void ! First { return .first }
        `second proc() void ! Second { return .second }
        `passes test { try assertions.expect_equal(19 + 23, 42) }
        `fails test {
        `    defer debug.print("cleanup ran\n", {})
        `    try assertions.expect(false)
        `    debug.print("unreachable after assertion\n", {})
        `}
        `first_error test { errdefer debug.print("error cleanup ran\n", {})
        `try first() }
        `second_error test { try second() }
        `returned_error test { return First.first }
        `Payload :: struct { code i16 }
        `payload proc() void ! Payload { return Payload { code = 42 } }
        `payload_error test { try payload() }
        `traps test { unreachable }
        `after_trap test { try assertions.expect(true) }
        `
    )
    failed :: try support.run(context, &[context.compiler, "test", package], support.RunOptions{ timeout_seconds = 300 })
    try support.expect(context, failed.status == 1, "failing framework suite exits one")
    try support.expect(context, support.contains(failed.stderr, "cleanup ran\n"), "assertion executes deferred cleanup")
    try support.expect(context, support.contains(failed.stderr, "error cleanup ran\n"), "returned error executes error cleanup")
    try support.expect(context, !support.contains(failed.stderr, "unreachable after assertion"), "assertion stops test execution")
    location :: try support.concat(context, &[try support.canonical(context, checks), ":10:9: expectation failed"])
    try support.expect(context, support.contains(failed.stderr, location), "assertion reports original source location")
    try support.expect(context, support.contains(failed.stderr, "checks.test.hon:after_trap ... ok"), "test after trap executes")
    try support.expect(context, support.contains(failed.stderr, "value.test.hon:dependency_check ... ok"), "test-only dependency executes")
    try support.expect(context, support.contains(failed.stderr, "3 passed, 6 failed\n"), "framework preserves all test outcomes")
    try support.expect(context, failed.stdout.len == 0, "framework writes no stdout")

    try support.write(context, dependency_tests, "invalid test syntax\n")
    production :: try support.run(context, &[context.compiler, "run", package], support.RunOptions{ timeout_seconds = 300 })
    try support.expect_result(context, production, 0, "42\n", "")
    malformed :: try support.run(context, &[context.compiler, "test", package], support.RunOptions{ timeout_seconds = 300 })
    try support.expect(context, malformed.status == 1 and support.contains(malformed.stderr, "unexpected token"), "test discovery diagnoses malformed dependency")
    try support.expect(context, !support.contains(malformed.stderr, "cleanup ran"), "malformed tests never execute")

    try support.write(context, source,
        `checks :: import "@std/testing"
        `other :: import "@unrelated"
        `forward :: alias checks.expect
        `main proc() i16 { return 42 }
        `inline_check test {
        `    try checks.expect_type(i16, i16(42))
        `    try forward(other.expect(true))
        `    try checks.expect(true, checks.SourceLocation { file = "explicit", line = 7, column = 3 })
        `    try checks.expect_equal([]u8, "same", "same")
        `    value ?i16 :: 42
        `    try checks.expect_equal(value, value)
        `}
        `
    )
    passing :: try support.run(context, &[context.compiler, "test", source], support.RunOptions{ timeout_seconds = 300 })
    try support.expect(context, passing.status == 0 and support.contains(passing.stderr, "1 passed, 0 failed\n"), "inline test ignores application's main")
    try support.expect(context, !support.contains(passing.stderr, "checks.test.hon"), "file input does not discover sibling test files")
    try support.expect(context, passing.stdout.len == 0, "inline test writes no stdout")
    empty :: try support.run(context, &[context.compiler, "test", value], support.RunOptions{ timeout_seconds = 300 })
    try support.expect(context, empty.status == 0 and support.contains(empty.stderr, "0 passed, 0 failed\n"), "file with no tests succeeds")
    usage :: try support.run(context, &[context.compiler, "test", source, "unexpected"], support.RunOptions{ timeout_seconds = 300 })
    try support.expect(context, usage.status == 2 and support.contains(usage.stderr, "usage:"), "test command rejects extra argument")
    only :: try support.path(context, project, "only")
    _ = try support.put(context, only, "checks.test.bro", "only_test test {}\n")
    test_only :: try support.run(context, &[context.compiler, "test", only], support.RunOptions{ timeout_seconds = 300 })
    try support.expect(context, test_only.status == 0 and support.contains(test_only.stderr, "1 passed, 0 failed\n"), "test-only Bro package is discovered")
}
