import "@ffi/c"

mkdir c_func(path ?*c_char, mode c_ushort) c_int
mkfifo c_func(path ?*c_char, mode c_ushort) c_int
lstat c_func(path ?*c_char, result ?*mut c.Stat) c_int
kill c_func(pid c_int, signal c_int) c_int
clock_gettime c_func(clock c_uint, result ?*mut c.timespec) c_int
posix_spawn c_func(
    pid ?*mut c_int, file ?*c_char,
    actions ?*c.posix_spawn_file_actions_t, attributes ?*c.posix_spawnattr_t,
    arguments ?*?*mut c_char, environment ?*?*mut c_char,
) c_int
posix_spawn_file_actions_init c_func(actions ?*mut c.posix_spawn_file_actions_t) c_int
posix_spawn_file_actions_destroy c_func(actions ?*mut c.posix_spawn_file_actions_t) c_int
posix_spawn_file_actions_adddup2 c_func(actions ?*mut c.posix_spawn_file_actions_t, source, destination c_int) c_int
posix_spawn_file_actions_addclose c_func(actions ?*mut c.posix_spawn_file_actions_t, descriptor c_int) c_int
posix_spawn_file_actions_addchdir_np c_func(actions ?*mut c.posix_spawn_file_actions_t, directory ?*c_char) c_int
posix_spawnattr_init c_func(attributes ?*mut c.posix_spawnattr_t) c_int
posix_spawnattr_destroy c_func(attributes ?*mut c.posix_spawnattr_t) c_int
posix_spawnattr_setflags c_func(attributes ?*mut c.posix_spawnattr_t, flags c_short) c_int
posix_spawnattr_setpgroup c_func(attributes ?*mut c.posix_spawnattr_t, group c_int) c_int
