import "@tests/support"

hyphenated_import_namespaces test {
    context := try support.init("hyphenated imports")
    defer support.deinit(&context)
    project :: try support.path(&context, context.temporary, "hyphenated")
    _ = try support.put(&context, project, "build.hon", "# project root\n")
    _ = try support.put(&context, project, "pine-window/main.hon", "answer :: 42\n")
    _ = try support.put(&context, project, "-pine--window/main.hon", "answer :: 42\n")
    _ = try support.put(&context, project, "pine_window/main.hon", "answer :: 99\n")
    _ = try support.put(&context, project, "other.name/main.hon", "answer :: 42\n")
    main :: try support.put(&context, project, "app/main.hon",
        "import \"../pine-window\"\nmain proc() int { return pine_window.answer }\n")
    try support.check(&context, main, { stdout = "42\n" })
    try support.write(&context, main,
        "import \"@-pine--window\"\nmain proc() int { return _pine__window.answer }\n")
    try support.check(&context, main, { stdout = "42\n" })
    try support.write(&context, main,
        "window :: import \"@pine-window\"\nmain proc() int { return window.answer }\n")
    try support.check(&context, main, { stdout = "42\n" })
    try support.write(&context, main,
        "import \"@pine-window\"\nimport \"@pine_window\"\nmain proc() int { return pine_window.answer }\n")
    try support.check(&context, main, { stdout = "42\n", diagnostic = "duplicate name" })
    try support.write(&context, main,
        "import \"../other.name\"\nmain proc() int { return 42 }\n")
    try support.check(&context, main, { stdout = "42\n", diagnostic = "import requires an explicit valid identifier alias" })
    try support.write(&context, main,
        "other :: import \"../other.name\"\nmain proc() int { return other.answer }\n")
    try support.check(&context, main, { stdout = "42\n" })
}
