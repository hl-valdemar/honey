import "@tests/support"

comptime_calls_preserve_checked_narrow_intermediates test {
    context := try support.init("comptime_calls_preserve_checked_narrow_intermediates")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "comptime_calls_preserve_checked_narrow_intermediates",
        "overflow proc(seed i8) i8 {\n    result := seed\n    result = result + 1\n    return result - 1\n}\nanswer proc($N i8) i16 { return 42 }\nmain proc() i16 { return answer(overflow(127)) }\n",
        support.Expected{ stdout = "", diagnostic = "integer arithmetic overflow" },
    )
}

comptime_calls_preserve_unsigned_and_signed_boundaries test {
    context := try support.init("comptime_calls_preserve_unsigned_and_signed_boundaries")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "comptime_calls_preserve_unsigned_and_signed_boundaries",
        "unsigned proc(value u64) u64 { return value }\nsigned proc(value i64) i64 { return value }\nanswer proc($high u64, $low i64) i16 {\n    if (high == 18446744073709551615 and low == -9223372036854775808) return 42\n    return 0\n}\nmain proc() i16 {\n    return answer(unsigned(18446744073709551615), signed(-9223372036854775808))\n}\n",
        support.Expected{ stdout = "42\n", diagnostic = null },
    )
}

comptime_call_cannot_promote_runtime_parameter test {
    context := try support.init("comptime_call_cannot_promote_runtime_parameter")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "comptime_call_cannot_promote_runtime_parameter",
        "identity proc(value usize) usize { return value }\nanswer proc($N usize) i16 { return 42 }\nruntime proc(value usize) i16 { return answer(identity(value)) }\nmain proc() i16 { return runtime(2) }\n",
        support.Expected{ stdout = "", diagnostic = "generic argument must be a compile-time value" },
    )
}

