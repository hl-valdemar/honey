    try support.check_text(
        &context,
        "comptime_call_keeps_uninitialized_local_traps",
        "premature proc() usize {\n    before :: after\n    after :: 2\n    return before\n}\nanswer proc($N usize) i16 { return 42 }\nmain proc() i16 { return answer(premature()) }\n",
        support.Expected{ stdout = "", diagnostic = "local value was read before initialization" },
    )
}

