import "@tests/support"
import "@std/mem"

check_packages proc(context @mut support.Context) void ! support.Error {
    project :: (try support.path(context, context.temporary, "packages"))
    (try support.put(context, project, "build.hon", "# project-root marker\n"))
    app :: (try support.path(context, project, "app"))
    main :: (try support.put(context, project, "app/main.hon", "import \"../left\"\nright :: import \"@right\"\nimport \"../shared\"\nmain proc() int { return helper(21) }\n"))
    helper :: (try support.put(context, project, "app/zhelper.bro", "helper proc(n int) int { return n * 2 }\n"))
    (try support.put(context, project, "app/ignored.test.hon", "this is deliberately not valid source\n"))
    (try support.directory(context, (try support.path(context, app, "directory.hon"))))
    fifo :: (try support.path(context, project, "pipe"))
    (try support.fifo(context, fifo))
    (try support.symlink(context, fifo, (try support.path(context, app, "pipe.hon"))))
    (try support.put(context, project, "left/left.hon", "import \"../shared\"\nhelper proc() int { return 1 }\nmain proc() int { return 99 }\n"))
    (try support.put(context, project, "right/right.hon", "import \"../shared-link\"\nhelper proc() int { return 2 }\n"))
    shared :: (try support.put(context, project, "shared/shared.hon", "helper proc() int { return 3 }\n"))
    (try support.symlink(context, (try support.path(context, project, "shared")), (try support.path(context, project, "shared-link"))))
    (try support.check(context, app, { stdout = "42\n", diagnostic = null }))
    (try support.check(context, main, { stdout = "", diagnostic = "unknown name" }))
    emitted :: (try support.run(context, &[context.compiler, "emit-llvm", app], {}))
    try support.expect(context, ((emitted.status == 0) and mem.eql(u8, emitted.stderr, "")), "original assertion: emitted.returncode == 0 and emitted.stderr == b''")
    (try support.write(context, shared, "bad proc() int { return missing }\n"))
    (try support.check(context, app, { stdout = "42\n", diagnostic = "unknown name" }))
    diagnosed :: (try support.run(context, &[context.compiler, "run", app], {}))
    try support.expect(context, (support.count(diagnosed.stderr, "unknown name") == 1), "original assertion: diagnosed.stderr.count(b'unknown name') == 1")
    try support.expect(context, support.contains(diagnosed.stderr, (try support.concat(context, &[(try support.canonical(context, shared)), ":1:"]))), "original assertion: str(shared.resolve()).encode() + b':1:' in diagnosed.stderr")
    (try support.write(context, main, "import \"../left\"\nentry proc() int { return 42 }\n"))
    (try support.write(context, shared, "helper proc() int { return 3 }\n"))
    (try support.check(context, app, { stdout = "", diagnostic = "program requires a main function" }))
    (try support.write(context, main, "import \"../left\"\nmain proc() int { return helper() }\n"))
    (try support.write(context, helper, "local_only proc() int { return 7 }\n"))
    (try support.check(context, app, { stdout = "", diagnostic = "unknown name" }))
    (try support.write(context, main, "import \"../left\"\nmain proc() int { return 42 }\n"))
    (try support.write(context, shared, "import \"../left\"\n"))
    (try support.check(context, app, { stdout = "42\n", diagnostic = "package import cycle" }))
    (try support.write(context, shared, "import \"../shared-link\"\n"))
    (try support.check(context, app, { stdout = "42\n", diagnostic = "package import cycle" }))
    (try support.write(context, shared, "helper proc() int { return 3 }\n"))
    (try support.directory(context, (try support.path(context, project, "empty"))))
    (try support.write(context, main, (try support.concat(context, &["import \"", "/tmp", "\"\nmain proc() int { return 42 }\n"]))))
    (try support.check(context, app, { stdout = "42\n", diagnostic = "invalid import path" }))
    (try support.directory(context, (try support.path(context, project, "empty"))))
    (try support.write(context, main, (try support.concat(context, &["import \"", "@/tmp", "\"\nmain proc() int { return 42 }\n"]))))
    (try support.check(context, app, { stdout = "42\n", diagnostic = "invalid import path" }))
    (try support.directory(context, (try support.path(context, project, "empty"))))
    (try support.write(context, main, (try support.concat(context, &["import \"", "../absent", "\"\nmain proc() int { return 42 }\n"]))))
    (try support.check(context, app, { stdout = "42\n", diagnostic = "cannot load package directory" }))
    (try support.directory(context, (try support.path(context, project, "empty"))))
    (try support.write(context, main, (try support.concat(context, &["import \"", "../shared/shared.hon", "\"\nmain proc() int { return 42 }\n"]))))
    (try support.check(context, app, { stdout = "42\n", diagnostic = "cannot load package directory" }))
    (try support.directory(context, (try support.path(context, project, "empty"))))
    (try support.write(context, main, (try support.concat(context, &["import \"", "../empty", "\"\nmain proc() int { return 42 }\n"]))))
    (try support.check(context, app, { stdout = "42\n", diagnostic = "cannot load package directory" }))
    (try support.write(context, main, "test import \"../absent\"\nmain proc() int { return 42 }\n"))
    (try support.check(context, app, { stdout = "42\n", diagnostic = null }))
    (try support.put(context, project, "duplicate/z.hon", "value :: 99\n"))
    (try support.put(context, project, "duplicate/a.hon", "value :: 41\n"))
    (try support.put(context, project, "duplicate/main.hon", "main proc() int { return value }\n"))
    (try support.check(context, (try support.path(context, project, "duplicate")), { stdout = "41\n", diagnostic = "duplicate name" }))
    (try support.write(context, main, "main proc() int { return fail() }\n"))
    (try support.write(context, helper, "\nfail proc() int { return 9223372036854775807 + 1 }\n"))
    (try support.check(context, app, { stdout = "", diagnostic = "integer arithmetic overflow" }))
    trapped :: (try support.run(context, &[context.compiler, "run", app], {}))
    try support.expect(context, support.contains(trapped.stderr, (try support.concat(context, &[(try support.canonical(context, helper)), ":2:"]))), "original assertion: str(helper.resolve()).encode() + b':2:' in trapped.stderr")
    empty :: (try support.run(context, &[context.compiler, "run", (try support.path(context, project, "empty"))], {}))
    try support.expect(context, ((empty.status == 2) and support.contains(empty.stderr, "no production source files")), "original assertion: empty.returncode == 2 and b'no production source files' in empty.stderr")
    special :: (try support.run(context, &[context.compiler, "run", fifo], {}))
    try support.expect(context, ((special.status == 2) and support.contains(special.stderr, "cannot open source file")), "original assertion: special.returncode == 2 and b'cannot open source file' in special.stderr")
}

check_namespace_packages proc(context @mut support.Context) void ! support.Error {
    project :: (try support.path(context, context.temporary, "namespaces"))
    (try support.put(context, project, "build.hon", "# project root\n"))
    main :: (try support.put(context, project, "app/main.hon", "\nimport \"../left\"\nright :: import \"@right\"\nimport \"../shared-link\"\nmain proc() int {\n    functions :: [left.helper, right.helper]\n    selected := left.helper\n    selected = right.helper\n    return sibling(18) + functions[0]() + selected() + shared.helper()\n}\n"))
    sibling :: (try support.put(context, project, "app/sibling.hon", "\nright :: import \"../left\"\nsibling proc(n int) int { return n * 2 + right.helper() - 1 }\n"))
    (try support.put(context, project, "left/main.hon", "\nimport \"../shared\"\nhelper proc() int { return shared.helper() - 2 }\nidentity proc(n int) int { return n }\nmain proc() int { return 99 }\n"))
    (try support.put(context, project, "right/main.hon", "\nimport \"../shared-link\"\nhelper proc() int { return shared.helper() - 1 }\n"))
    dependency :: (try support.put(context, project, "shared/main.hon", "\nhelper proc() int { return value }\nfail proc() int { return 9223372036854775807 + 1 }\n"))
    (try support.put(context, project, "shared/zfunctions.bro", "\nvalue :: 3\nidentity proc(n f64) f64 { return n }\n"))
    (try support.put(context, project, "shared/ignored.test.bro", "this is deliberately not valid source\n"))
    (try support.symlink(context, (try support.path(context, project, "shared")), (try support.path(context, project, "shared-link"))))
    app :: (try support.path(context, project, "app"))
    (try support.check(context, app, { stdout = "42\n", diagnostic = null }))
    emitted :: (try support.run(context, &[context.compiler, "emit-llvm", app], {}))
    try support.expect(context, ((emitted.status == 0) and mem.eql(u8, emitted.stderr, "")), "original assertion: emitted.returncode == 0 and emitted.stderr == b''")
    (try support.write(context, sibling, "sibling proc(n int) int { return n * 2 }\n"))
    (try support.write(context, main, "import \"../left\"\nmain proc() int { return left.helper() }\n"))
    (try support.check(context, app, { stdout = "1\n", diagnostic = null }))
    (try support.write(context, main, "lib :: import \"../shared\"\nmain proc() f64 { f :: lib.identity\nreturn f(1.5) }\n"))
    (try support.check(context, app, { stdout = "1.5\n", diagnostic = null }))
    (try support.write(context, main, "lib :: import \"../shared\"\nmain proc() int { return lib.value }\n"))
    (try support.check(context, app, { stdout = "3\n", diagnostic = null }))
    (try support.write(context, main, "\nimport \"../left\"\nimport \"../shared\"\nmain proc() bool {\n    return left.identity(41) == 41 and shared.identity(1.5) == 1.5\n}\n\n"))
    (try support.check(context, app, { stdout = "true\n", diagnostic = null }))
    (try support.write(context, main, "lib :: import \"../shared\"\nmain proc() int { return lib.absent() }\n"))
    (try support.check(context, app, { stdout = "", diagnostic = "unknown name" }))
    (try support.write(context, main, "lib :: import \"../shared\"\nmain proc() int { return helper() }\n"))
    (try support.check(context, app, { stdout = "", diagnostic = "unknown name" }))
    (try support.write(context, main, "import \"../left\"\nmain proc() int { return left.shared.helper() }\n"))
    (try support.check(context, app, { stdout = "", diagnostic = "unknown name" }))
    (try support.write(context, main, "import \"../shared\"\nmain proc() int { return shared.helper(1) }\n"))
    (try support.check(context, app, { stdout = "", diagnostic = "argument count" }))
    (try support.write(context, main, "import \"../shared\"\nmain proc() f64 { return shared.identity(true) }\n"))
    (try support.check(context, app, { stdout = "", diagnostic = "incompatible value type" }))
    (try support.write(context, main, "import \"../shared\"\nmain proc() int { shared\nreturn 42 }\n"))
    (try support.check(context, app, { stdout = "", diagnostic = "namespace cannot be used as a value" }))
    (try support.write(context, main, "import \"../shared\"\nmain proc() int { return shared.value.member }\n"))
    (try support.check(context, app, { stdout = "", diagnostic = "" }))
    (try support.write(context, main, "lib :: import \"../absent\"\nmain proc() int { return lib.helper() }\n"))
    (try support.check(context, app, { stdout = "", diagnostic = "cannot load package directory" }))
    (try support.write(context, main, "lib :: import \"../left\"\nlib :: import \"../right\"\nmain proc() int { return lib.helper() }\n"))
    (try support.check(context, app, { stdout = "1\n", diagnostic = "duplicate name" }))
    (try support.write(context, main, "lib :: import \"../shared\"\nlib :: 42\nmain proc() int { return lib.helper() }\n"))
    (try support.check(context, app, { stdout = "", diagnostic = "duplicate name" }))
    (try support.write(context, main, "lib :: import \"../shared\"\nmain proc() int { lib :: 42\nreturn lib }\n"))
    (try support.check(context, app, { stdout = "", diagnostic = "duplicate name" }))
    (try support.write(context, main, "int :: import \"../shared\"\nmain proc() int { return 42 }\n"))
    (try support.check(context, app, { stdout = "", diagnostic = "duplicate name" }))
    (try support.write(context, main, "import \"../shared\"\nmain proc() int { shared.value = 42\nreturn 0 }\n"))
    (try support.check(context, app, { stdout = "", diagnostic = "mutable local binding" }))
    (try support.write(context, main, "import \"../shared\"\nmain proc() int { shared = 42\nreturn 0 }\n"))
    (try support.check(context, app, { stdout = "", diagnostic = "mutable local binding" }))
    (try support.write(context, main, "import \"../shared\"\nunused proc() int { return shared.absent() }\nmain proc() int { return 42 }\n"))
    (try support.check(context, app, { stdout = "42\n", diagnostic = "unknown name" }))
    (try support.write(context, main, "import \"../shared\"\nmain proc() int { return shared.fail() }\n"))
    (try support.check(context, app, { stdout = "", diagnostic = "integer arithmetic overflow" }))
    (try support.write(context, main, "import \"../shared\"\nmain proc() int { return shared. }\n"))
    (try support.check(context, app, { stdout = "", diagnostic = "unexpected token" }))
    (try support.write(context, main, "main proc() int { return local.helper() }\n"))
    (try support.write(context, sibling, "local :: import \"../shared\"\nsibling proc(n int) int { return n }\n"))
    (try support.check(context, app, { stdout = "", diagnostic = "unknown name" }))
    (try support.write(context, main, "lib :: import \"../absent\"\nmain proc() int { return lib.helper() }\n"))
    diagnosed :: (try support.run(context, &[context.compiler, "run", app], {}))
    try support.expect(context, (support.count(diagnosed.stderr, "cannot load package directory") == 1), "original assertion: diagnosed.stderr.count(b'cannot load package directory') == 1")
    try support.expect(context, !support.contains(diagnosed.stderr, "unknown name"), "original assertion: b'unknown name' not in diagnosed.stderr")
    (try support.write(context, main, "import \"../shared\"\nmain proc() int { return shared.helper() }\n"))
    (try support.write(context, dependency, "helper proc() int { return missing }\n"))
    (try support.check(context, app, { stdout = "", diagnostic = "unknown name" }))
    diagnosed1 :: (try support.run(context, &[context.compiler, "run", app], {}))
    try support.expect(context, support.contains(diagnosed1.stderr, (try support.concat(context, &[(try support.canonical(context, dependency)), ":1:"]))), "original assertion: str(dependency.resolve()).encode() + b':1:' in diagnosed.stderr")
    (try support.write(context, dependency, "\nhelper proc() int { return 9223372036854775807 + 1 }\n"))
    (try support.check(context, app, { stdout = "", diagnostic = "integer arithmetic overflow" }))
    trapped :: (try support.run(context, &[context.compiler, "run", app], {}))
    try support.expect(context, support.contains(trapped.stderr, (try support.concat(context, &[(try support.canonical(context, dependency)), ":2:"]))), "original assertion: str(dependency.resolve()).encode() + b':2:' in trapped.stderr")
    single :: (try support.put(context, project, "single/main.bro", "\nimport \"../shared\"\nmain proc() f64 { return shared.identity(42) }\n"))
    (try support.put(context, project, "single/poison.hon", "\nmain proc() int { return missing }\n"))
    (try support.check(context, single, { stdout = "42\n", diagnostic = null }))
    emitted1 :: (try support.run(context, &[context.compiler, "emit-llvm", single], {}))
    try support.expect(context, ((emitted1.status == 0) and mem.eql(u8, emitted1.stderr, "")), "original assertion: emitted.returncode == 0 and emitted.stderr == b''")
    (try support.check(context, (try support.path(context, project, "single")), { stdout = "42\n", diagnostic = "duplicate name" }))
    (try support.put(context, project, "hidden/a.hon", "@hide:file\nhelper proc() int { return 20 }\n@hide\npackage_value :: 19\nfirst proc() int { return helper() }\n"))
    (try support.put(context, project, "hidden/b.hon", "@hide:file\nhelper proc() int { return 22 }\nsecond proc() int { return helper() }\nanswer proc() int { return package_value + 23 }\n"))
    (try support.write(context, sibling, "sibling proc(n int) int { return n }\n"))
    (try support.write(context, main, "import \"../hidden\"\nmain proc() int { return hidden.first() + hidden.second() }\n"))
    (try support.check(context, app, { stdout = "42\n", diagnostic = null }))
    (try support.write(context, main, "import \"../hidden\"\nmain proc() int { return hidden.helper() }\n"))
    (try support.check(context, app, { stdout = "", diagnostic = "unknown name" }))
    (try support.write(context, main, "import \"../hidden\"\nmain proc() int { return hidden.answer() }\n"))
    (try support.check(context, app, { stdout = "42\n", diagnostic = null }))
    (try support.write(context, main, "import \"../hidden\"\nmain proc() int { return hidden.package_value }\n"))
    (try support.check(context, app, { stdout = "", diagnostic = "unknown name" }))
    (try support.write(context, main, "import \"../hidden\"\nspace :: alias hidden\nmain proc() int { return space.package_value }\n"))
    (try support.check(context, app, { stdout = "", diagnostic = "unknown name" }))
    (try support.write(context, main, "@hide:file\nprivate proc() int { return 42 }\nmain proc() int { return private() }\n"))
    (try support.check(context, app, { stdout = "42\n", diagnostic = null }))
    (try support.write(context, sibling, "@hide:file\nprivate proc() int { return 42 }\n"))
    (try support.write(context, main, "main proc() int { return private() }\n"))
    (try support.check(context, app, { stdout = "", diagnostic = "unknown name" }))
}

check_record_packages proc(context @mut support.Context) void ! support.Error {
    project :: (try support.path(context, context.temporary, "records"))
    app :: (try support.path(context, project, "app"))
    library :: (try support.path(context, project, "library"))
    (try support.directory(context, app))
    (try support.directory(context, library))
    types :: (try support.path(context, library, "types.hon"))
    (try support.write(context, types, "Point :: struct { x i16, y i16 = 2 }\n"))
    (try support.write(context, (try support.path(context, library, "functions.hon")), "identity proc(p Point) Point { return p }\n"))
    (try support.write(context, (try support.path(context, app, "main.hon")), "lib :: import \"../library\"\nmain proc() i16 {\n    p lib.Point := lib.Point { x = 40 }\n    q :: lib.identity(p)\n    p.x = 1\n    return q.x + q.y\n}\n"))
    (try support.check(context, app, { stdout = "42\n", diagnostic = null }))
    (try support.write(context, (try support.path(context, library, "functions.hon")), "set proc(p @mut Point) void { p.x = 40 }\nidentity proc(p @mut Point) @mut Point { return p }\n"))
    (try support.write(context, (try support.path(context, app, "main.hon")), "lib :: import \"../library\"\nmain proc() i16 {\n    p lib.Point := { x = 1 }\n    pointer :: lib.identity(&p)\n    lib.set(pointer)\n    return pointer.x + p.y\n}\n"))
    (try support.check(context, app, { stdout = "42\n", diagnostic = null }))
    (try support.write(context, types, "Point :: struct { x i16, y i16 = 32767 + 1 }\n"))
    (try support.check(context, app, { stdout = "", diagnostic = "integer arithmetic overflow" }))
    trapped :: (try support.run(context, &[context.compiler, "run", app], {}))
    try support.expect(context, support.has_prefix(trapped.stderr, (try support.concat(context, &[(try support.canonical(context, types)), ":1:"]))), "original assertion: trapped.stderr.startswith(f'{types.resolve()}:1:'.encode())")
    (try support.write(context, types, "Point :: struct { x i16, y i16 = 2 }\nCallback :: alias @proc(p @mut Point, amount i16) i16\nVTable :: struct { run Callback }\n"))
    (try support.write(context, (try support.path(context, library, "functions.hon")), "increment proc(p @mut Point, amount i16) i16 { p.x = p.x + amount\nreturn p.x + p.y }\ninvoke proc(table VTable, values *mut Point) i16 { return table.run(&(values + 1)^, 40) }\n"))
    (try support.write(context, (try support.path(context, app, "main.hon")), "lib :: import \"../library\"\nmain proc() i16 {\n    values [2]mut lib.Point := [lib.Point { x = 7 }, lib.Point { x = 0 }]\n    callback lib.Callback :: lib.increment\n    table :: lib.VTable { run = callback }\n    result :: lib.invoke(table, (&values).ptr)\n    if (values[0].x != 7 or values[1].x != 40) return -1\n    return result\n}\n"))
    (try support.check(context, app, { stdout = "42\n", diagnostic = null }))
    (try support.write(context, types, "Generated proc(bias i16) type {\n    return struct_type!(.auto, [\"value\", \"bias\"], [i16, i16], [null, bias])\n}\n"))
    (try support.write(context, (try support.path(context, library, "functions.hon")), "identity proc(value Generated(2)) Generated(2) { return value }\n"))
    (try support.write(context, (try support.path(context, app, "main.hon")), "lib :: import \"../library\"\nSelected :: alias lib.Generated(2)\nmain proc() i16 {\n    value Selected :: { value = 40 }\n    same lib.Generated(2) :: lib.identity(value)\n    return same.value + same.bias\n}\n"))
    (try support.check(context, app, { stdout = "42\n", diagnostic = null }))
    (try support.write(context, types, "Generated proc(_ i16) type {\n    return struct_type!(.auto, [\"bad-name\"], [i16], [null])\n}\n"))
    (try support.check(context, app, { stdout = "", diagnostic = "generated field name" }))
    diagnosed :: (try support.run(context, &[context.compiler, "run", app], {}))
    try support.expect(context, support.has_prefix(diagnosed.stderr, (try support.concat(context, &[(try support.canonical(context, types)), ":2:"]))), "original assertion: diagnosed.stderr.startswith(f'{types.resolve()}:2:'.encode())")
}

check_data_model_packages proc(context @mut support.Context) void ! support.Error {
    project :: (try support.path(context, context.temporary, "data-models"))
    app :: (try support.path(context, project, "app"))
    library :: (try support.path(context, project, "library"))
    (try support.directory(context, app))
    (try support.directory(context, library))
    (try support.write(context, (try support.path(context, library, "types.hon")), "Kind :: enum { number, empty }\nId :: distinct i16\nChoice :: union(Kind) { empty void, number Id }\nCount :: alias Id\nseed Id :: Id(41)\n"))
    (try support.write(context, (try support.path(context, library, "functions.hon")), "identity proc(c Choice) Choice { return c }\nscore proc(c Choice) Id {\n    return match c { .number |n|: n + 1, .empty: Id(0) }\n}\ninvoke :: alias score\n"))
    source :: (try support.path(context, app, "main.hon"))
    (try support.write(context, source, "lib :: import \"../library\"\nAlias :: alias lib.Choice\ncall :: alias lib.invoke\nshared :: alias lib.seed\nmain proc() i16 {\n    value Alias :: { number = shared }\n    return i16(call(lib.identity(value)))\n}\n"))
    (try support.check(context, app, { stdout = "42\n", diagnostic = null }))
    (try support.write(context, source, "lib :: import \"../library\"\nId :: distinct i16\nmain proc() Id { return lib.seed }\n"))
    (try support.check(context, app, { stdout = "", diagnostic = "return does not match" }))
    (try support.write(context, source, "lib :: import \"../library\"\nKind :: enum { number, empty }\nmain proc() Kind { return lib.Kind.number }\n"))
    (try support.check(context, app, { stdout = "", diagnostic = "return does not match" }))
}

check_specialization_packages proc(context @mut support.Context) void ! support.Error {
    project :: (try support.path(context, context.temporary, "specialization"))
    app :: (try support.path(context, project, "app"))
    library :: (try support.path(context, project, "library"))
    (try support.directory(context, app))
    (try support.directory(context, library))
    (try support.write(context, (try support.path(context, library, "types.hon")), "Box proc(T type) type {\n    return struct { value match true { true: T, false: i8(128) } }\n}\nSelected proc(wide bool) type {\n    return match wide { true: i16, false: u8 }\n}\nFixed proc($T type, N usize) type {\n    Element := i8\n    length usize := 0\n    while (length < N) {\n        Element = T\n        length = length + 1\n    }\n    return struct { values [match length { 0: usize(0), else: length }]mut Element }\n}\nChoice :: union(enum) { count usize, empty void }\nCaptured proc(T type, choice Choice) type {\n    return match choice {\n        .count |length|: struct { values [length]T },\n        .empty: bool,\n    }\n}\nTypeRecord proc(T type) type {\n    config struct { child type, count usize } := { child = i8, count = 1 }\n    original :: config\n    config.child = T\n    config.count = 2\n    if (original.child != i8 or original.count != 1) return bool\n    return struct { values [config.count]config.child }\n}\n"))
