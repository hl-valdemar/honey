optional_fallback_evaluates_subject_once_and_rhs_lazily test {
    context := try support.init("optional_fallback_evaluates_subject_once_and_rhs_lazily")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "optional_fallback_evaluates_subject_once_and_rhs_lazily",
        "subject proc(count @mut i16, present bool) ?i16 {\n    count^ += 1\n    if (present) return 19\n    return null\n}\nfallback proc(count @mut i16) i16 { count^ += 10\n    return 23 }\nevaluate proc() [4]i16 {\n    count i16 := 0\n    first :: subject(&count, true) orelse fallback(&count)\n    second :: subject(&count, false) orelse fallback(&count)\n    nested ??i16 :: null\n    third :: nested orelse some!(i16(42)) orelse i16(0)\n    return [first, second, third, count]\n}\n\nmain proc() i32 {\n    value :: evaluate()\n    if (value.len != 4) return 1\n    if (value[0] != 19) return 1\n    if (value[1] != 23) return 1\n    if (value[2] != 42) return 1\n    if (value[3] != 12) return 1\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = null },
    )
}

