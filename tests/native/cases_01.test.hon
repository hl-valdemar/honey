    defer support.deinit(&context)
    try support.check_text(
        &context,
        "prefixed_integers_preserve_widths_and_comptime_values",
        "Flags :: enum(u8) { first = 0b1, second = 0o10, last = 0x80 }\nCount proc($n usize) type { return [n]u8 }\nflags :: 0b101010\nevaluate proc() [5]u64 {\n    values Count(0x2) :: [0o7, 0b10]\n    minimum i64 :: -0x8000000000000000\n    maximum u64 :: 0xffffffffffffffff\n    return [u64(flags), u64(values.len), u64(Flags.last),\n        u64(minimum + 0x7fffffffffffffff + 1), maximum]\n}\n\nmain proc() i32 {\n    value :: evaluate()\n    if (value.len != 5) return 1\n    if (value[0] != 42) return 1\n    if (value[1] != 2) return 1\n    if (value[2] != 128) return 1\n    if (value[3] != 0) return 1\n    if (value[4] != 18446744073709551615) return 1\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = null },
    )
}

