import "@tests/support"

sentinel_arrays_keep_logical_lengths_and_physical_storage test {
    context := try support.init("sentinel_arrays_keep_logical_lengths_and_physical_storage")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "sentinel_arrays_keep_logical_lengths_and_physical_storage",
        "evaluate proc() [10]usize {\n    values [2;7]mut u8 := [19, 23]\n    copy := values\n    copy[0] = 1\n    empty [0;7]u8 :: []\n    inferred [_;9]u8 :: [3, 4, 5]\n    _ [2][1;7]u16 :: [[11], [13]]\n    total usize := 0\n    for (values) |value| total += usize(value)\n    return [\n        values.len, sizeof!([2;7]u8), usize(values[2]),\n        usize(copy[0]), usize(values[0]), total,\n        empty.len, usize(empty[0]), inferred.len, sizeof!([2][1;7]u16),\n    ]\n}\n\nmain proc() i32 {\n    value :: evaluate()\n    if (value.len != 10) return 1\n    if (value[0] != 2) return 1\n    if (value[1] != 3) return 1\n    if (value[2] != 7) return 1\n    if (value[3] != 1) return 1\n    if (value[4] != 19) return 1\n    if (value[5] != 42) return 1\n    if (value[6] != 0) return 1\n    if (value[7] != 7) return 1\n    if (value[8] != 3) return 1\n    if (value[9] != 8) return 1\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = null },
    )
}

sentinel_arrays_survive_generic_inference_and_owned_comptime_results test {
    context := try support.init("sentinel_arrays_survive_generic_inference_and_owned_comptime_results")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "sentinel_arrays_survive_generic_inference_and_owned_comptime_results",
        "identity proc($N usize, $S u8, value [N;S]u8) [N;S]u8 { return value }\nmake proc() [2;7]mut i16 {\n    values [2;7]mut i16 := [19, 23]\n    return values\n}\nevaluate proc() [8]usize {\n    value [2;3]u8 :: [11, 13]\n    inferred :: identity(value)\n    owned :: $(make())\n    different usize :: if $([2;0]u8 != [2;1]u8) 1 else 0\n    ordinary usize :: if $([2;0]u8 != [2]u8) 1 else 0\n    return [\n        inferred.len, usize(inferred[2]), usize(owned[0]), usize(owned[1]),\n        usize(owned[2]), sizeof!([2;7]i16), different, ordinary,\n    ]\n}\n\nmain proc() i32 {\n    value :: evaluate()\n    if (value.len != 8) return 1\n    if (value[0] != 2) return 1\n    if (value[1] != 3) return 1\n    if (value[2] != 19) return 1\n    if (value[3] != 23) return 1\n    if (value[4] != 7) return 1\n    if (value[5] != 6) return 1\n    if (value[6] != 1) return 1\n    if (value[7] != 1) return 1\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = null },
    )
}

sentinel_array_views_preserve_endpoints_and_allow_weakening test {
    context := try support.init("sentinel_array_views_preserve_endpoints_and_allow_weakening")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "sentinel_array_views_preserve_endpoints_and_allow_weakening",
        "length proc(value [;0]u8) usize { return value.len }\nordinary proc(value []u8) usize { return value.len }\nevaluate proc() [7]usize {\n    values [2;0]mut u8 := [19, 23]\n    pointer :: &values\n    borrowed [;0]u8 :: &values\n    suffix [;0]u8 :: pointer[1..]\n    interior [;23]u8 :: values[..1;23]\n    checked [;0]u8 :: values[..2;0]\n    return [\n        length(values), length(suffix), ordinary(values[..1]), interior.len,\n        checked.len, usize(suffix.ptr[1]), length(borrowed),\n    ]\n}\n\nmain proc() i32 {\n    value :: evaluate()\n    if (value.len != 7) return 1\n    if (value[0] != 2) return 1\n    if (value[1] != 1) return 1\n    if (value[2] != 1) return 1\n    if (value[3] != 1) return 1\n    if (value[4] != 2) return 1\n    if (value[5] != 0) return 1\n    if (value[6] != 2) return 1\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = null },
    )
}

