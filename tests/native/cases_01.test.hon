runtime_shift_captures_are_not_constant_declarations test {
    context := try support.init("runtime_shift_captures_are_not_constant_declarations")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "runtime_shift_captures_are_not_constant_declarations",
        "Shift :: union(enum) { bits u8, empty void }\nevaluate proc() [3]u8 {\n    counts [2]u8 :: [1, 2]\n    sum u8 := 0\n    for counts |count| { sum += u8(1) << count }\n    optional ?u8 :: 2\n    from_optional u8 :: if optional |count| u8(1) << count else 0\n    tagged Shift :: .bits{3}\n    from_match u8 :: match tagged { .bits |count|: u8(1) << count, .empty: 0 }\n    return [sum, from_optional, from_match]\n}\n\nmain proc() i32 {\n    value :: evaluate()\n    if (value.len != 3) return 1\n    if (value[0] != 6) return 1\n    if (value[1] != 4) return 1\n    if (value[2] != 8) return 1\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = null },
    )
}

