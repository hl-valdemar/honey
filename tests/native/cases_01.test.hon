optional_capture_aliases_preserve_matched_error_residuals test {
    context := try support.init("optional_capture_aliases_preserve_matched_error_residuals")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "optional_capture_aliases_preserve_matched_error_residuals",
        "First :: enum { first }\nSecond :: enum { second }\nread proc(value ?(First | Second)) i16 ! Second {\n    if value |captured| {\n        original :: captured\n        match captured {\n            .first: return 1,\n            else: {\n                same :: match original { .first: false, .second: true }\n                if (!same) return 0\n                return captured\n            }\n        }\n    }\n    return 0\n}\nevaluate proc() [3]i16 {\n    return [read(.second) catch 42, read(.first) catch 99, read(null) catch 99]\n}\n\nmain proc() i32 {\n    value :: evaluate()\n    if (value.len != 3) return 1\n    if (value[0] != 42) return 1\n    if (value[1] != 1) return 1\n    if (value[2] != 0) return 1\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = null },
    )
}

closed_calls_skip_index_evaluation_in_short_circuit_guards test {
    context := try support.init("closed_calls_skip_index_evaluation_in_short_circuit_guards")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "closed_calls_skip_index_evaluation_in_short_circuit_guards",
        "make proc($N usize) [N + 1]mut u8 {\n    values [N]mut u8 := undefined\n    for 0..N |i| { values[i] = 1 }\n    j := N\n    while j > 0 and values[j - 1] > 0 : j -= 1 {}\n    success :: j == 0 or (values[j - 1] == 0 and values[j - 1] > 0)\n    count usize :: N + usize(values[0])\n    result [count]mut u8 := undefined\n    for 0..count |i| { result[i] = if (success) values[0] else 0 }\n    return result\n}\nevaluate proc() [3]mut u8 { return make(2) }\n\nmain proc() i32 {\n    value :: evaluate()\n    if (value.len != 3) return 1\n    if (value[0] != 1) return 1\n    if (value[1] != 1) return 1\n    if (value[2] != 1) return 1\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = null },
    )
}

