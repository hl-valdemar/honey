compound_updates_evaluate_places_once_before_rhs test {
    context := try support.init("compound_updates_evaluate_places_once_before_rhs")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "compound_updates_evaluate_places_once_before_rhs",
        "Box :: struct { values [2]mut i16 }\nplace proc(box @mut Box, trace @mut i16) @mut i16 {\n    trace^ = trace^ * 10 + 1\n    return &box.values[0]\n}\nrhs proc(box @mut Box, trace @mut i16) i16 {\n    trace^ = trace^ * 10 + 2\n    box.values[0] = 100\n    return 2\n}\nindex proc(trace @mut i16) usize {\n    trace^ = trace^ * 10 + 3\n    return 1\n}\nevaluate proc() [4]i16 {\n    box Box := { values = [40, 6] }\n    trace i16 := 0\n    place(&box, &trace)^ += rhs(&box, &trace)\n    box.values[index(&trace)] *= 7\n    count i16 := 0\n    for (0..3) |_| { defer count += 1 }\n    return [box.values[0], box.values[1], trace, count]\n}\n\nmain proc() i32 {\n    value :: evaluate()\n    if (value.len != 4) return 1\n    if (value[0] != 42) return 1\n    if (value[1] != 42) return 1\n    if (value[2] != 123) return 1\n    if (value[3] != 3) return 1\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = null },
    )
}

