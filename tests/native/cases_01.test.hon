sentinel_arrays_preserve_full_width_values_and_generated_storage test {
    context := try support.init("sentinel_arrays_preserve_full_width_values_and_generated_storage")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "sentinel_arrays_preserve_full_width_values_and_generated_storage",
        "wide proc() [0;$(maxval!(u64))]u64 { return [] }\nsigned proc() [0;$(minval!(i64))]i64 { return [] }\nFixed proc($S u8) type { return [1;S]u8 }\nFromEndpoint proc() type {\n    value [0;7]u8 :: []\n    return [value[0]]u8\n}\nevaluate proc() [5]bool {\n    unsigned_value :: $(wide())\n    signed_value :: $(signed())\n    generated Fixed(9) :: [5]\n    return [\n        unsigned_value[0] == maxval!(u64), signed_value[0] == minval!(i64),\n        generated[1] == 9, sizeof!(FromEndpoint()) == 7, generated.len == 1,\n    ]\n}\n\nmain proc() i32 {\n    value :: evaluate()\n    if (value.len != 5) return 1\n    if (value[0] != true) return 1\n    if (value[1] != true) return 1\n    if (value[2] != true) return 1\n    if (value[3] != true) return 1\n    if (value[4] != true) return 1\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = null },
    )
}

