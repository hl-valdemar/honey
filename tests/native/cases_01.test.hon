yielding_match_catch_and_conditional_blocks_are_lazy test {
    context := try support.init("yielding_match_catch_and_conditional_blocks_are_lazy")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "yielding_match_catch_and_conditional_blocks_are_lazy",
        "Error :: enum { failed }\nfail proc(flag bool) i16 ! Error {\n    if (flag) return .failed\n    return 40\n}\nchoose proc(flag bool) i16 {\n    return match flag {\n        true: { value :: fail(false) catch { yield 0 }\n            yield value + 2 },\n        false: { yield fail(true) catch { yield 7 } },\n    }\n}\nevaluate proc() [3]i16 {\n    return [choose(true), choose(false),\n        if (true) { yield 42 } else { yield divtrunc!(1, 0) }]\n}\n\nmain proc() i32 {\n    value :: evaluate()\n    if (value.len != 3) return 1\n    if (value[0] != 42) return 1\n    if (value[1] != 7) return 1\n    if (value[2] != 42) return 1\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = null },
    )
}

yielding_blocks_contextual_optional_fallible_and_aggregate_values test {
    context := try support.init("yielding_blocks_contextual_optional_fallible_and_aggregate_values")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "yielding_blocks_contextual_optional_fallible_and_aggregate_values",
        "Error :: enum { failed }\nItem :: struct { value i16 }\noptional proc(flag bool) ?i16 {\n    return { if (flag) yield 42\n        yield null }\n}\nfallible proc(flag bool) i16 ! Error {\n    return { if (flag) yield 42\n        yield .failed }\n}\nitem proc(flag bool) Item {\n    return if (flag) { yield { value = 42 } } else { value = 7 }\n}\nevaluate proc() [4]i16 {\n    if (optional(false) != null) return [0, 0, 0, 0]\n    return [optional(true)?, fallible(true) catch 0,\n        fallible(false) catch { yield 7 }, item(true).value]\n}\n\nmain proc() i32 {\n    value :: evaluate()\n    if (value.len != 4) return 1\n    if (value[0] != 42) return 1\n    if (value[1] != 42) return 1\n    if (value[2] != 7) return 1\n    if (value[3] != 42) return 1\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = null },
    )
}

yielding_blocks_propagate_errors_and_run_only_reached_cleanup test {
    context := try support.init("yielding_blocks_propagate_errors_and_run_only_reached_cleanup")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "yielding_blocks_propagate_errors_and_run_only_reached_cleanup",
        "Error :: enum { failed }\nfail proc() i16 ! Error { return .failed }\ncompute proc(trace @mut i16, flag bool) i16 ! Error {\n    value i16 :: {\n        defer trace^ = trace^ * 10 + 1\n        errdefer trace^ = trace^ * 10 + 2\n        if (flag) yield 42\n        yield try fail()\n    }\n    return value\n}\nevaluate proc() [4]i16 {\n    success i16 := 0\n    failure i16 := 0\n    left :: compute(&success, true) catch 0\n    right :: compute(&failure, false) catch 7\n    return [left, right, success, failure]\n}\n\nmain proc() i32 {\n    value :: evaluate()\n    if (value.len != 4) return 1\n    if (value[0] != 42) return 1\n    if (value[1] != 7) return 1\n    if (value[2] != 1) return 1\n    if (value[3] != 21) return 1\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = null },
    )
}

