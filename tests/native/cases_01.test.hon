fallible_return_context_does_not_wrap_conditional_alias_uses test {
    context := try support.init("fallible_return_context_does_not_wrap_conditional_alias_uses")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "fallible_return_context_does_not_wrap_conditional_alias_uses",
        "Err :: enum { failed }\nNodeId :: distinct u32\ntake proc(value NodeId) u32 { return u32(value) }\nparse proc(flag bool) NodeId ! Err {\n    value := if (flag) NodeId(1) else NodeId(2)\n    _ = take(value)\n    return value\n}\nevaluate proc() [2]u32 {\n    left :: parse(true) catch { return [0, 0] }\n    right :: parse(false) catch { return [0, 0] }\n    return [take(left), take(right)]\n}\n\nmain proc() i32 {\n    value :: evaluate()\n    if (value.len != 2) return 1\n    if (value[0] != 1) return 1\n    if (value[1] != 2) return 1\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = null },
    )
}

lossless_integer_widening_preserves_source_width test {
    context := try support.init("lossless_integer_widening_preserves_source_width")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "lossless_integer_widening_preserves_source_width",
        "Box :: struct { value u64 }\ntake proc(value u64) u64 { return value }\nevaluate proc() [6]u64 {\n    bytes [4]u8 :: [7, 11, 13, 17]\n    start u32 :: 1\n    end u16 :: 3\n    small u8 :: 250\n    box Box :: {value = small}\n    wide u64 := small\n    return [u64(bytes[start..end].len), u64(bytes[start]), take(small), box.value, wide, u64(~small)]\n}\n\nmain proc() i32 {\n    value :: evaluate()\n    if (value.len != 6) return 1\n    if (value[0] != 2) return 1\n    if (value[1] != 11) return 1\n    if (value[2] != 250) return 1\n    if (value[3] != 250) return 1\n    if (value[4] != 250) return 1\n    if (value[5] != 5) return 1\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = null },
    )
}

