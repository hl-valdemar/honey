        "mixed_runtime_branches_and_loops_keep_metadata_locals_independent",
        "Config :: struct { child type, count usize }\ncompute proc(value i16, repeats usize, take bool) i16 {\n    total := value\n    if (take) {\n        Element := i8\n        Element = i16\n        amount Element :: 2\n        total += amount\n    } else {\n        config Config := { child = i8, count = 1 }\n        config.child = i16\n        amount config.child :: 4\n        total += amount\n    }\n    index := usize(0)\n    while (index < repeats) {\n        config := Config { child = i8, count = 1 }\n        saved :: config\n        config.child = i16\n        config.count += 1\n        if (saved.child != i8 or saved.count != 1) return -1\n        values [config.count]config.child :: [total, 1]\n        total = values[0] + values[1]\n        index += 1\n    }\n    return total\n}\nforward proc(value i16, repeats usize, take bool) i16 { return compute(value, repeats, take) }\nevaluate proc() [2]i16 { return [forward(38, 2, true), forward(36, 2, false)] }\n\nmain proc() i32 {\n    value :: evaluate()\n    if (value.len != 2) return 1\n    if (value[0] != 42) return 1\n    if (value[1] != 42) return 1\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = null },
    )
}

