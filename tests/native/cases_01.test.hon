yielding_blocks_nest_and_copy_before_scoped_cleanup test {
    context := try support.init("yielding_blocks_nest_and_copy_before_scoped_cleanup")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "yielding_blocks_nest_and_copy_before_scoped_cleanup",
        "Item :: struct { values [1]mut i16 }\nevaluate proc() [3]i16 {\n    trace i16 := 0\n    source Item := { values = [40] }\n    saved Item :: {\n        defer trace = trace * 10 + 1\n        inner i16 :: {\n            defer trace = trace * 10 + 2\n            yield 2\n        }\n        {\n            defer source.values[0] = 0\n            source.values[0] = source.values[0] + inner\n            yield source\n        }\n        trace = -1\n    }\n    return [saved.values[0], source.values[0], trace]\n}\n\nmain proc() i32 {\n    value :: evaluate()\n    if (value.len != 3) return 1\n    if (value[0] != 42) return 1\n    if (value[1] != 0) return 1\n    if (value[2] != 21) return 1\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = null },
    )
}

