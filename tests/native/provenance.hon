import "@tests/support"
import "@std/mem"

check_dependency_provenance proc(context @mut support.Context) void ! support.Error {
    project :: (try support.path(context, context.temporary, "provenance"))
    app :: (try support.path(context, project, "app"))
    dependency :: (try support.path(context, project, "dependency"))
    (try support.directory(context, app))
    (try support.directory(context, dependency))
    main :: (try support.path(context, app, "main.hon"))
    source :: (try support.path(context, dependency, "diagnostic.hon"))
    bridge :: (try support.path(context, project, "bridge"))
    (try support.directory(context, bridge))
    (try support.write(context, (try support.path(context, bridge, "main.hon")), "import \"../dependency\"\nfail proc() int { return dependency.fail() }\n"))
    (try support.write(context, source, "\n# utf8: é\nfail proc() int {\n    return {\n        yield 9223372036854775807 + 1\n    }\n}\n"))
    location :: (try support.concat(context, &[(try support.canonical(context, source)), ":", "5", ":", "15", ": "]))
    (try support.write(context, main, "import \"../bridge\"\nevaluate proc() int {\n    if (false) return bridge.fail()\n    return 42\n}\nmain proc() i32 {\n    if (evaluate() == 42) return 0\n    return 1\n}\n"))
    interpreted :: (try support.run(context, &[context.compiler, "run", app], {}))
    try support.expect(context, (interpreted.status == 0), "original assertion: interpreted.returncode == int(static or reached)")
    try support.expect(context, mem.eql(u8, interpreted.stdout, ""), "entry point produces no implicit stdout")
    try support.expect(context, mem.eql(u8, interpreted.stderr, ""), "original assertion: interpreted.stderr == b''")
    emitted :: (try support.run(context, &[context.compiler, "emit-llvm", app], {}))
    try support.expect(context, (emitted.status == 0), "original assertion: emitted.returncode == int(static)")
    try support.expect(context, mem.eql(u8, emitted.stderr, ""), "original assertion: emitted.stderr == expected_diagnostics")
    built :: (try support.run(context, &[context.compiler, "build", app, "-o", context.executable, "--debug"], {}))
    try support.expect_result(context, built, 0, "", "")
    hidden :: (try support.path(context, context.temporary, "hidden-provenance"))
    (try support.rename(context, project, hidden))
    {
        defer {
        support.rename(context, hidden, project) catch |_| {}
        support.remove(context, context.executable) catch |_| {}
        }
    compiled :: (try support.run(context, &[context.executable], {}))
    try support.expect_same(context, compiled, interpreted)
    try support.rename(context, hidden, project)
    try support.remove(context, context.executable)
    }
    built1 :: (try support.run(context, &[context.compiler, "build", app, "-o", context.executable, "--release"], {}))
    try support.expect_result(context, built1, 0, "", "")
    hidden1 :: (try support.path(context, context.temporary, "hidden-provenance"))
    (try support.rename(context, project, hidden1))
    {
        defer {
        support.rename(context, hidden1, project) catch |_| {}
        support.remove(context, context.executable) catch |_| {}
        }
    compiled1 :: (try support.run(context, &[context.executable], {}))
    try support.expect_same(context, compiled1, interpreted)
    try support.rename(context, hidden1, project)
    try support.remove(context, context.executable)
    }
    (try support.write(context, main, "import \"../bridge\"\nevaluate proc() int {\n    if (true) return bridge.fail()\n    return 42\n}\nmain proc() i32 {\n    if (evaluate() == 42) return 0\n    return 1\n}\n"))
    interpreted1 :: (try support.run(context, &[context.compiler, "run", app], {}))
    try support.expect(context, (interpreted1.status == 1), "original assertion: interpreted.returncode == int(static or reached)")
    try support.expect(context, mem.eql(u8, interpreted1.stdout, ""), "entry point produces no implicit stdout")
    try support.expect(context, support.has_prefix(interpreted1.stderr, (try support.concat(context, &[location, "runtime trap: "]))), "original assertion: interpreted.stderr.startswith(location + label)")
    try support.expect(context, (support.line_count(interpreted1.stderr) == 1), "original assertion: len(interpreted.stderr.splitlines()) == 1")
    emitted1 :: (try support.run(context, &[context.compiler, "emit-llvm", app], {}))
    try support.expect(context, (emitted1.status == 0), "original assertion: emitted.returncode == int(static)")
    try support.expect(context, mem.eql(u8, emitted1.stderr, ""), "original assertion: emitted.stderr == expected_diagnostics")
    built2 :: (try support.run(context, &[context.compiler, "build", app, "-o", context.executable, "--debug"], {}))
    try support.expect_result(context, built2, 0, "", "")
    hidden2 :: (try support.path(context, context.temporary, "hidden-provenance"))
    (try support.rename(context, project, hidden2))
    {
        defer {
        support.rename(context, hidden2, project) catch |_| {}
        support.remove(context, context.executable) catch |_| {}
        }
    compiled2 :: (try support.run(context, &[context.executable], {}))
    try support.expect_same(context, compiled2, interpreted1)
    try support.rename(context, hidden2, project)
    try support.remove(context, context.executable)
    }
    built3 :: (try support.run(context, &[context.compiler, "build", app, "-o", context.executable, "--release"], {}))
    try support.expect_result(context, built3, 0, "", "")
    hidden3 :: (try support.path(context, context.temporary, "hidden-provenance"))
    (try support.rename(context, project, hidden3))
