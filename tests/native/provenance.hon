    try support.expect_same(context, compiled54, interpreted27)
    try support.rename(context, hidden54, project)
    try support.remove(context, context.executable)
    }
    built55 :: (try support.run(context, &[context.compiler, "build", app, "-o", context.executable, "--release"], {}))
    try support.expect_result(context, built55, 0, "", "")
    hidden55 :: (try support.path(context, context.temporary, "hidden-provenance"))
    (try support.rename(context, project, hidden55))
    {
        defer {
        support.rename(context, hidden55, project) catch |_| {}
        support.remove(context, context.executable) catch |_| {}
        }
    compiled55 :: (try support.run(context, &[context.executable], {}))
    try support.expect_same(context, compiled55, interpreted27)
    try support.rename(context, hidden55, project)
    try support.remove(context, context.executable)
    }
}

