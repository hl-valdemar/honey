    compiled3 :: (try support.run(context, &[context.executable], {}))
    try support.expect_same(context, compiled3, interpreted1)
    try support.rename(context, hidden3, project)
    try support.remove(context, context.executable)
    }
    (try support.write(context, source, "\n# utf8: é\nfail proc() int {\n    return {\n        yield missing\n    }\n}\n"))
    location1 :: (try support.concat(context, &[(try support.canonical(context, source)), ":", "5", ":", "15", ": "]))
    (try support.write(context, main, "import \"../bridge\"\nevaluate proc() int {\n    if (false) return bridge.fail()\n    return 42\n}\nmain proc() i32 {\n    if (evaluate() == 42) return 0\n    return 1\n}\n"))
    interpreted2 :: (try support.run(context, &[context.compiler, "run", app], {}))
    try support.expect(context, (interpreted2.status == 1), "original assertion: interpreted.returncode == int(static or reached)")
    try support.expect(context, mem.eql(u8, interpreted2.stdout, ""), "entry point produces no implicit stdout")
    try support.expect(context, support.has_prefix(interpreted2.stderr, (try support.concat(context, &[location1, "error: "]))), "original assertion: interpreted.stderr.startswith(location + label)")
    try support.expect(context, (support.line_count(interpreted2.stderr) == 1), "original assertion: len(interpreted.stderr.splitlines()) == 1")
    emitted2 :: (try support.run(context, &[context.compiler, "emit-llvm", app], {}))
    try support.expect(context, (emitted2.status == 1), "original assertion: emitted.returncode == int(static)")
    expected_diagnostics :: (try support.replace(context, interpreted2.stderr, "runtime trap: ", "error: "))
    try support.expect(context, mem.eql(u8, emitted2.stderr, expected_diagnostics), "original assertion: emitted.stderr == expected_diagnostics")
    built4 :: (try support.run(context, &[context.compiler, "build", app, "-o", context.executable, "--debug"], {}))
    try support.expect_result(context, built4, 1, "", expected_diagnostics)
