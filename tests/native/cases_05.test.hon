comptime_calls_share_runtime_inference_loops_and_recursion test {
    context := try support.init("comptime_calls_share_runtime_inference_loops_and_recursion")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "comptime_calls_share_runtime_inference_loops_and_recursion",
        "length proc() usize {\n    result := 0\n    while (result < 2) result = result + 1\n    return result\n}\nfactorial proc(count usize) usize {\n    if (count == 0) return 1\n    return count * factorial(count - 1)\n}\nsum proc(count usize) usize {\n    result := 0\n    for (0..count) |index| {\n        if (index == 1) continue\n        if (index == 4) break\n        result = result + index\n    }\n    return result\n}\nidentity proc($T type, value T) T { return value }\nFixed proc($N usize) type { return struct { values [N]i16 } }\nevaluate proc() i16 {\n    first Fixed(identity(usize, length())) :: { values = [40, 2] }\n    same Fixed(factorial(3) - sum(6) + 1) :: first\n    return same.values[0] + same.values[1]\n}\n\nmain proc() i32 {\n    value :: evaluate()\n    if (value != 42) return 1\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = null },
    )
}

