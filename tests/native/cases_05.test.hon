type_execution_mutable_types_and_nested_producers test {
    context := try support.init("type_execution_mutable_types_and_nested_producers")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "type_execution_mutable_types_and_nested_producers",
        "Nest proc(T type, depth usize) type {\n    Result type := T\n    count usize := 0\n    while (count < depth) {\n        Result = [2]Result\n        count = count + 1\n    }\n    return Result\n}\nBox proc(T type) type { return struct { value T } }\nevaluate proc() i16 {\n    value Box(Nest(i16, 2)) :: { value = [[20, 20], [1, 1]] }\n    same Box(Nest(i16, 1 + 1)) :: value\n    return same.value[0][0] + same.value[0][1] + same.value[1][0] + same.value[1][1]\n}\n\nmain proc() i32 {\n    value :: evaluate()\n    if (value != 42) return 1\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = null },
    )
}

type_execution_range_captures_scope_and_transfers test {
    context := try support.init("type_execution_range_captures_scope_and_transfers")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "type_execution_range_captures_scope_and_transfers",
        "Storage proc() type {\n    Result := i8\n    size usize := 0\n    for (0..usize(5)) |index| {\n        if (index == 0) continue\n        if (index == 3) break\n        next :: [index]Result\n        Result = next\n        size = size + 1\n    }\n    while (size < 3) {\n        size = size + 1\n        if (size == 3) continue\n        Result = bool\n    }\n    return struct { values Result, bias i16 = i16(size) }\n}\nevaluate proc() i16 {\n    value Storage() :: { values = [[19], [20]] }\n    return i16(value.values[0][0]) + i16(value.values[1][0]) + value.bias\n}\n\nmain proc() i32 {\n    value :: evaluate()\n    if (value != 42) return 1\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = null },
    )
}

type_execution_early_return_and_recursive_calls test {
    context := try support.init("type_execution_early_return_and_recursive_calls")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "type_execution_early_return_and_recursive_calls",
        "Nest proc(T type, depth usize) type {\n    if (depth == 0) return T\n    return [2]Nest(T, depth - 1)\n}\nSelect proc(wide bool) type {\n    Result := i8\n    if (wide) {\n        Result = Nest(i16, 1)\n        return Result\n    } else { Result = [2]Result }\n    return Result\n}\nevaluate proc() i16 {\n    wide Select(true) :: [40, 2]\n    narrow Select(false) :: [1, 1]\n    return wide[0] + wide[1] + i16(narrow[0] - narrow[1])\n}\n\nmain proc() i32 {\n    value :: evaluate()\n    if (value != 42) return 1\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = null },
    )
}

