comptime_tagged_union_preserves_tags_and_nested_raw_payloads test {
    context := try support.init("comptime_tagged_union_preserves_tags_and_nested_raw_payloads")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "comptime_tagged_union_preserves_tags_and_nested_raw_payloads",
        "Tag :: enum(i16) { number = -7, empty = 12, zero = 41, payload = 90 }\nEmpty :: struct {}\nPayload :: struct { rows [2]struct { values [2]i16 }, text string }\nChoice :: union(Tag) { payload Payload, empty void, zero Empty, number i16 }\nmake proc() Choice {\n    return .payload { rows = [{ values = [10, 20] }, { values = [4, 6] }], text = \"ok\" }\n}\nnumeric proc() Choice { return .number{42} }\nempty proc() Choice { return .empty }\nzero proc() Choice { return .zero{} }\nscore proc(value Choice) i16 {\n    return match value {\n        .number |number|: number,\n        .payload |payload|: (\n            payload.rows[0].values[0] + payload.rows[0].values[1]\n            + payload.rows[1].values[0] + payload.rows[1].values[1] + i16(payload.text.len)\n        ),\n        .empty: 3,\n        .zero: 5,\n    }\n}\nevaluate proc() [5]i16 {\n    value :: $(make())\n    return [score(value), value.payload.rows[1].values[1], score($(numeric())),\n        score($(empty())), score($(zero()))]\n}\n\nmain proc() i32 {\n    value :: evaluate()\n    if (value.len != 5) return 1\n    if (value[0] != 42) return 1\n    if (value[1] != 6) return 1\n    if (value[2] != 42) return 1\n    if (value[3] != 3) return 1\n    if (value[4] != 5) return 1\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = null },
    )
}

comptime_tagged_union_value_parameters_and_cache_identity test {
    context := try support.init("comptime_tagged_union_value_parameters_and_cache_identity")
