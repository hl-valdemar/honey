comptime_byte_slices_preserve_nested_optional_tagged_and_fallible_channels test {
    context := try support.init("comptime_byte_slices_preserve_nested_optional_tagged_and_fallible_channels")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "comptime_byte_slices_preserve_nested_optional_tagged_and_fallible_channels",
        "Failure :: struct { text []u8 }\nChoice :: union(enum) { data struct { rows [2]?[]u8 }, empty void }\nPacket :: struct { choice ?Choice, result []u8 ! Failure }\nmake proc(fail bool) Packet {\n    values [2]mut u8 := [40, 2]\n    result []u8 ! Failure := values[..]\n    if (fail) result = Failure { text = values[1..] }\n    return {\n        choice = Choice { data = { rows = [values[..1], null] } },\n        result = result,\n    }\n}\nevaluate proc() [4]u8 {\n    good :: $(make(false))\n    bad :: $(make(true))\n    choice :: good.choice?\n    if (choice.data.rows[1] != null) return [0, 0, 0, 0]\n    success :: good.result catch \"\"\n    failure :: bad.result catch |err| err.text\n    return [choice.data.rows[0]?[0], success[0], success[1], failure[0]]\n}\n\nmain proc() i32 {\n    value :: evaluate()\n    if (value.len != 4) return 1\n    if (value[0] != 40) return 1\n    if (value[1] != 40) return 1\n    if (value[2] != 2) return 1\n    if (value[3] != 2) return 1\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = null },
    )
}

