import "@tests/support"

type_arrays_whole_assignment_requires_mutable_binding test {
    context := try support.init("type_arrays_whole_assignment_requires_mutable_binding")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "type_arrays_whole_assignment_requires_mutable_binding",
        "Bad proc() type {\n    types :: [i16]\n    types = [bool]\n    return types[0]\n}\nevaluate proc() Bad() { return 42 }\n\nmain proc() i32 {\n    _ = evaluate()\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = "assignment requires a mutable local binding" },
    )
}

