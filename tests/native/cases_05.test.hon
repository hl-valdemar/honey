        "Empty :: struct {}\nempty proc() []i16 {\n    values [0]i16 :: []\n    return values[..]\n}\ncells proc() []Empty {\n    values [3]Empty :: [{}, {}, {}]\n    return values[..]\n}\nrows proc() [][0]i16 {\n    values [2][0]i16 :: [[], []]\n    return values[..]\n}\nevaluate proc() [5]usize {\n    none :: $(empty())\n    items :: $(cells())\n    arrays :: $(rows())\n    _ Empty :: items[2]\n    return [none.len, items.len, arrays.len, arrays[0].len, arrays[1].len]\n}\n\nmain proc() i32 {\n    value :: evaluate()\n    if (value.len != 5) return 1\n    if (value[0] != 0) return 1\n    if (value[1] != 3) return 1\n    if (value[2] != 2) return 1\n    if (value[3] != 0) return 1\n    if (value[4] != 0) return 1\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = null },
    )
}

comptime_nonbyte_slices_cross_nested_optional_tagged_and_fallible_channels test {
