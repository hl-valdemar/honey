comptime_untagged_union_owns_padding_tail_bytes_and_copies test {
    context := try support.init("comptime_untagged_union_owns_padding_tail_bytes_and_copies")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "comptime_untagged_union_owns_padding_tail_bytes_and_copies",
        "Pair :: struct { small u8, large u64 }\nStorage :: union { small u8, rows [2]mut Pair, words [4]mut u64, bytes [32]u8 }\nmake proc(prefix u64) Storage {\n    value := Storage { words = [prefix, 40, maxval!(u64), 2] }\n    value.small = 9\n    return value\n}\nToken proc($value Storage) type {\n    _ = value\n return struct {} }\nevaluate proc() [8]u64 {\n    if (Token(make(maxval!(u64))) == Token(make(9))) return [0, 0, 0, 0, 0, 0, 0, 0]\n    value := $(make(maxval!(u64)))\n    saved :: value\n    value.small = 0\n    value.rows[0].large = 99\n    other :: $(make(maxval!(u64)))\n    return [u64(saved.small), u64(saved.bytes[1]), u64(saved.bytes[7]),\n        saved.rows[0].large, u64(saved.bytes[17]), u64(saved.bytes[23]),\n        other.rows[1].large, value.rows[0].large]\n}\n\nmain proc() i32 {\n    value :: evaluate()\n    if (value.len != 8) return 1\n    if (value[0] != 9) return 1\n    if (value[1] != 255) return 1\n    if (value[2] != 255) return 1\n    if (value[3] != 40) return 1\n    if (value[4] != 255) return 1\n    if (value[5] != 255) return 1\n    if (value[6] != 2) return 1\n    if (value[7] != 99) return 1\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = null },
    )
}

