type_arrays_preserve_anonymous_nominal_identity_across_reads_and_copies test {
    context := try support.init("type_arrays_preserve_anonymous_nominal_identity_across_reads_and_copies")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "type_arrays_preserve_anonymous_nominal_identity_across_reads_and_copies",
        "Selected proc() type {\n    types :: [struct { value i16 }, struct { value i16 }]\n    copied :: types\n    if (types[0] != copied[0] or types[0] == types[1]) return bool\n    return struct { first types[0], second copied[0] }\n}\nevaluate proc() i16 {\n    value Selected() :: { first = { value = 19 }, second = { value = 23 } }\n    copied := value.first\n    copied = value.second\n    return value.first.value + copied.value\n}\n\nmain proc() i32 {\n    value :: evaluate()\n    if (value != 42) return 1\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = null },
    )
}

