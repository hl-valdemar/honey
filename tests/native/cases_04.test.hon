collection_iteration_borrows_array_and_reads_each_element test {
    context := try support.init("collection_iteration_borrows_array_and_reads_each_element")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "collection_iteration_borrows_array_and_reads_each_element",
        "evaluate proc() [2]i16 {\n    values [3]mut i16 := [19, 1, 100]\n    total i16 := 0\n    for values |value, index| {\n        if (index == 0) values[1] = 22\n        if (index == 2) break\n        total = total + value + i16(index)\n        continue\n    }\n    return [total, values[1]]\n}\n\nmain proc() i32 {\n    value :: evaluate()\n    if (value.len != 2) return 1\n    if (value[0] != 42) return 1\n    if (value[1] != 22) return 1\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = null },
    )
}

collection_iteration_pointer_captures_slices_and_array_pointers test {
    context := try support.init("collection_iteration_pointer_captures_slices_and_array_pointers")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "collection_iteration_pointer_captures_slices_and_array_pointers",
        "evaluate proc() [3]i16 {\n    values [2]mut i16 := [19, 21]\n    for (&values) |@value, index| { value^ = value^ + i16(index) }\n    view []mut i16 :: values[..]\n    for view |@value| { value^ = value^ + 1 }\n    total i16 := 0\n    for view |value| { total = total + value }\n    return [total - 1, values[0], values[1]]\n}\n\nmain proc() i32 {\n    value :: evaluate()\n    if (value.len != 3) return 1\n    if (value[0] != 42) return 1\n    if (value[1] != 20) return 1\n    if (value[2] != 23) return 1\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = null },
    )
}

collection_iteration_evaluates_entry_once_and_retains_slice_bound test {
    context := try support.init("collection_iteration_evaluates_entry_once_and_retains_slice_bound")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "collection_iteration_evaluates_entry_once_and_retains_slice_bound",
        "data proc(calls @mut i16) [2]i16 {\n    calls^ = calls^ + 1\n    return [19, 22]\n}\nevaluate proc() [3]i16 {\n    calls i16 := 0\n    total i16 := 0\n    for data(&calls) |value, index| { total = total + value + i16(index) }\n    values [2]mut i16 := [20, 22]\n    view []mut i16 := values[..]\n    sum i16 := 0\n    for view |value| {\n        view = values[0..0]\n        sum = sum + value\n    }\n    return [total, calls, sum]\n}\n\nmain proc() i32 {\n    value :: evaluate()\n    if (value.len != 3) return 1\n    if (value[0] != 42) return 1\n    if (value[1] != 1) return 1\n    if (value[2] != 42) return 1\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = null },
    )
}

collection_iteration_aggregate_copies_nested_and_zero_cell_shapes test {
    context := try support.init("collection_iteration_aggregate_copies_nested_and_zero_cell_shapes")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "collection_iteration_aggregate_copies_nested_and_zero_cell_shapes",
        "Empty :: struct {}\nItem :: struct { values [2]mut i16 }\nevaluate proc() [3]i16 {\n    items [2]mut Item := [{ values = [19, 21] }, { values = [0, 0] }]\n    total i16 := 0\n    for items |item, index| {\n        copied := item\n        copied.values[0] = copied.values[0] + 1\n        for copied.values |value| { total = total + value }\n        if (index == 0) items[1].values[1] = 0\n    }\n    empty [0]i16 :: []\n    for empty |_| { return [-1, -1, -1] }\n    cells [2]Empty :: [{}, {}]\n    count i16 := 0\n    for cells |cell, index| {\n        _ Empty :: cell\n        count = count + i16(index) + 1\n    }\n    return [total, items[0].values[0], count]\n}\n\nmain proc() i32 {\n    value :: evaluate()\n    if (value.len != 3) return 1\n    if (value[0] != 42) return 1\n    if (value[1] != 19) return 1\n    if (value[2] != 3) return 1\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = null },
    )
}

collection_iteration_strings_and_cleanup_on_transfers test {
    context := try support.init("collection_iteration_strings_and_cleanup_on_transfers")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "collection_iteration_strings_and_cleanup_on_transfers",
        "evaluate proc() [2]i16 {\n    values [3]i16 :: [20, 22, 99]\n    total i16 := 0\n    cleanups i16 := 0\n    for values |value, index| {\n        defer cleanups = cleanups + 1\n        if (index == 2) break\n        total = total + value\n        continue\n    }\n    for \"a\\0b\" |byte, index| {\n        if (index == 1 and byte != 0) return [-1, -1]\n        if (index == 2 and byte != u8(98)) return [-2, -2]\n    }\n    return [total, cleanups]\n}\n\nmain proc() i32 {\n    value :: evaluate()\n    if (value.len != 2) return 1\n    if (value[0] != 42) return 1\n    if (value[1] != 3) return 1\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = null },
    )
}

