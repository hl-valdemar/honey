field_reflection_runtime_places_callbacks_and_single_evaluation test {
    context := try support.init("field_reflection_runtime_places_callbacks_and_single_evaluation")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "field_reflection_runtime_places_callbacks_and_single_evaluation",
        "Point :: struct { value i16, callback @proc(value i16) i16 }\nadd proc(value i16) i16 { return value + 2 }\nplace proc(point @mut Point, calls @mut i16) @mut Point {\n    calls^ = calls^ + 1\n    return point\n}\nname proc() string { return \"val\\x75e\" }\nevaluate proc() [3]i16 {\n    point Point := { value = 19, callback = add }\n    calls i16 := 0\n    field!(place(&point, &calls), name()) = 40\n    pointer @mut i16 :: &field!(point, \"value\")\n    pointer^ = pointer^ + 1\n    return [field!(point, \"callback\")(field!(point, \"value\")), calls, point.value]\n}\n\nmain proc() i32 {\n    value :: evaluate()\n    if (value.len != 3) return 1\n    if (value[0] != 43) return 1\n    if (value[1] != 1) return 1\n    if (value[2] != 41) return 1\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = null },
    )
}

field_reflection_tuple_enum_union_and_sequence_members test {
    context := try support.init("field_reflection_tuple_enum_union_and_sequence_members")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "field_reflection_tuple_enum_union_and_sequence_members",
        "A :: enum { first, second }\nB :: enum { third }\nE :: alias A | B\nChoice :: union(enum) { payload i16, empty void }\nread proc($name string, value struct { count i16 }) i16 {\n    return field!(value, name)\n}\nevaluate proc() [4]i16 {\n    tuple :: {i16(19), i16(21)}\n    choice Choice :: { payload = 2 }\n    values [2]i16 :: [19, 21]\n    member E :: field!(E, \"third\")\n    if (member != E.third) return [0, 0, 0, 0]\n    return [\n        field!(tuple, \"0\") + field!(tuple, \"1\") + field!(choice, \"payload\"),\n        i16(field!(values, \"len\")),\n        field!(&values, \"ptr\")[1],\n        read(\"count\", { count = 42 }),\n    ]\n}\n\nmain proc() i32 {\n    value :: evaluate()\n    if (value.len != 4) return 1\n    if (value[0] != 42) return 1\n    if (value[1] != 2) return 1\n    if (value[2] != 21) return 1\n    if (value[3] != 42) return 1\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = null },
    )
}

field_reflection_type_control_and_constant_materialization test {
    context := try support.init("field_reflection_type_control_and_constant_materialization")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "field_reflection_type_control_and_constant_materialization",
        "Config :: struct { count usize, value i16 }\nconfig proc() Config { return { count = 2, value = 21 } }\nStorage proc(name string) type {\n    settings :: config()\n    types :: [i16, bool]\n    return struct {\n        values [field!(settings, name)]types[0]\n        bias i16 = i16(field!(types, \"len\"))\n    }\n}\nevaluate proc() i16 {\n    value Storage(\"count\") :: { values = [19, 21] }\n    constant :: $(field!(config(), \"value\"))\n    return value.values[0] + constant + value.bias\n}\n\nmain proc() i32 {\n    value :: evaluate()\n    if (value != 42) return 1\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = null },
    )
}

