import "@tests/support"

type_record_procedure_rejects_runtime_dependency test {
    context := try support.init("type_record_procedure_rejects_runtime_dependency")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "type_record_procedure_rejects_runtime_dependency",
        "config proc(wide bool) struct { child type } {\n    if (wide) return { child = i16 }\n    return { child = i8 }\n}\nread proc(wide bool) i16 {\n    value config(wide).child :: 42\n    return i16(value)\n}\nevaluate proc() i16 { return read(true) }\n\nmain proc() i32 {\n    _ = evaluate()\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = "generic argument must be a compile-time value" },
    )
}

type_record_procedure_nested_execution_shares_step_limit test {
    context := try support.init("type_record_procedure_nested_execution_shares_step_limit")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "type_record_procedure_nested_execution_shares_step_limit",
        "config proc(count usize) struct { child type } {\n    for (0..count) |_| { }\n    return { child = i16 }\n}\nSelected proc() type {\n    for (0..maxval!(usize)) |index| { input :: config(index + 100) }\n    return i16\n}\nevaluate proc() Selected() { return 42 }\n\nmain proc() i32 {\n    _ = evaluate()\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = "compile-time execution exceeds its recursion or step limit" },
    )
}

