    try support.check_text(
        &context,
        "type_execution_collection_iteration_observes_updates_and_freezes_places",
        "Storage proc() type {\n    rows [2]mut [2]mut usize := [[1, 1], [9, 9]]\n    selected usize := 0\n    length usize := 0\n    for rows[selected] |value, index| {\n        selected = 1\n        (rows[0])[1] = 2\n        length = length + value\n        if (index == 0) continue\n        break\n    }\n    Result := i8\n    for \"a\\0b\" |byte, index| {\n        if (byte == 0 and index == 1) Result = i16\n    }\n    return struct { values [length]Result }\n}\nevaluate proc() i16 {\n    value Storage() :: { values = [19, 21, 2] }\n    same Storage() :: value\n    return same.values[0] + same.values[1] + same.values[2]\n}\n\nmain proc() i32 {\n    value :: evaluate()\n    if (value != 42) return 1\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = null },
    )
}

