import "@tests/support"
import "@std/mem"

check_typeinfo_packages proc(context @mut support.Context) void ! support.Error {
    try support.directory(context, try support.path(context, context.temporary, "typeinfo"))
    try support.write(context, try support.path(context, context.temporary, "typeinfo/build.hon"), "# project root\n")
    try support.directory(context, try support.path(context, context.temporary, "typeinfo/std"))
    try support.symlink(context, try support.path(context, context.root, "std/meta"), try support.path(context, context.temporary, "typeinfo/std/meta"))
    try support.symlink(context, try support.path(context, context.root, "std/enummap"), try support.path(context, context.temporary, "typeinfo/std/enummap"))
    try support.directory(context, try support.path(context, context.temporary, "typeinfo/captures"))
    try support.write(context, try support.path(context, context.temporary, "typeinfo/captures/main.hon"), "read proc($T type, value @T) T { return value^ }\nfailed proc($T type, value T) bool { return value == .failed }\n")
    try support.directory(context, try support.path(context, context.temporary, "typeinfo/composed_enum_maps_merge_compatible_shared_variant_names"))
    try support.write(context, try support.path(context, context.temporary, "typeinfo/composed_enum_maps_merge_compatible_shared_variant_names/main.hon"), "import \"@std/enummap\"\nA :: enum { shared, a }\nB :: enum { shared, b }\nKey :: alias (A | B)\nnames :: $enummap.init_default(Key, usize, usize(0), {shared = 42})\nevaluate proc() usize { return enummap.get(&names, .shared)? + names.present.len }\nmain proc() i32 { return if (evaluate() == 45) 0 else 1 }\n")
    try support.check(context, try support.path(context, context.temporary, "typeinfo/composed_enum_maps_merge_compatible_shared_variant_names"), {stdout = ""})
    try support.directory(context, try support.path(context, context.temporary, "typeinfo/composed_enum_map_construction_has_bounded_execution_budget"))
    try support.write(context, try support.path(context, context.temporary, "typeinfo/composed_enum_map_construction_has_bounded_execution_budget/main.hon"), "import \"@std/enummap\"\nA :: enum { a, b }\nB :: enum { c, d }\nC :: enum { e, f }\nD :: enum { g, h }\nE :: enum { i, j }\nF :: enum { k, l }\nKey :: alias (A | B | C | D | E | F)\nnames :: $enummap.init_default(Key, []u8, \"\", {a = \"one\"})\nevaluate proc() usize { return enummap.get(&names, .a)?.len }\nmain proc() i32 { return if (evaluate() == 3) 0 else 1 }\n")
    try support.check(context, try support.path(context, context.temporary, "typeinfo/composed_enum_map_construction_has_bounded_execution_budget"), {stdout = ""})
    try support.directory(context, try support.path(context, context.temporary, "typeinfo/transitive_metadata_and_pointer_capture_generic_context"))
    try support.write(context, try support.path(context, context.temporary, "typeinfo/transitive_metadata_and_pointer_capture_generic_context/main.hon"), "import \"@std/enummap\"\nimport \"../captures\"\nKey :: enum { first, second }\nError :: enum { failed }\nfail proc() i16 ! Error { return .failed }\ncount proc($T type) usize {\n    match typeinfo!(T) { .enum |info|: return info.fields.len, else: return 0 }\n}\nevaluate proc() i16 {\n    values [2]i16 :: [19, 23]\n    total i16 := 0\n    for values |@item| { total += captures.read(item) }\n    if (count(Key) != 2) return -1\n    fallback i16 :: fail() catch |error| if (captures.failed(error)) i16(42) else i16(-2)\n    if (fallback != total) return -2\n    map enummap.EnumMap(Key, i16) :: enummap.init({first = total})\n    return enummap.get(&map, .first)?\n}\nmain proc() i32 { return if (evaluate() == 42) 0 else 1 }\n")
    try support.check(context, try support.path(context, context.temporary, "typeinfo/transitive_metadata_and_pointer_capture_generic_context"), {stdout = ""})
    try support.directory(context, try support.path(context, context.temporary, "typeinfo/enum_field_struct_preserves_owned_and_address_backed_defaults"))
    try support.write(context, try support.path(context, context.temporary, "typeinfo/enum_field_struct_preserves_owned_and_address_backed_defaults/main.hon"), "import \"@std/meta\"\nKeys :: enum(i16) { last = -7, first = 3, middle = 90 }\nItem :: struct { values [2]mut i16 }\nCallback :: alias @proc(value i16) i16\nAddresses :: struct { pointer @mut i16, view []mut i16, values [2]mut i16 }\nincrement proc(value i16) i16 { return value + 1 }\naddress_default proc() Addresses {\n    backing [3]mut i16 := [9, 19, 23]\n    return { pointer = &backing[1], view = backing[1..], values = [19, 23] }\n}\npointer_default proc() @mut i16 {\n    value i16 := 19\n    return &value\n}\nslice_default proc() []mut i16 {\n    values [2]mut i16 := [19, 23]\n    return values[..]\n}\nevaluate proc() i16 {\n    Absent :: meta.EnumFieldStruct(Keys, ??i16, some!(null))\n    Null :: meta.EnumFieldStruct(Keys, ??i16, some!(some!(null)))\n    Present :: meta.EnumFieldStruct(Keys, ??i16, some!(some!(some!(i16(42)))))\n    absent Absent :: {}\n    nulls Null :: { first = null, middle = some!(some!(i16(19))) }\n    present Present :: {}\n    if (absent.last != null or nulls.last == null) return -1\n    if (nulls.last? != null or nulls.first != null or nulls.middle?? != 19) return -2\n    if (present.last?? != 42) return -3\n\n    Arrays :: meta.EnumFieldStruct(Keys, [2]mut i16, [19, 23])\n    Items :: meta.EnumFieldStruct(Keys, Item, Item { values = [19, 23] })\n    arrays Arrays := {}\n    array_copy := arrays\n    arrays.last[0] = 0\n    array_copy.first[1] = 0\n    if (array_copy.last[0] != 19 or arrays.first[1] != 23) return -4\n    if (arrays.middle[0] + arrays.middle[1] != 42) return -5\n    items Items := {}\n    item_copy := items\n    items.last.values[0] = 0\n    item_copy.first.values[1] = 0\n    if (item_copy.last.values[0] != 19 or items.first.values[1] != 23) return -6\n    if (typeinfo!(Arrays).record.fields[0].type != [2]mut i16) return -7\n    if (typeinfo!(Items).record.fields[2].type != Item) return -8\n\n    Callbacks :: meta.EnumFieldStruct(Keys, Callback, increment)\n    callbacks Callbacks :: {}\n    if (callbacks.last(41) != 42 or field!(callbacks, \"middle\")(41) != 42) return -9\n    Pointers :: meta.EnumFieldStruct(Keys, @mut i16, pointer_default())\n    pointers Pointers :: {}\n    pointers.last^ = 42\n    if (pointers.middle^ != 42 or pointers.first != pointers.last) return -10\n    Slices :: meta.EnumFieldStruct(Keys, []mut i16, slice_default())\n    slices Slices :: {}\n    slices.last[0] = 20\n    slices.first[1] = 22\n    if (slices.middle[0] + slices.middle[1] != 42) return -11\n\n    AddressValues :: meta.EnumFieldStruct(Keys, Addresses, address_default())\n    addresses AddressValues := {}\n    saved := addresses\n    addresses.last.pointer^ = 20\n    addresses.first.view[1] = 22\n    addresses.last.values[0] = 0\n    saved.first.values[1] = 0\n    if (saved.middle.pointer^ != 20) return -12\n    if (addresses.middle.view[0] + saved.last.view[1] != 42) return -13\n    if (saved.last.values[0] != 19 or addresses.first.values[1] != 23) return -14\n    first :: $(address_default())\n    second :: $(address_default())\n    first.pointer^ = 99\n    if (first.view[0] != 99 or second.view[0] != 19) return -15\n    return 42\n}\nmain proc() i32 { return if (evaluate() == 42) 0 else 1 }\n")
    try support.check(context, try support.path(context, context.temporary, "typeinfo/enum_field_struct_preserves_owned_and_address_backed_defaults"), {stdout = ""})
    try support.directory(context, try support.path(context, context.temporary, "typeinfo/ordinary_metadata_helpers_return_values_and_names"))
    try support.write(context, try support.path(context, context.temporary, "typeinfo/ordinary_metadata_helpers_return_values_and_names/main.hon"), "import \"@std/meta\"\nRecord :: struct { first i16, second bool }\nfield_name proc(info meta.TypeInfo, index usize) []u8 {\n    return match info {\n        .record |record|: record.fields[index].name,\n        else: compile_error!(\"expected record\"),\n    }\n}\ncount proc(fields []meta.FieldInfo) usize {\n    total usize := 0\n    for fields |field| {\n        if (field.type == i16) total += 19\n        else total += 23\n    }\n    return total\n}\nevaluate proc() usize {\n    name :: field_name(typeinfo!(Record), 1)\n    if (name.len != 6 or name[0] != 115) return 0\n    return count(typeinfo!(Record).record.fields)\n}\nmain proc() i32 { return if (evaluate() == 42) 0 else 1 }\n")
    try support.check(context, try support.path(context, context.temporary, "typeinfo/ordinary_metadata_helpers_return_values_and_names"), {stdout = ""})
    try support.directory(context, try support.path(context, context.temporary, "typeinfo/categories_specialize_generic_calls"))
    try support.write(context, try support.path(context, context.temporary, "typeinfo/categories_specialize_generic_calls/main.hon"), "reflection :: import \"@std/meta\"\nError :: enum { failed }\nChoice :: union(enum) { number i16, empty void }\nRaw :: union { number i16, flag bool }\ncategory proc($T type) i16 {\n    return match typeinfo!(T) {\n        .integer: 1,\n        .bool: 2,\n        .float: 3,\n        .void: 4,\n        .anyopaque: 5,\n        .pointer: 6,\n        .slice: 7,\n        .optional: 8,\n        .function: 9,\n        .union: 10,\n        .fallible: 11,\n        else: -1,\n    }\n}\nwiden proc($T type, value T) i16 {\n    return match typeinfo!(T) {\n        .integer: i16(value),\n        .bool: match value { true: 23, false: 0 },\n        else: value.missing,\n    }\n}\nevaluate proc() [14]i16 {\n    return [\n        category(i8), category(bool), category(f64), category(void),\n        category(anyopaque), category(@mut i16), category([]u8),\n        category(?i16), category(proc(value i16) i16),\n        category(Choice), category(i16 ! Error), category(Raw),\n        category(string), widen(i8(19)) + widen(true),\n    ]\n}\nmain proc() i32 {\n    result :: evaluate()\n    return if (result[0] == 1 and result[1] == 2 and result[2] == 3 and result[3] == 4 and result[4] == 5 and result[5] == 6 and result[6] == 7 and result[7] == 8 and result[8] == 9 and result[9] == 10 and result[10] == 11 and result[11] == 10 and result[12] == 6 and result[13] == 42) 0 else 1\n}\n")
    try support.check(context, try support.path(context, context.temporary, "typeinfo/categories_specialize_generic_calls"), {stdout = ""})
    try support.directory(context, try support.path(context, context.temporary, "typeinfo/arrays_and_immediate_distinct_backing"))
    try support.write(context, try support.path(context, context.temporary, "typeinfo/arrays_and_immediate_distinct_backing/main.hon"), "import \"@std/meta\"\nInner :: distinct u16\nOuter :: distinct Inner\nOther :: distinct u16\nOuterAlias :: alias Outer\nArrayAlias :: alias [3]Inner\narray_matches proc($T, $Child type, $length usize) bool {\n    return match typeinfo!(T) {\n        .array |info|: info.child == Child and info.len == length,\n        else: false,\n    }\n}\nbacking_matches proc($T, $Backing type) bool {\n    return match typeinfo!(T) {\n        .distinct |backing|: backing == Backing,\n        else: false,\n    }\n}\nevaluate proc() bool {\n    return $(\n        array_matches(ArrayAlias, Inner, 3)\n        and array_matches([0]bool, bool, 0)\n        and array_matches([2]mut i16, i16, 2)\n        and !array_matches(ArrayAlias, Other, 3)\n        and backing_matches(Inner, u16)\n        and backing_matches(OuterAlias, Inner)\n        and !backing_matches(Outer, u16)\n        and OuterAlias == Outer and Inner != Other\n    )\n}\nmain proc() i32 { return if (evaluate() == true) 0 else 1 }\n")
    try support.check(context, try support.path(context, context.temporary, "typeinfo/arrays_and_immediate_distinct_backing"), {stdout = ""})
    try support.directory(context, try support.path(context, context.temporary, "typeinfo/record_tuple_names_order_exact_types_and_layout"))
    try support.write(context, try support.path(context, context.temporary, "typeinfo/record_tuple_names_order_exact_types_and_layout/main.hon"), "import \"@std/meta\"\nChild :: struct { value i16 }\nOther :: struct { value i16 }\nRecord :: struct { child Child, maybe ?i8, pointer @u8 }\nRecordAlias :: alias Record\nTuple :: alias struct { i8, Child, bool }\nPacket :: struct_type!(.c, [\"value\"], [i16], [null])\nsame_name proc(left, right []u8) bool {\n    if (left.len != right.len) return false\n    for left |byte, index| {\n        if (byte != right[index]) return false\n    }\n    return true\n}\nvalid proc() bool {\n    match typeinfo!(RecordAlias) {\n        .record |info|: {\n            if (info.is_tuple or info.layout != .auto) return false\n            if (!same_name(info.name?, \"Record\") or info.fields.len != 3) return false\n            if (!same_name(info.fields[0].name, \"child\") or info.fields[0].index != 0) return false\n            if (!same_name(info.fields[1].name, \"maybe\") or info.fields[1].index != 1) return false\n            if (!same_name(info.fields[2].name, \"pointer\") or info.fields[2].index != 2) return false\n            if (info.fields[0].type != Child or info.fields[0].type == Other) return false\n            if (info.fields[1].type != ?i8 or info.fields[2].type != @u8) return false\n        }\n        else: return false,\n    }\n    match typeinfo!(Tuple) {\n        .record |info|: {\n            if (!info.is_tuple or info.name != null or info.layout != .auto) return false\n            if (info.fields.len != 3) return false\n            inline for info.fields |field, index| {\n                if (field.index != index or field.name.len != 1) return false\n                if (field.name[0] != u8(48 + index)) return false\n                if (index == 0 and field.type != i8) return false\n                if (index == 1 and field.type != Child) return false\n                if (index == 2 and field.type != bool) return false\n            }\n        }\n        else: return false,\n    }\n    match typeinfo!(struct { value i16 }) {\n        .record |info|: if (info.name != null or info.is_tuple) return false,\n        else: return false,\n    }\n    return match typeinfo!(Packet) {\n        .record |info|: info.layout == .c and !info.is_tuple,\n        else: false,\n    }\n}\nevaluate proc() bool { return $(valid()) }\nmain proc() i32 { return if (evaluate() == true) 0 else 1 }\n")
    try support.check(context, try support.path(context, context.temporary, "typeinfo/record_tuple_names_order_exact_types_and_layout"), {stdout = ""})
    try support.directory(context, try support.path(context, context.temporary, "typeinfo/enum_metadata_uses_declaration_order_not_discriminants"))
    try support.write(context, try support.path(context, context.temporary, "typeinfo/enum_metadata_uses_declaration_order_not_discriminants/main.hon"), "import \"@std/meta\"\nSparse :: enum(i16) { last = -7, first = 3, middle = 90 }\nSparseAlias :: alias Sparse\nOther :: enum(i16) { last = -7, first = 3, middle = 90 }\nvalid proc() bool {\n    return match typeinfo!(SparseAlias) {\n        .enum |info|: (\n            info.fields.len == 3\n            and info.fields[0].index == 0\n            and info.fields[1].index == 1\n            and info.fields[2].index == 2\n            and info.fields[0].name.len == 4 and info.fields[0].name[0] == 108\n            and info.fields[1].name.len == 5 and info.fields[1].name[0] == 102\n            and info.fields[2].name.len == 6 and info.fields[2].name[0] == 109\n            and info.fields[0].type == Sparse\n            and info.fields[1].type == SparseAlias\n            and info.fields[2].type != Other\n        ),\n        else: false,\n    }\n}\nevaluate proc() [3]mut i16 {\n    if (!$(valid())) return [0, 0, 0]\n    values [3]mut i16 := [0, 0, 0]\n    match typeinfo!(SparseAlias) {\n        .enum |info|: inline for info.fields |field, index| {\n            values[index] = i16(field!(SparseAlias, field.name))\n        }\n        else: compile_error!(\"expected enum\"),\n    }\n    return values\n}\nmain proc() i32 {\n    result :: evaluate()\n    return if (result[0] == -7 and result[1] == 3 and result[2] == 90) 0 else 1\n}\n")
    try support.check(context, try support.path(context, context.temporary, "typeinfo/enum_metadata_uses_declaration_order_not_discriminants"), {stdout = ""})
    try support.directory(context, try support.path(context, context.temporary, "typeinfo/record_fields_drive_field_access_and_generic_inference"))
    try support.write(context, try support.path(context, context.temporary, "typeinfo/record_fields_drive_field_access_and_generic_inference/main.hon"), "import \"@std/meta\"\nRecord :: struct { small i8, wide i16, enabled bool }\nconvert proc($T type, value T) i16 {\n    return match typeinfo!(T) {\n        .integer: i16(value),\n        .bool: match value { true: 2, false: 0 },\n        else: compile_error!(\"unsupported field\"),\n    }\n}\nsum proc($T type, value T) i16 {\n    total i16 := 0\n    match typeinfo!(T) {\n        .record |info|: inline for info.fields |field| {\n            total = total + convert(field!(value, field.name))\n        }\n        else: compile_error!(\"expected record\"),\n    }\n    return total\n}\nevaluate proc() i16 {\n    value Record :: { small = 19, wide = 21, enabled = true }\n    return sum(value)\n}\nmain proc() i32 { return if (evaluate() == 42) 0 else 1 }\n")
    try support.check(context, try support.path(context, context.temporary, "typeinfo/record_fields_drive_field_access_and_generic_inference"), {stdout = ""})
    try support.directory(context, try support.path(context, context.temporary, "typeinfo/reflected_fields_generate_owned_schema_and_defaults"))
    try support.write(context, try support.path(context, context.temporary, "typeinfo/reflected_fields_generate_owned_schema_and_defaults/main.hon"), "import \"@std/meta\"\nSource :: struct { left i16, right i16 }\nDefaults proc($T type, $default i16) type {\n    match typeinfo!(T) {\n        .record |info|: {\n            names [info.fields.len]mut []u8 := undefined\n            types [info.fields.len]mut type := undefined\n            defaults [info.fields.len]mut ?i16 := undefined\n            inline for info.fields |field, index| {\n                names[index] = field.name\n                types[index] = field.type\n                defaults[index] = default\n            }\n            return struct_type!(info.layout, names, types, defaults)\n        }\n        else: compile_error!(\"expected record\"),\n    }\n}\nevaluate proc() i16 {\n    first Defaults(Source, 21) := {}\n    saved :: first\n    field!(first, \"left\") = 0\n    same Defaults(Source, 21) :: saved\n    return same.left + same.right\n}\nmain proc() i32 { return if (evaluate() == 42) 0 else 1 }\n")
    try support.check(context, try support.path(context, context.temporary, "typeinfo/reflected_fields_generate_owned_schema_and_defaults"), {stdout = ""})
    try support.directory(context, try support.path(context, context.temporary, "typeinfo/real_meta_enum_field_struct_defaults"))
    try support.write(context, try support.path(context, context.temporary, "typeinfo/real_meta_enum_field_struct_defaults/main.hon"), "import \"@std/meta\"\nKey :: enum(i16) { last = -7, first = 3, middle = 90 }\nValues :: alias meta.EnumFieldStruct(Key, i16, 21)\nevaluate proc() i16 {\n    values Values :: { last = 19, first = 23 }\n    empty Values :: {}\n    if (values.middle != 21 or empty.last != 21 or empty.first != 21) return -1\n    return values.last + field!(values, \"first\")\n}\nmain proc() i32 { return if (evaluate() == 42) 0 else 1 }\n")
    try support.check(context, try support.path(context, context.temporary, "typeinfo/real_meta_enum_field_struct_defaults"), {stdout = ""})
    try support.directory(context, try support.path(context, context.temporary, "typeinfo/real_enummap_generates_ordinal_storage"))
    try support.write(context, try support.path(context, context.temporary, "typeinfo/real_enummap_generates_ordinal_storage/main.hon"), "import \"@std/meta\"\nimport \"@std/enummap\"\nKey :: enum(i16) { last = -7, first = 3, missing = 90 }\nKeyAlias :: alias Key\nevaluate proc() i16 {\n    values enummap.EnumMap(KeyAlias, i16) :: {\n        present = [true, true, false], values = [19, 23, 0],\n    }\n    if (values.present[2]) return -1\n    return values.values[0] + values.values[1]\n}\nmain proc() i32 { return if (evaluate() == 42) 0 else 1 }\n")
    try support.check(context, try support.path(context, context.temporary, "typeinfo/real_enummap_generates_ordinal_storage"), {stdout = ""})
    try support.directory(context, try support.path(context, context.temporary, "typeinfo/real_enummap_init_get_sparse_alias_and_absence"))
    try support.write(context, try support.path(context, context.temporary, "typeinfo/real_enummap_init_get_sparse_alias_and_absence/main.hon"), "import \"@std/meta\"\nimport \"@std/enummap\"\nKey :: enum(i16) { last = -7, first = 3, missing = 90 }\nKeyAlias :: alias Key\nevaluate proc() i16 {\n    values :: enummap.init(KeyAlias, i16, { last = 19, first = 23 })\n    empty :: enummap.init(Key, i16, {})\n    if (enummap.get(&values, .missing) != null) return -1\n    if (enummap.get(&empty, .first) != null) return -2\n    return enummap.get(&values, .last)? + enummap.get(Key, i16, &values, .first)?\n}\nmain proc() i32 { return if (evaluate() == 42) 0 else 1 }\n")
    try support.check(context, try support.path(context, context.temporary, "typeinfo/real_enummap_init_get_sparse_alias_and_absence"), {stdout = ""})
    try support.directory(context, try support.path(context, context.temporary, "typeinfo/real_enummap_composed_keys_and_owned_aggregate_values"))
    try support.write(context, try support.path(context, context.temporary, "typeinfo/real_enummap_composed_keys_and_owned_aggregate_values/main.hon"), "import \"@std/meta\"\nimport \"@std/enummap\"\nFirst :: enum { first, absent }\nSecond :: enum { last }\nKeys :: alias (First | (Second | First))\nItem :: struct { values [2]mut i16 }\nevaluate proc() i16 {\n    source Item := { values = [19, 23] }\n    values :: enummap.init(Keys, Item, { first = source })\n    source.values[0] = 0\n    copy := enummap.get(&values, .first)?\n    copy.values[1] = 0\n    retained :: enummap.get(&values, .first)?\n    if (enummap.get(&values, .last) != null or enummap.get(&values, .absent) != null) return -1\n    return retained.values[0] + retained.values[1]\n}\nmain proc() i32 { return if (evaluate() == 42) 0 else 1 }\n")
    try support.check(context, try support.path(context, context.temporary, "typeinfo/real_enummap_composed_keys_and_owned_aggregate_values"), {stdout = ""})
    try support.directory(context, try support.path(context, context.temporary, "typeinfo/real_enummap_all_entries_materialize_at_compile_time"))
    try support.write(context, try support.path(context, context.temporary, "typeinfo/real_enummap_all_entries_materialize_at_compile_time/main.hon"), "import \"@std/meta\"\nimport \"@std/enummap\"\nKey :: enum { first, last }\nknown proc() enummap.EnumMap(Key, i16) {\n    return enummap.init(Key, i16, { first = 19, last = 23 })\n}\nevaluate proc() i16 {\n    values :: $(known())\n    return enummap.get(&values, .first)? + enummap.get(&values, .last)?\n}\nmain proc() i32 { return if (evaluate() == 42) 0 else 1 }\n")
    try support.check(context, try support.path(context, context.temporary, "typeinfo/real_enummap_all_entries_materialize_at_compile_time"), {stdout = ""})
    try support.directory(context, try support.path(context, context.temporary, "typeinfo/real_enummap_filled_sparse_constants_preserve_optional_presence"))
    try support.write(context, try support.path(context, context.temporary, "typeinfo/real_enummap_filled_sparse_constants_preserve_optional_presence/main.hon"), "import \"@std/meta\"\nimport \"@std/enummap\"\nKey :: enum(i16) { absent = -3, present_null = 8, present_value = 21 }\nevaluate proc() i16 {\n    values :: $(enummap.init_default(Key, ?i16, null, {\n        present_null = some!(null),\n        present_value = some!(some!(i16(42))),\n    }))\n    empty :: $(enummap.init_default(Key, i16, i16(99), {}))\n    if (enummap.get(&values, .absent) != null or enummap.get(&empty, .absent) != null) return -1\n    payload :: enummap.get(&values, .present_null)\n    if (payload == null or payload? != null) return -2\n    return enummap.get(&values, .present_value)??\n}\nmain proc() i32 { return if (evaluate() == 42) 0 else 1 }\n")
    try support.check(context, try support.path(context, context.temporary, "typeinfo/real_enummap_filled_sparse_constants_preserve_optional_presence"), {stdout = ""})
    try support.directory(context, try support.path(context, context.temporary, "typeinfo/metadata_slices_cross_producers_without_losing_type_identity"))
