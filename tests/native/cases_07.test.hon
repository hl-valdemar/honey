        "compile_error_rejects_runtime_messages",
        "fail proc(message string) void { compile_error!(message) }\n        evaluate proc() i16 { fail(\"not constant\")\nreturn 42 }\n\nmain proc() i32 {\n    _ = evaluate()\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = "compile_error! requires one compile-time string argument" },
    )
}

