import "@tests/support"

pointer_aggregate_copy_keeps_alias test {
    context := try support.init("pointer_aggregate_copy_keeps_alias")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "pointer_aggregate_copy_keeps_alias",
        "Holder :: struct { pointer @mut i16 }\nidentity proc(h Holder) Holder { return h }\nevaluate proc() i16 {\n    value i16 := 40\n    first :: Holder { pointer = &value }\n    second :: identity(first)\n    pointers [2]@mut i16 :: [first.pointer, second.pointer]\n    pointers[1]^ = pointers[0]^ + 2\n    return value\n}\n\nmain proc() i32 {\n    value :: evaluate()\n    if (value != 42) return 1\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = null },
    )
}

