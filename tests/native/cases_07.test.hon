pointer_readonly_not_mutable_argument test {
    context := try support.init("pointer_readonly_not_mutable_argument")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "pointer_readonly_not_mutable_argument",
        "set proc(p @mut i16) void { p^ = 42 }\nevaluate proc() i16 { value i16 :: 0\nset(&value)\nreturn value }\n\nmain proc() i32 {\n    _ = evaluate()\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = "requires writable storage but receives read-only storage" },
    )
    source :: try support.put(&context, context.temporary, "readonly-slot.hon",
        "Handle :: opaque\nResult :: struct { handle ?*mut Handle }\ndestroy c_func(slot ?*mut ?*mut Handle) void\nmain proc() void {\n    init_res Result :: { handle = null }\n    destroy(&init_res.handle)\n}\n")
    result :: try support.run(&context, &[context.compiler, "emit-llvm", source], support.RunOptions{})
    try support.expect(&context, result.status == 1, "read-only foreign argument is rejected")
    try support.expect(&context, support.contains(result.stderr,
        ":6:13: error: requires writable storage but receives read-only storage"), "argument storage diagnostic")
    try support.expect(&context, support.contains(result.stderr,
        ":5:5: note: value was declared immutable here"), "immutable declaration location")
    try support.expect(&context, support.contains(result.stderr,
        "help: use `:=` instead of `::` if this value should be mutable"), "conditional mutability help")
    try support.check_text(&context, "mutable-slot",
        "Handle :: opaque\nResult :: struct { handle ?*mut Handle }\ndestroy proc(slot ?*mut ?*mut Handle) void { _ = slot }\nmain proc() void { init_res Result := { handle = null }\ndestroy(&init_res.handle) }\n",
        support.Expected{ stdout = "", diagnostic = null })
}

