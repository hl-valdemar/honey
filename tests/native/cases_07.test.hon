        support.Expected{ stdout = "", diagnostic = null },
    )
}

pointer_location_identity test {
    context := try support.init("pointer_location_identity")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "pointer_location_identity",
        "Point :: struct { x i16, y i16 }\nidentity proc(p @mut i16) @mut i16 { return p }\nevaluate proc() bool {\n    point Point := { x = 40, y = 2 }\n    values [2]mut i16 := [40, 2]\n    first :: &point\n    second :: &point\n    return (\n        first == second\n        and identity(&point.x) == &point.x\n        and &point.x != &point.y\n        and (&values).ptr == (&values).ptr\n    )\n}\n\nmain proc() i32 {\n    value :: evaluate()\n    if (value != true) return 1\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = null },
    )
}

