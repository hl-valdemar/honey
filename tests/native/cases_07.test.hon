    context := try support.init("pointer_addition_aggregate_stride_and_identity")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "pointer_addition_aggregate_stride_and_identity",
        "Point :: struct { x i16, y i64 }\nevaluate proc() bool {\n    values [3]mut Point := [\n        Point { x = 1, y = 2 }, Point { x = 3, y = 4 }, Point { x = 5, y = 6 },\n    ]\n    pointer :: (&values).ptr\n    next :: pointer + (1 + 1)\n    next.y = 42\n    last *mut Point :: &values[2]\n    return (next == last and values[2].y == 42\n        and pointer + 3 == next + 1)\n}\n\nmain proc() i32 {\n    value :: evaluate()\n    if (value != true) return 1\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = null },
    )
}

pointer_addition_evaluates_operands_once_in_order test {
    context := try support.init("pointer_addition_evaluates_operands_once_in_order")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "pointer_addition_evaluates_operands_once_in_order",
        "first proc(count @mut usize, values *mut i16) *mut i16 {\n    count^ = count^ + 1\n    return values\n}\nsecond proc(count @mut usize) usize {\n    previous :: count^\n    count^ = count^ + 1\n    return previous\n}\nevaluate proc() [2]i16 {\n    count usize := 0\n    values [2]mut i16 := [1, 42]\n    pointer :: first(&count, (&values).ptr) + second(&count)\n    return [pointer^, i16(count)]\n}\n\nmain proc() i32 {\n    value :: evaluate()\n    if (value.len != 2) return 1\n    if (value[0] != 42) return 1\n    if (value[1] != 2) return 1\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = null },
    )
}

