rigid_slice_inference_preserves_borrowing_and_string_context test {
    context := try support.init("rigid_slice_inference_preserves_borrowing_and_string_context")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "rigid_slice_inference_preserves_borrowing_and_string_context",
        "Box proc($T type) type { return struct { value T } }\nlength proc($T type, box @Box(T), value T) usize { return box.value.len + value.len }\nevaluate proc() [3]usize {\n    box Box([]u8) :: { value = \"ab\" }\n    bytes [3]mut u8 := [1, 2, 3]\n    return [length(&box, bytes[..]), length(&box, \"abc\"), length(&box, bytes)]\n}\n\nmain proc() i32 {\n    value :: evaluate()\n    if (value.len != 3) return 1\n    if (value[0] != 5) return 1\n    if (value[1] != 5) return 1\n    if (value[2] != 5) return 1\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = null },
    )
}

