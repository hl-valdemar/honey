pointer_addition_preserves_alias_and_mutability test {
    context := try support.init("pointer_addition_preserves_alias_and_mutability")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "pointer_addition_preserves_alias_and_mutability",
        "advance proc(p *mut i16, count usize) *mut i16 { return p + count }\nevaluate proc() [3]i16 {\n    values [3]mut i16 := [1, 2, 3]\n    pointer :: advance((&values).ptr, 1)\n    pointer^ = 40\n    (pointer + 1)^ = pointer^ + 2\n    return [values[0], values[1], values[2]]\n}\n\nmain proc() i32 {\n    value :: evaluate()\n    if (value.len != 3) return 1\n    if (value[0] != 1) return 1\n    if (value[1] != 40) return 1\n    if (value[2] != 42) return 1\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = null },
    )
}

