}

metadata_slices_optional_fallible_parameters_results_and_captures test {
    context := try support.init("metadata_slices_optional_fallible_parameters_results_and_captures")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "metadata_slices_optional_fallible_parameters_results_and_captures",
        "Failure :: struct { types []type }\nInfo :: struct { child type, count usize }\nchoose proc(present bool, failed bool) ?[]Info ! Failure {\n    if (failed) return Failure { types = [i16] }\n    if (present) return some!([{ child = i16, count = 2 }])\n    return null\n}\npass proc(value ?[]Info ! Failure) ?[]Info ! Failure { return value }\nToken proc($value ?[]Info ! Failure) type { return struct {} }\nStorage proc() type {\n    original :: pass(choose(true, false))\n    if (Token(original) != Token(choose(true, false))) return bool\n    if (Token(original) == Token(choose(false, false))) return bool\n    if (Token(original) == Token(choose(false, true))) return bool\n    missing :: pass(choose(false, false)) catch null\n    if (missing != null) return bool\n    pass(choose(false, true)) catch |err| {\n        if (err.types[0] != i16) return bool\n        yield null\n    }\n    selected :: original catch null\n    if selected |fields| {\n        return [fields[0].count]fields[0].child\n    }\n    return bool\n}\nmain proc() Storage() { return [40, 2] }\n",
        support.Expected{ stdout = "[40, 2]\n", diagnostic = null },
    )
}

metadata_pointers_scalar_aliases_helpers_and_uncached_effects test {
    context := try support.init("metadata_pointers_scalar_aliases_helpers_and_uncached_effects")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "metadata_pointers_scalar_aliases_helpers_and_uncached_effects",
        "replace proc(value @mut type) void { value^ = i16 }\nread proc(value @type) bool { return value^ == i16 }\nInfo :: struct { child type, count usize }\nupdate proc(left, right @mut Info) void {\n    left.child = i16\n    left.count += 1\n    right.count += 1\n}\nStorage proc() type {\n    T type := bool\n    pointer :: &T\n    replace(pointer)\n    if (!read(pointer)) return bool\n    info Info := { child = bool, count = 0 }\n    saved :: info\n    reference :: &info\n    update(reference, reference)\n    if (info.child != i16 or info.count != 2) return bool\n    info = saved\n    update(reference, reference)\n    update(reference, reference)\n    if (info.count != 4 or saved.child != bool or saved.count != 0) return bool\n    return pointer^\n}\nmain proc() Storage() { return 42 }\n",
        support.Expected{ stdout = "42\n", diagnostic = null },
    )
}

metadata_pointers_sequences_arithmetic_slices_and_identity test {
    context := try support.init("metadata_pointers_sequences_arithmetic_slices_and_identity")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "metadata_pointers_sequences_arithmetic_slices_and_identity",
        "fill proc(pointer *mut type) void { pointer[0] = i16\npointer[1] = i16 }\nStorage proc() type {\n    values [3]mut type := [bool, i8, u8]\n    pointer :: values.ptr + usize(1)\n    fill(pointer)\n    if (values[1] != i16 or values[2] != i16) return bool\n    if (pointer != &values[1] or pointer == &values[0]) return bool\n    tail :: pointer[0..2]\n    tail[1] = bool\n    if (values[2] != bool) return bool\n    saved :: tail.ptr\n    values = [u8, i16, i8]\n    if (saved[1] != i8) return bool\n    end :: values.ptr + values.len\n    if (end != values[3..3].ptr or end[0..0].len != 0) return bool\n    return pointer[0]\n}\nmain proc() Storage() { return 42 }\n",
        support.Expected{ stdout = "42\n", diagnostic = null },
    )
}

