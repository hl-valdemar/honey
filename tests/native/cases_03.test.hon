import "@tests/support"

struct_type_empty_auto_and_nested_c_layout test {
    context := try support.init("struct_type_empty_auto_and_nested_c_layout")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "struct_type_empty_auto_and_nested_c_layout",
        "Layout :: enum { auto, c }\nTag :: enum(u8) { ready = 7 }\nEmpty :: struct_type!(.auto, [], [], [])\nInner :: struct_type!(.c, [\"value\"], [i16], [null])\nPacket :: struct_type!(\n    Layout.c,\n    {\"tag\", \"items\", \"pointer\", \"maybe\"},\n    {Tag, [2]Inner, @i16, ?@i16},\n    {.ready, null, null, null},\n)\nidentity proc(value Empty) Empty { return value }\nmain proc() i16 {\n    empty Empty :: identity({})\n    if (sizeof!(Packet) != 24 or alignof!(Packet) != 8) return -3\n    extra i16 :: 2\n    packet Packet :: {\n        items = [{ value = 19 }, { value = 21 }],\n        pointer = &extra,\n        maybe = null,\n    }\n    if (packet.tag != .ready) return -1\n    if packet.maybe |_| return -2\n    return packet.items[0].value + packet.items[1].value + packet.pointer^\n}\n",
        support.Expected{ stdout = "42\n", diagnostic = null },
    )
}

struct_type_required_optional_is_not_a_null_default test {
    context := try support.init("struct_type_required_optional_is_not_a_null_default")
