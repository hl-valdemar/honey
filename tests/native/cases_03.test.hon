        "Record :: struct_type!(.auto, [\"required\"], [?i16], [null])\nmain proc() i16 {\n    value Record :: {}\n    return 42\n}\n",
        support.Expected{ stdout = "", diagnostic = "missing a required field" },
    )
}

struct_type_default_preserves_narrow_field_arithmetic test {
    context := try support.init("struct_type_default_preserves_narrow_field_arithmetic")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "struct_type_default_preserves_narrow_field_arithmetic",
        "Record :: struct_type!(.auto, [\"value\"], [i8], [127])\nmain proc() i16 {\n    value Record := {}\n    value.value = value.value + 1\n    return i16(value.value)\n}\n",
        support.Expected{ stdout = "", diagnostic = "integer arithmetic overflow" },
    )
}

