type_record_procedure_argument_rejects_missing_field test {
    context := try support.init("type_record_procedure_argument_rejects_missing_field")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "type_record_procedure_argument_rejects_missing_field",
        "Selected proc(input struct { child type, count usize }) type { return input.child }\nmain proc() Selected({ child = i16 }) { return 42 }\n",
        support.Expected{ stdout = "", diagnostic = "missing a required field" },
    )
}

