c_layout_records_and_nominal_opaque_pointers test {
    context := try support.init("c_layout_records_and_nominal_opaque_pointers")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "c_layout_records_and_nominal_opaque_pointers",
        "Handle :: opaque\nOther :: opaque\nHeader :: c_struct { tag c_uchar, value c_ulong }\nmain proc() c_ulong {\n    header Header := { tag = 2, value = 40 }\n    if (sizeof!(Header) != 16 or alignof!(Header) != 8) return 0\n    pointer ?*mut Handle :: ptrcast!(&header)\n    restored *mut Header :: ptrcast!(pointer?)\n    return restored.value + c_ulong(restored.tag)\n}\n",
        support.Expected{ stdout = "42\n", diagnostic = null },
    )
}

