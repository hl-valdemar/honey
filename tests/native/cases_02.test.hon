        support.Expected{ stdout = "[42, 42, 7]\n", diagnostic = null },
    )
}

optional_conditional_expressions_materialize_compile_time_scalars test {
    context := try support.init("optional_conditional_expressions_materialize_compile_time_scalars")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "optional_conditional_expressions_materialize_compile_time_scalars",
        "choose proc(value ?i8) i16 { return if value |payload| i16(payload) + 2 else 7 }\nnested proc(value ??i16) i16 {\n    return if value |inner| if inner |payload| payload else 11 else 13\n}\nmain proc() [4]i16 {\n    return [$(choose(40)), $(choose(null)), $(nested(some!(null))), $(nested(null))]\n}\n",
        support.Expected{ stdout = "[42, 7, 11, 13]\n", diagnostic = null },
