optional_conditional_expressions_evaluate_once_and_keep_branches_lazy test {
    context := try support.init("optional_conditional_expressions_evaluate_once_and_keep_branches_lazy")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "optional_conditional_expressions_evaluate_once_and_keep_branches_lazy",
        "next proc(calls @mut i16, value ?i16) ?i16 {\n    calls^ = calls^ + 1\n    return value\n}\nmain proc() [3]i16 {\n    calls i16 := 0\n    first i16 :: if next(&calls, 42) |payload| payload else divtrunc!(1, 0)\n    second i16 :: if next(&calls, null) |payload| divtrunc!(payload, 0) else 7\n    return [first, second, calls]\n}\n",
        support.Expected{ stdout = "[42, 7, 2]\n", diagnostic = null },
    )
}

optional_conditional_expressions_keep_nested_presence_and_else_binding test {
    context := try support.init("optional_conditional_expressions_keep_nested_presence_and_else_binding")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "optional_conditional_expressions_keep_nested_presence_and_else_binding",
        "identity proc($T type, value T) T { return value }\nchoose proc(value ??i16) i16 {\n    return if value |inner| if identity(inner) |payload| payload else 7 else 3\n}\nmain proc() [3]i16 {\n    return [choose(some!(null)), choose(null), choose(some!(some!(42)))]\n}\n",
        support.Expected{ stdout = "[7, 3, 42]\n", diagnostic = null },
    )
}

optional_conditional_expressions_snapshot_aggregate_payloads test {
    context := try support.init("optional_conditional_expressions_snapshot_aggregate_payloads")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "optional_conditional_expressions_snapshot_aggregate_payloads",
        "Item :: struct { values [1]mut i16 }\nreplace proc(value @mut ?Item) i16 {\n    value^ = Item { values = [0] }\n    return 0\n}\nmain proc() [2]i16 {\n    original ?Item := Item { values = [42] }\n    saved i16 :: if original |payload| replace(&original) + payload.values[0] else -1\n    return [saved, (original?).values[0]]\n}\n",
        support.Expected{ stdout = "[42, 0]\n", diagnostic = null },
    )
}

optional_conditional_expressions_preserve_narrow_payload_types test {
    context := try support.init("optional_conditional_expressions_preserve_narrow_payload_types")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "optional_conditional_expressions_preserve_narrow_payload_types",
        "identity proc($T type, value T) T { return value }\nexact proc(value i8) i16 { return i16(value) }\nchoose proc(value ?i8) i16 { return if value |payload| exact(identity(payload)) else 7 }\nmain proc() [2]i16 { return [choose(42), choose(null)] }\n",
        support.Expected{ stdout = "[42, 7]\n", diagnostic = null },
    )
}

optional_conditional_expressions_capture_pointer_callback_slice_and_zero_size test {
    context := try support.init("optional_conditional_expressions_capture_pointer_callback_slice_and_zero_size")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "optional_conditional_expressions_capture_pointer_callback_slice_and_zero_size",
        "increment proc(value i16) i16 { return value + 2 }\nread_pointer proc(value ?@i16) i16 { return if value |pointer| pointer^ else 7 }\ninvoke proc(value ?@proc(value i16) i16) i16 {\n    return if value |callback| callback(40) else 8\n}\nsum proc(value ?[]i16) i16 {\n    return if value |items| items[0] + items[1] else 9\n}\nempty proc(value ?[0]i16) i16 { return if value |items| i16(items.len) else 10 }\nmain proc() [8]i16 {\n    value i16 :: 42\n    items [2]i16 :: [19, 23]\n    return [read_pointer(&value), read_pointer(null), invoke(increment), invoke(null),\n        sum(items[..]), sum(null), empty([]), empty(null)]\n}\n",
        support.Expected{ stdout = "[42, 7, 42, 8, 42, 9, 0, 10]\n", diagnostic = null },
    )
}

