        support.Expected{ stdout = "", diagnostic = "incompatible value type" },
    )
}

runtime_undefined_nested_storage_and_copy_isolation test {
    context := try support.init("runtime_undefined_nested_storage_and_copy_isolation")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "runtime_undefined_nested_storage_and_copy_isolation",
        "Item :: struct { values [2]mut i16, label string }\nfill proc() Item {\n    item Item := undefined\n    for (usize(0)..item.values.len) |i| { item.values[i] = i16(i) + 19 }\n    item.label = \"yes\"\n    return item\n}\nmain proc() i16 {\n    item := fill()\n    saved :: item\n    pointer :: &item\n    pointer.values[0] = 0\n    return saved.values[0] + saved.values[1] + i16(saved.label.len)\n}\n",
        support.Expected{ stdout = "42\n", diagnostic = null },
    )
}

ordinary_constant_procedures_fill_undefined_arrays test {
    context := try support.init("ordinary_constant_procedures_fill_undefined_arrays")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "ordinary_constant_procedures_fill_undefined_arrays",
        "values proc() [2]mut i16 {\n    result [2]mut i16 := undefined\n    for (usize(0)..result.len) |i| { result[i] = i16(i) + 20 }\n    return result\n}\nmain proc() i16 { result :: $(values())\n    return result[0] + result[1] + 1 }\n",
        support.Expected{ stdout = "42\n", diagnostic = null },
