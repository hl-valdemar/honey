integer_divtrunc_preserves_sign_and_single_evaluation test {
    context := try support.init("integer_divtrunc_preserves_sign_and_single_evaluation")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "integer_divtrunc_preserves_sign_and_single_evaluation",
        "next proc(calls @mut i16) i16 { calls^ = calls^ + 1\n    return calls^ + 5 }\nquotient proc(value i16) i16 { return divtrunc!(value, 3) }\nmain proc() [6]i16 {\n    calls i16 := 0\n    result :: divtrunc!(next(&calls), next(&calls))\n    return [result, calls, quotient(-7), quotient(7),\n        $(quotient(-7)), divtrunc!(-7, i16(-3))]\n}\n",
        support.Expected{ stdout = "[0, 2, -2, 2, -2, 2]\n", diagnostic = null },
    )
}

