import "@tests/support"

yielding_blocks_check_skipped_compile_time_guard_result_types test {
    context := try support.init("yielding_blocks_check_skipped_compile_time_guard_result_types")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "yielding_blocks_check_skipped_compile_time_guard_result_types",
        "Bad proc() type {\n    if (false and { yield 1 }) return bool\n    return i16\n}\nmain proc() Bad() { return 42 }\n",
        support.Expected{ stdout = "", diagnostic = "operator requires compatible operand types" },
    )
}

conditional_expressions_evaluate_guard_once_and_only_selected_arm test {
    context := try support.init("conditional_expressions_evaluate_guard_once_and_only_selected_arm")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "conditional_expressions_evaluate_guard_once_and_only_selected_arm",
        "next proc(calls @mut i16, value bool) bool { calls^ = calls^ + 1\n    return value }\nmain proc() [3]i16 {\n    calls i16 := 0\n    first i16 :: if next(&calls, true) 42 else divtrunc!(1, 0)\n    second i16 :: if next(&calls, false) divtrunc!(1, 0) else 7\n    return [first, second, calls]\n}\n",
        support.Expected{ stdout = "[42, 7, 2]\n", diagnostic = null },
    )
}

conditional_expressions_nest_bind_else_and_preserve_precedence test {
    context := try support.init("conditional_expressions_nest_bind_else_and_preserve_precedence")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "conditional_expressions_nest_bind_else_and_preserve_precedence",
        "choose proc(a, b bool) i16 { return if (a) if (b) 1 else 40 else 3 + 4 }\nmain proc() [3]i16 {\n    return [choose(true, false) + 2, choose(false, true),\n        2 * (if (false) 10 else 21)]\n}\n",
        support.Expected{ stdout = "[42, 7, 42]\n", diagnostic = null },
    )
}

conditional_expressions_preserve_aggregate_copy_isolation test {
    context := try support.init("conditional_expressions_preserve_aggregate_copy_isolation")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "conditional_expressions_preserve_aggregate_copy_isolation",
        "Item :: struct { values [1]mut i16 }\nchoose proc(flag bool, left, right Item) Item { return if (flag) left else right }\nmain proc() i16 {\n    left Item := { values = [42] }\n    right Item :: { values = [7] }\n    saved :: choose(true, left, right)\n    left.values[0] = 0\n    return saved.values[0]\n}\n",
        support.Expected{ stdout = "42\n", diagnostic = null },
    )
}

conditional_expressions_select_generated_types_and_specialized_bodies test {
    context := try support.init("conditional_expressions_select_generated_types_and_specialized_bodies")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "conditional_expressions_select_generated_types_and_specialized_bodies",
        "Choose proc(wide bool) type { return if (wide) i16 else i8 }\nlength proc(flag bool) usize { return if (flag) 2 else 1 }\nBox proc($wide bool) type {\n    return struct {\n        value Choose(wide)\n        items [length(wide)]i16\n        other (if (wide) i16 else i8)\n    }\n}\nselect proc($flag bool, value i16) i16 {\n    return if $(flag) value else compile_error!(\"unselected\")\n}\nmain proc() [3]i16 {\n    value Box(true) :: { value = 40, items = [1, 2], other = 42 }\n    return [value.value, i16(value.items.len), select(true, value.other)]\n}\n",
        support.Expected{ stdout = "[40, 2, 42]\n", diagnostic = null },
    )
}

conditional_expressions_keep_outer_match_default test {
    context := try support.init("conditional_expressions_keep_outer_match_default")
