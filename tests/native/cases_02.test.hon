conditional_expressions_preserve_optional_and_fallible_result_context test {
    context := try support.init("conditional_expressions_preserve_optional_and_fallible_result_context")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "conditional_expressions_preserve_optional_and_fallible_result_context",
        "Error :: enum { failed }\noptional proc(flag bool) ?i16 { return if (flag) 42 else null }\nfallible proc(flag bool) i16 ! Error { return if (flag) 42 else .failed }\nmain proc() [3]i16 {\n    if (optional(false) != null) return [0, 0, 0]\n    return [optional(true)?, fallible(true) catch 0, fallible(false) catch 7]\n}\n",
        support.Expected{ stdout = "[42, 42, 7]\n", diagnostic = null },
    )
}

