cast_trap_float_high test {
    context := try support.init("cast_trap_float_high")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "cast_trap_float_high",
        "evaluate proc() i64 { return i64(u8(256.0)) }\n\nmain proc() i32 {\n    _ = evaluate()\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = "integer arithmetic overflow" },
    )
}

