u64_bitwise_boundaries test {
    context := try support.init("u64_bitwise_boundaries")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "u64_bitwise_boundaries",
        "shift proc(value u64, count u64) [4]u64 {\n    return [value << count, value >> count, value <<| count, ~value]\n}\nevaluate proc() [8]u64 {\n    high :: shift(maxval!(u64), 63)\n    huge :: shift_zero(u64(0), maxval!(u64))\n    return [high[0], high[1], high[2], high[3],\n        u64(1) <<| maxval!(u64), huge,\n        minval!(u64) <<| maxval!(u64),\n        minval!(u64) >> u8(63)]\n}\nshift_zero proc(value u64, count u64) u64 { return value <<| count }\n\nmain proc() i32 {\n    value :: evaluate()\n    if (value.len != 8) return 1\n    if (value[0] != 9223372036854775808) return 1\n    if (value[1] != 1) return 1\n    if (value[2] != 18446744073709551615) return 1\n    if (value[3] != 0) return 1\n    if (value[4] != 18446744073709551615) return 1\n    if (value[5] != 0) return 1\n    if (value[6] != 0) return 1\n    if (value[7] != 0) return 1\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = null },
    )
}

