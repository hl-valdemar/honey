i8_bitwise_boundaries test {
    context := try support.init("i8_bitwise_boundaries")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "i8_bitwise_boundaries",
        "shift proc(value i8, count u64) [4]i8 {\n    return [value << count, value >> count, value <<| count, ~value]\n}\nevaluate proc() [8]i8 {\n    high :: shift(maxval!(i8), 7)\n    huge :: shift_zero(i8(0), maxval!(u64))\n    return [high[0], high[1], high[2], high[3],\n        i8(1) <<| maxval!(u64), huge,\n        minval!(i8) <<| maxval!(u64),\n        minval!(i8) >> u8(7)]\n}\nshift_zero proc(value i8, count u64) i8 { return value <<| count }\n\nmain proc() i32 {\n    value :: evaluate()\n    if (value.len != 8) return 1\n    if (value[0] != -128) return 1\n    if (value[1] != 0) return 1\n    if (value[2] != 127) return 1\n    if (value[3] != -128) return 1\n    if (value[4] != 127) return 1\n    if (value[5] != 0) return 1\n    if (value[6] != -128) return 1\n    if (value[7] != -1) return 1\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = null },
    )
}

i8_limits_and_truncating_division test {
    context := try support.init("i8_limits_and_truncating_division")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "i8_limits_and_truncating_division",
        "identity proc(value i8) i8 { return value }\nevaluate proc() [4]i8 {\n    return [identity(minval!(i8)), identity(maxval!(i8)),\n        divtrunc!(maxval!(i8), 2), divtrunc!(minval!(i8), 2)]\n}\n\nmain proc() i32 {\n    value :: evaluate()\n    if (value.len != 4) return 1\n    if (value[0] != -128) return 1\n    if (value[1] != 127) return 1\n    if (value[2] != 63) return 1\n    if (value[3] != -64) return 1\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = null },
    )
}

i8_storage test {
    context := try support.init("i8_storage")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "i8_storage",
        "seed [2]mut i8 :: [-128, 127]\nidentity proc(a [2]mut i8) [2]mut i8 { return a }\nevaluate proc() [2]mut i8 {\n    a := identity(seed)\n    b := a\n    a[0] = 1\n    return b\n}\n\nmain proc() i32 {\n    value :: evaluate()\n    if (value.len != 2) return 1\n    if (value[0] != -128) return 1\n    if (value[1] != 127) return 1\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = null },
    )
}

i8_inclusive_max test {
    context := try support.init("i8_inclusive_max")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "i8_inclusive_max",
        "evaluate proc() int {\n    start i8 :: 126\n    end i8 :: 127\n    count := 0\n    for start..=end |i| {\n        if (i < start) return -1\n        count = count + 1\n        continue\n    }\n    return count\n}\n\nmain proc() i32 {\n    value :: evaluate()\n    if (value != 2) return 1\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = null },
    )
}

i8_overflow_add test {
    context := try support.init("i8_overflow_+")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "i8_overflow_+",
        "evaluate proc() i8 { a i8 :: 127\nreturn a + 1 }\n\nmain proc() i32 {\n    _ = evaluate()\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = "integer arithmetic overflow" },
    )
}

