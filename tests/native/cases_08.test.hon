import "@tests/support"

struct_type_rejects_argument_count test {
    context := try support.init("struct_type_rejects_argument_count")
    defer support.deinit(&context)
    try support.check_text(
        &context,
        "struct_type_rejects_argument_count",
        "Generated proc() type { return struct_type!(.auto, [\"value\"], [i16]) }\nevaluate proc() i16 {\n    value Generated() :: {}\n    return 42\n}\n\nmain proc() i32 {\n    _ = evaluate()\n    return 0\n}\n",
        support.Expected{ stdout = "", diagnostic = "argument count" },
    )
}

