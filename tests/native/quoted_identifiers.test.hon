import "@tests/support"

quoted_names_preserve_declarations_members_and_builtin_overrides test {
    context := try support.init("quoted identifiers")
    defer support.deinit(&context)
    try support.check_text(&context, "quoted_identifiers",
        `@"i32" :: alias c_int
        `@"type" :: c_struct { @"proc" @"i32" }
        `@"test" proc(value @"type") @"i32" { return value.@"proc" }
        `main proc() i32 {
        `    value @"type" :: { @"proc" = 42 }
        `    return if (@"test"(value) == 42) 0 else 1
        `}
        `
        , support.Expected{ stdout = "" })
}
