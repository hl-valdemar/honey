import "@tests/support"

native_driver_files_process_arguments_and_statuses test {
    context := try support.init("honey driver ' ; $")
    defer support.deinit(&context)
    try check_native_driver(&context)
}

variadic_libc_promotions test {
    context := try support.init("honey variadic ' ; $")
    defer support.deinit(&context)
    try check_variadic_libc(&context)
}
