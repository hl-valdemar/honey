import "@tests/support"
import "@std/mem"

unused_locals_report_root_and_dependency_locations_without_suppressing_execution test {
    context := try support.init("unused locals")
    defer support.deinit(&context)
    library :: try support.put(&context, context.temporary, "library/library.hon",
        `unused proc(parameter i16) void {
        `    hidden :: 1
        `}
    )
    source :: try support.put(&context, context.temporary, "main.hon",
        `import "./library"
        `main proc() i32 {
        `    leftover :: 1
        `    return 42
        `}
    )
    interpreted :: try support.run(&context, &[context.compiler, "run", source], support.RunOptions{})
    message :: ": error: unused local declaration; use '_' or explicitly discard the value\n"
    for ([
        try support.concat(&context, &[source, ":3:5", message]),
        try support.concat(&context, &[library, ":1:13", message]),
        try support.concat(&context, &[library, ":2:5", message]),
    ]) |diagnostic| {
        try support.expect(&context, support.contains(interpreted.stderr, diagnostic), "unused declaration name location")
    }
    try support.expect(&context, support.line_count(interpreted.stderr) == 3, "one diagnostic per unused declaration")
    try support.check(&context, source, support.Expected{ stdout = "", status = 42, diagnostic = "unused local declaration" })
    emitted :: try support.run(&context, &[context.compiler, "emit-llvm", source], support.RunOptions{})
    try support.expect(&context, emitted.status == 1 and support.contains(emitted.stdout, "define"), "LLVM emission retains source error status")
    try support.expect(&context, mem.eql(emitted.stderr, interpreted.stderr), "emission preserves unused diagnostics")
}

explicit_discards_keep_effects_and_signature_only_names_are_exempt test {
    context := try support.init("explicit discards")
    defer support.deinit(&context)
    try support.check_text(&context, "discards",
        `Callback :: alias @proc(named i16) i16
        `external c_func(named c_int) c_int
        `touch proc(pointer @mut i16) i16 {
        `    pointer^ += 1
        `    return pointer^
        `}
        `ignored proc(_ i16) void {}
        `main proc() i32 {
        `    count i16 := 40
        `    _ = touch(&count)
        `    _ :: touch(&count)
        `    ignored(count)
        `    for [1] |_, _| {}
        `    return if (count == 42) 0 else 1
        `}
        , support.Expected{ stdout = "" })
}
