import "@tests/support"
import "@std/mem"

check_arraylist_packages proc(context @mut support.Context) void ! support.Error {
    try support.directory(context, try support.path(context, context.temporary, "arraylist"))
    try support.write(context, try support.path(context, context.temporary, "arraylist/build.hon"), "# project root\n")
    try support.symlink(context, try support.path(context, context.root, "std"), try support.path(context, context.temporary, "arraylist/std"))
    try support.symlink(context, try support.path(context, context.root, "ffi"), try support.path(context, context.temporary, "arraylist/ffi"))
    try support.write(context, try support.path(context, context.temporary, "arraylist/main.hon"), "import \"@std/arraylist\"\nimport \"@std/mem\"\nState :: struct { storage *mut i16, fail bool = false, allocations usize = 0, releases usize = 0 }\nallocate proc(context ?@mut anyopaque, size usize, alignment usize) ?*mut u8 {\n    state @mut State :: ptrcast!(context?)\n    state.allocations = state.allocations + 1\n    if (state.fail or size > sizeof!([64]i16) or alignment > alignof!(i16)) return null\n    return ptrcast!(state.storage)\n}\nresize proc(\n    context ?@mut anyopaque, _ ?*mut u8, _ usize, size usize, alignment usize,\n) ?*mut u8 { return allocate(context, size, alignment) }\nrelease proc(context ?@mut anyopaque, _ ?*mut u8, _ usize, _ usize) void {\n    state @mut State :: ptrcast!(context?)\n    state.releases = state.releases + 1\n}\ntable mem.AllocatorVTable :: { alloc = allocate, realloc = resize, free = release }\nfail proc(allocator mem.Allocator) void ! mem.AllocError {\n    list := arraylist.init(i16, allocator)\n    defer arraylist.deinit(&list)\n    try arraylist.append(&list, 42)\n    return .out_of_memory\n}\nmain proc() i16 ! mem.AllocError {\n    storage [64]mut i16 := undefined\n    state State := { storage = (&storage).ptr }\n    allocator mem.Allocator :: { context = &state, vtable = &table }\n    list := arraylist.init(i16, allocator)\n    if (list.items.len != 0 or list.capacity != 0 or state.allocations != 0) return -1\n    if (arraylist.pop(&list) != null) return -2\n    for (i16(0)..20) |value| { try arraylist.append(&list, value) }\n    if (list.items.len != 20 or list.capacity < 20) return -3\n    for list.items |value, index| { if (value != i16(index)) return -4 }\n    previous_capacity :: list.capacity\n    previous_calls :: state.allocations\n    try arraylist.reserve(&list, previous_capacity)\n    if (state.allocations != previous_calls) return -5\n    state.fail = true\n    arraylist.reserve(&list, previous_capacity + 1) catch |err| {\n        if (err != .out_of_memory) return -6\n    }\n    if (list.capacity != previous_capacity or list.items.len != 20 or list.items[19] != 19) return -7\n    if (state.allocations != previous_calls + 1) return -8\n    if (arraylist.pop(&list)? != 19 or list.items.len != 19) return -9\n    arraylist.clear(&list)\n    if (list.items.len != 0 or list.capacity != previous_capacity) return -10\n    state.fail = false\n    try arraylist.append(&list, 42)\n    if (list.items[0] != 42 or state.allocations != previous_calls + 1) return -11\n    arraylist.deinit(&list)\n    if (list.items.len != 0 or list.capacity != 0 or state.releases != 1) return -12\n    arraylist.deinit(&list)\n    if (state.releases != 1) return -13\n    fail(allocator) catch {}\n    if (state.releases != 2) return -14\n    state.fail = true\n    arraylist.append(&list, 1) catch {}\n    if (list.items.len != 0 or list.capacity != 0) return -15\n    return 42\n}\n")
    try support.check(context, try support.path(context, context.temporary, "arraylist/main.hon"), {stdout = "42\n"})
    try support.write(context, try support.path(context, context.temporary, "arraylist/main.hon"), "import \"@std/arraylist\"\nimport \"@std/mem\"\nEmpty :: struct {}\nmain proc() i16 ! mem.AllocError {\n    list := arraylist.init(Empty, mem.c_allocator)\n    defer arraylist.deinit(&list)\n    try arraylist.reserve(&list, 20)\n    for (0..21) |_| { try arraylist.append(&list, Empty{}) }\n    if (list.items.len != 21 or list.capacity < 21) return -1\n    if (arraylist.pop(&list) == null or list.items.len != 20) return -2\n    arraylist.clear(&list)\n    if (list.items.len != 0 or arraylist.pop(&list) != null) return -3\n    return 42\n}\n")
    try support.check(context, try support.path(context, context.temporary, "arraylist/main.hon"), {stdout = "42\n"})
    try support.write(context, try support.path(context, context.temporary, "arraylist/main.hon"), "import \"@std/arraylist\"\nimport \"@std/mem\"\nItem :: struct { number i16, values [2]mut i16 }\nmain proc() i16 ! mem.AllocError {\n    list := arraylist.init(Item, mem.c_allocator)\n    defer arraylist.deinit(&list)\n    for (i16(0)..32) |value| {\n        try arraylist.append(&list, Item{ number = value, values = [value, 2] })\n    }\n    if (list.items.len != 32 or list.capacity < 32) return -1\n    saved :: list.items[20]\n    list.items[20].values[0] = 0\n    if (saved.values[0] != 20) return -2\n    for list.items |item, index| { if (item.number != i16(index)) return -3 }\n    if (arraylist.pop(&list)?.number != 31) return -4\n    arraylist.clear(&list)\n    try arraylist.append(&list, saved)\n    return list.items[0].number + list.items[0].values[0] + list.items[0].values[1]\n}\n")
    result_1 :: try support.run(context, &[context.compiler, "run", try support.path(context, context.temporary, "arraylist/main.hon")], {})
    try support.expect(context, ((result_1.status == 1) and mem.eql(u8, result_1.stdout, "")), "interpreted.returncode == 1 and interpreted.stdout == b''")
    try support.expect(context, support.contains(result_1.stderr, "foreign function calls are unsupported by the interpreter"), "b'foreign function calls are unsupported by the interpreter' in interpreted.stderr")
    try support.expect(context, (support.line_count(result_1.stderr) == 1), "len(interpreted.stderr.splitlines()) == 1")
    result_2 :: try support.run(context, &[context.compiler, "build", try support.path(context, context.temporary, "arraylist/main.hon"), "-o", context.executable, "--debug"], {})
    try support.expect_result(context, result_2, 0, "", "")
    result_3 :: try support.run(context, &[context.executable], {})
    try support.expect_result(context, result_3, 0, "42\n", "")
    try support.remove(context, context.executable)
    result_4 :: try support.run(context, &[context.compiler, "build", try support.path(context, context.temporary, "arraylist/main.hon"), "-o", context.executable, "--release"], {})
    try support.expect_result(context, result_4, 0, "", "")
    result_5 :: try support.run(context, &[context.executable], {})
    try support.expect_result(context, result_5, 0, "42\n", "")
    try support.remove(context, context.executable)
    try support.write(context, try support.path(context, context.temporary, "arraylist/main.hon"), "import \"@std/mem\"\nmain proc() i16 {\n    allocator :: mem.c_allocator\n    if (mem.raw_alloc(allocator, 16, 3) != null) return -1\n    initial :: mem.raw_alloc(allocator, 16, 64)\n    if initial |bytes| {\n        values *mut i16 :: ptrcast!(bytes)\n        values[0] = 40\n        values[1] = 2\n        resized :: mem.raw_realloc(allocator, bytes, 16, 128, 64)\n        if resized |grown| {\n            defer mem.raw_free(allocator, grown, 128, 64)\n            result *i16 :: ptrcast!(grown)\n            return result[0] + result[1]\n        }\n        mem.raw_free(allocator, bytes, 16, 64)\n    }\n    return -2\n}\n")
    result_6 :: try support.run(context, &[context.compiler, "run", try support.path(context, context.temporary, "arraylist/main.hon")], {})
    try support.expect(context, ((result_6.status == 1) and mem.eql(u8, result_6.stdout, "")), "interpreted.returncode == 1 and interpreted.stdout == b''")
    try support.expect(context, support.contains(result_6.stderr, "foreign function calls are unsupported by the interpreter"), "b'foreign function calls are unsupported by the interpreter' in interpreted.stderr")
    try support.expect(context, (support.line_count(result_6.stderr) == 1), "len(interpreted.stderr.splitlines()) == 1")
    result_7 :: try support.run(context, &[context.compiler, "build", try support.path(context, context.temporary, "arraylist/main.hon"), "-o", context.executable, "--debug"], {})
    try support.expect_result(context, result_7, 0, "", "")
    result_8 :: try support.run(context, &[context.executable], {})
    try support.expect_result(context, result_8, 0, "42\n", "")
    try support.remove(context, context.executable)
    result_9 :: try support.run(context, &[context.compiler, "build", try support.path(context, context.temporary, "arraylist/main.hon"), "-o", context.executable, "--release"], {})
    try support.expect_result(context, result_9, 0, "", "")
    result_10 :: try support.run(context, &[context.executable], {})
    try support.expect_result(context, result_10, 0, "42\n", "")
    try support.remove(context, context.executable)
}

check_allocator_libc proc(context @mut support.Context) void ! support.Error {
    try support.write(context, try support.path(context, context.temporary, "allocator_libc.hon"), "malloc c_func(size c_ulong) ?*mut anyopaque\nrealloc c_func(memory ?*mut anyopaque, size c_ulong) ?*mut anyopaque\nfree c_func(memory ?*mut anyopaque) void\nposix_memalign c_func(output *mut ?*mut anyopaque, alignment c_ulong, size c_ulong) c_int\nVTable :: struct {\n    alloc @proc(context ?@mut anyopaque, size usize, alignment usize) ?*mut u8\n    release @proc(context ?@mut anyopaque, memory ?*mut u8) void\n}\nAllocator :: struct { context ?@mut anyopaque, vtable @VTable }\nallocate proc(_ ?@mut anyopaque, size usize, alignment usize) ?*mut u8 {\n    if (alignment <= 16) return ptrcast!(malloc(c_ulong(size)))\n    output [1]mut ?*mut anyopaque := [null]\n    status :: posix_memalign((&output).ptr, c_ulong(alignment), c_ulong(size))\n    if (status != 0) return null\n    return ptrcast!(output[0])\n}\nrelease proc(_ ?@mut anyopaque, memory ?*mut u8) void { free(memory) }\ntable VTable :: { alloc = allocate, release = release }\nmain proc() i16 {\n    allocator Allocator :: { context = null, vtable = &table }\n    memory :: allocator.vtable.alloc(allocator.context, 4, 8)\n    if memory |bytes| {\n        values *mut i16 :: ptrcast!(bytes)\n        values[0] = 40\n        values[1] = 2\n        resized ?*mut i16 :: ptrcast!(realloc(bytes, 8))\n        if resized |items| {\n            aligned :: allocator.vtable.alloc(null, 8, 64)\n            if aligned |other| {\n                target *mut i16 :: ptrcast!(other)\n                memcopy!(target[..2], items[..2])\n                answer :: target[0] + target[1]\n                allocator.vtable.release(null, other)\n                free(items)\n                return answer\n            }\n            free(items)\n            return -1\n        }\n        free(bytes)\n        return -2\n    }\n    return -3\n}\n")
    result_1 :: try support.run(context, &[context.compiler, "run", try support.path(context, context.temporary, "allocator_libc.hon")], {})
    try support.expect(context, ((result_1.status == 1) and mem.eql(u8, result_1.stdout, "")), "interpreted.returncode == 1 and interpreted.stdout == b''")
    try support.expect(context, support.contains(result_1.stderr, "foreign function calls are unsupported by the interpreter"), "b'foreign function calls are unsupported by the interpreter' in interpreted.stderr")
    try support.expect(context, (support.line_count(result_1.stderr) == 1), "len(interpreted.stderr.splitlines()) == 1")
    result_2 :: try support.run(context, &[context.compiler, "build", try support.path(context, context.temporary, "allocator_libc.hon"), "-o", context.executable, "--debug"], {})
    try support.expect_result(context, result_2, 0, "", "")
    result_3 :: try support.run(context, &[context.executable], {})
    try support.expect_result(context, result_3, 0, "42\n", "")
    try support.remove(context, context.executable)
    result_4 :: try support.run(context, &[context.compiler, "build", try support.path(context, context.temporary, "allocator_libc.hon"), "-o", context.executable, "--release"], {})
    try support.expect_result(context, result_4, 0, "", "")
    result_5 :: try support.run(context, &[context.executable], {})
    try support.expect_result(context, result_5, 0, "42\n", "")
    try support.remove(context, context.executable)
}

