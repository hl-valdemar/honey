    try support.write(context, try support.path(context, context.temporary, "fallible_packages/app/main.hon"), "library :: import \"../library\"\nLocalError :: enum { local }\nread proc() i16 ! (LocalError | library.Error) {\n    return try library.read()\n}\nmain proc() i16 {\n    return read() catch |err| match err {\n        .local: 0,\n        .unavailable: 42,\n    }\n}\n")
