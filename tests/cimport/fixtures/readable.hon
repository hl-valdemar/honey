a :: import "@ffi/paint"
b :: import "@ffi/colors"

convert_color proc(color a.Color) b.Color { return color }
convert_rectangle proc(rectangle a.Rectangle) b.Rectangle { return rectangle }

main proc() i32 {
    color a.Color :: { red = 11, green = 19 }
    input a.Rectangle :: {
        position = { x = 2, y = 3 },
        payload = { integer = 7 },
        color = { red = 0, green = 0 },
    }
    result :: a.paint_rectangle(input, convert_color(color))
    actual :: b.rectangle_color(convert_rectangle(result))
    if (actual.red != color.red or actual.green != color.green) return -1
    return result.position.x + result.position.y + result.payload.integer
}
