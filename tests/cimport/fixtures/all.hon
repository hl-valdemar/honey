binding :: import "@ffi/everything"

main proc() i32 {
    input binding.AllDependency :: { tag = 3, value = 1.25, count = 8 }
    result :: binding.all_transform(input)
    if (result.tag != 4 or result.value != 1.75 or result.count != 10) return -1
    count binding.AllCount :: binding.all_unused_function()
    if (count != binding.ALL_NUMBER + binding.ALL_MODE_NEXT) return -2
    mode binding.AllMode :: binding.AllMode(binding.ALL_MODE_NEXT)
    if (binding.ALL_MODE_FIRST != 6 or mode != 7) return -3
    if (binding.c_types != 1) return -4
    return 42
}
