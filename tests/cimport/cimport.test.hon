import "@std/mem"
import "@std/arraylist"
import "@tests/support"

@hide:file
translate proc(context @mut support.Context, project [;0]u8, package [;0]u8, header [;0]u8, selections [][;0]u8) support.Result ! support.Error {
    arguments := arraylist.init([;0]u8, context.allocator)
    defer arraylist.deinit(&arguments)
    initial [9][;0]u8 :: [context.compiler, "translate-c", package, "--project", project, "--target", "arm64-apple-macos11", "--header", header]
    for (initial) |argument| try arraylist.append(&arguments, argument)
    for (selections) |selection| {
        try arraylist.append(&arguments, "--symbol")
        try arraylist.append(&arguments, selection)
    }
    return try support.run(context, arguments.items, support.RunOptions{})
}

selected_declarations_shared_identity_and_regeneration test {
    context := try support.init("cimport_selected")
    defer support.deinit(&context)
    project :: try support.path(&context, context.temporary, "project")
    try support.directory(&context, try support.path(&context, project, "source"))
    _ = try support.put(&context, project, "build.hon", "# project-root marker\n")
    header :: try support.path(&context, context.root, "tests/cimport/fixtures/bindings.h")
    first :: try translate(&context, project, "first", header, &["move_point", "set_callback", "open_handle", "Value", "Mode", "ANSWER", "RATIO", "LABEL"])
    try support.expect_result(&context, first, 0, "", "")
    bindings_path :: try support.path(&context, project, "ffi/first/bindings.hon")
    common_path :: try support.path(&context, project, "ffi/__c_types/bindings.hon")
    manifest_path :: try support.path(&context, project, "ffi/first/.honey-cimport")
    original :: try support.read(&context, bindings_path)
    original_common :: try support.read(&context, common_path)
    original_manifest :: try support.read(&context, manifest_path)
    try support.expect(&context, support.contains(original, "move_point c_func("), "external function spelling was changed")
    try support.expect(&context, support.contains(original, "c_float"), "C float was not preserved")
    try support.expect(&context, support.contains(original, "Callback :: alias ?*c_func("), "callback typedef was omitted")
    try support.expect(&context, support.contains(original, "MODE_DONE c_int :: 8"), "implicit enumerator was not evaluated")
    try support.expect(&context, support.contains(original, "ANSWER c_int :: 42"), "Clang constant evaluation was not used")
    try support.expect(&context, support.contains(original, "LABEL :: \"honey\""), "string macro was not emitted")
    try support.expect(&context, !support.contains(original, "global_value") and !support.contains(original, "inline_only"), "unselected unsupported declarations leaked into bindings")
    handwritten :: try support.put(&context, project, "ffi/first/helpers.hon", "helper :: 42\n")
    again :: try translate(&context, project, "first", header, &["move_point", "set_callback", "open_handle", "Value", "Mode", "ANSWER", "RATIO", "LABEL"])
    try support.expect_result(&context, again, 0, "", "")
    try support.expect(&context, mem.eql(original, try support.read(&context, bindings_path)), "regeneration is not deterministic")
    try support.expect(&context, mem.eql(original_common, try support.read(&context, common_path)), "shared declarations are not deterministic")
    try support.expect(&context, mem.eql(original_manifest, try support.read(&context, manifest_path)), "recipe/provenance is not deterministic")
    try support.expect(&context, mem.eql("helper :: 42\n", try support.read(&context, handwritten)), "handwritten file was modified")
    second :: try translate(&context, project, "second", header, &["move_point"])
    try support.expect_result(&context, second, 0, "", "")
    shared :: try support.read(&context, common_path)
    try support.expect(&context, support.count(shared, "c_struct {") == 1, "shared C record was duplicated nominally")
    source :: try support.put(&context, project, "source/main.hon", "a :: import \"@ffi/first\"\nb :: import \"@ffi/second\"\nconvert proc(point a.Point) b.Point { return point }\nmain proc() i32 { return 0 }\n")
    checked :: try support.run(&context, &[context.compiler, "emit-llvm", source], support.RunOptions{})
    try support.expect(&context, checked.status == 0, checked.stderr)
    trimmed :: try translate(&context, project, "first", header, &["open_handle"])
    try support.expect_result(&context, trimmed, 0, "", "")
    try support.expect(&context, !support.contains(try support.read(&context, bindings_path), "move_point"), "obsolete generated declarations survived regeneration")
    try support.write(&context, bindings_path, "handwritten :: 123\n")
    refused :: try translate(&context, project, "first", header, &["move_point"])
    try support.expect(&context, refused.status == 1 and support.contains(refused.stderr, "refusing to overwrite"), "edited generated output was overwritten")
    try support.expect(&context, mem.eql("handwritten :: 123\n", try support.read(&context, bindings_path)), "edited output was destroyed")
}

unsupported_requests_are_explicit_and_non_destructive test {
    context := try support.init("cimport_unsupported")
    defer support.deinit(&context)
    project :: try support.path(&context, context.temporary, "project")
    try support.directory(&context, try support.path(&context, project, "source"))
    _ = try support.put(&context, project, "build.hon", "# project-root marker\n")
    header :: try support.path(&context, context.root, "tests/cimport/fixtures/bindings.h")
    unsupported [4][;0]u8 :: ["global_value", "inline_only", "APPLY", "not_declared"]
    for (unsupported) |selection| {
        result :: try translate(&context, project, "rejected", header, &[selection])
        try support.expect(&context, result.status == 1 and support.contains(result.stderr, selection), "unsupported requested declaration was silently omitted")
        try support.expect(&context, !try support.exists(&context, try support.path(&context, project, "ffi/rejected/bindings.hon")), "failed translation wrote partial bindings")
    }
    layout_header :: try support.put(&context, project, "layout.h", "struct __attribute__((packed)) Packed { char tag; int value; };\nstruct Bits { unsigned flag : 1; };\nstruct Flexible { int count; int values[]; };\n")
    layouts [3][;0]u8 :: ["Packed", "Bits", "Flexible"]
    for (layouts) |selection| {
        result :: try translate(&context, project, "layout", layout_header, &[selection])
        try support.expect(&context, result.status == 1 and support.contains(result.stderr, "unsupported"), "unsupported C layout was guessed")
    }
    unowned :: try support.put(&context, project, "ffi/unowned/bindings.hon", "preserve :: 7\n")
    collision :: try translate(&context, project, "unowned", header, &["move_point"])
    try support.expect(&context, collision.status == 1 and mem.eql("preserve :: 7\n", try support.read(&context, unowned)), "unowned output was overwritten")
}

external_collisions_keywords_and_clang_settings test {
    context := try support.init("cimport_collisions")
    defer support.deinit(&context)
    project :: try support.path(&context, context.temporary, "project")
    try support.directory(&context, try support.path(&context, project, "source"))
    _ = try support.put(&context, project, "build.hon", "# project-root marker\n")
    first_header :: try support.put(&context, project, "first.h", "extern int shared_symbol(int);\nextern int proc(int);\ntypedef struct Keyword { int mut; int test; } Keyword;\n")
    first :: try translate(&context, project, "one", first_header, &["shared_symbol", "proc", "Keyword"])
    try support.expect_result(&context, first, 0, "", "")
    bindings :: try support.read(&context, try support.path(&context, project, "ffi/one/bindings.hon"))
    common :: try support.read(&context, try support.path(&context, project, "ffi/__c_types/bindings.hon"))
    try support.expect(&context, support.contains(bindings, "@\"proc\" c_func("), "Honey keyword was not explicitly escaped")
    try support.expect(&context, support.contains(common, "@\"mut\" c_int") and support.contains(common, "@\"test\" c_int"), "keyword fields were not escaped")
    second_header :: try support.put(&context, project, "second.h", "extern long shared_symbol(long);\n")
    second :: try translate(&context, project, "two", second_header, &["shared_symbol"])
    try support.expect(&context, second.status == 1 and support.contains(second.stderr, "shared_symbol") and support.contains(second.stderr, "incompatible"), "linker-level collision across namespaces was not diagnosed")
    _ = try support.put(&context, project, "include/selected.h", "typedef struct Selected { int value; } Selected;\n")
    configured_header :: try support.put(&context, project, "configured.h", "#include <selected.h>\n#ifndef ENABLE_BINDING\n#error explicit define required\n#endif\nextern Selected configured(Selected);\n")
    included :: try support.path(&context, project, "include")
    configured :: try support.run(&context, &[context.compiler, "translate-c", "configured", "--project", project, "--target", "arm64-apple-macos11", "--header", configured_header, "--symbol", "configured", "-I", included, "-D", "ENABLE_BINDING=1"], support.RunOptions{})
    try support.expect_result(&context, configured, 0, "", "")
}

uninitialized_project_is_rejected test {
    context := try support.init("cimport_uninitialized")
    defer support.deinit(&context)
    project :: try support.path(&context, context.temporary, "project")
    try support.directory(&context, try support.path(&context, project, "source"))
    header :: try support.path(&context, context.root, "tests/cimport/fixtures/bindings.h")
    result :: try translate(&context, project, "rejected", header, &["move_point"])
    try support.expect(&context, result.status == 2 and support.contains(result.stderr, "run honey init"), "uninitialized project was accepted despite unresolved @ffi imports")
    try support.expect(&context, !try support.exists(&context, try support.path(&context, project, "ffi")), "invalid project validation wrote partial bindings")
}

pointer_qualifiers_and_scientific_constants test {
    context := try support.init("cimport_qualifiers")
    defer support.deinit(&context)
    project :: try support.path(&context, context.temporary, "project")
    try support.directory(&context, try support.path(&context, project, "source"))
    _ = try support.put(&context, project, "build.hon", "# project-root marker\n")
    header :: try support.path(&context, context.root, "tests/cimport/fixtures/qualifiers.h")
    generated :: try translate(&context, project, "qualified", header, &["pointer_levels", "readonly_text", "get_small_value", "get_large_value", "get_fraction_value", "get_negative_zero", "SMALL_VALUE", "LARGE_VALUE", "FRACTION_VALUE", "NEGATIVE_ZERO"])
    try support.expect_result(&context, generated, 0, "", "")
    fixture :: try support.path(&context, context.root, "tests/cimport/fixtures/qualifiers.hon")
    source :: try support.put(&context, project, "source/main.hon", try support.read(&context, fixture))
    checked :: try support.run(&context, &[context.compiler, "emit-llvm", source], support.RunOptions{})
    try support.expect(&context, checked.status == 0, checked.stderr)
    llvm :: try support.put(&context, context.temporary, "qualified.ll", checked.stdout)
    implementation :: try support.path(&context, context.root, "tests/cimport/fixtures/qualifiers.c")
    linked :: try support.run(&context, &["clang", "-target", "arm64-apple-macosx11.0.0", "-O2", llvm, implementation, "-o", context.executable], {})
    try support.expect_result(&context, linked, 0, "", "")
    result :: try support.run(&context, &[context.executable], {})
    try support.expect_result(&context, result, 0, "42\n", "")
    try support.write(&context, source, "binding :: import \"@ffi/qualified\"\nmain proc() i32 { return binding.pointer_levels(\"immutable\", \"immutable\", null, null, null, null, null, null) }\n")
    rejected :: try support.run(&context, &[context.compiler, "emit-llvm", source], {})
    try support.expect(&context, rejected.status == 1, "immutable string was accepted as a mutable C pointer")
}

retargeting_regenerates_types_without_mixing_package_targets test {
    context := try support.init("cimport_retarget")
    defer support.deinit(&context)
    project :: try support.path(&context, context.temporary, "project")
    try support.directory(&context, try support.path(&context, project, "source"))
    _ = try support.put(&context, project, "build.hon", "# project-root marker\n")
    header :: try support.put(&context, project, "version.h", "#if __ENVIRONMENT_MAC_OS_X_VERSION_MIN_REQUIRED__ >= 150000\ntypedef long Version;\n#else\ntypedef int Version;\n#endif\nextern Version version_value(void);\n")
    first :: try translate(&context, project, "versioned", header, &["version_value"])
    try support.expect_result(&context, first, 0, "", "")
    retargeted :: try support.run(&context, &[context.compiler, "translate-c", "versioned", "--project", project, "--target", "arm64-apple-macos15", "--header", header, "--symbol", "version_value"], {})
    try support.expect_result(&context, retargeted, 0, "", "")
    source :: try support.put(&context, project, "source/main.hon", "binding :: import \"@ffi/versioned\"\nmain proc() i32 { return if (binding.version_value() == c_long(4294967338)) 0 else 1 }\n")
    emitted :: try support.run(&context, &[context.compiler, "emit-llvm", source], {})
    try support.expect(&context, emitted.status == 0 and emitted.stderr.len == 0, emitted.stderr)
    llvm :: try support.put(&context, project, "version.ll", emitted.stdout)
    implementation :: try support.put(&context, project, "version.c", "long version_value(void) { return 4294967338L; }\n")
    linked :: try support.run(&context, &["clang", "-target", "arm64-apple-macosx11.0.0", llvm, implementation, "-o", context.executable], {})
    try support.expect_result(&context, linked, 0, "", "")
    executed :: try support.run(&context, &[context.executable], {})
    try support.expect_result(&context, executed, 0, "0\n", "")
    other :: try support.run(&context, &[context.compiler, "translate-c", "other", "--project", project, "--target", "arm64-apple-macos15", "--header", header, "--symbol", "version_value"], {})
    try support.expect_result(&context, other, 0, "", "")
    bindings_path :: try support.path(&context, project, "ffi/versioned/bindings.hon")
    common_path :: try support.path(&context, project, "ffi/__c_types/bindings.hon")
    bindings :: try support.read(&context, bindings_path)
    common :: try support.read(&context, common_path)
    rejected :: try translate(&context, project, "versioned", header, &["version_value"])
    try support.expect(&context, rejected.status == 1, "mixed binding targets were accepted")
    try support.expect(&context, mem.eql(bindings, try support.read(&context, bindings_path)) and mem.eql(common, try support.read(&context, common_path)), "target conflict changed generated bindings")
}

all_selected_headers_exports_and_transitive_layouts test {
    context := try support.init("cimport_all")
    defer support.deinit(&context)
    project :: try support.path(&context, context.temporary, "project")
    try support.directory(&context, try support.path(&context, project, "source"))
    _ = try support.put(&context, project, "build.hon", "# project-root marker\n")
    header :: try support.path(&context, context.root, "tests/cimport/fixtures/all.h")
    arguments [10][;0]u8 :: [context.compiler, "translate-c", "everything", "--project", project, "--target", "arm64-apple-macos11", "--header", header, "--all"]
    generated :: try support.run(&context, arguments[..], {})
    try support.expect(&context, generated.status == 0, generated.stderr)
    unsupported [6][;0]u8 :: ["all_global", "all_inline", "ALL_APPLY", "all_long_double", "AllUnsupported", "all_unsupported_record"]
    for (unsupported) |selection| {
        try support.expect(&context, support.contains(generated.stderr, selection), "unsupported --all item was silently skipped")
    }
    bindings_path :: try support.path(&context, project, "ffi/everything/bindings.hon")
    common_path :: try support.path(&context, project, "ffi/__c_types/bindings.hon")
    manifest_path :: try support.path(&context, project, "ffi/everything/.honey-cimport")
    original :: try support.read(&context, bindings_path)
    common :: try support.read(&context, common_path)
    recipe :: try support.read(&context, manifest_path)
    try support.expect(&context, support.contains(recipe, "\"all\":true"), "manifest omitted --all selection mode")
    fixture :: try support.path(&context, context.root, "tests/cimport/fixtures/all.hon")
    source :: try support.put(&context, project, "source/main.hon", try support.read(&context, fixture))
    emitted :: try support.run(&context, &[context.compiler, "emit-llvm", source], {})
    try support.expect(&context, emitted.status == 0, emitted.stderr)
    llvm :: try support.put(&context, context.temporary, "all.ll", emitted.stdout)
    implementation :: try support.path(&context, context.root, "tests/cimport/fixtures/all.c")
    linked :: try support.run(&context, &["clang", "-target", "arm64-apple-macosx11.0.0", "-O2", llvm, implementation, "-o", context.executable], {})
    try support.expect_result(&context, linked, 0, "", "")
    executed :: try support.run(&context, &[context.executable], {})
    try support.expect_result(&context, executed, 0, "42\n", "")
    for (["unrelated_included_function()", "UNRELATED_INCLUDED_VALUE"]) |expression| {
        text :: try support.concat(&context, &["binding :: import \"@ffi/everything\"\nmain proc() i32 { return i32(binding.", expression, ") }\n"])
        try support.write(&context, source, text)
        excluded :: try support.run(&context, &[context.compiler, "emit-llvm", source], {})
        try support.expect(&context, excluded.status == 1, "unrelated included-header export was visible to Honey")
    }
    again :: try support.run(&context, arguments[..], {})
    try support.expect(&context, again.status == 0, again.stderr)
    try support.expect(&context, mem.eql(original, try support.read(&context, bindings_path)), "--all regeneration changed bindings")
    try support.expect(&context, mem.eql(common, try support.read(&context, common_path)), "--all regeneration changed transitive types")
    try support.expect(&context, mem.eql(recipe, try support.read(&context, manifest_path)), "--all regeneration changed recipe")
    for (unsupported) |selection| {
        rejected :: try translate(&context, project, "strict", header, &[selection])
        try support.expect(&context, rejected.status == 1 and support.contains(rejected.stderr, selection), "explicit unsupported selection was not strict")
        try support.expect(&context, !try support.exists(&context, try support.path(&context, project, "ffi/strict/bindings.hon")), "strict selection wrote partial bindings")
    }
    invalid :: try support.run(&context, &[context.compiler, "translate-c", "invalid", "--project", project, "--target", "arm64-apple-macos11", "--header", header, "--all", "--symbol", "all_unused_function"], {})
    try support.expect(&context, invalid.status != 0 and support.contains(invalid.stderr, "--all") and support.contains(invalid.stderr, "--symbol"), "--all and --symbol were accepted together")
    try support.expect(&context, !try support.exists(&context, try support.path(&context, project, "ffi/invalid/bindings.hon")), "invalid selection mode wrote bindings")
    selected :: try translate(&context, project, "selected", header, &["all_unused_function"])
    try support.expect_result(&context, selected, 0, "", "")
    selected_recipe :: try support.read(&context, try support.path(&context, project, "ffi/selected/.honey-cimport"))
    try support.write(&context, source, "binding :: import \"@ffi/selected\"\nmain proc() i32 { return i32(binding.ALL_NUMBER) }\n")
    unselected :: try support.run(&context, &[context.compiler, "emit-llvm", source], {})
    try support.expect(&context, unselected.status == 1, "explicit selection unexpectedly exposed an unselected constant")
    try support.expect(&context, support.contains(selected_recipe, "\"all\":false"), "manifest omitted explicit selection mode")
    try support.write(&context, bindings_path, "handwritten :: 123\n")
    refused :: try support.run(&context, arguments[..], {})
    try support.expect(&context, refused.status == 1 and support.contains(refused.stderr, "refusing to overwrite"), "--all overwrote edited bindings")
    try support.expect(&context, mem.eql("handwritten :: 123\n", try support.read(&context, bindings_path)), "--all destroyed edited output")
    try support.expect(&context, mem.eql(common, try support.read(&context, common_path)) and mem.eql(recipe, try support.read(&context, manifest_path)), "failed --all regeneration changed generated metadata")
}

omitted_target_uses_project_configuration_and_override_is_independent test {
    context := try support.init("cimport project target")
    defer support.deinit(&context)
    root :: try support.path(&context, context.temporary, "project")
    created :: try support.run(&context, &[context.compiler, "new", root], {})
    try support.expect_result(&context, created, 0, "", "")
    config :: try support.put(&context, root, "build.hon", "import \"@std/build\"\nconfig :: build.BuildConfig{ name = \"app\", source = \"source\", macos_deployment_target = \"15.0\", libraries = &[\"not_installed\"], linkage = .static }\n")
    header :: try support.put(&context, root, "version.h", "#if __ENVIRONMENT_MAC_OS_X_VERSION_MIN_REQUIRED__ == 150000\ntypedef long Version;\n#else\ntypedef int Version;\n#endif\n")
    source :: try support.put(&context, root, "source/main.hon", "binding :: import \"@ffi/versioned\"\nmain proc() i32 { return i32(sizeof!(binding.Version)) }\n")
    for ([false, true]) |override| {
        arguments := arraylist.init([;0]u8, context.allocator)
        defer arraylist.deinit(&arguments)
        initial [8][;0]u8 :: [context.compiler, "translate-c", "versioned", "--project", root, "--header", header, "--all"]
        for (initial) |argument| try arraylist.append(&arguments, argument)
        if (override) {
            try arraylist.append(&arguments, "--target")
            try arraylist.append(&arguments, "arm64-apple-macos11")
        }
        generated :: try support.run(&context, arguments.items, { cwd = context.temporary })
        try support.expect_result(&context, generated, 0, "", "")
        emitted :: try support.run(&context, &[context.compiler, "emit-llvm", source], {})
        try support.expect(&context, emitted.status == 0, emitted.stderr)
        llvm :: try support.put(&context, context.temporary, "version.ll", emitted.stdout)
        linked :: try support.run(&context, &["clang", "-target", "arm64-apple-macos15", llvm, "-o", context.executable], {})
        try support.expect_result(&context, linked, 0, "", "")
        result :: try support.run(&context, &[context.executable], {})
        expected :: if (override) "4\n" else "8\n"
        try support.expect_result(&context, result, 0, expected, "")
    }
    bindings :: try support.path(&context, root, "ffi/versioned/bindings.hon")
    original :: try support.read(&context, bindings)
    try support.write(&context, config, "config ::\n")
    rejected :: try support.run(&context, &[context.compiler, "translate-c", "versioned", "--project", root, "--header", header, "--symbol", "Version"], {})
    try support.expect(&context, rejected.status == 2 and mem.eql(original, try support.read(&context, bindings)), "invalid configuration must not silently choose a target or change bindings")
    explicit :: try translate(&context, root, "versioned", header, &["Version"])
    try support.expect_result(&context, explicit, 0, "", "")
    empty :: try support.run(&context, &[context.compiler, "translate-c", "versioned", "--project", root, "--header", header, "--symbol", "Version", "--target", ""], {})
    try support.expect(&context, empty.status == 2, "empty explicit target must not fall back to project configuration")
}
