    invalid_generated_field_name
    invalid_struct_layout
    invalid_c_record_field_type
    missing_metadata_import
    invalid_metadata_abi
    invalid_undefined
    invalid_shift_count
    unreachable_executed
    compile_error
    invalid_compile_error
}

Diagnostic :: struct {
    code Code
    span Span
    custom_message ?[]u8 = null
}

#! owns diagnostic storage and retains its allocator; release with deinit.
Store :: struct { list arraylist.ArrayList(Diagnostic) }

CapacityError :: enum { diagnostic_limit_reached, storage_limit_reached }

#! retains `allocator` for added diagnostics; the caller owns the returned Store.
init proc(allocator mem.Allocator) Store {
    return Store{ list = arraylist.init(allocator) }
}

#! releases diagnostic storage with the retained allocator.
deinit proc(store @mut Store) void {
    for (store.list.items) |diagnostic| {
        if (diagnostic.custom_message) |text| mem.free(store.list.allocator, text)
    }
    arraylist.deinit(&store.list)
}

#! allocates from the retained allocator; the returned ID is valid until deinit.
add proc(store @mut Store, code Code, span Span) DiagnosticId ! (mem.AllocError | CapacityError) {
    if (store.list.items.len >= usize(no_diagnostic)) return .diagnostic_limit_reached
    id :: DiagnosticId(store.list.items.len)
    try arraylist.append(&store.list, Diagnostic{ code = code, span = span })
    return id
}

#! copies `text`; the store owns the message until deinit.
add_message proc(store @mut Store, code Code, span Span, text []u8) DiagnosticId ! (mem.AllocError | CapacityError) {
    owned :: try mem.alloc(u8, store.list.allocator, text.len)
    errdefer mem.free(store.list.allocator, owned)
    memcopy!(owned, text)
    id :: try add(store, code, span)
    store.list.items[usize(id)].custom_message = owned
    return id
}

#! borrows either the store-owned custom message or process-lifetime code text.
message proc(diagnostic Diagnostic) []u8 {
    if (diagnostic.custom_message) |text| return text
    return enummap.get(Code, []u8, &messages, diagnostic.code)?
}

get proc(store @Store, id DiagnosticId) ?Diagnostic {
    if (usize(id) >= store.list.items.len) return null
    return store.list.items[usize(id)]
}

count proc(store @Store) usize {
    return store.list.items.len
}

#! constructed at compile time so missing entries fail compilation; message bytes live for the process lifetime.
messages :: $enummap.init(Code, []u8, {
    invalid_character = "invalid character",
    float_must_end_with_digit = "float literal must end with a digit",
    invalid_integer_literal = "invalid digits in prefixed integer literal",
    unterminated_string = "unterminated string literal",
    unterminated_character = "unterminated character literal",
    invalid_character_literal = "character literal must contain one Unicode code point",
    unexpected_token = "unexpected token",
    duplicate_name = "duplicate name or forbidden shadowing",
    unknown_name = "unknown name",
    unused_local = "unused local declaration; use '_' or explicitly discard the value",
    expected_type = "annotation must name a type",
    type_not_value = "type name cannot be used as a value",
    invalid_void_type = "void cannot be stored or used as a parameter type",
    type_mismatch = "incompatible value type",
    invalid_operand = "operator requires compatible operand types",
    integer_division = "division requires float operands",
    invalid_shift_count = "shift count must be smaller than the integer bit width",
    not_callable = "value is not callable",
    argument_count_mismatch = "argument count does not match the function signature",
    cannot_infer_type = "cannot infer a type without a type anchor",
    missing_return = "nonvoid function can finish without returning a value",
    unreachable_executed = "reached unreachable statement",
    return_type_mismatch = "return does not match the function result type",
    yield_outside_block = "yield requires an enclosing value block",
    missing_yield = "nonvoid value block can finish without yielding a value",
    yield_type_mismatch = "yield does not match the value block result type",
    condition_not_bool = "condition must have type bool",
    invalid_assignment_target = "assignment requires a mutable local binding",
    break_outside_loop = "break requires an enclosing loop",
    continue_outside_loop = "continue requires an enclosing loop",
    invalid_range_bound = "range bounds must have compatible integer types",
    invalid_for_iterable = "for-loop iteration requires an array, slice, string, single pointer to an array, direct integer range, or inline tuple",
    range_value_not_supported = "first-class range values are not implemented",
    range_pointer_capture = "range loops do not support pointer captures",
    range_index_capture = "range loops do not support index captures",
    invalid_array_length = "array length must be a nonnegative supported compile-time integer",
    array_length_mismatch = "array literal length does not match its type",
    invalid_array_element_type = "array element annotations require a supported concrete value type",
    array_size_overflow = "array storage size exceeds the supported address space",
    invalid_index_type = "array index must have type usize",
    not_indexable = "indexing is currently implemented for fixed arrays only",
    invalid_index_assignment = "indexed assignment requires a writable array element",
    index_out_of_bounds = "index out of bounds",
    unknown_field = "record has no such field",
    duplicate_field = "record field is specified more than once",
    missing_field = "record initializer is missing a required field",
    tuple_arity_mismatch = "tuple initializer arity does not match its type",
    not_record = "field selection requires a record or tuple",
    recursive_record = "record has a recursive by-value layout",
    invalid_record_field_type = "record fields require a concrete value type",
    missing_entry = "program requires a main function",
    invalid_entry = "main must be a runtime function with no parameters, or accept process.Init and return i32 or void (optionally fallible)",
    literal_out_of_range = "numeric literal is outside its runtime type's range",
    inexact_integer_literal = "integer literal is not exactly representable as float; use a floating literal to allow rounding",
    invalid_escape = "invalid string escape",
    read_before_initialization = "local value was read before initialization",
    write_before_initialization = "local value was assigned before initialization",
    initialization_cycle = "global initialization cycle",
    integer_overflow = "integer arithmetic overflow",
    division_by_zero = "integer division by zero",
    import_cycle = "package import cycle",
    invalid_import_path = "invalid import path",
    package_unavailable = "cannot load package directory",
    namespace_not_value = "package namespace cannot be used as a value",
    not_namespace = "member selection requires a package namespace",
    invalid_import_alias = "import requires an explicit valid identifier alias",
    invalid_enum_backing = "enum backing must be a concrete integer type",
    invalid_enum_value = "enum values require explicit backing and increasing representable constant integers",
    enum_context_required = "enum literal requires an enum or tagged union context",
    invalid_distinct_backing = "distinct requires a concrete runtime backing type",
    invalid_union_tag = "union tag must be an enum containing every union variant",
    union_initializer_count = "union construction requires exactly one member",
    invalid_match_subject = "match subject must be an enum, tagged union, or scalar",
    invalid_match_pattern = "invalid match pattern",
    duplicate_match_pattern = "duplicate or overlapping match pattern",
    non_exhaustive_match = "match is not exhaustive",
    unreachable_match_arm = "match arm is unreachable",
