import "@std/mem"
import "@std/arraylist"
import "@std/enummap"

SourceId :: distinct usize

#! borrows a source path and text owned by the compilation or caller.
Source :: struct {
    path []u8
    text []u8
}

Span :: struct {
    start u32
    end u32
    source SourceId = SourceId(0)
}

DiagnosticId :: distinct u32
no_diagnostic :: maxval!(DiagnosticId)

Code :: enum {
    invalid_character
    float_must_end_with_digit
    invalid_integer_literal
    unterminated_string
    unterminated_character
    invalid_character_literal
    unexpected_token
    duplicate_name
