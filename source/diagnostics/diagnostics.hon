    cleanup_control_flow = "cleanup cannot transfer control out of itself",
    comptime_argument_required = "generic argument must be a compile-time value",
    cannot_infer_generic = "cannot infer consistent compile-time arguments from arguments and result context",
    specialization_cycle = "compile-time specialization depends on its unfinished result",
