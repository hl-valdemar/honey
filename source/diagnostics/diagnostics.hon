    argument_count_mismatch
    cannot_infer_type
    missing_return
    return_type_mismatch
    yield_outside_block
    missing_yield
    yield_type_mismatch
    condition_not_bool
    invalid_assignment_target
    break_outside_loop
    continue_outside_loop
    invalid_range_bound
    invalid_for_iterable
    range_value_not_supported
    range_pointer_capture
    range_index_capture
    invalid_array_length
    array_length_mismatch
    invalid_array_element_type
    array_size_overflow
    invalid_index_type
    not_indexable
    invalid_index_assignment
    index_out_of_bounds
    unknown_field
    duplicate_field
    missing_field
    tuple_arity_mismatch
    not_record
    recursive_record
    invalid_record_field_type
    missing_entry
    invalid_entry
    literal_out_of_range
    inexact_integer_literal
    invalid_escape
    read_before_initialization
    write_before_initialization
    initialization_cycle
    integer_overflow
    division_by_zero
    import_cycle
    invalid_import_path
    package_unavailable
    namespace_not_value
    not_namespace
    invalid_import_alias
    invalid_enum_backing
    invalid_enum_value
    enum_context_required
    invalid_distinct_backing
    invalid_union_tag
    union_initializer_count
    invalid_match_subject
    invalid_match_pattern
    duplicate_match_pattern
    non_exhaustive_match
    unreachable_match_arm
    invalid_match_capture
    invalid_inline_match_subject
    invalid_inline_match_capture
    inactive_union_field
    invalid_pointer_type
    invalid_address_operand
    invalid_dereference
    invalid_pointer_assignment
    invalid_pointer_access
    null_unwrap
    invalid_slice_bounds
