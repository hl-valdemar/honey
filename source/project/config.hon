import "@std/mem"
import "@std/io"
import "@std/fs"
import "@std/arraylist"
import "@source/compilation"
import "@source/loader"
import "@source/ast"
import "@source/diagnostics"
import "@source/ir"
import "@source/interpreter"

#! owns paths, target and linker arguments; release exactly once with deinit_config.
#! source/output are absolute; target is a validated Darwin arm64 Clang/LLVM triple.
#! arguments are ready to append after the LLVM input.
Config :: struct {
    allocator mem.Allocator
    root [;0]u8 = ""
    name [;0]u8 = ""
    source [;0]u8 = ""
    output [;0]u8 = ""
    install_version [;0]u8 = "0.0.0-dev"
    install_self_hosted bool = false
    install_bootstrap [;0]u8 = ""
    target [;0]u8 = "arm64-apple-macosx11.0.0"
    arguments arraylist.ArrayList([;0]u8)
    owned arraylist.ArrayList([]mut u8)
}

deinit_config proc(config @mut Config) void {
    for (config.owned.items) |bytes| free_text(config.allocator, bytes)
    arraylist.deinit(&config.owned)
    arraylist.deinit(&config.arguments)
}

#! creates the default output directory only when a project build requests it.
prepare_output proc(config @Config) void ! Error {
    if (config.name.len == 0 or config.output.len == 0) return .invalid_config
    try ensure_directory(config.allocator, parent_path(config.output))
}

@hide:file
own proc(config @mut Config, bytes []mut u8) [;0]u8 ! Error {
    arraylist.append(&config.owned, bytes) catch |err| {
        free_text(config.allocator, bytes)
        return err
    }
    return bytes.ptr[..bytes.len;0]
}

@hide:file
text proc(config @mut Config, bytes []u8) [;0]u8 ! Error {
    return try own(config, try terminated(config.allocator, bytes))
}

@hide:file
path proc(config @mut Config, relative []u8) [;0]u8 ! Error {
    return try own(config, try join(config.allocator, config.root, relative))
}

@hide:file
argument proc(config @mut Config, value []u8) void ! Error {
    try arraylist.append(&config.arguments, try text(config, value))
}

@hide:file
pair proc(config @mut Config, option, value []u8) void ! Error {
    try argument(config, option)
    try argument(config, value)
}

#! discovers build.hon from a directory or its ancestors, type-checks its BuildConfig
#! and optional InstallConfig, then evaluates them with Honey's bounded constant interpreter.
#! optional reads return name == "" and no arguments when no config is declared.
#! library selection is skipped for metadata-only callers when `resolve_libraries` is false.
#! no output directories are created. diagnostics are local; return status 2 on failure.
load_config proc(allocator mem.Allocator, runtime io.Io, input []u8, required, resolve_libraries bool) Config ! Error {
    config := Config{ allocator = allocator, arguments = arraylist.init(allocator), owned = arraylist.init(allocator) }
    errdefer deinit_config(&config)
    directory :: try loader.directory(allocator, input)
    defer mem.free(allocator, directory)
    root :: try loader.project_root(allocator, directory)
    defer mem.free(allocator, root)
    config.root = try text(&config, root)
    build_path :: try path(&config, "build.hon")
    if (try fs.kind(allocator, build_path) != .file) {
        if (!required) return config
        try io.print("honey build: no build.hon in {s} or its ancestors; run honey init first\n", io.stderr(runtime), {input})
        return .project_not_found
    }
    declarations :: try config_declarations(allocator, runtime, build_path)
    if (!declarations.config) {
        if (!required) return config
        try io.print("{s}: build config: missing top-level config declaration\n", io.stderr(runtime), {build_path})
        return .invalid_config
    }
    session := compilation.init(allocator)
    defer compilation.deinit(&session)
    store := diagnostics.init(allocator)
    defer diagnostics.deinit(&store)
    project_package :: try compilation.load(&session, runtime, build_path, &store)
    build_package :: try compilation.load(&session, runtime, try path(&config, "std/build"), &store)
    # the typed snapshot keeps field extraction independent of BuildConfig declaration order.
    # imported package identities are wired exactly like the compiler's native test runner.
    runner_text :: "__honey_build :: import \"build\"\n__honey_project :: import \"project\"\nSnapshot :: struct {\n name []u8\n source []u8\n libraries [][]u8\n lib_paths [][]u8\n includes [][]u8\n defines [][]u8\n links [][]u8\n frameworks [][]u8\n rpaths [][]u8\n linkage u8\n macos_deployment_target []u8\n install_version []u8 = \"0.0.0-dev\"\n install_self_hosted u8 = 0\n install_bootstrap []u8 = \"\"\n}\nsnapshot proc(value __honey_build.BuildConfig) Snapshot {\n return Snapshot{ name = value.name, source = value.source, libraries = value.libraries, lib_paths = value.lib_paths, includes = value.includes, defines = value.defines, links = value.links, frameworks = value.frameworks, rpaths = value.rpaths, linkage = match value.linkage { .automatic: u8(0), .static: u8(1), .shared: u8(2) }, macos_deployment_target = value.macos_deployment_target }\n}\n"
    # absent installation settings never reference InstallConfig, preserving older vendored std/build.
    runner_main :: if (declarations.installation) "installation_snapshot proc(value __honey_build.InstallConfig) Snapshot {\n result := snapshot(__honey_project.config)\n result.install_version = value.version\n result.install_self_hosted = if (value.self_hosted) u8(1) else u8(0)\n result.install_bootstrap = value.bootstrap\n return result\n}\nmain proc() Snapshot { return installation_snapshot(__honey_project.installation) }\n" else "main proc() Snapshot { return snapshot(__honey_project.config) }\n"
    bytes := arraylist.init(u8, allocator)
    defer arraylist.deinit(&bytes)
    runner_parts [2][]u8 :: [runner_text, runner_main]
    for (runner_parts) |part| {
        for (part) |byte| try arraylist.append(&bytes, byte)
    }
    runner :: try compilation.add_package(&session)
    file :: try compilation.add_source(&session, runner, "<honey-build-config>", &bytes, &store)
    packages [2]compilation.PackageId :: [build_package, project_package]
    for (packages) |package, index| {
        declaration :: compilation.declaration(&session, file, index)
        try arraylist.append(&session.imports, compilation.Import{ node = declaration.node, target = package })
    }
    module := try compilation.compile(&session, runner, &store)
    defer ir.deinit(&module)
    if (diagnostics.count(&store) != 0) {
        try report_config_diagnostics(runtime, &session, &store)
        return .invalid_config
    }
    outcome := try interpreter.run_evaluation(allocator, &module, &store)
    defer interpreter.deinit(&outcome)
    if (outcome.trap != null or diagnostics.count(&store) != 0) {
        try report_config_diagnostics(runtime, &session, &store)
        return .invalid_config
    }
    value :: outcome.value
    if (value.type != .record or module.arrays.items[usize(value.array_type)].fields.len != 14) return .invalid_config
    config.install_version = try read_text(&config, &module, &outcome, ir.aggregate_item(&module, value, 11))
    self_hosted :: ir.aggregate_item(&module, value, 12).data.unsigned
    if (self_hosted > 1) return .invalid_config
    config.install_self_hosted = self_hosted == 1
    bootstrap :: try read_text(&config, &module, &outcome, ir.aggregate_item(&module, value, 13))
    if (bootstrap.len != 0) config.install_bootstrap = try path(&config, bootstrap)
    deployment_version :: read_text(&config, &module, &outcome, ir.aggregate_item(&module, value, 10)) catch |err| {
        if (err == .invalid_config) try report_invalid_deployment_target(runtime)
        return err
    }
    components :: deployment_components(deployment_version)
    if (components == null) {
        try report_invalid_deployment_target(runtime)
        return .invalid_config
    }
    normalized :: components?
    target [32]mut u8 := undefined
    target_length := usize(0)
    target_parts [6][]u8 :: ["arm64-apple-macosx", normalized[0], ".", normalized[1], ".", normalized[2]]
    for (target_parts) |part| {
        for (part) |byte| {
            target[target_length] = byte
            target_length += 1
        }
    }
    config.target = try text(&config, target[..target_length])
    config.name = try read_text(&config, &module, &outcome, ir.aggregate_item(&module, value, 0))
    if (!valid_name(config.name)) {
        try io.write_all(io.stderr(runtime), "honey build: config.name must be a nonempty plain executable name\n")
        return .invalid_config
    }
    source :: try read_text(&config, &module, &outcome, ir.aggregate_item(&module, value, 1))
    if (source.len == 0) return .invalid_config
    config.source = try path(&config, source)
    output_directory :: try path(&config, "build")
    config.output = try own(&config, try join(allocator, output_directory, config.name))
    libraries := try read_list(&config, &module, &outcome, ir.aggregate_item(&module, value, 2))
    defer arraylist.deinit(&libraries)
    paths := try read_list(&config, &module, &outcome, ir.aggregate_item(&module, value, 3))
    defer arraylist.deinit(&paths)
    for (paths.items) |@entry| {
        entry^ = try path(&config, entry^)
        try pair(&config, "-L", entry^)
    }
    for (usize(4)..usize(9)) |field| {
        values := try read_list(&config, &module, &outcome, ir.aggregate_item(&module, value, field))
        defer arraylist.deinit(&values)
        for (values.items) |entry, index| {
            if (entry.len == 0) return .invalid_config
            match field {
                4: try pair(&config, "-I", try path(&config, entry))
                5: try pair(&config, "-D", entry)
                6: {
                    if (entry[0] == '-' or (index != 0 and mem.eql(values.items[index - 1], "-framework"))) try argument(&config, entry)
                    else try argument(&config, try path(&config, entry))
                }
                7: try pair(&config, "-framework", entry)
                8: {
                    try pair(&config, "-Xlinker", "-rpath")
                    # dyld's @loader_path/@executable_path are not project-relative paths.
                    resolved :: if (entry[0] == '@') entry else try path(&config, entry)
                    try pair(&config, "-Xlinker", resolved)
                }
                else: unreachable
            }
        }
    }
    # the snapshot's exhaustive match normalizes tags; language enum ordinals are not zero-based.
    linkage :: ir.aggregate_item(&module, value, 9).data.unsigned
    if (linkage > 2) return .invalid_config
    for (libraries.items) |library| {
        if (!valid_name(library) or library[0] == '-') return .invalid_config
        if (linkage == 0 or !resolve_libraries) try pair(&config, "-l", library)
        else try select_library(&config, runtime, paths.items, library, linkage == 1)
    }
    return config
}

@hide:file
report_invalid_deployment_target proc(runtime io.Io) void ! Error {
    try io.write_all(io.stderr(runtime), "honey build: config.macos_deployment_target must be decimal major.minor[.patch], at least 11.0 for Apple Silicon (major <= 65535, minor/patch <= 255); for example \"15.0\"\n")
}

@hide:file
sysctlbyname c_func(name ?*c_char, old_value ?*mut anyopaque, old_length ?*mut c_ulong, new_value ?*anyopaque, new_length c_ulong) c_int

#! queries only at project creation; the returned version borrows `buffer`.
@hide
host_macos_version proc(buffer []mut u8) [;0]u8 ! Error {
    length [1]mut c_ulong := [c_ulong(buffer.len)]
    if (sysctlbyname("kern.osproductversion", buffer.ptr, length[..].ptr, null, 0) != 0) return .host_version_failed
    if (length[0] == 0 or length[0] > c_ulong(buffer.len)) return .host_version_failed
    count :: usize(length[0]) - 1
    if (buffer[count] != 0 or deployment_components(buffer[..count]) == null) return .host_version_failed
    return buffer.ptr[..count;0]
}

# Mach-O stores the major version in 16 bits and the minor/patch in 8 bits each.
# returned components borrow the input with leading zeros removed; an omitted patch is zero.
@hide:file
deployment_components proc(deployment_version []u8) ?[3][]u8 {
    components [3]mut []u8 := ["", "", "0"]
    cursor := usize(0)
    for (usize(0)..usize(3)) |index| {
        start := cursor
        number := u32(0)
        limit :: if (index == 0) u32(65535) else u32(255)
        while (cursor < deployment_version.len and deployment_version[cursor] >= '0' and deployment_version[cursor] <= '9') {
            number = number * 10 + u32(deployment_version[cursor] - '0')
            if (number > limit) return null
            cursor += 1
        }
        if (cursor == start or (index == 0 and number < 11)) return null
        while (start + 1 < cursor and deployment_version[start] == '0') start += 1
        components[index] = deployment_version[start..cursor]
        if (cursor == deployment_version.len) {
            if (index == 0) return null
            normalized [3][]u8 :: [components[0], components[1], components[2]]
            return normalized
        }
        if (deployment_version[cursor] != '.' or index == 2) return null
        cursor += 1
    }
    return null
}

@hide:file
valid_name proc(name []u8) bool {
    if (name.len == 0 or mem.eql(name, ".") or mem.eql(name, "..")) return false
    for (name) |byte| { if (byte == '/' or byte == '\\' or byte == 0) return false }
    return true
}

@hide:file
read_text proc(config @mut Config, module @ir.Module, outcome @interpreter.Outcome, value ir.Value) [;0]u8 ! Error {
    if (value.type == .string) return try text(config, ir.string_bytes(module, value.data.string))
    if (value.type != .record or module.arrays.items[usize(value.array_type)].fields.len != 2) return .invalid_config
    pointer :: ir.aggregate_item(module, value, 0)
    count :: ir.aggregate_item(module, value, 1)
    if (count.data.unsigned > 1048576) return .invalid_config
    length :: usize(count.data.unsigned)
    owned :: try mem.alloc(u8, config.allocator, length + 1)
    transferred := false
    errdefer { if (!transferred) mem.free(config.allocator, owned) }
    for (0..length) |index| {
        byte :: interpreter.evaluation_byte(outcome, module, pointer, index)
        if (byte == null or byte?.uninitialized or byte?.data.unsigned == 0 or byte?.data.unsigned > 255) return .invalid_config
        owned[index] = u8(byte?.data.unsigned)
    }
    owned[length] = 0
    transferred = true
    return try own(config, owned[..length])
}

@hide:file
read_list proc(config @mut Config, module @ir.Module, outcome @interpreter.Outcome, value ir.Value) arraylist.ArrayList([;0]u8) ! Error {
    result := arraylist.init([;0]u8, config.allocator)
    errdefer arraylist.deinit(&result)
    if (value.type != .record or module.arrays.items[usize(value.array_type)].fields.len != 2) return .invalid_config
    pointer :: ir.aggregate_item(module, value, 0)
    count :: ir.aggregate_item(module, value, 1)
    if (count.data.unsigned > 65536) return .invalid_config
    shape :: module.arrays.items[usize(value.array_type)]
    for (0..usize(count.data.unsigned)) |index| {
        entry :: interpreter.evaluation_element(outcome, module, pointer, index, shape.element, shape.element_array)
        if (entry == null) return .invalid_config
        try arraylist.append(&result, try read_text(config, module, outcome, entry?))
    }
    return result
}

@hide:file
select_library proc(config @mut Config, runtime io.Io, paths [][;0]u8, library []u8, static bool) void ! Error {
    suffixes [2]mut []u8 := [".dylib", ".tbd"]
    suffix_count := usize(2)
    if (static) {
        suffixes[0] = ".a"
        suffix_count = 1
    }
    defaults [3][;0]u8 :: ["/usr/lib", "/usr/local/lib", "/opt/homebrew/lib"]
    for (0..(paths.len + defaults.len)) |index| {
        directory :: if (index < paths.len) paths[index] else defaults[index - paths.len]
        for (suffixes[..suffix_count]) |suffix| {
            filename := arraylist.init(u8, config.allocator)
            defer arraylist.deinit(&filename)
            parts [3][]u8 :: ["lib", library, suffix]
            for (parts) |part| {
                for (part) |byte| try arraylist.append(&filename, byte)
            }
            candidate :: try own(config, try join(config.allocator, directory, filename.items))
            if (try fs.kind(config.allocator, candidate) == .file) {
                try argument(config, candidate)
                return
            }
        }
    }
    mode []u8 :: if (static) "static (.a)" else "shared (.dylib/.tbd)"
    try io.print("honey build: cannot find {s} library '{s}'; install it or add its directory to config.lib_paths (relative to {s})\n", io.stderr(runtime), {mode, library, config.root[..]})
    return .missing_library
}

#! prints actionable context after a native linker failure (clang retains exact diagnostics).
report_link_failure proc(runtime io.Io) void {
    io.write_all(io.stderr(runtime), "honey build: check config.libraries, config.lib_paths and config.frameworks; use config.linkage = .static/.shared to require that library form, and config.rpaths for runtime shared-library discovery\n") catch |_| {}
}

@hide:file
report_config_diagnostics proc(runtime io.Io, session @compilation.Compilation, store @diagnostics.Store) void ! Error {
    for (store.list.items) |diagnostic| {
        file :: session.sources.items[usize(diagnostic.span.source)]
        try io.print("{s}:{}: build config: {s}\n", io.stderr(runtime), {file.path, diagnostic.span.start, diagnostics.message(diagnostic)})
    }
}

@hide:file
ConfigDeclarations :: struct {
    config bool = false
    installation bool = false
}

@hide:file
config_declarations proc(allocator mem.Allocator, runtime io.Io, build_path []u8) ConfigDeclarations ! Error {
    parsed := compilation.init(allocator)
    defer compilation.deinit(&parsed)
    store := diagnostics.init(allocator)
    defer diagnostics.deinit(&store)
    bytes := try loader.read_source(allocator, runtime, build_path)
    defer arraylist.deinit(&bytes)
    package :: try compilation.add_package(&parsed)
    file :: try compilation.add_source(&parsed, package, build_path, &bytes, &store)
    if (diagnostics.count(&store) != 0) {
        try report_config_diagnostics(runtime, &parsed, &store)
        return .invalid_config
    }
    tree :: ast.view(&parsed.builder, compilation.source(&parsed, file).root)
    result := ConfigDeclarations{}
    for (0..ast.package_decl_count(&tree)) |index| {
        declaration :: ast.package_decl(&tree, index)
        name :: match ast.decl_kind(&tree, declaration) {
            .statement: ast.statement_decl(&tree, declaration).name
            .function: ast.function_decl(&tree, declaration).name
            else: continue
        }
        declaration_name :: ast.source_text(&tree, name)
        if (mem.eql(declaration_name, "config")) result.config = true
        if (mem.eql(declaration_name, "installation")) result.installation = true
    }
    return result
}
