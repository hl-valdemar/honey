        if (found_opening == null) return .invalid_clang_output
        opening :: found_opening?
        found_closing :: find(text[opening..], "]")
        if (found_closing == null) return .invalid_clang_output
        closing_relative :: found_closing?
        closing :: opening + closing_relative
        count :: trim(text[opening + 1..closing])
