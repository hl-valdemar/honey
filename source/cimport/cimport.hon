@hide:file
contains_qualifier proc(text, qualifier []u8) bool {
    cursor := usize(0)
    while (cursor < text.len) {
        start :: cursor
        while (cursor < text.len and ((text[cursor] >= 'a' and text[cursor] <= 'z') or (text[cursor] >= 'A' and text[cursor] <= 'Z') or (text[cursor] >= '0' and text[cursor] <= '9') or text[cursor] == '_')) cursor += 1
