@hide:file
strip_trailing_qualifiers proc(text []u8) []u8 {
    result := trim(text)
    while (result.len != 0) {
        start := result.len
        while (start > 0 and ((result[start - 1] >= 'a' and result[start - 1] <= 'z') or (result[start - 1] >= 'A' and result[start - 1] <= 'Z') or result[start - 1] == '_')) start -= 1
        if (!qualifier_word(result[start..])) break
        result = trim(result[..start])
    }
    return result
}
@hide:file
strip_qualifiers proc(text []u8) []u8 {
    result := strip_trailing_qualifiers(text)
    while (result.len != 0) {
        end := usize(0)
        while (end < result.len and ((result[end] >= 'a' and result[end] <= 'z') or (result[end] >= 'A' and result[end] <= 'Z') or result[end] == '_')) end += 1
        if (!qualifier_word(result[..end])) break
        result = trim(result[end..])
    }
    return result
