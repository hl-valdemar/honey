@hide:file
top_const proc(context @Context, spelling []u8, depth usize) bool ! Error {
    if (depth > 64) return .unsupported_declaration
    text :: trim(spelling)
    if (find(text, "(*")) |opening| {
        closing :: find(text[opening + 2..], ")")
        if (closing == null) return .unsupported_declaration
        return contains_qualifier(text[opening + 2..opening + 2 + closing?], "const")
