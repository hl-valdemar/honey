import "@ffi/c"
import "@std/mem"
import "@std/arraylist"
import "@std/fs"
import "@std/io"
import "@std/process"
import "@std/strconv"
import "@source/project"

Failure :: enum { invalid_options, clang_failed, invalid_clang_output, unsupported_declaration, conflicting_declaration, unsafe_output, filesystem_failed }
Error :: alias (Failure | mem.AllocError | fs.ReadFileError | io.WriteError | io.OpenError | io.CloseError | process.RunError)

@hide:file
Storage :: struct { allocator mem.Allocator, owned arraylist.ArrayList([]mut u8) }
@hide:file
storage_init proc(allocator mem.Allocator) Storage { return Storage{ allocator = allocator, owned = arraylist.init(allocator) } }
@hide:file
storage_deinit proc(storage @mut Storage) void {
    for (storage.owned.items) |bytes| mem.free(storage.allocator, bytes)
    arraylist.deinit(&storage.owned)
}
@hide:file
keep proc(storage @mut Storage, bytes []mut u8) []mut u8 ! Error {
    arraylist.append(&storage.owned, bytes) catch |err| {
        mem.free(storage.allocator, bytes)
        return err
    }
    return bytes
}
@hide:file
retain_list proc(storage @mut Storage, list @mut arraylist.ArrayList(u8)) []u8 ! Error {
    allocation :: list.items.ptr[..list.capacity]
    length :: list.items.len
    list.items = &[]
    list.capacity = 0
    return (try keep(storage, allocation))[..length]
}
@hide:file
append_parts proc(list @mut arraylist.ArrayList(u8), parts [][]u8) void ! Error {
    length := list.items.len
    for (parts) |part| {
        if (part.len > maxval!(usize) - length) return .out_of_memory
        length += part.len
    }
    start := list.items.len
    try arraylist.reserve(list, length)
    list.items = list.items.ptr[..length]
    for (parts) |part| {
        memcopy!(list.items[start..start + part.len], part)
        start += part.len
    }
}
@hide:file
join proc(storage @mut Storage, parts [][]u8) [;0]u8 ! Error {
    length := usize(0)
    for (parts) |part| {
        if (part.len >= maxval!(usize) - length) return .out_of_memory
        length += part.len
    }
    bytes :: try keep(storage, try mem.alloc(u8, storage.allocator, length + 1))
    offset := usize(0)
    for (parts) |part| {
        memcopy!(bytes[offset..offset + part.len], part)
        offset += part.len
    }
    bytes[length] = 0
    return bytes.ptr[..length;0]
}
@hide:file
number proc(storage @mut Storage, value u64) [;0]u8 ! Error {
    buffer [20]mut u8 := undefined
    start := buffer.len
    remaining := value
    while true {
        start -= 1
        buffer[start] = '0' + u8(rem!(remaining, 10))
        remaining = divtrunc!(remaining, 10)
        if (remaining == 0) break
    }
    parts [1][]u8 :: [buffer[start..]]
    return try join(storage, parts[..])
}
@hide:file
prefix proc(text, part []u8) bool { return text.len >= part.len and mem.eql(text[..part.len], part) }
@hide:file
suffix proc(text, part []u8) bool { return text.len >= part.len and mem.eql(text[text.len - part.len..], part) }
@hide:file
find proc(text, part []u8) ?usize {
    if (part.len > text.len) return null
    for (0..(text.len - part.len + 1)) |i| { if (mem.eql(text[i..i + part.len], part)) return i }
    return null
}
@hide:file
trim proc(text []u8) []u8 {
    first := usize(0)
    last := text.len
    while (first < last and (text[first] == ' ' or text[first] == '\n' or text[first] == '\r' or text[first] == '\t')) first += 1
    while (last > first and (text[last - 1] == ' ' or text[last - 1] == '\n' or text[last - 1] == '\r' or text[last - 1] == '\t')) last -= 1
    return text[first..last]
}
@hide:file
identifier proc(text []u8) bool {
    if (text.len == 0) return false
    for (text) |byte, i| {
        if ((byte >= 'a' and byte <= 'z') or (byte >= 'A' and byte <= 'Z') or byte == '_') continue
        if (i != 0 and byte >= '0' and byte <= '9') continue
        return false
    }
    return true
}
@hide:file
escaped proc(storage @mut Storage, name []u8) []u8 ! Error {
    if (!identifier(name)) return .unsupported_declaration
    keywords [70][]u8 :: ["proc", "c_func", "null", "undefined", "return", "yield", "break", "continue", "unreachable", "try", "catch", "orelse", "defer", "errdefer", "if", "for", "inline", "else", "while", "true", "false", "and", "or", "xor", "mut", "struct", "c_struct", "opaque", "enum", "union", "distinct", "alias", "match", "import", "test", "int", "float", "bool", "string", "void", "i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64", "f32", "f64", "uint", "isize", "usize", "anyopaque", "c_char", "c_schar", "c_uchar", "c_short", "c_ushort", "c_int", "c_uint", "c_long", "c_ulong", "c_longlong", "c_ulonglong", "c_float", "c_double", "c_longdouble", "type", "noreturn"]
    for (keywords) |word| {
        if (mem.eql(name, word)) {
            parts [3][]u8 :: ["@\"", name, "\""]
            return try join(storage, parts[..])
        }
    }
    return name
}
@hide:file
hash proc(text []u8) u64 {
    value := u64(5381)
    # wrapping arithmetic expressed without overflow, for bootstrap compatibility.
    for (text) |byte| value = ((value & u64(72057594037927935)) * 33) xor u64(byte)
    return value
}
@hide:file
read_text proc(storage @mut Storage, runtime io.Io, path []u8) []u8 ! Error {
    bytes := try fs.read_file(storage.allocator, runtime, path, 268435456)
    defer arraylist.deinit(&bytes)
    return try retain_list(storage, &bytes)
}
@hide:file
write_text proc(runtime io.Io, path [;0]u8, text []u8) void ! Error {
    file :: try io.open(runtime, path, .write_only)
    closing := false
    defer { if (!closing) io.close(file) catch |_| {} }
    try io.write_all(io.writer(file), text)
    closing = true
    try io.close(file)
}
@hide:file
make_directory proc(storage @mut Storage, path []u8) void ! Error {
    parts [1][]u8 :: [path]
    terminated :: try join(storage, parts[..])
    if (c.mkdir(ptrcast!(terminated.ptr), 493) == 0) return
    if (c.__error()?^ == c.EEXIST and try fs.kind(storage.allocator, path) == .directory) return
    return .filesystem_failed
}
@hide:file
posix_spawn_file_actions_init c_func(actions ?*mut c.posix_spawn_file_actions_t) c_int
@hide:file
posix_spawn_file_actions_destroy c_func(actions ?*mut c.posix_spawn_file_actions_t) c_int
@hide:file
posix_spawn_file_actions_adddup2 c_func(actions ?*mut c.posix_spawn_file_actions_t, source, destination c_int) c_int
@hide:file
posix_spawn_file_actions_addclose c_func(actions ?*mut c.posix_spawn_file_actions_t, descriptor c_int) c_int

@hide:file
Temporary :: struct { descriptor c_int, path [;0]u8 }
@hide:file
temporary proc(storage @mut Storage) Temporary ! Error {
    path :: try join(storage, &["/tmp/honey-cimport-XXXXXX"])
    descriptor :: c.mkstemp(ptrcast!(constcast!(path).ptr))
    if (descriptor < 0) return .filesystem_failed
    return Temporary{ descriptor = descriptor, path = path }
}
@hide:file
remove_temporary proc(file Temporary) void {
    _ = c.close(file.descriptor)
    _ = c.unlink(ptrcast!(file.path.ptr))
}

@hide:file
capture proc(storage @mut Storage, runtime io.Io, arguments [][;0]u8) []u8 ! Error {
    if (arguments.len == 0 or arguments[0].len == 0) return .invalid_options
    if (arguments.len == maxval!(usize)) return .out_of_memory
    for (arguments) |argument| {
        for (argument) |byte| { if (byte == 0) return .invalid_options }
    }
    output :: try temporary(storage)
    defer remove_temporary(output)
    actions [1]mut c.posix_spawn_file_actions_t := [null]
    if (posix_spawn_file_actions_init(actions[..].ptr) != 0) return .filesystem_failed
    defer _ = posix_spawn_file_actions_destroy(actions[..].ptr)
    if (posix_spawn_file_actions_adddup2(actions[..].ptr, output.descriptor, 1) != 0) return .filesystem_failed
    if (posix_spawn_file_actions_addclose(actions[..].ptr, output.descriptor) != 0) return .filesystem_failed
    argv :: try mem.alloc(?*mut c_char, storage.allocator, arguments.len + 1)
    defer mem.free(storage.allocator, argv)
    for (arguments) |argument, i| argv[i] = ptrcast!(constcast!(argument).ptr)
    argv[arguments.len] = null
    pid [1]mut c_int := [0]
    if (c.posix_spawnp(pid[..].ptr, ptrcast!(arguments[0].ptr), actions[..].ptr, null, argv.ptr, c._NSGetEnviron()?^) != 0) return .spawn_failed
    status [1]mut c_int := [0]
    while (c.waitpid(pid[0], status[..].ptr, 0) < 0) { if (c.__error()?^ != c.EINTR) return .wait_failed }
    if (status[0] != 0) return .clang_failed
    return try read_text(storage, runtime, output.path)
}

@hide:file
JsonNode :: struct {
    key []u8 = ""
    text []u8 = ""
    first usize = 0
    next usize = 0
    file []u8 = ""
}
@hide:file
Json :: struct { nodes arraylist.ArrayList(JsonNode), source []u8, cursor usize = 0, storage @mut Storage }
@hide:file
json_space proc(json @mut Json) void {
    while (json.cursor < json.source.len and (json.source[json.cursor] == ' ' or json.source[json.cursor] == '\n' or json.source[json.cursor] == '\r' or json.source[json.cursor] == '\t')) json.cursor += 1
}
@hide:file
json_string proc(json @mut Json) []u8 ! Error {
    if (json.cursor >= json.source.len or json.source[json.cursor] != '"') return .invalid_clang_output
    json.cursor += 1
    bytes := arraylist.init(u8, json.storage.allocator)
    defer arraylist.deinit(&bytes)
    while (json.cursor < json.source.len) {
        byte := json.source[json.cursor]
        json.cursor += 1
        if (byte == '"') return try retain_list(json.storage, &bytes)
        if (byte == '\\') {
            if (json.cursor == json.source.len) return .invalid_clang_output
            byte = json.source[json.cursor]
            json.cursor += 1
            match byte {
                'n': byte = '\n'
                'r': byte = '\r'
                't': byte = '\t'
                'b': byte = 8
                'f': byte = 12
                '"', '\\', '/': {}
                'u': {
                    if (json.cursor + 4 > json.source.len) return .invalid_clang_output
                    code := u32(0)
                    for (json.source[json.cursor..json.cursor + 4]) |digit| {
                        value := u32(16)
                        if (digit >= '0' and digit <= '9') value = u32(digit - '0')
                        else if (digit >= 'a' and digit <= 'f') value = u32(digit - 'a') + 10
                        else if (digit >= 'A' and digit <= 'F') value = u32(digit - 'A') + 10
                        if (value == 16) return .invalid_clang_output
                        code = code * 16 + value
                    }
                    json.cursor += 4
                    if (code >= 55296 and code <= 57343) return .invalid_clang_output
                    if (code < 128) byte = u8(code)
                    else {
                        if (code >= 2048) try arraylist.append(&bytes, u8(224 + divtrunc!(code, 4096)))
                        leading :: if (code < 2048) u32(192) else u32(128)
                        try arraylist.append(&bytes, u8(leading + (divtrunc!(code, 64) & 63)))
                        byte = u8(128 + (code & 63))
                    }
                }
                else: return .invalid_clang_output
            }
        } else if (byte < 32) return .invalid_clang_output
        try arraylist.append(&bytes, byte)
    }
    return .invalid_clang_output
}
@hide:file
json_value proc(json @mut Json, key []u8, depth usize) usize ! Error {
    if (depth > 256) return .invalid_clang_output
    json_space(json)
    if (json.cursor >= json.source.len) return .invalid_clang_output
    index :: json.nodes.items.len
    try arraylist.append(&json.nodes, JsonNode{ key = key })
    byte :: json.source[json.cursor]
    if (byte == '{' or byte == '[') {
        json.cursor += 1
        end :: if (byte == '{') u8('}') else u8(']')
        previous := usize(0)
        json_space(json)
        while (json.cursor < json.source.len and json.source[json.cursor] != end) {
            child_key []u8 := ""
            if (byte == '{') {
                child_key = try json_string(json)
                json_space(json)
                if (json.cursor >= json.source.len or json.source[json.cursor] != ':') return .invalid_clang_output
                json.cursor += 1
            }
            child :: try json_value(json, child_key, depth + 1)
            if (previous == 0) json.nodes.items[index].first = child
            else json.nodes.items[previous].next = child
            previous = child
            json_space(json)
            if (json.cursor >= json.source.len) return .invalid_clang_output
            if (json.source[json.cursor] == end) break
            if (json.source[json.cursor] != ',') return .invalid_clang_output
            json.cursor += 1
            json_space(json)
        }
        if (json.cursor >= json.source.len) return .invalid_clang_output
        json.cursor += 1
    } else if (byte == '"') json.nodes.items[index].text = try json_string(json)
    else {
        start :: json.cursor
        while (json.cursor < json.source.len and json.source[json.cursor] != ',' and json.source[json.cursor] != '}' and json.source[json.cursor] != ']' and json.source[json.cursor] != '\n' and json.source[json.cursor] != '\r' and json.source[json.cursor] != ' ' and json.source[json.cursor] != '\t') json.cursor += 1
        if (start == json.cursor) return .invalid_clang_output
        json.nodes.items[index].text = json.source[start..json.cursor]
    }
    return index
}
@hide:file
json_parse proc(storage @mut Storage, text []u8) Json ! Error {
    json := Json{ nodes = arraylist.init(storage.allocator), source = text, storage = storage }
    errdefer arraylist.deinit(&json.nodes)
    try arraylist.append(&json.nodes, JsonNode{})
    _ = try json_value(&json, "", 0)
    json_space(&json)
    if (json.cursor != text.len) return .invalid_clang_output
    return json
}
@hide:file
property proc(json @Json, node usize, key []u8) usize {
    if (node == 0) return 0
    child := json.nodes.items[node].first
    while (child != 0) {
        if (mem.eql(json.nodes.items[child].key, key)) return child
        child = json.nodes.items[child].next
    }
    return 0
}
@hide:file
json_text proc(json @Json, node usize, key []u8) []u8 { return json.nodes.items[property(json, node, key)].text }
@hide:file
inner proc(json @Json, node usize) usize { return json.nodes.items[property(json, node, "inner")].first }
@hide:file
kind proc(json @Json, node usize, expected []u8) bool { return mem.eql(json_text(json, node, "kind"), expected) }
@hide:file
qual_type proc(json @Json, node usize) []u8 { return json_text(json, property(json, node, "type"), "qualType") }

#! borrows strings for the duration of generate. API callers supply a resolved Darwin arm64 target.
#! the CLI defaults an omitted --target to the configured project target.
#! `all` selects declarations and macros from the selected headers plus required types;
#! it is mutually exclusive with `symbols` and reports unsupported roots without failing.
Options :: struct {
    name []u8 = ""
    project []u8 = "."
    target []u8 = ""
    clang [;0]u8 = "clang"
    sysroot []u8 = ""
    headers [][]u8 = &[]
    symbols [][]u8 = &[]
    all bool = false
    includes [][]u8 = &[]
    defines [][]u8 = &[]
}

#! CLI entry point; accepts the complete process argument vector, including translate-c.
#! prints actionable errors, returns 0 on success, 1 on translation failure, 2 on invalid options.
#! all temporary and generated text is released before returning.
command proc(allocator mem.Allocator, runtime io.Io, args process.Args) i32 {
    storage := storage_init(allocator)
    defer storage_deinit(&storage)
    return command_inner(&storage, runtime, args) catch |err| {
        message []u8 :: match err {
            .invalid_options: "invalid options; use: honey translate-c <name> --header <header> (--all | --symbol <declaration>) [--target <target>] [--project <directory>] [-I <directory>] [-D <definition>] [--sysroot <directory>] [--clang <executable>] (repeat header/symbol/-I/-D)"
            .clang_failed: "Clang rejected the headers or selected constant; see its diagnostic above"
            .invalid_clang_output: "cannot decode Clang output; use a Clang installation supporting -ast-dump=json"
            .unsupported_declaration: "selected declaration or required type is unsupported; see diagnostic above"
            .conflicting_declaration: "incompatible C declarations across binding packages; see diagnostic above"
            .unsafe_output: "refusing to overwrite an unowned or modified generated file; restore its exact generated contents or choose a fresh package/project"
            .spawn_failed: "cannot start Clang; install Clang or specify --clang"
            .wait_failed: "cannot wait for Clang"
            .out_of_memory: "out of memory"
            else: "cannot access binding inputs or outputs (check paths and permissions)"
        }
        io.print("translate-c: {s}\n", io.stderr(runtime), {message}) catch |_| {}
        return if (err == .invalid_options) 2 else 1
    }
}

@hide:file
command_inner proc(storage @mut Storage, runtime io.Io, args process.Args) i32 ! Error {
    if (args.values.len < 3) return .invalid_options
    options := Options{ name = args.values[2] }
    has_target := false
    headers := arraylist.init([]u8, storage.allocator)
    defer arraylist.deinit(&headers)
    symbols := arraylist.init([]u8, storage.allocator)
    defer arraylist.deinit(&symbols)
    includes := arraylist.init([]u8, storage.allocator)
    defer arraylist.deinit(&includes)
    defines := arraylist.init([]u8, storage.allocator)
    defer arraylist.deinit(&defines)
    cursor := usize(3)
    while (cursor < args.values.len) {
        flag :: args.values[cursor]
        cursor += 1
        if (mem.eql(flag, "--all")) {
            options.all = true
            continue
        }
        if (cursor == args.values.len) return .invalid_options
        argument :: args.values[cursor]
        cursor += 1
        if (mem.eql(flag, "--header")) try arraylist.append(&headers, argument)
        else if (mem.eql(flag, "--symbol")) try arraylist.append(&symbols, argument)
        else if (mem.eql(flag, "-I")) try arraylist.append(&includes, argument)
        else if (mem.eql(flag, "-D")) try arraylist.append(&defines, argument)
        else if (mem.eql(flag, "--project")) options.project = argument
        else if (mem.eql(flag, "--target")) {
            if (argument.len == 0) return .invalid_options
            options.target = argument
            has_target = true
        } else if (mem.eql(flag, "--clang")) options.clang = argument
        else if (mem.eql(flag, "--sysroot")) options.sysroot = argument
        else return .invalid_options
    }
    options.headers = headers.items
    options.symbols = symbols.items
    options.includes = includes.items
    options.defines = defines.items
    if (!has_target) {
        config := project.load_config(storage.allocator, runtime, options.project, true, false) catch |_| {
            try io.write_all(io.stderr(runtime), "translate-c: cannot determine project target; fix build.hon or supply --target explicitly\n")
            return .invalid_options
        }
        defer project.deinit_config(&config)
        parts [1][]u8 :: [config.target]
        options.target = try join(storage, parts[..])
    }
    try generate_inner(storage, runtime, options)
    return 0
}

#! generate ffi/<name>/bindings.hon and the shared ffi/__c_types module beside source/.
#! `options.project` must contain source/ and a build.hon/build.bro project-root marker.
#! errors never authorize replacing handwritten or edited output. inputs are borrowed until return.
#! generated declarations do not imply ownership, lifetime, callback threading or library initialization contracts.
generate proc(allocator mem.Allocator, runtime io.Io, options Options) void ! Error {
    storage := storage_init(allocator)
    defer storage_deinit(&storage)
    try generate_inner(&storage, runtime, options)
}

@hide:file
clang_arguments proc(storage @mut Storage, options Options, input []u8) arraylist.ArrayList([;0]u8) ! Error {
    args := arraylist.init([;0]u8, storage.allocator)
    errdefer arraylist.deinit(&args)
    base_arguments [7][]u8 :: [options.clang, "-target", options.target, "-x", "c", "-std=c11", "-Werror=implicit-function-declaration"]
    for (base_arguments) |arg| {
        parts [1][]u8 :: [arg]
        try arraylist.append(&args, try join(storage, parts[..]))
    }
    if (options.sysroot.len != 0) {
        try arraylist.append(&args, "-isysroot")
        sysroot_parts [1][]u8 :: [options.sysroot]
        try arraylist.append(&args, try join(storage, sysroot_parts[..]))
    }
    for (options.includes) |path| {
        try arraylist.append(&args, "-I")
        include_parts [1][]u8 :: [path]
        try arraylist.append(&args, try join(storage, include_parts[..]))
    }
    for (options.defines) |definition| {
        try arraylist.append(&args, "-D")
        define_parts [1][]u8 :: [definition]
        try arraylist.append(&args, try join(storage, define_parts[..]))
    }
    input_parts [1][]u8 :: [input]
    try arraylist.append(&args, try join(storage, input_parts[..]))
    return args
}

@hide:file
c_string_literal proc(storage @mut Storage, text []u8) []u8 ! Error {
    result := arraylist.init(u8, storage.allocator)
    defer arraylist.deinit(&result)
    try arraylist.append(&result, '"')
    for (text) |byte| {
        if (byte == 0 or byte == '\n' or byte == '\r') return .invalid_options
        if (byte == '\\' or byte == '"') try arraylist.append(&result, '\\')
        try arraylist.append(&result, byte)
    }
    try arraylist.append(&result, '"')
    parts [1][]u8 :: [result.items]
    return try join(storage, parts[..])
}

@hide:file
generate_inner proc(storage @mut Storage, runtime io.Io, options Options) void ! Error {
    if (!identifier(options.name) or mem.eql(options.name, "c") or mem.eql(options.name, "__c_types")) return .invalid_options
    if (options.headers.len == 0 or options.target.len == 0 or (options.all and options.symbols.len != 0) or (!options.all and options.symbols.len == 0)) return .invalid_options
    if (!(prefix(options.target, "arm64-apple-") or prefix(options.target, "aarch64-apple-")) or (find(options.target, "macos") == null and find(options.target, "darwin") == null)) {
        try io.write_all(io.stderr(runtime), "translate-c: only Darwin arm64 targets are supported\n")
        return .invalid_options
    }
    source_parts [2][]u8 :: [options.project, "/source"]
    if (try fs.kind(storage.allocator, try join(storage, source_parts[..])) != .directory) {
        try io.write_all(io.stderr(runtime), "translate-c: --project must contain source/ (run honey init first)\n")
        return .invalid_options
    }
    honey_marker_parts [2][]u8 :: [options.project, "/build.hon"]
    bro_marker_parts [2][]u8 :: [options.project, "/build.bro"]
    if (
        try fs.kind(storage.allocator, try join(storage, honey_marker_parts[..])) != .file
        and try fs.kind(storage.allocator, try join(storage, bro_marker_parts[..])) != .file
    ) {
        try io.write_all(io.stderr(runtime), "translate-c: --project must contain a build.hon/build.bro project-root marker (run honey init first)\n")
        return .invalid_options
    }
    unit :: try temporary(storage)
    defer remove_temporary(unit)
    unit_source []u8 := ""
    headers := arraylist.init([]u8, storage.allocator)
    defer arraylist.deinit(&headers)
    for (options.headers) |header| {
        absolute :: try fs.canonical(storage.allocator, header)
        defer mem.free(storage.allocator, absolute)
        canonical_parts [1][]u8 :: [absolute]
        try arraylist.append(&headers, try join(storage, canonical_parts[..]))
        include_parts [4][]u8 :: [unit_source, "#include ", try c_string_literal(storage, absolute), "\n"]
        unit_source = try join(storage, include_parts[..])
    }
    try write_text(runtime, unit.path, unit_source)
    args := try clang_arguments(storage, options, unit.path)
    defer arraylist.deinit(&args)
    try arraylist.append(&args, "-fsyntax-only")
    try arraylist.append(&args, "-Xclang")
    try arraylist.append(&args, "-ast-dump=json")
    ast_text :: try capture(storage, runtime, args.items)
    json := try json_parse(storage, ast_text)
    defer arraylist.deinit(&json.nodes)
    # Clang owns all parsing, preprocessing, name lookup and C semantic checking.
    # We consume only its declarations and canonical type spellings, never C source.
    context := try context_init(storage, runtime, &json, options, headers.items)
    defer context_deinit(&context)
    context.input = unit.path
    context.unit_source = unit_source
    if (options.all) try select_all(&context)
    else {
        for (options.symbols) |selection| {
            if (!identifier(selection)) return .invalid_options
            select_symbol(&context, selection) catch |err| {
                if (err == .unsupported_declaration) try report(&context, selection, "cannot generate selected binding")
                return err
            }
        }
        emit_pending(&context) catch |err| {
            if (err == .unsupported_declaration) {
                for (options.symbols) |selection| try report(&context, selection, "cannot complete selected binding package because a required declaration is unsupported")
            }
            return err
        }
    }
    version_arguments [2][;0]u8 :: [options.clang, "--version"]
    version :: try capture(storage, runtime, version_arguments[..])
    args.items = args.items[..args.items.len - 3]
    dependency_arguments [3][;0]u8 :: ["-M", "-MT", "honey-translation-unit"]
    for (dependency_arguments) |argument| try arraylist.append(&args, argument)
    dependencies :: try capture(storage, runtime, args.items)
    found_unit :: find(dependencies, unit.path)
    if (found_unit == null) return .invalid_clang_output
    unit_position :: found_unit?
    dependency_parts [3][]u8 :: [dependencies[..unit_position], "honey-translation-unit.c", dependencies[unit_position + unit.path.len..]]
    stable_dependencies :: try join(storage, dependency_parts[..])
    context.recipe = try recipe(storage, options, unit_source, version, stable_dependencies)
    try install(&context)
}

@hide:file
Declaration :: struct {
    node usize
    file []u8
    name []u8
    identity []u8 = ""
    record_label []u8 = ""
    record_spelling []u8 = ""
    canonical_name []u8 = ""
    exported bool = false
    enum_type []u8 = ""
    required bool = false
    emitted bool = false
}
@hide:file
Entry :: struct { key []u8, text []u8 }
@hide:file
Context :: struct {
    storage @mut Storage
    runtime io.Io
    json @Json
    options Options
    headers [][]u8
    declarations arraylist.ArrayList(Declaration)
    bindings arraylist.ArrayList(Entry)
    common arraylist.ArrayList(Entry)
    symbols arraylist.ArrayList(Entry)
    shared bool = false
    defining_typedef []u8 = ""
    namespace []u8 = "c_types"
    input []u8 = ""
    unit_source []u8 = ""
    macros []u8 = ""
    recipe []u8 = ""
}
@hide:file
context_init proc(storage @mut Storage, runtime io.Io, json @Json, options Options, headers [][]u8) Context ! Error {
    context := Context{
        storage = storage, runtime = runtime, json = json, options = options, headers = headers,
        declarations = arraylist.init(storage.allocator), bindings = arraylist.init(storage.allocator),
        common = arraylist.init(storage.allocator), symbols = arraylist.init(storage.allocator),
    }
    errdefer context_deinit(&context)
    # Clang elides filenames relative to the preceding serialized source location,
    # including nested ranges and macro spelling/expansion locations.
    file []u8 := ""
    canonical []u8 := ""
    for (json.nodes.items) |_, index| {
        if (property(json, index, "offset") == 0) continue
        actual_file :: json_text(json, index, "file")
        if (actual_file.len != 0 and !mem.eql(actual_file, file)) {
            file = actual_file
            canonical = file
            if (file[0] != '<') {
                owned :: try fs.canonical(storage.allocator, file)
                defer mem.free(storage.allocator, owned)
                parts [1][]u8 :: [owned]
                canonical = try join(storage, parts[..])
            }
        }
        json.nodes.items[index].file = canonical
    }
    node := inner(json, 1)
    while (node != 0) {
        try collect_declaration(&context, node, "")
        node = json.nodes.items[node].next
    }
    for (context.declarations.items) |declaration, index| {
        if (!kind(json, declaration.node, "RecordDecl")) continue
        label :: try record_label(&context, index, 0)
        context.declarations.items[index].record_label = label
        context.declarations.items[index].canonical_name = try escaped(storage, label)
    }
    try assign_record_names(&context)
    while true {
        collision := false
        for (context.declarations.items) |declaration| {
            if (mem.eql(declaration.name, context.namespace)) collision = true
        }
        for (options.symbols) |selection| {
            if (mem.eql(selection, context.namespace)) collision = true
        }
        if (!collision) break
        namespace_parts [2][]u8 :: [context.namespace, "_"]
        context.namespace = try join(storage, namespace_parts[..])
    }
    return context
}
@hide:file
context_deinit proc(context @mut Context) void {
    arraylist.deinit(&context.declarations)
    arraylist.deinit(&context.bindings)
    arraylist.deinit(&context.common)
    arraylist.deinit(&context.symbols)
}
@hide:file
collect_declaration proc(context @mut Context, node usize, file []u8) void ! Error {
    json :: context.json
    location := property(json, node, "loc")
    if (property(json, location, "expansionLoc") != 0) location = property(json, location, "expansionLoc")
    else if (property(json, location, "spellingLoc") != 0) location = property(json, location, "spellingLoc")
    origin :: if (json.nodes.items[location].file.len == 0) file else json.nodes.items[location].file
    if (kind(json, node, "RecordDecl") or kind(json, node, "TypedefDecl") or kind(json, node, "EnumDecl") or kind(json, node, "FunctionDecl") or kind(json, node, "VarDecl") or kind(json, node, "EnumConstantDecl")) {
        name :: json_text(json, node, "name")
        identity []u8 := ""
        if (kind(json, node, "RecordDecl")) {
            # named identity does not depend on offsets changing between opaque and complete inputs.
            identity_location :: if (name.len == 0) json_text(json, location, "offset") else name
            identity_parts [5][]u8 :: [origin, ":", json_text(json, node, "tagUsed"), ":", identity_location]
            identity = try join(context.storage, identity_parts[..])
            # redeclarations share the first declaration's identity, including forward declarations.
            previous :: json_text(json, node, "previousDecl")
            if (previous.len != 0) {
                for (context.declarations.items) |declaration| {
                    if (mem.eql(json_text(json, declaration.node, "id"), previous)) {
                        identity = declaration.identity
                    }
                }
            }
        }
        try arraylist.append(&context.declarations, Declaration{ node = node, name = name, file = origin, identity = identity, exported = selected_file(context, origin) })
    }
    if (kind(json, node, "RecordDecl") or kind(json, node, "EnumDecl")) {
        child := inner(json, node)
        while (child != 0) {
            try collect_declaration(context, child, origin)
            child = json.nodes.items[child].next
        }
    }
}
@hide:file
report proc(context @Context, name, reason []u8) void ! Error {
    try io.print("translate-c: {s}: {s}\n", io.stderr(context.runtime), {name, reason})
}
@hide:file
selected_file proc(context @Context, file []u8) bool {
    for (context.headers) |header| { if (mem.eql(header, file)) return true }
    return false
}
@hide:file
entry_put proc(context @Context, entries @mut arraylist.ArrayList(Entry), key, text []u8) void ! Error {
    for (entries.items) |entry, index| {
        if (!mem.eql(entry.key, key)) continue
        if (mem.eql(entry.text, text)) return
        if (prefix(entry.text, "# C record identity: ") and prefix(text, "# C record identity: ")) {
            previous_end :: find(entry.text, "\n") orelse usize(0)
            current_end :: find(text, "\n") orelse usize(0)
            if (previous_end != 0 and mem.eql(entry.text[..previous_end], text[..current_end])) {
                if (suffix(entry.text, " :: opaque\n")) {
                    entries.items[index].text = text
                    return
                }
                if (suffix(text, " :: opaque\n")) return
            }
        }
        try report(context, key, "incompatible C declaration (including external linker symbols across packages)")
        return .conflicting_declaration
    }
    try arraylist.append(entries, Entry{ key = key, text = text })
}
@hide:file
lookup_type proc(context @Context, name []u8, expected []u8) ?usize {
    result ?usize := null
    for (context.declarations.items) |declaration, i| {
        if (!mem.eql(declaration.name, name) or !kind(context.json, declaration.node, expected)) continue
        result = i
        if (kind(context.json, declaration.node, "RecordDecl") and mem.eql(json_text(context.json, declaration.node, "completeDefinition"), "true")) return i
    }
    return result
}
@hide:file
assign_record_names proc(context @mut Context) void ! Error {
    storage :: context.storage
    shared_parts [2][]u8 :: [context.options.project, "/ffi/__c_types"]
    previous :: try read_manifest(context, try join(storage, shared_parts[..]))
    defer {
        if (previous) |saved| {
            parsed := saved
            arraylist.deinit(&parsed.nodes)
        }
    }
    names := arraylist.init(Entry, storage.allocator)
    defer arraylist.deinit(&names)
    if (previous) |saved| {
        parsed :: saved
        child := parsed.nodes.items[property(&parsed, 1, "common")].first
        while (child != 0) {
            try arraylist.append(&names, Entry{ key = json_text(&parsed, child, "key"), text = json_text(&parsed, child, "text") })
            child = parsed.nodes.items[child].next
        }
    }
    for (context.declarations.items) |declaration, index| {
        if (!kind(context.json, declaration.node, "RecordDecl")) continue
        marker :: try join(storage, &["# C record identity: ", try json_quote(storage, declaration.identity), "\n"])
        name := declaration.canonical_name
        # Shared identities keep their assigned name when another package adds a collision.
        found := false
        for (names.items) |entry| {
            if (!prefix(entry.text, marker)) continue
            name = entry.key
            found = true
            break
        }
        if (!found) {
            origin :: declaration.file
            end := origin.len
            while (end != 0 and origin[end - 1] != '/') end -= 1
            header_start :: end
            path_suffix []u8 := ""
            discriminator := u64(0)
            while (record_name_conflicts(context, names.items, declaration.identity, marker, name)) {
                while (end != 0 and origin[end - 1] == '/') end -= 1
                if (end != 0) {
                    start := end
                    while (start != 0 and origin[start - 1] != '/') start -= 1
                    component :: try path_label(storage, origin[start..end])
                    path_suffix = if (path_suffix.len == 0) component else try join(storage, &[component, "__", path_suffix])
                    name = try escaped(storage, try join(storage, &[declaration.record_label, "__", path_suffix]))
                    end = start
                } else {
                    if (discriminator == 0) {
                        stem_end := origin.len
                        cursor := origin.len
                        while (cursor > header_start) {
                            cursor -= 1
                            if (origin[cursor] == '.') {
                                stem_end = cursor
                                break
                            }
                        }
                        path_suffix = try path_label(storage, origin[header_start..stem_end])
                        name = try escaped(storage, try join(storage, &[declaration.record_label, "__", path_suffix]))
                    } else {
                        name = try escaped(storage, try join(storage, &[declaration.record_label, "__", path_suffix, "__", try number(storage, discriminator)]))
                    }
                    discriminator += 1
                }
            }
            try arraylist.append(&names, Entry{ key = name, text = marker })
        }
        context.declarations.items[index].canonical_name = name
    }
}
@hide:file
record_name_conflicts proc(context @Context, names []Entry, identity, marker, name []u8) bool {
    for (names) |entry| {
        if (mem.eql(entry.key, name) and !prefix(entry.text, marker)) return true
    }
    for (context.declarations.items) |other| {
        if (!kind(context.json, other.node, "RecordDecl") or mem.eql(other.identity, identity)) continue
        if (mem.eql(other.record_label, name) or mem.eql(other.canonical_name, name)) return true
    }
    return false
}
@hide:file
path_label proc(storage @mut Storage, component []u8) []u8 ! Error {
    if (identifier(component)) return component
    bytes :: try keep(storage, try mem.alloc(u8, storage.allocator, component.len))
    for (component) |byte, index| {
        bytes[index] = if (
            (byte >= 'a' and byte <= 'z') or (byte >= 'A' and byte <= 'Z')
            or (byte >= '0' and byte <= '9') or byte == '_'
        ) byte else '_'
    }
    return bytes
}
@hide:file
record_label proc(context @mut Context, index, depth usize) []u8 ! Error {
    if (depth > 64) return .unsupported_declaration
    record :: context.declarations.items[index]
    if (record.name.len != 0) return record.name
    label []u8 := ""
    for (context.declarations.items) |declaration| {
        if (!kind(context.json, declaration.node, "TypedefDecl")) continue
        if (owned_record(context, declaration.node)) |owned| {
            if (owned == index and (label.len == 0 or before(declaration.name, label))) label = declaration.name
        }
    }
    if (label.len != 0) return label
    offset :: json_text(context.json, property(context.json, record.node, "loc"), "offset")
    for (context.declarations.items) |parent, parent_index| {
        if (!kind(context.json, parent.node, "RecordDecl") or !mem.eql(parent.file, record.file) or parent_index == index) continue
        field := inner(context.json, parent.node)
        while (field != 0) {
            begin :: property(context.json, property(context.json, field, "range"), "begin")
            if (kind(context.json, field, "FieldDecl") and mem.eql(json_text(context.json, begin, "offset"), offset)) {
                spelling :: qual_type(context.json, field)
                if (find(spelling, ")")) |closing| context.declarations.items[index].record_spelling = spelling[..closing + 1]
                field_name :: json_text(context.json, field, "name")
                if (field_name.len != 0) {
                    parts [3][]u8 :: [try record_label(context, parent_index, depth + 1), "_", field_name]
                    return try join(context.storage, parts[..])
                }
            }
            field = context.json.nodes.items[field].next
        }
    }
    parts [2][]u8 :: ["Anonymous_", try number(context.storage, hash(record.identity))]
    return try join(context.storage, parts[..])
}
@hide:file
record_name proc(context @Context, index usize) []u8 ! Error {
    return context.declarations.items[index].canonical_name
}
@hide:file
require_record proc(context @mut Context, index usize) []u8 ! Error {
    context.declarations.items[index].required = true
    if (!context.shared and context.declarations.items[index].name.len != 0) {
        public_name :: try record_public_name(context, index)
        if (!mem.eql(public_name, context.defining_typedef)) return try escaped(context.storage, public_name)
    }
    name :: try record_name(context, index)
    namespace_parts [2][]u8 :: [context.namespace, "."]
    namespace_prefix []u8 :: if (context.shared) "" else try join(context.storage, namespace_parts[..])
    reference_parts [2][]u8 :: [namespace_prefix, name]
    return try join(context.storage, reference_parts[..])
}
@hide:file
qualifier_word proc(text []u8) bool {
    words [9][]u8 :: ["const", "volatile", "restrict", "_Nonnull", "_Nullable", "_Null_unspecified", "__restrict", "__restrict__", "__const"]
    for (words) |word| { if (mem.eql(text, word)) return true }
