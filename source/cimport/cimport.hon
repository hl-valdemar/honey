            }
        }
        if (definition != 0) {
            spelling :: qual_type(json, definition)
            canonical := json_text(json, property(json, definition, "type"), "desugaredQualType")
            if (canonical.len == 0) canonical = spelling
            if (try top_const(context, canonical, 0) and !contains_qualifier(canonical, "volatile")) {
                try select_constant(context, name, spelling)
                return
            }
        }
        try report(context, name, "only initialized, non-volatile const scalar objects can be imported as values; mutable and external-only C globals are unsupported")
        return .unsupported_declaration
    }
    try report(context, name, "unsupported C declaration")
    return .unsupported_declaration
}

@hide:file
record_public_name proc(context @Context, index usize) []u8 ! Error {
    record :: context.declarations.items[index]
    for (context.declarations.items) |declaration| {
        if (!mem.eql(declaration.name, record.name) or kind(context.json, declaration.node, "RecordDecl")) continue
        if (kind(context.json, declaration.node, "TypedefDecl")) {
            if (owned_record(context, declaration.node)) |other| {
                if (mem.eql(context.declarations.items[other].identity, record.identity)) continue
            } else {
                spelling_parts [3][]u8 :: [json_text(context.json, record.node, "tagUsed"), " ", record.name]
                if (mem.eql(qual_type(context.json, declaration.node), try join(context.storage, spelling_parts[..]))) continue
            }
        }
        tag_parts [2][]u8 :: ["__c_tag_", record.name]
        return try join(context.storage, tag_parts[..])
    }
    return record.name
}
@hide:file
render_record proc(context @mut Context, node usize, name []u8) []u8 ! Error {
    json :: context.json
    original_name :: json_text(json, node, "name")
    display :: if (original_name.len == 0) name else original_name
    if (!mem.eql(json_text(json, node, "completeDefinition"), "true")) {
        opaque_parts [2][]u8 :: [name, " :: opaque\n"]
        return try join(context.storage, opaque_parts[..])
    }
    record_kind []u8 :: if (mem.eql(json_text(json, node, "tagUsed"), "union")) "union" else "c_struct"
    header_parts [4][]u8 :: [name, " :: ", record_kind, " {\n"]
    text := try join(context.storage, header_parts[..])
    fields := usize(0)
    child := inner(json, node)
    while (child != 0) {
        if (kind(json, child, "FieldDecl")) {
            field_name :: json_text(json, child, "name")
            if (field_name.len == 0 or mem.eql(json_text(json, child, "isBitfield"), "true")) {
                try report(context, display, "anonymous members and bitfields have unsupported layouts")
                return .unsupported_declaration
            }
            field_parts [6][]u8 :: [text, "    ", try escaped(context.storage, field_name), " ", try render_type(context, qual_type(json, child), 0), "\n"]
            text = try join(context.storage, field_parts[..])
            fields += 1
            attribute := inner(json, child)
            while (attribute != 0) {
                if (suffix(json_text(json, attribute, "kind"), "Attr")) {
                    try report(context, display, "field layout attributes are unsupported")
                    return .unsupported_declaration
                }
                attribute = json.nodes.items[attribute].next
            }
        } else if (suffix(json_text(json, child, "kind"), "Attr") or kind(json, child, "IndirectFieldDecl")) {
            try report(context, display, "record layout attributes and anonymous members are unsupported")
            return .unsupported_declaration
        }
        child = json.nodes.items[child].next
    }
    if (fields == 0) {
        try report(context, display, "complete empty C records are unsupported")
        return .unsupported_declaration
    }
    closing_parts [2][]u8 :: [text, "}\n"]
    return try join(context.storage, closing_parts[..])
}
@hide:file
constant_value proc(json @Json, node usize) []u8 {
    if (kind(json, node, "ConstantExpr")) return json_text(json, node, "value")
    child := inner(json, node)
    while (child != 0) {
        result :: constant_value(json, child)
        if (result.len != 0) return result
        child = json.nodes.items[child].next
    }
    return ""
}
@hide:file
increment_decimal proc(storage @mut Storage, text []u8) []u8 ! Error {
    negative :: prefix(text, "-")
    digits :: if (negative) text[1..] else text
    parsed_magnitude :: strconv.parse_unsigned(digits, maxval!(u64))
    if (parsed_magnitude == null) return .invalid_clang_output
    magnitude :: parsed_magnitude?
    if (negative) {
        sign []u8 :: if (magnitude > 1) "-" else ""
        parts [2][]u8 :: [sign, try number(storage, magnitude - 1)]
        return try join(storage, parts[..])
    }
    if (magnitude == maxval!(u64)) return .unsupported_declaration
    return try number(storage, magnitude + 1)
}
@hide:file
emit_enum_constant proc(context @mut Context, parent, node usize) void ! Error {
    json :: context.json
    current []u8 := "0"
    child := inner(json, parent)
    while (child != 0) {
        if (kind(json, child, "EnumConstantDecl")) {
            explicit :: constant_value(json, child)
            if (explicit.len != 0) current = explicit
            if (child == node) {
                name :: json_text(json, node, "name")
                parts [6][]u8 :: [try escaped(context.storage, name), " ", try render_type(context, qual_type(json, node), 0), " :: ", current, "\n"]
                try entry_put(context, &context.bindings, name, try join(context.storage, parts[..]))
                return
            }
            current = try increment_decimal(context.storage, current)
        }
        child = json.nodes.items[child].next
    }
    return .invalid_clang_output
}

