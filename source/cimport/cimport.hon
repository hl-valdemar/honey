}
@hide:file
render_type proc(context @mut Context, spelling []u8, depth usize) []u8 ! Error {
    return try render_type_inner(context, spelling, depth, false)
}
@hide:file
render_type_inner proc(context @mut Context, spelling []u8, depth usize, indirect bool) []u8 ! Error {
