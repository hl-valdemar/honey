atomic_write proc(context @Context, path [;0]u8, text []u8) void ! Error {
    parts [2][]u8 :: [path, ".tmp-XXXXXX"]
    temporary_path :: try join(context.storage, parts[..])
    descriptor :: c.mkstemp(ptrcast!(constcast!(temporary_path).ptr))
    if (descriptor < 0) return .filesystem_failed
    defer _ = c.unlink(ptrcast!(temporary_path.ptr))
    file :: io.File{ io = context.runtime, handle = io.Handle{ file_desc = descriptor } }
    closing := false
    defer { if (!closing) io.close(file) catch |_| {} }
    try io.write_all(io.writer(file), text)
    if (c.fsync(descriptor) != 0) return .filesystem_failed
    closing = true
    try io.close(file)
    if (c.rename(ptrcast!(temporary_path.ptr), ptrcast!(path.ptr)) != 0) return .filesystem_failed
}
@hide:file
install proc(context @mut Context) void ! Error {
    storage :: context.storage
    root_parts [2][]u8 :: [context.options.project, "/ffi"]
    root :: try join(storage, root_parts[..])
    _ = try regular_or_missing(storage, root, true)
    try make_directory(storage, root)
    lock_parts [2][]u8 :: [root, "/.honey-cimport-lock"]
    lock :: try join(storage, lock_parts[..])
    if (c.mkdir(ptrcast!(lock.ptr), 448) != 0) {
        try report(context, lock, "generation is already in progress, or a previous process was interrupted; remove this empty lock directory only after checking no generator is running")
        return .filesystem_failed
    }
    defer _ = c.rmdir(ptrcast!(lock.ptr))
    package_parts [3][]u8 :: [root, "/", context.options.name]
    package :: try join(storage, package_parts[..])
    shared_parts [2][]u8 :: [root, "/__c_types"]
    shared :: try join(storage, shared_parts[..])
    _ = try regular_or_missing(storage, package, true)
    _ = try regular_or_missing(storage, shared, true)
    previous_package := try read_manifest(context, package)
    defer {
        if (previous_package) |saved| {
            previous := saved
            arraylist.deinit(&previous.nodes)
        }
    }
    previous_shared := try read_manifest(context, shared)
    defer {
        if (previous_shared) |saved| {
            previous := saved
            arraylist.deinit(&previous.nodes)
        }
    }
    if (previous_package) |previous| try preflight(context, package, &previous)
    else try preflight(context, package, null)
    if (previous_shared) |previous| try preflight(context, shared, &previous)
    else try preflight(context, shared, null)
    merged_common := arraylist.init(Entry, storage.allocator)
    defer arraylist.deinit(&merged_common)
    merged_symbols := arraylist.init(Entry, storage.allocator)
    defer arraylist.deinit(&merged_symbols)
    directory := try fs.open_directory(storage.allocator, root)
    defer fs.close_directory(&directory) catch |_| {}
    while (try fs.next(&directory)) |entry| {
        if (mem.eql(entry.name, context.options.name) or mem.eql(entry.name, "__c_types") or mem.eql(entry.name, ".honey-cimport-lock")) continue
        if (entry.kind != .directory and entry.kind != .unknown) continue
        other_parts [3][]u8 :: [root, "/", entry.name]
        other_path :: try join(storage, other_parts[..])
        if (try read_manifest(context, other_path)) |other_value| {
            other := other_value
            defer arraylist.deinit(&other.nodes)
            if (!mem.eql(json_text(&other, 1, "target"), context.options.target)) {
                try report(context, other_path, "binding target differs from this project's other generated C packages; use a separate project for another target")
                return .conflicting_declaration
            }
            try merge_manifest(context, &other, &merged_common, &merged_symbols)
        }
    }
    for (context.common.items) |entry| try entry_put(context, &merged_common, entry.key, entry.text)
    for (context.symbols.items) |entry| try entry_put(context, &merged_symbols, entry.key, entry.text)
    package_source :: try source_text(storage, context.bindings.items, false, context.namespace)
    shared_source :: try source_text(storage, merged_common.items, true, context.namespace)
    package_manifest :: try manifest(context, context.options.name, package_source, context.common.items, context.symbols.items)
    shared_manifest :: try manifest(context, "__c_types", shared_source, merged_common.items, merged_symbols.items)
    # All collisions, ownership and modification checks finish before the first output write.
    try make_directory(storage, package)
    try make_directory(storage, shared)
    shared_source_parts [2][]u8 :: [shared, "/bindings.hon"]
    try atomic_write(context, try join(storage, shared_source_parts[..]), shared_source)
    shared_manifest_parts [2][]u8 :: [shared, "/.honey-cimport"]
    try atomic_write(context, try join(storage, shared_manifest_parts[..]), shared_manifest)
    package_source_parts [2][]u8 :: [package, "/bindings.hon"]
    try atomic_write(context, try join(storage, package_source_parts[..]), package_source)
    package_manifest_parts [2][]u8 :: [package, "/.honey-cimport"]
    try atomic_write(context, try join(storage, package_manifest_parts[..]), package_manifest)
}
