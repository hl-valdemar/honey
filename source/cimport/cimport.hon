Buffer :: struct { bytes arraylist.ArrayList(u8) }
@hide:file
buffer_write proc(context ?@mut anyopaque, _ io.Handle, bytes []u8) usize ! io.WriteError {
    buffer @mut Buffer :: ptrcast!(context?)
    for (bytes) |byte| arraylist.append(&buffer.bytes, byte) catch |_| { return .write_failed }
    return bytes.len
}
@hide:file
decimal_float_literal proc(storage @mut Storage, text []u8) []u8 ! Error {
    exponent_at := find(text, "e")
    if (exponent_at == null) exponent_at = find(text, "E")
    if (exponent_at == null) {
        if (find(text, ".") != null) return text
        parts [2][]u8 :: [text, ".0"]
        return try join(storage, parts[..])
    }
    at :: exponent_at?
    mantissa :: text[..at]
    exponent_text := text[at + 1..]
    negative_exponent :: prefix(exponent_text, "-")
    if (negative_exponent or prefix(exponent_text, "+")) exponent_text = exponent_text[1..]
    magnitude :: strconv.parse_unsigned(exponent_text, 4096)
    if (magnitude == null) return .invalid_clang_output
    exponent := i64(magnitude?)
    if (negative_exponent) exponent = -exponent
    digits := arraylist.init(u8, storage.allocator)
    defer arraylist.deinit(&digits)
    decimal_position := i64(0)
    after_point := false
    negative :: prefix(mantissa, "-")
    first :: if (negative or prefix(mantissa, "+")) usize(1) else usize(0)
    for (mantissa[first..]) |byte| {
        if (byte == '.' and !after_point) {
            after_point = true
            continue
        }
        if (byte < '0' or byte > '9') return .invalid_clang_output
        try arraylist.append(&digits, byte)
        if (!after_point) decimal_position += 1
    }
    if (digits.items.len == 0) return .invalid_clang_output
    decimal_position += exponent
    output := arraylist.init(u8, storage.allocator)
    defer arraylist.deinit(&output)
    if (negative) try arraylist.append(&output, '-')
    # Honey decimal literals have no exponent spelling. Move the decimal point
    # without rounding the Clang/frontend-provided significant digits.
    if (decimal_position <= 0) {
        try arraylist.append(&output, '0')
        try arraylist.append(&output, '.')
        for (0..usize(-decimal_position)) |_| try arraylist.append(&output, '0')
        parts [1][]u8 :: [digits.items]
        try append_parts(&output, parts[..])
    } else {
        for (digits.items) |byte, index| {
            if (i64(index) == decimal_position) try arraylist.append(&output, '.')
            try arraylist.append(&output, byte)
        }
        if (decimal_position >= i64(digits.items.len)) {
            for (0..usize(decimal_position - i64(digits.items.len))) |_| try arraylist.append(&output, '0')
            try arraylist.append(&output, '.')
            try arraylist.append(&output, '0')
        }
    }
    return try retain_list(storage, &output)
}
