@hide:file
render_record_reference proc(context @mut Context, index usize, indirect bool) []u8 ! Error {
    if (!indirect and !mem.eql(json_text(context.json, context.declarations.items[index].node, "completeDefinition"), "true")) {
        try report(context, context.declarations.items[index].name, "incomplete C record cannot be passed or returned by value; use its pointer type")
        return .unsupported_declaration
    }
    return try require_record(context, index)
}
@hide:file
owned_record proc(context @Context, node usize) ?usize {
    json :: context.json
    type_node :: inner(json, node)
    tag :: property(json, type_node, "ownedTagDecl")
    if (!kind(json, tag, "RecordDecl")) return null
    id :: json_text(json, tag, "id")
    for (context.declarations.items) |declaration, index| {
        if (mem.eql(json_text(json, declaration.node, "id"), id)) {
            if (declaration.name.len != 0) return lookup_type(context, declaration.name, "RecordDecl")
            return index
        }
    }
    return null
}
@hide:file
render_signature proc(context @mut Context, result, arguments []u8, depth usize) []u8 ! Error {
    text []u8 := "c_func("
    remaining :: trim(arguments)
    if (remaining.len == 0) {
        try report(context, result, "C function without a prototype is unsupported; declare an explicit (void) parameter list")
        return .unsupported_declaration
    }
    if (!mem.eql(remaining, "void")) {
        start := usize(0)
        nesting := usize(0)
        count := usize(0)
        for (0..(remaining.len + 1)) |i| {
            if (i < remaining.len) {
                if (remaining[i] == '(' or remaining[i] == '[') nesting += 1
                else if (remaining[i] == ')' or remaining[i] == ']') {
                    if (nesting == 0) return .invalid_clang_output
                    nesting -= 1
                }
            }
            if (i != remaining.len and (remaining[i] != ',' or nesting != 0)) continue
            argument :: trim(remaining[start..i])
            separator []u8 :: if (count == 0) "" else ", "
            rendered_argument []u8 := "..."
            if (!mem.eql(argument, "...")) {
                argument_parts [2][]u8 :: ["_ ", try render_type(context, argument, depth + 1)]
                rendered_argument = try join(context.storage, argument_parts[..])
            }
            signature_parts [3][]u8 :: [text, separator, rendered_argument]
            text = try join(context.storage, signature_parts[..])
            count += 1
            start = i + 1
        }
    }
    result_parts [3][]u8 :: [text, ") ", try render_type(context, result, depth + 1)]
    return try join(context.storage, result_parts[..])
}
@hide:file
enum_underlying proc(context @mut Context, node usize) []u8 ! Error {
    json :: context.json
    fixed :: json_text(json, property(json, node, "fixedUnderlyingType"), "qualType")
    if (fixed.len != 0) return try render_type(context, fixed, 0)
    declaration_index := usize(0)
    for (context.declarations.items) |declaration, index| {
        if (declaration.node == node) {
            if (declaration.enum_type.len != 0) return declaration.enum_type
            declaration_index = index
        }
    }
    tag :: json_text(json, node, "name")
    spelling []u8 := ""
    if (tag.len != 0) {
        tag_parts [2][]u8 :: ["enum ", tag]
        spelling = try join(context.storage, tag_parts[..])
    }
    else {
        for (context.declarations.items) |declaration| {
            if (!kind(json, declaration.node, "TypedefDecl")) continue
            owned :: property(json, inner(json, declaration.node), "ownedTagDecl")
            if (mem.eql(json_text(json, owned, "id"), json_text(json, node, "id"))) spelling = declaration.name
        }
    }
    if (spelling.len == 0) return .unsupported_declaration
    # JSON's EnumDecl omits the implementation-chosen compatible integer type.
    # Ask the same Clang frontend through C11 generic selection instead of guessing.
    probe :: try temporary(context.storage)
    defer remove_temporary(probe)
    probe_parts [4][]u8 :: [context.unit_source,
        "\nenum { __honey_enum_type = _Generic((", spelling, ")0, signed char:1, unsigned char:2, short:3, unsigned short:4, int:5, unsigned int:6, long:7, unsigned long:8, long long:9, unsigned long long:10, default:0) };\n",
    ]
    text :: try join(context.storage, probe_parts[..])
    try write_text(context.runtime, probe.path, text)
    args := try clang_arguments(context.storage, context.options, probe.path)
    defer arraylist.deinit(&args)
    probe_arguments [3][;0]u8 :: ["-fsyntax-only", "-Xclang", "-ast-dump=json"]
    for (probe_arguments) |argument| try arraylist.append(&args, argument)
    output :: capture(context.storage, context.runtime, args.items) catch |err| {
        if (!context.options.all or err != .clang_failed) return err
        try report(context, tag, "incomplete or unsupported C enum type; see Clang diagnostic above")
        return .unsupported_declaration
    }
    parsed := try json_parse(context.storage, output)
    defer arraylist.deinit(&parsed.nodes)
    result []u8 := ""
    for (parsed.nodes.items) |_, parent| {
        if (!kind(&parsed, parent, "EnumConstantDecl") or !mem.eql(json_text(&parsed, parent, "name"), "__honey_enum_type")) continue
        parsed_code :: strconv.parse_unsigned(constant_value(&parsed, parent), 10)
        if (parsed_code == null) return .invalid_clang_output
        code :: parsed_code?
        names [11][]u8 :: ["", "c_schar", "c_uchar", "c_short", "c_ushort", "c_int", "c_uint", "c_long", "c_ulong", "c_longlong", "c_ulonglong"]
        result = names[usize(code)]
    }
    if (result.len == 0) return .unsupported_declaration
    context.declarations.items[declaration_index].enum_type = result
    return result
}
@hide:file
select_symbol proc(context @mut Context, name []u8) void ! Error {
    if (try macro_definition(context, name)) |definition| {
        try select_macro(context, name, definition)
        return
    }
    found := false
    for (context.declarations.items) |declaration, i| {
        if (!mem.eql(declaration.name, name)) continue
        context.declarations.items[i].required = true
        found = true
    }
    if (!found) {
        try report(context, name, "requested declaration or final preprocessor macro was not found")
        return .unsupported_declaration
    }
}
@hide:file
select_all proc(context @mut Context) void ! Error {
    args := try clang_arguments(context.storage, context.options, context.input)
    defer arraylist.deinit(&args)
    try arraylist.append(&args, "-E")
    try arraylist.append(&args, "-dD")
    preprocessed :: try capture(context.storage, context.runtime, args.items)
    macros := arraylist.init(Entry, context.storage.allocator)
    defer arraylist.deinit(&macros)
    file []u8 := ""
    start := usize(0)
    while (start < preprocessed.len) {
        end :: start + (find(preprocessed[start..], "\n") orelse preprocessed.len - start)
        line :: preprocessed[start..end]
        if (prefix(line, "# ") and find(line, "\"") != null) {
            opening :: find(line, "\"")?
            bytes := arraylist.init(u8, context.storage.allocator)
            defer arraylist.deinit(&bytes)
            cursor := opening + 1
            while (cursor < line.len and line[cursor] != '"') {
                if (line[cursor] == '\\') cursor += 1
                if (cursor == line.len) return .invalid_clang_output
                try arraylist.append(&bytes, line[cursor])
                cursor += 1
            }
            if (cursor == line.len) return .invalid_clang_output
            file = try retain_list(context.storage, &bytes)
            if (file.len != 0 and file[0] != '<') {
                canonical :: try fs.canonical(context.storage.allocator, file)
                defer mem.free(context.storage.allocator, canonical)
                parts [1][]u8 :: [canonical]
                file = try join(context.storage, parts[..])
            }
        } else if (prefix(line, "#define ") or prefix(line, "#undef ")) {
            defining :: prefix(line, "#define ")
            offset :: if (defining) usize(8) else usize(7)
            length := offset
            while (length < line.len and line[length] != ' ' and line[length] != '\t' and line[length] != '(') length += 1
            name :: line[offset..length]
            origin []u8 :: if (defining) file else ""
            found := false
            for (macros.items) |macro, index| {
                if (!mem.eql(macro.key, name)) continue
                macros.items[index].text = origin
                found = true
                break
            }
            if (!found) try arraylist.append(&macros, Entry{ key = name, text = origin })
        }
        start = end + 1
    }
    # Reserve the shared-module namespace before any declaration or macro is rendered.
    while true {
        collision := false
        for (context.declarations.items) |declaration| {
            if (mem.eql(declaration.name, context.namespace)) collision = true
        }
        for (macros.items) |macro| {
            if (selected_file(context, macro.text) and mem.eql(macro.key, context.namespace)) collision = true
        }
        if (!collision) break
        parts [2][]u8 :: [context.namespace, "_"]
        context.namespace = try join(context.storage, parts[..])
    }
    for (context.declarations.items) |declaration, index| {
        if (!declaration.exported or mem.eql(json_text(context.json, declaration.node, "isImplicit"), "true")) continue
        try select_all_item(context, index, declaration.name, "")
    }
    for (macros.items) |macro| {
        if (!selected_file(context, macro.text)) continue
        if (try macro_definition(context, macro.key)) |definition| try select_all_item(context, null, macro.key, definition)
    }
}
@hide:file
select_all_item proc(context @mut Context, index ?usize, name, definition []u8) void ! Error {
    # Each root owns its dependency closure. Failed roots cannot leave aliases,
    # upgraded common entries, or required/emitted flags in later roots.
    isolated := context^
    isolated.declarations = arraylist.init(context.storage.allocator)
    isolated.bindings = arraylist.init(context.storage.allocator)
    isolated.common = arraylist.init(context.storage.allocator)
    isolated.symbols = arraylist.init(context.storage.allocator)
    defer context_deinit(&isolated)
    try arraylist.reserve(&isolated.declarations, context.declarations.items.len)
    for (context.declarations.items) |declaration| try arraylist.append(&isolated.declarations, declaration)
    if (index) |root| isolated.declarations.items[root].required = true
    else {
        select_macro(&isolated, name, definition) catch |err| {
            if (err != .unsupported_declaration) return err
            try report(context, name, "skipping unsupported macro")
            return
        }
    }
    emit_pending(&isolated) catch |err| {
        if (err != .unsupported_declaration) return err
        display :: if (name.len == 0) "(anonymous declaration)" else name
        try report(context, display, "skipping unsupported declaration or required type")
        return
    }
    for (isolated.declarations.items) |declaration, declaration_index| {
        context.declarations.items[declaration_index].enum_type = declaration.enum_type
    }
    for (isolated.common.items) |entry| try entry_put(context, &context.common, entry.key, entry.text)
    for (isolated.bindings.items) |entry| try entry_put(context, &context.bindings, entry.key, entry.text)
    for (isolated.symbols.items) |entry| try entry_put(context, &context.symbols, entry.key, entry.text)
}
@hide:file
emit_pending proc(context @mut Context) void ! Error {
    while true {
        pending := false
        for (0..(context.declarations.items.len)) |index| {
            if (!context.declarations.items[index].required or context.declarations.items[index].emitted) continue
            context.declarations.items[index].emitted = true
            pending = true
            try emit_declaration(context, index)
        }
        if (!pending) break
    }
}
@hide:file
emit_declaration proc(context @mut Context, index usize) void ! Error {
    declaration :: context.declarations.items[index]
    json :: context.json
    node :: declaration.node
    name :: declaration.name
    if (kind(json, node, "RecordDecl")) {
        chosen := index
        if (name.len != 0) chosen = lookup_type(context, name, "RecordDecl")?
        if (chosen != index) {
            context.declarations.items[chosen].required = true
            return
        }
        canonical :: try record_name(context, index)
        context.shared = true
        defer context.shared = false
        record_parts [4][]u8 :: ["# C record identity: ", try json_quote(context.storage, declaration.identity), "\n", try render_record(context, node, canonical)]
        text :: try join(context.storage, record_parts[..])
        try entry_put(context, &context.common, canonical, text)
        if (name.len != 0) {
            public_name :: try record_public_name(context, index)
            explanation_parts [5][]u8 :: ["# C tag ", name, " is exported as ", public_name, " to avoid its ordinary C namespace.\n"]
            explanation []u8 :: if (mem.eql(public_name, name)) "" else try join(context.storage, explanation_parts[..])
            alias_parts [7][]u8 :: [explanation, try escaped(context.storage, public_name), " :: alias ", context.namespace, ".", canonical, "\n"]
            try entry_put(context, &context.bindings, public_name, try join(context.storage, alias_parts[..]))
        }
        return
    }
    if (kind(json, node, "TypedefDecl")) {
        context.defining_typedef = name
        defer context.defining_typedef = ""
        rendered :: try render_type_inner(context, name, 0, true)
        typedef_parts [4][]u8 :: [try escaped(context.storage, name), " :: alias ", rendered, "\n"]
        try entry_put(context, &context.bindings, name, try join(context.storage, typedef_parts[..]))
        return
    }
    if (kind(json, node, "EnumDecl")) {
        if (name.len != 0) {
            alias_parts [4][]u8 :: [try escaped(context.storage, name), " :: alias ", try enum_underlying(context, node), "\n"]
            try entry_put(context, &context.bindings, name, try join(context.storage, alias_parts[..]))
        }
        child := inner(json, node)
        while (child != 0) {
            if (kind(json, child, "EnumConstantDecl")) try emit_enum_constant(context, node, child)
            child = json.nodes.items[child].next
        }
        return
    }
    if (kind(json, node, "EnumConstantDecl")) {
        for (context.declarations.items) |parent| {
            if (!kind(json, parent.node, "EnumDecl")) continue
            child := inner(json, parent.node)
            while (child != 0) {
                if (child == node) {
                    try emit_enum_constant(context, parent.node, node)
                    return
                }
                child = json.nodes.items[child].next
            }
        }
        return .invalid_clang_output
    }
    if (kind(json, node, "FunctionDecl")) {
        if (mem.eql(json_text(json, node, "storageClass"), "static") or mem.eql(json_text(json, node, "inline"), "true")) {
            try report(context, name, "inline-only or internal-linkage function has no callable external symbol; no C bridge is generated")
            return .unsupported_declaration
        }
        child := inner(json, node)
        while (child != 0) {
            if (kind(json, child, "AsmLabelAttr") or kind(json, child, "MSABIAttr") or kind(json, child, "SysVABIAttr")) {
                try report(context, name, "custom symbol labels or calling conventions are unsupported")
                return .unsupported_declaration
            }
            child = json.nodes.items[child].next
        }
        signature :: try render_type(context, qual_type(json, node), 0)
        context.shared = true
        canonical_signature :: render_type(context, qual_type(json, node), 0) catch |err| {
            context.shared = false
            return err
        }
        context.shared = false
        try entry_put(context, &context.symbols, name, canonical_signature)
        function_parts [4][]u8 :: [try escaped(context.storage, name), " ", signature, "\n"]
        try entry_put(context, &context.bindings, name, try join(context.storage, function_parts[..]))
        return
    }
    if (kind(json, node, "VarDecl")) {
        definition := node
        if (json_text(json, definition, "init").len == 0) {
            definition = 0
            for (context.declarations.items) |candidate| {
                if (
                    kind(json, candidate.node, "VarDecl") and mem.eql(candidate.name, name)
                    and json_text(json, candidate.node, "init").len != 0
