        { key = "char", text = "c_char" }, { key = "signed char", text = "c_schar" }, { key = "unsigned char", text = "c_uchar" },
        { key = "short", text = "c_short" }, { key = "unsigned short", text = "c_ushort" },
        { key = "int", text = "c_int" }, { key = "unsigned int", text = "c_uint" },
        { key = "long", text = "c_long" }, { key = "unsigned long", text = "c_ulong" },
        { key = "long long", text = "c_longlong" }, { key = "unsigned long long", text = "c_ulonglong" },
        { key = "float", text = "c_float" }, { key = "double", text = "c_double" },
