            `    return lib.Box(saved)
            `}
            `main proc() i16 {
            `    value lib.types()[0] :: { value = 40 }
            `    if (lib.read(lib.make(), value) != 42) return -1
            `    box Storage() :: { values = [{ value = 19 }, { value = 21 }] }
            `    same lib.Box(lib.literal()) :: box
            `    return same.values[0].value + same.values[1].value + same.bias
            `}
            ,
        )
