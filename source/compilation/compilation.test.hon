            `lib :: import "../library"
            `Child :: struct { value bool }
            `Storage proc() type {
            `    saved :: $(lib.make())
            `    if (lib.Box(saved) != lib.Box(lib.make())) return bool
            `    if (lib.Box(saved) != lib.Box(lib.literal())) return bool
            `    if (lib.Box(saved) != lib.Box(lib.borrowed())) return bool
            `    Selected :: lib.types()[0]
