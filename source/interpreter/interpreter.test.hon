    module.entry = main
    try emit(&module, main, integer(0, 1))
    try emit(&module, main, ir.Instruction{ op = .store_local, slot = 0, left = ir.ValueId(0) })
    try emit(&module, main, integer(1, 42))
    try emit(&module, main, ir.Instruction{ op = .assign_local, slot = 0, left = ir.ValueId(1) })
    try emit(&module, main, ir.Instruction{ op = .load_local, type = .int, destination = ir.ValueId(2), slot = 0 })
    return_value(&module, main, ir.ValueId(2))
    outcome := try run(mem.c_allocator, &module, &store)
