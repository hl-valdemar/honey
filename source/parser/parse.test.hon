preserves_array_error_ids_control_bodies_and_following_siblings test {
    strings := strpool.init(mem.c_allocator)
    defer strpool.deinit(&strings)
    diagnostic_store := diagnostics.init(mem.c_allocator)
    defer diagnostics.deinit(&diagnostic_store)
    source ::
        `main proc() void {
        `    bad [~]i64 :: [~, 2]
        `    while (items[0) { break }
        `    for items[0 |i| { continue }
        `    unfinished :: [1,
        `    kept :: []
        `}
        `tail :: 4
    scan_state := lexer.init(mem.c_allocator)
    defer lexer.deinit(&scan_state)
    try lexer.scan(&scan_state, source, &strings, &diagnostic_store)
    try testing.expect_equal(2, diagnostics.count(&diagnostic_store))
    tree := try parse(mem.c_allocator, scan_state.tokens.items, source, &diagnostic_store)
    defer ast.deinit(&tree)
    try testing.expect_equal(2, ast.package_decl_count(&tree))
    body :: ast.function_decl(&tree, ast.package_decl(&tree, 0)).body
    try testing.expect_equal(5, ast.block_statement_count(&tree, body))
    bad :: ast.statement_decl(&tree, ast.block_statement(&tree, body, 0))
    count :: ast.array_type(&tree, bad.type?).count?
    element :: ast.array_element(&tree, bad.initializer, 0)
    try testing.expect_equal(diagnostics.DiagnosticId(0), ast.invalid(&tree, count).diagnostic)
    try testing.expect_equal(diagnostics.DiagnosticId(1), ast.invalid(&tree, element).diagnostic)
    while_loop :: ast.while_stmt(&tree, ast.block_statement(&tree, body, 1))
    try testing.expect_equal(ast.ExprKind.invalid, ast.expr_kind(&tree, while_loop.condition))
    try testing.expect_equal(ast.StmtKind.break_stmt, ast.stmt_kind(
        &tree, ast.block_statement(&tree, while_loop.body, 0),
    ))
    for_loop :: ast.for_stmt(&tree, ast.block_statement(&tree, body, 2))
    try testing.expect_equal(ast.ExprKind.invalid, ast.expr_kind(&tree, for_loop.iterable))
    try testing.expect_equal(ast.StmtKind.continue_stmt, ast.stmt_kind(
        &tree, ast.block_statement(&tree, for_loop.body, 0),
    ))
    unfinished :: ast.statement_decl(&tree, ast.block_statement(&tree, body, 3))
    try testing.expect_equal(ast.ExprKind.invalid, ast.expr_kind(&tree, unfinished.initializer))
    kept :: ast.statement_decl(&tree, ast.block_statement(&tree, body, 4))
    try testing.expect_equal("kept", ast.source_text(&tree, kept.name))
    try testing.expect_equal(0, ast.array_element_count(&tree, kept.initializer))
}

