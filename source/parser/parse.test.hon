    try lexer.scan(&scan_state, source, &strings, &diagnostic_store)
    tree := try parse(mem.c_allocator, scan_state.tokens.items, source, &diagnostic_store)
    defer ast.deinit(&tree)
    try testing.expect_equal(4, ast.package_decl_count(&tree))
    try testing.expect_equal(3, diagnostics.count(&diagnostic_store))
    for (usize(0)..usize(3)) |index| {
        declaration :: ast.package_decl(&tree, index)
        try testing.expect_equal(ast.DeclKind.invalid, ast.decl_kind(&tree, declaration))
        diagnostic :: diagnostics.get(&diagnostic_store, ast.invalid(&tree, declaration).diagnostic)?
        try testing.expect_equal(diagnostics.Code.invalid_import_path, diagnostic.code)
    }
    kept :: ast.statement_decl(&tree, ast.package_decl(&tree, 3))
    try testing.expect_equal("kept", ast.source_text(&tree, kept.name))
}

@hide:file
AllocationBudget :: struct { remaining usize }

@hide:file
budget_alloc proc(context ?@mut anyopaque, size usize, alignment usize) ?*mut u8 {
    budget @mut AllocationBudget :: ptrcast!(context?)
    if (budget.remaining == 0) return null
    budget.remaining -= 1
    return mem.raw_alloc(mem.c_allocator, size, alignment)
}

@hide:file
budget_realloc proc(
    context ?@mut anyopaque, memory ?*mut u8, old_size, new_size, alignment usize,
) ?*mut u8 {
    budget @mut AllocationBudget :: ptrcast!(context?)
    if (budget.remaining == 0) return null
    budget.remaining -= 1
    return mem.raw_realloc(mem.c_allocator, memory, old_size, new_size, alignment)
}

@hide:file
budget_free proc(context ?@mut anyopaque, memory ?*mut u8, size, alignment usize) void {
    _ = context
    mem.raw_free(mem.c_allocator, memory, size, alignment)
}

@hide:file
budget_vtable :: mem.AllocatorVTable{ alloc = budget_alloc, realloc = budget_realloc, free = budget_free }

rolls_back_shared_nodes_extra_spans_and_diagnostics_on_allocation_failure test {
    failures := 0
    for (usize(0)..usize(16)) |remaining| {
        strings := strpool.init(mem.c_allocator)
        defer strpool.deinit(&strings)
        diagnostic_store := diagnostics.init(mem.c_allocator)
        defer diagnostics.deinit(&diagnostic_store)
        budget := AllocationBudget{ remaining = maxval!(usize) }
        allocator :: mem.Allocator{ context = &budget, vtable = &budget_vtable }
        builder := ast.init_builder(allocator, "")
        defer ast.deinit_builder(&builder)
        first_text :: "value :: 1\n"
        first_source :: try ast.set_source(&builder, "first.hon", first_text)
        first_scan := lexer.init(mem.c_allocator)
        defer lexer.deinit(&first_scan)
        first_scan.source_id = first_source
        try lexer.scan(&first_scan, first_text, &strings, &diagnostic_store)
        first_root :: try parse_source(&builder, first_scan.tokens.items, &diagnostic_store)
        node_count :: builder.storage.nodes.items.len
        extra_count :: builder.storage.extra.items.len
        second_text :: "another :: [1, 2, 3]\n@ broken\nlast :: 4\n"
        second_source :: try ast.set_source(&builder, "second.hon", second_text)
        second_scan := lexer.init(mem.c_allocator)
        defer lexer.deinit(&second_scan)
        second_scan.source_id = second_source
        try lexer.scan(&second_scan, second_text, &strings, &diagnostic_store)
        budget.remaining = remaining
        _ = parse_source(&builder, second_scan.tokens.items, &diagnostic_store) catch |error| {
            try testing.expect(error == .out_of_memory)
            failures += 1
            try testing.expect_equal(node_count, builder.storage.nodes.items.len)
            try testing.expect_equal(node_count, builder.storage.spans.items.len)
            try testing.expect_equal(extra_count, builder.storage.extra.items.len)
            try testing.expect_equal(0, diagnostics.count(&diagnostic_store))
            ast.remove_source(&builder)
            tree :: ast.view(&builder, first_root)
            declaration :: ast.statement_decl(&tree, ast.package_decl(&tree, 0))
            try testing.expect_equal("value", ast.source_text(&tree, declaration.name))
            try testing.expect_equal(1, ast.source_files(&tree).len)
            try testing.expect_equal(first_source, builder.source_id)
            continue
        }
    }
    try testing.expect(failures > 0)
}

parses_enum_union_wrappers_and_keyword_variants test {
    strings := strpool.init(mem.c_allocator)
    defer strpool.deinit(&strings)
    diagnostic_store := diagnostics.init(mem.c_allocator)
    defer diagnostics.deinit(&diagnostic_store)
    source ::
        `Tag :: enum(i32) { if = -2, else = 3 # preserve the member boundary
        `    return
        `}
        `Payload :: union(Tag) { if i32, else void, return struct { value i32 } }
        `Auto :: union(enum) { value i32, empty void }
        `Raw :: union { integer i32, real f64 }
        `Id :: distinct i32
        `Other :: alias Id
        `value Payload :: Payload{ if = 4 }
        `context Payload :: .return{value = 5}
        `empty Payload :: .else
    scan_state := lexer.init(mem.c_allocator)
    defer lexer.deinit(&scan_state)
    try lexer.scan(&scan_state, source, &strings, &diagnostic_store)
    tree := try parse(mem.c_allocator, scan_state.tokens.items, source, &diagnostic_store)
    defer ast.deinit(&tree)
    try testing.expect_equal(0, diagnostics.count(&diagnostic_store))
    try testing.expect_equal(9, ast.package_decl_count(&tree))
    enumeration :: ast.statement_decl(&tree, ast.package_decl(&tree, 0)).initializer
    try testing.expect(ast.enum_type(&tree, enumeration).backing != null)
    try testing.expect_equal(3, ast.enum_member_count(&tree, enumeration))
    member :: ast.field(&tree, ast.enum_member(&tree, enumeration, 0))
    try testing.expect_equal("if", strpool.get_str(&strings, ast.name_id(&tree, member.name?))?)
    try testing.expect_equal(ast.ExprKind.unary, ast.expr_kind(&tree, member.value?))
    tagged :: ast.statement_decl(&tree, ast.package_decl(&tree, 1)).initializer
    automatic :: ast.statement_decl(&tree, ast.package_decl(&tree, 2)).initializer
    raw :: ast.statement_decl(&tree, ast.package_decl(&tree, 3)).initializer
    try testing.expect(ast.union_type(&tree, tagged).tag != null)
    try testing.expect(ast.union_type(&tree, automatic).auto_tag)
    try testing.expect(!ast.union_type(&tree, raw).auto_tag)
    try testing.expect_equal(2, ast.record_field_count(&tree, raw))
    distinct_type :: ast.statement_decl(&tree, ast.package_decl(&tree, 4)).initializer
    alias_value :: ast.statement_decl(&tree, ast.package_decl(&tree, 5)).initializer
    try testing.expect_equal(ast.ExprKind.distinct_type, ast.expr_kind(&tree, distinct_type))
    try testing.expect_equal(ast.ExprKind.alias_expr, ast.expr_kind(&tree, alias_value))
    contextual :: ast.statement_decl(&tree, ast.package_decl(&tree, 7)).initializer
    variant :: ast.record_literal(&tree, contextual).type?
    try testing.expect_equal(ast.ExprKind.enum_literal, ast.expr_kind(&tree, variant))
    try testing.expect_equal("return", strpool.get_str(&strings, ast.name_id(&tree, ast.enum_literal(&tree, variant)))?)
}

parses_match_patterns_payload_captures_and_statement_arms test {
    strings := strpool.init(mem.c_allocator)
    defer strpool.deinit(&strings)
    diagnostic_store := diagnostics.init(mem.c_allocator)
    defer diagnostics.deinit(&diagnostic_store)
    source ::
        `choose proc(value int) int {
        `    return match value {
        `        0, 1..=3: 10,
        `        4: 20 # preserve the arm boundary
        `        else: 30
        `    }
        `}
        `use proc(value int) void {
        `    match value {
        `        .if, .return |payload|: { local :: payload }
        `        .else: return,
        `        else: {}
        `    }
        `}
    scan_state := lexer.init(mem.c_allocator)
    defer lexer.deinit(&scan_state)
    try lexer.scan(&scan_state, source, &strings, &diagnostic_store)
    tree := try parse(mem.c_allocator, scan_state.tokens.items, source, &diagnostic_store)
    defer ast.deinit(&tree)
    try testing.expect_equal(0, diagnostics.count(&diagnostic_store))
    choose :: ast.function_decl(&tree, ast.package_decl(&tree, 0))
    value_match :: ast.return_stmt(&tree, ast.block_statement(&tree, choose.body, 0)).value?
    try testing.expect_equal(3, ast.match_arm_count(&tree, value_match))
    first :: ast.match_arm(&tree, value_match, 0)
    try testing.expect_equal(2, ast.match_pattern_count(&tree, first))
    try testing.expect_equal(ast.ExprKind.range, ast.expr_kind(&tree, ast.match_pattern(&tree, first, 1)))
    try testing.expect(ast.match_arm_view(&tree, first).expression)
    use :: ast.function_decl(&tree, ast.package_decl(&tree, 1))
    statement_match :: ast.statement_expr(&tree, ast.block_statement(&tree, use.body, 0))
    captured :: ast.match_arm_view(&tree, ast.match_arm(&tree, statement_match, 0))
    try testing.expect(captured.capture != null)
    try testing.expect(!captured.expression)
    try testing.expect(ast.match_arm_view(&tree, ast.match_arm(&tree, statement_match, 2)).catch_all)
}

rejects_pointer_match_captures_and_preserves_siblings test {
    strings := strpool.init(mem.c_allocator)
    defer strpool.deinit(&strings)
    diagnostic_store := diagnostics.init(mem.c_allocator)
    defer diagnostics.deinit(&diagnostic_store)
    source ::
        `broken :: enum { first
        `after :: 1
        `use proc(value int) void {
        `    match value {
        `        .item |@payload|: payload
        `        else: {}
        `    }
        `}
        `last :: 2
    scan_state := lexer.init(mem.c_allocator)
    defer lexer.deinit(&scan_state)
    try lexer.scan(&scan_state, source, &strings, &diagnostic_store)
    tree := try parse(mem.c_allocator, scan_state.tokens.items, source, &diagnostic_store)
    defer ast.deinit(&tree)
    try testing.expect(diagnostics.count(&diagnostic_store) > 0)
    try testing.expect_equal(4, ast.package_decl_count(&tree))
    try testing.expect_equal("after", ast.source_text(&tree, ast.statement_decl(&tree, ast.package_decl(&tree, 1)).name))
    try testing.expect_equal("last", ast.source_text(&tree, ast.statement_decl(&tree, ast.package_decl(&tree, 3)).name))
}
