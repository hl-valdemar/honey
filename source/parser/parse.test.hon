recovers_conditional_conditions_and_arms_without_losing_siblings test {
    strings := strpool.init(mem.c_allocator)
    defer strpool.deinit(&strings)
    diagnostic_store := diagnostics.init(mem.c_allocator)
    defer diagnostics.deinit(&diagnostic_store)
    source ::
        `main proc() void {
        `    if { good() } else { other() }
        `    if (true) else return
        `    if broken( { kept() }
        `    after :: 7
        `    return 1 else return 2
        `    final :: 8
        `}
        `tail :: 9
    scan_state := lexer.init(mem.c_allocator)
    defer lexer.deinit(&scan_state)
    try lexer.scan(&scan_state, source, &strings, &diagnostic_store)
    tree := try parse(mem.c_allocator, scan_state.tokens.items, source, &diagnostic_store)
    defer ast.deinit(&tree)
    try testing.expect_equal(2, ast.package_decl_count(&tree))
    body :: ast.function_decl(&tree, ast.package_decl(&tree, 0)).body
    try testing.expect_equal(6, ast.block_statement_count(&tree, body))
    first :: ast.if_stmt(&tree, ast.block_statement(&tree, body, 0))
    try testing.expect_equal(ast.ExprKind.invalid, ast.expr_kind(&tree, first.condition))
    condition_diagnostic :: diagnostics.get(&diagnostic_store, ast.invalid(&tree, first.condition).diagnostic)?
    try testing.expect_equal("{", ast.source_text(&tree, condition_diagnostic.span))
    try testing.expect_equal(1, ast.block_statement_count(&tree, first.then_block))
    second :: ast.if_stmt(&tree, ast.block_statement(&tree, body, 1))
    bad_arm :: ast.block_statement(&tree, second.then_block, 0)
    try testing.expect_equal(ast.StmtKind.invalid, ast.stmt_kind(&tree, bad_arm))
    arm_diagnostic :: diagnostics.get(&diagnostic_store, ast.invalid(&tree, bad_arm).diagnostic)?
    try testing.expect_equal("else", ast.source_text(&tree, arm_diagnostic.span))
    try testing.expect(second.else_block != null)
    third :: ast.if_stmt(&tree, ast.block_statement(&tree, body, 2))
    try testing.expect_equal(1, ast.block_statement_count(&tree, third.then_block))
    after :: ast.statement_decl(&tree, ast.block_statement(&tree, body, 3))
    try testing.expect_equal("after", ast.source_text(&tree, after.name))
    try testing.expect_equal(ast.StmtKind.invalid, ast.stmt_kind(&tree, ast.block_statement(&tree, body, 4)))
    final :: ast.statement_decl(&tree, ast.block_statement(&tree, body, 5))
    try testing.expect_equal("final", ast.source_text(&tree, final.name))
    try testing.expect_equal(4, diagnostics.count(&diagnostic_store))
}

