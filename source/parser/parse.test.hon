    strings := strpool.init(mem.c_allocator)
    defer strpool.deinit(&strings)
    diagnostic_store := diagnostics.init(mem.c_allocator)
    defer diagnostics.deinit(&diagnostic_store)
    source :: "value :: !-!probe()\nother :: -!false\n"
    scan_state := lexer.init(mem.c_allocator)
    defer lexer.deinit(&scan_state)
    try lexer.scan(&scan_state, source, &strings, &diagnostic_store)
    tree := try parse(mem.c_allocator, scan_state.tokens.items, source, &diagnostic_store)
    defer ast.deinit(&tree)

    try testing.expect_equal(0, diagnostics.count(&diagnostic_store))
    value :: ast.statement_decl(&tree, ast.package_decl(&tree, 0))
    first :: ast.unary_expr(&tree, value.initializer)
    second :: ast.unary_expr(&tree, first.operand)
    third :: ast.unary_expr(&tree, second.operand)
    try testing.expect_equal(ast.UnaryOperator.logical_not, first.operator)
    try testing.expect_equal(ast.UnaryOperator.negate, second.operator)
    try testing.expect_equal(ast.UnaryOperator.logical_not, third.operator)
    try testing.expect_equal(ast.ExprKind.call, ast.expr_kind(&tree, third.operand))
    try testing.expect_equal("!-!probe()", ast.source_text(&tree, first.span))
    try testing.expect_equal("-!probe()", ast.source_text(&tree, second.span))
    other :: ast.statement_decl(&tree, ast.package_decl(&tree, 1))
    negate :: ast.unary_expr(&tree, other.initializer)
    try testing.expect_equal(ast.UnaryOperator.negate, negate.operator)
    try testing.expect_equal(ast.UnaryOperator.logical_not, ast.unary_expr(&tree, negate.operand).operator)
}

parses_logical_expressions_in_all_expression_positions test {
    strings := strpool.init(mem.c_allocator)
    defer strpool.deinit(&strings)
    diagnostic_store := diagnostics.init(mem.c_allocator)
    defer diagnostics.deinit(&diagnostic_store)
    source ::
        `global :: (
        `    false
        `    and absent
        `)
        `main proc() bool {
        `    value := (
        `        true
        `        or absent
        `    )
        `    value = (
        `        !
        `        value
        `        and ready(
        `        )
        `    )
        `    !value
        `    if (
        `        !value
        `        or ready()
        `    ) { value = false }
        `    while (
        `        value
        `        and !done()
        `    ) { value = false }
        `    return (
        `        choose(
        `            (
        `                value
        `                or false
        `            ),
        `            nested(
        `                !value
        `                and true
        `            ),
        `        )
        `    )
        `}
    scan_state := lexer.init(mem.c_allocator)
    defer lexer.deinit(&scan_state)
    try lexer.scan(&scan_state, source, &strings, &diagnostic_store)
    tree := try parse(mem.c_allocator, scan_state.tokens.items, source, &diagnostic_store)
    defer ast.deinit(&tree)

    try testing.expect_equal(0, diagnostics.count(&diagnostic_store))
    global :: ast.statement_decl(&tree, ast.package_decl(&tree, 0))
    global_and :: ast.binary_expr(&tree, global.initializer)
    try testing.expect_equal(ast.BinaryOperator.logical_and, global_and.operator)
    try testing.expect_equal("absent", ast.source_text(&tree, ast.node_span(&tree, global_and.right)))
    function :: ast.function_decl(&tree, ast.package_decl(&tree, 1))
    try testing.expect_equal(6, ast.block_statement_count(&tree, function.body))
    local :: ast.statement_decl(&tree, ast.block_statement(&tree, function.body, 0))
    try testing.expect_equal(ast.BinaryOperator.logical_or, ast.binary_expr(&tree, local.initializer).operator)
    assignment :: ast.assignment_stmt(&tree, ast.block_statement(&tree, function.body, 1))
    try testing.expect_equal(ast.BinaryOperator.logical_and, ast.binary_expr(&tree, assignment.value).operator)
    expression :: ast.statement_expr(&tree, ast.block_statement(&tree, function.body, 2))
    try testing.expect_equal(ast.UnaryOperator.logical_not, ast.unary_expr(&tree, expression).operator)
    conditional :: ast.if_stmt(&tree, ast.block_statement(&tree, function.body, 3))
    try testing.expect_equal(ast.BinaryOperator.logical_or, ast.binary_expr(&tree, conditional.condition).operator)
    loop :: ast.while_stmt(&tree, ast.block_statement(&tree, function.body, 4))
    try testing.expect_equal(ast.BinaryOperator.logical_and, ast.binary_expr(&tree, loop.condition).operator)
    returned :: ast.return_stmt(&tree, ast.block_statement(&tree, function.body, 5)).value?
    try testing.expect_equal(2, ast.call_arg_count(&tree, returned))
    first_argument :: ast.call_arg(&tree, returned, 0)
    try testing.expect_equal(ast.BinaryOperator.logical_or, ast.binary_expr(&tree, first_argument).operator)
    nested :: ast.call_arg(&tree, returned, 1)
    nested_argument :: ast.call_arg(&tree, nested, 0)
    try testing.expect_equal(ast.BinaryOperator.logical_and, ast.binary_expr(&tree, nested_argument).operator)
}

multiline_group_errors_preserve_statement_boundaries test {
