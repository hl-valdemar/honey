    body :: ast.function_decl(&tree, ast.package_decl(&tree, 0)).body
    outer :: ast.if_stmt(&tree, ast.block_statement(&tree, body, 0))
    try testing.expect(outer.else_block == null)
    loop :: ast.for_stmt(&tree, ast.block_statement(&tree, outer.then_block, 0))
    nested :: ast.if_stmt(&tree, ast.block_statement(&tree, loop.body, 0))
    try testing.expect(nested.else_block != null)
