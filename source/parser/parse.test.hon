parses_logical_precedence_and_associativity test {
    strings := strpool.init(mem.c_allocator)
    defer strpool.deinit(&strings)
    diagnostic_store := diagnostics.init(mem.c_allocator)
    defer diagnostics.deinit(&diagnostic_store)
    source :: "value :: !probe() == a + b * c < d and e and f or g or h\n"
    scan_state := lexer.init(mem.c_allocator)
    defer lexer.deinit(&scan_state)
    try lexer.scan(&scan_state, source, &strings, &diagnostic_store)
    tree := try parse(mem.c_allocator, scan_state.tokens.items, source, &diagnostic_store)
    defer ast.deinit(&tree)

    try testing.expect_equal(0, diagnostics.count(&diagnostic_store))
    value :: ast.statement_decl(&tree, ast.package_decl(&tree, 0))
    outer_or :: ast.binary_expr(&tree, value.initializer)
    try testing.expect_equal(ast.BinaryOperator.logical_or, outer_or.operator)
    try testing.expect_equal("h", ast.source_text(&tree, ast.node_span(&tree, outer_or.right)))
    inner_or :: ast.binary_expr(&tree, outer_or.left)
    try testing.expect_equal(ast.BinaryOperator.logical_or, inner_or.operator)
    outer_and :: ast.binary_expr(&tree, inner_or.left)
    try testing.expect_equal(ast.BinaryOperator.logical_and, outer_and.operator)
    try testing.expect_equal("f", ast.source_text(&tree, ast.node_span(&tree, outer_and.right)))
    inner_and :: ast.binary_expr(&tree, outer_and.left)
    try testing.expect_equal(ast.BinaryOperator.logical_and, inner_and.operator)
    equality :: ast.binary_expr(&tree, inner_and.left)
    try testing.expect_equal(ast.BinaryOperator.equal, equality.operator)
    logical_not :: ast.unary_expr(&tree, equality.left)
    try testing.expect_equal(ast.UnaryOperator.logical_not, logical_not.operator)
    try testing.expect_equal(ast.ExprKind.call, ast.expr_kind(&tree, logical_not.operand))
    try testing.expect_equal("!probe()", ast.source_text(&tree, logical_not.span))
    comparison :: ast.binary_expr(&tree, equality.right)
    try testing.expect_equal(ast.BinaryOperator.less, comparison.operator)
    addition :: ast.binary_expr(&tree, comparison.left)
    try testing.expect_equal(ast.BinaryOperator.add, addition.operator)
    multiply :: ast.binary_expr(&tree, addition.right)
    try testing.expect_equal(ast.BinaryOperator.multiply, multiply.operator)
}

