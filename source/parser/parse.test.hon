    try testing.expect_equal(1, ast.block_statement_count(&tree, call_loop.body))
}

parses_recursive_array_annotations_literals_and_grouped_parameters test {
    strings := strpool.init(mem.c_allocator)
    defer strpool.deinit(&strings)
    diagnostic_store := diagnostics.init(mem.c_allocator)
    defer diagnostics.deinit(&diagnostic_store)
    source ::
        `matrix [2]mut [width]mut i64 := [
        `    [1, 2,],
        `    [3, 4],
        `]
        `inferred [_]f64 :: [1.0,]
        `empty :: []
        `width usize :: 2
        `choose proc(a, b [width]mut [2]i64, index usize) [_]f64 {
        `    return []
        `}
    scan_state := lexer.init(mem.c_allocator)
    defer lexer.deinit(&scan_state)
    try lexer.scan(&scan_state, source, &strings, &diagnostic_store)
    tree := try parse(mem.c_allocator, scan_state.tokens.items, source, &diagnostic_store)
    defer ast.deinit(&tree)
    try testing.expect_equal(0, diagnostics.count(&diagnostic_store))
    try testing.expect_equal(5, ast.package_decl_count(&tree))
    declaration :: ast.statement_decl(&tree, ast.package_decl(&tree, 0))
    outer :: ast.array_type(&tree, declaration.type?)
    try testing.expect(outer.mutable)
    try testing.expect_equal(ast.ExprKind.literal_int, ast.expr_kind(&tree, outer.count?))
    inner :: ast.array_type(&tree, outer.element)
    try testing.expect(inner.mutable)
    try testing.expect_equal(ast.ExprKind.identifier, ast.expr_kind(&tree, inner.count?))
    try testing.expect_equal("i64", ast.source_text(&tree, ast.node_span(&tree, inner.element)))
    try testing.expect_equal(
        ast.name_id(&tree, ast.package_decl(&tree, 3)), ast.name_id(&tree, inner.count?),
    )
    try testing.expect_equal("i64", strpool.get_str(&strings, ast.name_id(&tree, inner.element))?)
    try testing.expect_equal(2, ast.array_element_count(&tree, declaration.initializer))
    for (0..ast.array_element_count(&tree, declaration.initializer)) |i| {
        try testing.expect_equal(2, ast.array_element_count(
            &tree, ast.array_element(&tree, declaration.initializer, i),
        ))
    }
    inferred :: ast.statement_decl(&tree, ast.package_decl(&tree, 1))
    try testing.expect_equal(null, ast.array_type(&tree, inferred.type?).count)
    try testing.expect_equal(1, ast.array_element_count(&tree, inferred.initializer))
    empty :: ast.statement_decl(&tree, ast.package_decl(&tree, 2))
    try testing.expect_equal(0, ast.array_element_count(&tree, empty.initializer))
    function :: ast.package_decl(&tree, 4)
    try testing.expect_equal(3, ast.function_param_count(&tree, function))
    first :: ast.param(&tree, ast.function_param(&tree, function, 0))
    second :: ast.param(&tree, ast.function_param(&tree, function, 1))
    try testing.expect_equal(first.type, second.type)
    try testing.expect_equal(ast.ExprKind.array_type, ast.expr_kind(&tree, first.type))
    try testing.expect_equal(null, ast.array_type(&tree, ast.function_decl(&tree, function).return_type).count)
}

parses_postfix_indices_and_general_assignment_targets test {
    strings := strpool.init(mem.c_allocator)
    defer strpool.deinit(&strings)
    diagnostic_store := diagnostics.init(mem.c_allocator)
    defer diagnostics.deinit(&diagnostic_store)
    source ::
        `value :: -factory()[position()][0] + ([1, 2])[0]
        `main proc() void {
        `    (matrix[1])[0] = rhs()[0]
        `    (matrix) = [[1]]
        `    1 = 2
        `}
    scan_state := lexer.init(mem.c_allocator)
    defer lexer.deinit(&scan_state)
    try lexer.scan(&scan_state, source, &strings, &diagnostic_store)
    tree := try parse(mem.c_allocator, scan_state.tokens.items, source, &diagnostic_store)
    defer ast.deinit(&tree)
    try testing.expect_equal(0, diagnostics.count(&diagnostic_store))
    expression :: ast.statement_decl(&tree, ast.package_decl(&tree, 0)).initializer
    add :: ast.binary_expr(&tree, expression)
    negative :: ast.unary_expr(&tree, add.left)
    outer :: ast.index_expr(&tree, negative.operand)
    inner :: ast.index_expr(&tree, outer.base)
    try testing.expect_equal(ast.ExprKind.call, ast.expr_kind(&tree, inner.base))
    try testing.expect_equal(ast.ExprKind.call, ast.expr_kind(&tree, inner.index))
    try testing.expect_equal(ast.ExprKind.literal_int, ast.expr_kind(&tree, outer.index))
    literal_index :: ast.index_expr(&tree, add.right)
    try testing.expect_equal(ast.ExprKind.array_literal, ast.expr_kind(&tree, literal_index.base))
    body :: ast.function_decl(&tree, ast.package_decl(&tree, 1)).body
    try testing.expect_equal(3, ast.block_statement_count(&tree, body))
    assignment :: ast.assignment_stmt(&tree, ast.block_statement(&tree, body, 0))
    target :: ast.index_expr(&tree, assignment.target)
    try testing.expect_equal(ast.ExprKind.index, ast.expr_kind(&tree, target.base))
    try testing.expect_equal(ast.ExprKind.index, ast.expr_kind(&tree, assignment.value))
    grouped :: ast.assignment_stmt(&tree, ast.block_statement(&tree, body, 1))
    try testing.expect_equal(ast.ExprKind.identifier, ast.expr_kind(&tree, grouped.target))
    invalid_target :: ast.assignment_stmt(&tree, ast.block_statement(&tree, body, 2))
    try testing.expect_equal(ast.ExprKind.literal_int, ast.expr_kind(&tree, invalid_target.target))
}

