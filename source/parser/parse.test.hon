import "@std/mem"
import "@std/testing"
import "@std/arraylist"

import "@source/diagnostics"
import "@source/strpool"
import "@source/lexer"
import "@source/ast"

parses_expression_precedence_through_tree_views test {
    strings := strpool.init(mem.c_allocator)
    defer strpool.deinit(&strings)
    diagnostic_store := diagnostics.init(mem.c_allocator)
    defer diagnostics.deinit(&diagnostic_store)
    source :: "value :: 1 + 2 * 3\n"
    scan_state := lexer.init(mem.c_allocator)
    defer lexer.deinit(&scan_state)
    try lexer.scan(&scan_state, source, &strings, &diagnostic_store)

    tree := try parse(mem.c_allocator, scan_state.tokens.items, source, &diagnostic_store)
    defer ast.deinit(&tree)

    try testing.expect_equal(1, ast.package_decl_count(&tree))
    declaration :: ast.package_decl(&tree, 0)
    statement :: ast.statement_decl(&tree, declaration)
    try testing.expect_equal("value", ast.source_text(&tree, statement.name))
    try testing.expect_equal("value", strpool.get_str(&strings, ast.name_id(&tree, declaration))?)
    try testing.expect_equal(ast.ExprKind.binary, ast.expr_kind(&tree, statement.initializer))
    add :: ast.binary_expr(&tree, statement.initializer)
    try testing.expect_equal(ast.BinaryOperator.add, add.operator)
    try testing.expect_equal(ast.ExprKind.literal_int, ast.expr_kind(&tree, add.left))
    try testing.expect_equal(ast.ExprKind.binary, ast.expr_kind(&tree, add.right))
    multiply :: ast.binary_expr(&tree, add.right)
    try testing.expect_equal(ast.BinaryOperator.multiply, multiply.operator)
    try testing.expect_equal(0, diagnostics.count(&diagnostic_store))
}

parses_grouped_expression_precedence test {
    strings := strpool.init(mem.c_allocator)
    defer strpool.deinit(&strings)
    diagnostic_store := diagnostics.init(mem.c_allocator)
    defer diagnostics.deinit(&diagnostic_store)
    source :: "value :: a + ((b - c)) * 2 / 3\n"
    scan_state := lexer.init(mem.c_allocator)
    defer lexer.deinit(&scan_state)
    try lexer.scan(&scan_state, source, &strings, &diagnostic_store)

    tree := try parse(mem.c_allocator, scan_state.tokens.items, source, &diagnostic_store)
    defer ast.deinit(&tree)

    try testing.expect_equal(0, diagnostics.count(&diagnostic_store))
    try testing.expect_equal(1, ast.package_decl_count(&tree))
    statement :: ast.statement_decl(&tree, ast.package_decl(&tree, 0))
    add :: ast.binary_expr(&tree, statement.initializer)
    try testing.expect_equal(ast.BinaryOperator.add, add.operator)
    try testing.expect_equal("a", ast.source_text(&tree, ast.node_span(&tree, add.left)))
    divide :: ast.binary_expr(&tree, add.right)
    try testing.expect_equal(ast.BinaryOperator.divide, divide.operator)
    try testing.expect_equal("3", ast.source_text(&tree, ast.node_span(&tree, divide.right)))
    multiply :: ast.binary_expr(&tree, divide.left)
    try testing.expect_equal(ast.BinaryOperator.multiply, multiply.operator)
    try testing.expect_equal("2", ast.source_text(&tree, ast.node_span(&tree, multiply.right)))
    subtract :: ast.binary_expr(&tree, multiply.left)
    try testing.expect_equal(ast.BinaryOperator.subtract, subtract.operator)
    try testing.expect_equal("b", ast.source_text(&tree, ast.node_span(&tree, subtract.left)))
    try testing.expect_equal("c", ast.source_text(&tree, ast.node_span(&tree, subtract.right)))
}

parses_function_structure_through_tree_views test {
    strings := strpool.init(mem.c_allocator)
    defer strpool.deinit(&strings)
    diagnostic_store := diagnostics.init(mem.c_allocator)
    defer diagnostics.deinit(&diagnostic_store)
    source ::
        `grouped proc(a, b T, c U) void {
        `    value int :: 1
        `}
    scan_state := lexer.init(mem.c_allocator)
    defer lexer.deinit(&scan_state)
    try lexer.scan(&scan_state, source, &strings, &diagnostic_store)

    tree := try parse(mem.c_allocator, scan_state.tokens.items, source, &diagnostic_store)
    defer ast.deinit(&tree)

    declaration :: ast.package_decl(&tree, 0)
    try testing.expect_equal(ast.DeclKind.function, ast.decl_kind(&tree, declaration))
    function :: ast.function_decl(&tree, declaration)
    try testing.expect_equal("grouped", ast.source_text(&tree, function.name))
    try testing.expect_equal("grouped", strpool.get_str(&strings, ast.name_id(&tree, declaration))?)
    try testing.expect_equal(3, ast.function_param_count(&tree, declaration))
    first :: ast.param(&tree, ast.function_param(&tree, declaration, 0))
    second :: ast.param(&tree, ast.function_param(&tree, declaration, 1))
    third :: ast.param(&tree, ast.function_param(&tree, declaration, 2))
    try testing.expect_equal("a", ast.source_text(&tree, first.name))
    try testing.expect_equal("b", ast.source_text(&tree, second.name))
    try testing.expect_equal("c", ast.source_text(&tree, third.name))
    try testing.expect_equal(
        "a", strpool.get_str(&strings, ast.name_id(&tree, ast.function_param(&tree, declaration, 0)))?,
    )
    try testing.expect_equal(
        "b", strpool.get_str(&strings, ast.name_id(&tree, ast.function_param(&tree, declaration, 1)))?,
    )
    try testing.expect_equal(
        "c", strpool.get_str(&strings, ast.name_id(&tree, ast.function_param(&tree, declaration, 2)))?,
    )
    try testing.expect_equal("T", strpool.get_str(&strings, ast.name_id(&tree, first.type))?)
    try testing.expect_equal("U", strpool.get_str(&strings, ast.name_id(&tree, third.type))?)
    try testing.expect_equal(first.type, second.type)
    try testing.expect(first.type != third.type)
    try testing.expect(!first.comptime)
    try testing.expect(!second.comptime)
    try testing.expect(!third.comptime)
    try testing.expect(!ast.function_generic(&tree, declaration))
    try testing.expect_equal(1, ast.block_statement_count(&tree, function.body))
    try testing.expect_equal(0, diagnostics.count(&diagnostic_store))
}

parses_compile_time_parameter_groups_and_callbacks test {
    strings := strpool.init(mem.c_allocator)
    defer strpool.deinit(&strings)
    diagnostic_store := diagnostics.init(mem.c_allocator)
    defer diagnostics.deinit(&diagnostic_store)
    source ::
        `generic proc($T type, $K, $V type, $N usize, $first, second T, $build proc(value T) T, legacy @proc(value T) T) T {}
    scan_state := lexer.init(mem.c_allocator)
    defer lexer.deinit(&scan_state)
    try lexer.scan(&scan_state, source, &strings, &diagnostic_store)
    tree := try parse(mem.c_allocator, scan_state.tokens.items, source, &diagnostic_store)
    defer ast.deinit(&tree)

    try testing.expect_equal(0, diagnostics.count(&diagnostic_store))
    declaration :: ast.package_decl(&tree, 0)
    try testing.expect(ast.function_generic(&tree, declaration))
    expected [8]bool :: [true, true, true, true, true, false, true, false]
    try testing.expect_equal(expected.len, ast.function_param_count(&tree, declaration))
    for (expected) |comptime, index| {
        parameter :: ast.param(&tree, ast.function_param(&tree, declaration, index))
        try testing.expect_equal(comptime, parameter.comptime)
    }
    first :: ast.param(&tree, ast.function_param(&tree, declaration, 0))
    key :: ast.param(&tree, ast.function_param(&tree, declaration, 1))
    value :: ast.param(&tree, ast.function_param(&tree, declaration, 2))
    count :: ast.param(&tree, ast.function_param(&tree, declaration, 3))
    try testing.expect_equal("T", ast.source_text(&tree, first.name))
    try testing.expect_equal("$T type", ast.source_text(&tree, first.span))
    try testing.expect_equal("$K, $V type", ast.source_text(&tree, key.span))
    try testing.expect_equal("$V type", ast.source_text(&tree, value.span))
    try testing.expect_equal(key.type, value.type)
    try testing.expect_equal("usize", ast.source_text(&tree, ast.node_span(&tree, count.type)))
    callback :: ast.param(&tree, ast.function_param(&tree, declaration, 6)).type
    legacy :: ast.param(&tree, ast.function_param(&tree, declaration, 7)).type
    try testing.expect_equal(ast.ExprKind.function_type, ast.expr_kind(&tree, callback))
    try testing.expect_equal(ast.ExprKind.function_type, ast.expr_kind(&tree, legacy))
    try testing.expect_equal("proc(value T) T", ast.source_text(&tree, ast.node_span(&tree, callback)))
    try testing.expect_equal("@proc(value T) T", ast.source_text(&tree, ast.node_span(&tree, legacy)))
    try testing.expect_equal(1, ast.function_param_count(&tree, callback))
    try testing.expect(!ast.param(&tree, ast.function_param(&tree, callback, 0)).comptime)
}

parses_dependent_type_calls_in_annotations_and_constructors test {
    strings := strpool.init(mem.c_allocator)
    defer strpool.deinit(&strings)
    diagnostic_store := diagnostics.init(mem.c_allocator)
    defer diagnostics.deinit(&diagnostic_store)
    source ::
        `example proc($T type, $N usize, input library.Buffer(T, N)) library.ArrayList(T) {
        `    direct library.Buffer(T, N) :: library.Buffer(T, N){}
        `    chained library.Factory(T).Buffer(N) :: library.Factory(T).Buffer(N){}
        `}
    scan_state := lexer.init(mem.c_allocator)
    defer lexer.deinit(&scan_state)
    try lexer.scan(&scan_state, source, &strings, &diagnostic_store)
    tree := try parse(mem.c_allocator, scan_state.tokens.items, source, &diagnostic_store)
    defer ast.deinit(&tree)

    try testing.expect_equal(0, diagnostics.count(&diagnostic_store))
    declaration :: ast.package_decl(&tree, 0)
    function :: ast.function_decl(&tree, declaration)
    input :: ast.param(&tree, ast.function_param(&tree, declaration, 2))
    try testing.expect_equal(ast.ExprKind.call, ast.expr_kind(&tree, input.type))
    try testing.expect_equal(2, ast.call_arg_count(&tree, input.type))
    try testing.expect_equal("library.Buffer", ast.source_text(&tree, ast.node_span(&tree, ast.call_expr(&tree, input.type).callee)))
    try testing.expect_equal("T", ast.source_text(&tree, ast.node_span(&tree, ast.call_arg(&tree, input.type, 0))))
    try testing.expect_equal("N", ast.source_text(&tree, ast.node_span(&tree, ast.call_arg(&tree, input.type, 1))))
    try testing.expect_equal(ast.ExprKind.call, ast.expr_kind(&tree, function.return_type))
    try testing.expect_equal(1, ast.call_arg_count(&tree, function.return_type))
    direct :: ast.statement_decl(&tree, ast.block_statement(&tree, function.body, 0))
    try testing.expect_equal(ast.ExprKind.call, ast.expr_kind(&tree, direct.type?))
    constructor :: ast.record_literal(&tree, direct.initializer).type?
    try testing.expect_equal(ast.ExprKind.call, ast.expr_kind(&tree, constructor))
    try testing.expect_equal("library.Buffer(T, N)", ast.source_text(&tree, ast.node_span(&tree, constructor)))
    chained :: ast.statement_decl(&tree, ast.block_statement(&tree, function.body, 1))
    selected :: ast.selection_expr(&tree, ast.call_expr(&tree, chained.type?).callee)
    try testing.expect_equal(ast.ExprKind.call, ast.expr_kind(&tree, selected.base))
    try testing.expect_equal("Buffer", ast.source_text(&tree, ast.node_span(&tree, selected.member)))
    try testing.expect_equal(1, ast.call_arg_count(&tree, chained.type?))
}

recovers_invalid_declaration_and_preserves_sibling test {
    strings := strpool.init(mem.c_allocator)
    defer strpool.deinit(&strings)
    diagnostic_store := diagnostics.init(mem.c_allocator)
    defer diagnostics.deinit(&diagnostic_store)
    source :: "@ broken\nvalid :: 1\n"
    scan_state := lexer.init(mem.c_allocator)
    defer lexer.deinit(&scan_state)
    try lexer.scan(&scan_state, source, &strings, &diagnostic_store)

    tree := try parse(mem.c_allocator, scan_state.tokens.items, source, &diagnostic_store)
    defer ast.deinit(&tree)

    try testing.expect_equal(2, ast.package_decl_count(&tree))
    invalid_decl :: ast.package_decl(&tree, 0)
    valid_decl :: ast.package_decl(&tree, 1)
    try testing.expect_equal(ast.DeclKind.invalid, ast.decl_kind(&tree, invalid_decl))
    try testing.expect_equal(ast.DeclKind.statement, ast.decl_kind(&tree, valid_decl))
    invalid_view :: ast.invalid(&tree, invalid_decl)
    try testing.expect(diagnostics.get(&diagnostic_store, invalid_view.diagnostic) != null)
    valid_statement :: ast.statement_decl(&tree, valid_decl)
    try testing.expect_equal("valid", ast.source_text(&tree, valid_statement.name))
}

recovers_malformed_groups_and_preserves_following_statements test {
    strings := strpool.init(mem.c_allocator)
    defer strpool.deinit(&strings)
    diagnostic_store := diagnostics.init(mem.c_allocator)
    defer diagnostics.deinit(&diagnostic_store)
    source ::
        `main proc() void {
        `    empty :: ()
        `    operand :: (1 + )
        `    missing :: (2
        `    valid :: (3)
        `}
        `after :: 4
    scan_state := lexer.init(mem.c_allocator)
    defer lexer.deinit(&scan_state)
    try lexer.scan(&scan_state, source, &strings, &diagnostic_store)

    tree := try parse(mem.c_allocator, scan_state.tokens.items, source, &diagnostic_store)
    defer ast.deinit(&tree)

    try testing.expect_equal(3, diagnostics.count(&diagnostic_store))
    try testing.expect_equal(2, ast.package_decl_count(&tree))
    function :: ast.function_decl(&tree, ast.package_decl(&tree, 0))
    try testing.expect_equal(4, ast.block_statement_count(&tree, function.body))
    empty :: ast.statement_decl(&tree, ast.block_statement(&tree, function.body, 0))
    try testing.expect_equal(ast.ExprKind.invalid, ast.expr_kind(&tree, empty.initializer))
    operand :: ast.statement_decl(&tree, ast.block_statement(&tree, function.body, 1))
    add :: ast.binary_expr(&tree, operand.initializer)
    try testing.expect_equal(ast.ExprKind.invalid, ast.expr_kind(&tree, add.right))
    missing :: ast.statement_decl(&tree, ast.block_statement(&tree, function.body, 2))
    try testing.expect_equal(ast.ExprKind.invalid, ast.expr_kind(&tree, missing.initializer))
    valid :: ast.statement_decl(&tree, ast.block_statement(&tree, function.body, 3))
    try testing.expect_equal(ast.ExprKind.literal_int, ast.expr_kind(&tree, valid.initializer))
    try testing.expect_equal("3", ast.source_text(&tree, ast.node_span(&tree, valid.initializer)))
    after :: ast.statement_decl(&tree, ast.package_decl(&tree, 1))
    try testing.expect_equal("after", ast.source_text(&tree, after.name))
    try testing.expect_equal("4", ast.source_text(&tree, ast.node_span(&tree, after.initializer)))
}

parses_call_statements_and_postfix_precedence test {
    strings := strpool.init(mem.c_allocator)
    defer strpool.deinit(&strings)
    diagnostic_store := diagnostics.init(mem.c_allocator)
    defer diagnostics.deinit(&diagnostic_store)
    source ::
        `main proc() void {
        `    ping()
        `    result int := -factory()(add(1, 2 * 3), (4 + 5),) + 6
        `    (handler)(result)
        `}
    scan_state := lexer.init(mem.c_allocator)
    defer lexer.deinit(&scan_state)
    try lexer.scan(&scan_state, source, &strings, &diagnostic_store)
    tree := try parse(mem.c_allocator, scan_state.tokens.items, source, &diagnostic_store)
    defer ast.deinit(&tree)

    try testing.expect_equal(0, diagnostics.count(&diagnostic_store))
    function :: ast.function_decl(&tree, ast.package_decl(&tree, 0))
    try testing.expect_equal(3, ast.block_statement_count(&tree, function.body))
    ping_stmt :: ast.block_statement(&tree, function.body, 0)
    try testing.expect_equal(ast.StmtKind.expression, ast.stmt_kind(&tree, ping_stmt))
    ping :: ast.statement_expr(&tree, ping_stmt)
    try testing.expect_equal(ast.ExprKind.call, ast.expr_kind(&tree, ping))
    try testing.expect_equal(0, ast.call_arg_count(&tree, ping))
    try testing.expect_equal(
        "ping",
        ast.source_text(&tree, ast.node_span(&tree, ast.call_expr(&tree, ping).callee)),
    )
    try testing.expect_equal("ping()", ast.source_text(&tree, ast.call_expr(&tree, ping).span))

    result :: ast.statement_decl(&tree, ast.block_statement(&tree, function.body, 1))
    try testing.expect_equal(ast.Mutability.variable, result.mutability)
    add :: ast.binary_expr(&tree, result.initializer)
    try testing.expect_equal(ast.BinaryOperator.add, add.operator)
    try testing.expect_equal("6", ast.source_text(&tree, ast.node_span(&tree, add.right)))
    negate :: ast.unary_expr(&tree, add.left)
    call :: negate.operand
    try testing.expect_equal(2, ast.call_arg_count(&tree, call))
    factory :: ast.call_expr(&tree, call).callee
    try testing.expect_equal(0, ast.call_arg_count(&tree, factory))
    try testing.expect_equal(
        "factory",
        ast.source_text(&tree, ast.node_span(&tree, ast.call_expr(&tree, factory).callee)),
    )
    nested :: ast.call_arg(&tree, call, 0)
    try testing.expect_equal(2, ast.call_arg_count(&tree, nested))
    try testing.expect_equal(
        "add",
        ast.source_text(&tree, ast.node_span(&tree, ast.call_expr(&tree, nested).callee)),
    )
    try testing.expect_equal(
        "1",
        ast.source_text(&tree, ast.node_span(&tree, ast.call_arg(&tree, nested, 0))),
    )
    multiply :: ast.binary_expr(&tree, ast.call_arg(&tree, nested, 1))
    try testing.expect_equal(ast.BinaryOperator.multiply, multiply.operator)
    try testing.expect_equal("2", ast.source_text(&tree, ast.node_span(&tree, multiply.left)))
    try testing.expect_equal("3", ast.source_text(&tree, ast.node_span(&tree, multiply.right)))
    grouped :: ast.binary_expr(&tree, ast.call_arg(&tree, call, 1))
    try testing.expect_equal(ast.BinaryOperator.add, grouped.operator)
    try testing.expect_equal("4", ast.source_text(&tree, ast.node_span(&tree, grouped.left)))
    try testing.expect_equal("5", ast.source_text(&tree, ast.node_span(&tree, grouped.right)))

    handler :: ast.statement_expr(&tree, ast.block_statement(&tree, function.body, 2))
    try testing.expect_equal(
        "handler",
        ast.source_text(&tree, ast.node_span(&tree, ast.call_expr(&tree, handler).callee)),
    )
    try testing.expect_equal(1, ast.call_arg_count(&tree, handler))
    try testing.expect_equal(
        "result",
        ast.source_text(&tree, ast.node_span(&tree, ast.call_arg(&tree, handler, 0))),
    )
}

parses_namespace_selection_with_calls_indices_and_prefixes test {
    strings := strpool.init(mem.c_allocator)
    defer strpool.deinit(&strings)
    diagnostic_store := diagnostics.init(mem.c_allocator)
    defer diagnostics.deinit(&diagnostic_store)
    source :: "main proc() int { return -library.factory()[0].member(1) + 2 }"
    scan_state := lexer.init(mem.c_allocator)
    defer lexer.deinit(&scan_state)
    try lexer.scan(&scan_state, source, &strings, &diagnostic_store)
    tree := try parse(mem.c_allocator, scan_state.tokens.items, source, &diagnostic_store)
    defer ast.deinit(&tree)
    function :: ast.function_decl(&tree, ast.package_decl(&tree, 0))
    returned :: ast.return_stmt(&tree, ast.block_statement(&tree, function.body, 0)).value?
    binary :: ast.binary_expr(&tree, returned)
    try testing.expect_equal(ast.BinaryOperator.add, binary.operator)
    call :: ast.unary_expr(&tree, binary.left).operand
    selected :: ast.selection_expr(&tree, ast.call_expr(&tree, call).callee)
    try testing.expect_equal("member", ast.source_text(&tree, ast.node_span(&tree, selected.member)))
    index :: ast.index_expr(&tree, selected.base)
    factory :: ast.selection_expr(&tree, ast.call_expr(&tree, index.base).callee)
    try testing.expect_equal("library", ast.source_text(&tree, ast.node_span(&tree, factory.base)))
    try testing.expect_equal("factory", ast.source_text(&tree, ast.node_span(&tree, factory.member)))
    try testing.expect_equal("library.factory()[0].member", ast.source_text(&tree, selected.span))
    try testing.expect_equal(0, diagnostics.count(&diagnostic_store))
}

recovers_malformed_calls_and_preserves_siblings test {
    strings := strpool.init(mem.c_allocator)
    defer strpool.deinit(&strings)
    diagnostic_store := diagnostics.init(mem.c_allocator)
    defer diagnostics.deinit(&diagnostic_store)
    source ::
        `main proc() void {
        `    bad(1 2)
        `    good()
        `    missing(1
        `    after :: 3
        `    holes(, 2)
        `}
        `tail :: f()
    scan_state := lexer.init(mem.c_allocator)
    defer lexer.deinit(&scan_state)
    try lexer.scan(&scan_state, source, &strings, &diagnostic_store)
    tree := try parse(mem.c_allocator, scan_state.tokens.items, source, &diagnostic_store)
    defer ast.deinit(&tree)

    try testing.expect_equal(3, diagnostics.count(&diagnostic_store))
    try testing.expect_equal(2, ast.package_decl_count(&tree))
    function :: ast.function_decl(&tree, ast.package_decl(&tree, 0))
    try testing.expect_equal(5, ast.block_statement_count(&tree, function.body))
    for ([0, 2]) |index| {
        statement :: ast.block_statement(&tree, function.body, usize(index))
        try testing.expect_equal(ast.StmtKind.invalid, ast.stmt_kind(&tree, statement))
        try testing.expect(
            diagnostics.get(&diagnostic_store, ast.invalid(&tree, statement).diagnostic) != null,
        )
    }
    good :: ast.statement_expr(&tree, ast.block_statement(&tree, function.body, 1))
    try testing.expect_equal(
        "good",
        ast.source_text(&tree, ast.node_span(&tree, ast.call_expr(&tree, good).callee)),
    )
    after :: ast.statement_decl(&tree, ast.block_statement(&tree, function.body, 3))
    try testing.expect_equal("after", ast.source_text(&tree, after.name))
    holes :: ast.statement_expr(&tree, ast.block_statement(&tree, function.body, 4))
    try testing.expect_equal(2, ast.call_arg_count(&tree, holes))
    try testing.expect_equal(ast.ExprKind.invalid, ast.expr_kind(&tree, ast.call_arg(&tree, holes, 0)))
    try testing.expect_equal(
        "2",
        ast.source_text(&tree, ast.node_span(&tree, ast.call_arg(&tree, holes, 1))),
    )
    tail :: ast.statement_decl(&tree, ast.package_decl(&tree, 1))
    try testing.expect_equal("tail", ast.source_text(&tree, tail.name))
    try testing.expect_equal(0, ast.call_arg_count(&tree, tail.initializer))
}

parses_return_boundaries_and_recovers_trailing_tokens test {
    strings := strpool.init(mem.c_allocator)
    defer strpool.deinit(&strings)
    diagnostic_store := diagnostics.init(mem.c_allocator)
    defer diagnostics.deinit(&diagnostic_store)
    source ::
        `return 1
        `main proc() void {
        `    return
        `    2
        `    return (3 + 4)
        `    return 5 stray
        `    after :: 6
        `    return }
    scan_state := lexer.init(mem.c_allocator)
    defer lexer.deinit(&scan_state)
    try lexer.scan(&scan_state, source, &strings, &diagnostic_store)
    tree := try parse(mem.c_allocator, scan_state.tokens.items, source, &diagnostic_store)
    defer ast.deinit(&tree)

    try testing.expect_equal(2, ast.package_decl_count(&tree))
    try testing.expect_equal(ast.DeclKind.invalid, ast.decl_kind(&tree, ast.package_decl(&tree, 0)))
    body :: ast.function_decl(&tree, ast.package_decl(&tree, 1)).body
    try testing.expect_equal(6, ast.block_statement_count(&tree, body))
    first :: ast.block_statement(&tree, body, 0)
    try testing.expect_equal(ast.StmtKind.return_stmt, ast.stmt_kind(&tree, first))
    try testing.expect(ast.return_stmt(&tree, first).value == null)
    try testing.expect_equal("return", ast.source_text(&tree, ast.return_stmt(&tree, first).span))
    try testing.expect_equal(ast.StmtKind.expression, ast.stmt_kind(&tree, ast.block_statement(&tree, body, 1)))
    grouped :: ast.return_stmt(&tree, ast.block_statement(&tree, body, 2))
    try testing.expect_equal("return (3 + 4)", ast.source_text(&tree, grouped.span))
    if (grouped.value) |value| try testing.expect_equal(ast.ExprKind.binary, ast.expr_kind(&tree, value))
    else return .expectation_failed
    try testing.expect_equal(ast.StmtKind.invalid, ast.stmt_kind(&tree, ast.block_statement(&tree, body, 3)))
    after :: ast.statement_decl(&tree, ast.block_statement(&tree, body, 4))
    try testing.expect_equal("after", ast.source_text(&tree, after.name))
    last :: ast.return_stmt(&tree, ast.block_statement(&tree, body, 5))
    try testing.expect(last.value == null)
    try testing.expect_equal("return", ast.source_text(&tree, last.span))
    try testing.expect_equal(2, diagnostics.count(&diagnostic_store))
}

parses_boolean_comparison_precedence_and_associativity test {
    strings := strpool.init(mem.c_allocator)
    defer strpool.deinit(&strings)
    diagnostic_store := diagnostics.init(mem.c_allocator)
    defer diagnostics.deinit(&diagnostic_store)
    source ::
        `value :: -f() * 2 + 3 < 4 <= 5 > 6 >= 7 == true != false
    scan_state := lexer.init(mem.c_allocator)
    defer lexer.deinit(&scan_state)
    try lexer.scan(&scan_state, source, &strings, &diagnostic_store)
    tree := try parse(mem.c_allocator, scan_state.tokens.items, source, &diagnostic_store)
    defer ast.deinit(&tree)
    different :: ast.binary_expr(&tree, ast.statement_decl(&tree, ast.package_decl(&tree, 0)).initializer)
    try testing.expect_equal(ast.BinaryOperator.not_equal, different.operator)
    try testing.expect_equal(ast.ExprKind.literal_bool, ast.expr_kind(&tree, different.right))
    try testing.expect_equal("false", ast.source_text(&tree, ast.node_span(&tree, different.right)))
    equal :: ast.binary_expr(&tree, different.left)
    try testing.expect_equal(ast.BinaryOperator.equal, equal.operator)
    try testing.expect_equal(ast.ExprKind.literal_bool, ast.expr_kind(&tree, equal.right))
    relation := equal.left
    operators [4]ast.BinaryOperator :: [.greater_equal, .greater, .less_equal, .less]
    for (operators) |operator| {
        binary :: ast.binary_expr(&tree, relation)
        try testing.expect_equal(operator, binary.operator)
        relation = binary.left
    }
    addition :: ast.binary_expr(&tree, relation)
    try testing.expect_equal(ast.BinaryOperator.add, addition.operator)
    product :: ast.binary_expr(&tree, addition.left)
    try testing.expect_equal(ast.BinaryOperator.multiply, product.operator)
    negate :: ast.unary_expr(&tree, product.left)
    try testing.expect_equal(ast.ExprKind.call, ast.expr_kind(&tree, negate.operand))
    try testing.expect_equal(0, diagnostics.count(&diagnostic_store))
}

parses_factorial_and_canonical_conditional_arms test {
    strings := strpool.init(mem.c_allocator)
    defer strpool.deinit(&strings)
    diagnostic_store := diagnostics.init(mem.c_allocator)
    defer diagnostics.deinit(&diagnostic_store)
    source ::
        `factorial proc(n int) int {
        `    if (n <= 1) return 1 else return n * factorial(n - 1)
        `}
        `main proc() int {
        `    if true {
        `        local :: factorial(5)
        `        if (false) return 0 else return local
        `    }
        `    else if ready() return 2 else { return 3 }
        `}
    scan_state := lexer.init(mem.c_allocator)
    defer lexer.deinit(&scan_state)
    try lexer.scan(&scan_state, source, &strings, &diagnostic_store)
    tree := try parse(mem.c_allocator, scan_state.tokens.items, source, &diagnostic_store)
    defer ast.deinit(&tree)
    factorial :: ast.function_decl(&tree, ast.package_decl(&tree, 0))
    try testing.expect_equal(1, ast.block_statement_count(&tree, factorial.body))
    guard :: ast.if_stmt(&tree, ast.block_statement(&tree, factorial.body, 0))
    try testing.expect_equal("n <= 1", ast.source_text(&tree, ast.node_span(&tree, guard.condition)))
    try testing.expect_equal(1, ast.block_statement_count(&tree, guard.then_block))
    try testing.expect_equal("return 1", ast.source_text(&tree, ast.return_stmt(&tree, ast.block_statement(&tree, guard.then_block, 0)).span))
    try testing.expect_equal(1, ast.block_statement_count(&tree, guard.else_block?))
    try testing.expect_equal(ast.StmtKind.return_stmt, ast.stmt_kind(&tree, ast.block_statement(&tree, guard.else_block?, 0)))
    main :: ast.function_decl(&tree, ast.package_decl(&tree, 1))
    outer :: ast.if_stmt(&tree, ast.block_statement(&tree, main.body, 0))
    try testing.expect_equal(2, ast.block_statement_count(&tree, outer.then_block))
    try testing.expect_equal(ast.StmtKind.declaration, ast.stmt_kind(&tree, ast.block_statement(&tree, outer.then_block, 0)))
    nested :: ast.if_stmt(&tree, ast.block_statement(&tree, outer.then_block, 1))
    try testing.expect(nested.else_block != null)
    try testing.expect_equal(1, ast.block_statement_count(&tree, outer.else_block?))
    chain :: ast.if_stmt(&tree, ast.block_statement(&tree, outer.else_block?, 0))
    try testing.expect_equal(ast.ExprKind.call, ast.expr_kind(&tree, chain.condition))
    try testing.expect(chain.else_block != null)
    try testing.expect_equal(0, diagnostics.count(&diagnostic_store))
}

