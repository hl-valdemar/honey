@hide:file
parse_union_field proc(state @mut State, tagged bool) ast.NodeId ! ParseError {
    token :: if (tagged) try consume_member(state, false) else try consume(state, .ident)
    name :: try ast.add_identifier(state.builder, token.span, token.data.str_id)
    type :: try parse_type(state)
    return try ast.add_field(state.builder, ast.Span{
        start = token.span.start, end = ast.builder_span(state.builder, type).end, source = token.span.source,
    }, name, type, null)
}

@hide:file
parse_match proc(state @mut State) ast.NodeId ! ParseError {
    keyword :: try consume(state, .match)
    skip_newlines(state)
    subject :: try parse_guard_expr(state)
    skip_newlines(state)
    _ = try consume(state, .open_curly)
    previous_depth :: state.paren_depth
    state.paren_depth = 0
    defer state.paren_depth = previous_depth
    arms arraylist.ArrayList(ast.NodeId) := arraylist.init(state.allocator)
    defer arraylist.deinit(&arms)
    skip_newlines(state)
    while (!next_is(state, .close_curly) and !next_is(state, .eof)) {
        if (
            next_is(state, .ident)
            and (next_n_is(state, 1, .double_colon) or next_n_is(state, 1, .colon_equal) or next_n_is(state, 1, .proc))
        ) return try invalid_record(state, keyword.span.start, false)
        start :: state.next_token
