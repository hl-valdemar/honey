            span :: recover_record_field(state, start)
            invalid :: try ast.add_invalid_expr(state.builder, span, diagnostic)
            yield try ast.add_match_arm(state.builder, span, &[], null, invalid, true, false)
        }
        try arraylist.append(&arms, arm)
        if next_is(state, .close_curly) break
        if next_is(state, .comma) state.next_token += 1
        else if (!next_is(state, .newline)) return try invalid_record(state, keyword.span.start, true)
        skip_newlines(state)
    }
    if (!next_is(state, .close_curly)) return try invalid_record(state, keyword.span.start, false)
    close :: try consume(state, .close_curly)
    return try ast.add_match(state.builder, ast.Span{
        start = keyword.span.start, end = close.span.end, source = keyword.span.source,
    }, subject, arms.items)
}

@hide:file
parse_match_arm proc(state @mut State) ast.NodeId ! ParseError {
    start :: current(state).span
    patterns arraylist.ArrayList(ast.NodeId) := arraylist.init(state.allocator)
    defer arraylist.deinit(&patterns)
    is_inline :: next_is(state, .inline)
    if (is_inline) state.next_token += 1
    catch_all :: !is_inline and next_is(state, .else)
    capture ?ast.NodeId := null
    tag_capture ?ast.NodeId := null
    tag_capture_present := false
    if (catch_all) state.next_token += 1
    else if (!is_inline) {
        while true {
            try arraylist.append(&patterns, try parse_guard_expr(state))
            if (!next_is(state, .comma)) break
            state.next_token += 1
            skip_newlines(state)
        }
    }
    if (is_inline or (!catch_all and next_is(state, .pipe))) {
        _ = try consume(state, .pipe)
        # captures are by value; pointer capture tokens are not identifiers.
        token :: try consume(state, .ident)
        if (
            token.span.end != token.span.start + 1
            or state.builder.source[usize(token.span.start)] != '_'
        ) capture = try ast.add_identifier(state.builder, token.span, token.data.str_id)
        if (is_inline and next_is(state, .comma)) {
            state.next_token += 1
            tag_capture_present = true
            tag :: try consume(state, .ident)
            if (
                tag.span.end != tag.span.start + 1
                or state.builder.source[usize(tag.span.start)] != '_'
            ) tag_capture = try ast.add_identifier(state.builder, tag.span, tag.data.str_id)
        }
        _ = try consume(state, .pipe)
    }
    _ = try consume(state, .colon)
    skip_newlines(state)
    previous :: state.match_arm_body
    state.match_arm_body = true
    defer state.match_arm_body = previous
    statement_body :: match current(state).kind {
        .open_curly, .return, .yield, .break, .continue, .if, .while, .for, .inline, .defer, .errdefer: true
        else: false
    }
    body ast.NodeId := undefined
    expression := false
    if (statement_body or named_binding_starts(state)) {
        body = try parse_arm(state, false)
    } else {
        value :: try parse_expr(state)
        if next_is(state, .equal) {
            statement :: try parse_assignment(state, value, false)
            statements [1]ast.NodeId :: [statement]
            body = try ast.add_block(state.builder, ast.builder_span(state.builder, statement), statements[..])
        } else {
            body = value
            expression = true
        }
        tree :: ast.view(state.builder, value)
        if (expression and ast.expr_kind(&tree, value) == .match_expr
            and ast.match_arm_count(&tree, value) > 0) {
            nested :: ast.match_arm_view(&tree, ast.match_arm(&tree, value, 0))
            if (!nested.expression) {
                statement :: try ast.add_expression_stmt(state.builder, value)
                statements [1]ast.NodeId :: [statement]
                body = try ast.add_block(state.builder, ast.builder_span(state.builder, value), statements[..])
                expression = false
            }
        }
    }
    arm :: try ast.add_match_arm(state.builder, ast.Span{
        start = start.start, end = ast.builder_span(state.builder, body).end, source = start.source,
    }, patterns.items, capture, body, expression, catch_all)
    if (is_inline) ast.set_match_arm_inline(state.builder, arm, tag_capture, tag_capture_present)
    return arm
}

@hide:file
parse_record_type proc(state @mut State) ast.NodeId ! ParseError {
    keyword :: try consume_either(state, &[.struct, .c_struct])
    id :: try parse_record(state, null, keyword.span.start, true)
    if (keyword.kind == .c_struct and ast.builder_expr_kind(state.builder, id) == .record_type)
        ast.set_record_c_layout(state.builder, id)
    return id
}

@hide:file
parse_record_literal proc(
    state @mut State, type ?ast.NodeId, start u32,
) ast.NodeId ! ParseError {
    return try parse_record(state, type, start, false)
}

@hide:file
parse_record proc(
    state @mut State, type ?ast.NodeId, start u32, declaration bool,
) ast.NodeId ! ParseError {
    open :: try consume(state, .open_curly)
    previous :: state.allow_record_literals
    state.allow_record_literals = true
    defer state.allow_record_literals = previous
    fields arraylist.ArrayList(ast.NodeId) := arraylist.init(state.allocator)
    defer arraylist.deinit(&fields)
    skip_newlines(state)
    while (!next_is(state, .close_curly) and !next_is(state, .eof)) {
        # leave the next declaration intact when a record's closing brace is missing.
        if (
            next_is(state, .ident)
            and (next_n_is(state, 1, .double_colon) or next_n_is(state, 1, .colon_equal) or next_n_is(state, 1, .proc))
        ) return try invalid_record(state, start, false)
