                else: return err
            }
            diagnostic :: try unexpected_diagnostic(state)
            span :: recover_record_field(state, start)
            invalid :: try ast.add_invalid_expr(state.builder, span, diagnostic)
            yield try ast.add_field(state.builder, span, null, null, invalid)
        }
        try arraylist.append(&members, member)
        if next_is(state, .close_curly) break
        if next_is(state, .comma) state.next_token += 1
        else if (!next_is(state, .newline)) return try invalid_record(state, keyword.span.start, true)
        skip_newlines(state)
    }
    if (!next_is(state, .close_curly)) return try invalid_record(state, keyword.span.start, false)
    close :: try consume(state, .close_curly)
    return try ast.add_enum_type(state.builder, ast.Span{
        start = keyword.span.start, end = close.span.end, source = keyword.span.source,
    }, backing, members.items)
}

@hide:file
parse_enum_member proc(state @mut State) ast.NodeId ! ParseError {
    token :: try consume_member(state, false)
    name :: try ast.add_identifier(state.builder, token.span, token.data.str_id)
    value ?ast.NodeId := null
    if next_is(state, .equal) {
        state.next_token += 1
        value = try parse_expr(state)
    }
    end :: if (value) |id| ast.builder_span(state.builder, id).end else token.span.end
    return try ast.add_field(state.builder, ast.Span{
        start = token.span.start,
        end = end,
        source = token.span.source,
    }, name, null, value)
}

@hide:file
parse_union_type proc(state @mut State) ast.NodeId ! ParseError {
    keyword :: try consume(state, .union)
    tag ?ast.NodeId := null
    auto_tag := false
    if next_is(state, .open_paren) {
        state.next_token += 1
        if next_is(state, .enum) {
            state.next_token += 1
            auto_tag = true
