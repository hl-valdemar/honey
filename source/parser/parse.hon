            diagnostic :: try unexpected_diagnostic(state)
            span :: recover_record_field(state, field_start)
            invalid :: try ast.add_invalid_expr(state.builder, span, diagnostic)
            recovered_type ?ast.NodeId :: if (declaration) invalid else null
            recovered_value ?ast.NodeId :: if (declaration) null else invalid
            yield try ast.add_field(state.builder, span, null, recovered_type, recovered_value)
        }
        try arraylist.append(&fields, field)
        if next_is(state, .close_curly) break
        if next_is(state, .comma) {
            state.next_token += 1
            skip_newlines(state)
            continue
        }
        if (declaration and next_is(state, .newline)) {
            skip_newlines(state)
            continue
        }
        after_field :: state.next_token
        skip_newlines(state)
        if next_is(state, .close_curly) break
        state.next_token = after_field
        return try invalid_record(state, start, true)
    }
    if (!next_is(state, .close_curly)) return try invalid_record(state, start, false)
    close :: try consume(state, .close_curly)
    span :: ast.Span{ start = start, end = close.span.end, source = open.span.source }
    if (declaration) return try ast.add_record_type(state.builder, span, fields.items)
    return try ast.add_record_literal(state.builder, span, type, fields.items)
}

@hide:file
parse_record_field proc(state @mut State, declaration bool) ast.NodeId ! ParseError {
    start :: current(state).span
    start_token :: state.next_token
    name ?ast.NodeId := null
    type ?ast.NodeId := null
    value ?ast.NodeId := null
    named :: (
        member_name(current(state).kind)
        and ((!declaration and next_n_is(state, 1, .equal))
            or (declaration and starts_type(state.tokens[state.next_token + 1].kind)))
    )
    if (named) {
        token :: if (declaration) try consume(state, .ident) else try consume_member(state, false)
        name = try ast.add_identifier(state.builder, token.span, token.data.str_id)
    }
    if (declaration) {
        type = try parse_type(state)
        if next_is(state, .equal) {
            state.next_token += 1
            value = try parse_expr(state)
        }
    } else {
        if (named) _ = try consume(state, .equal)
        value = try parse_expr(state)
    }
    end :: if (state.next_token > start_token) state.tokens[state.next_token - 1].span.end else start.end
    return try ast.add_field(state.builder, ast.Span{
        start = start.start,
        end = end,
        source = start.source,
    }, name, type, value)
}

@hide:file
recover_record_field proc(state @mut State, start usize) ast.Span {
    depth usize := 0
    for (start..state.next_token) |index| {
        kind :: state.tokens[index].kind
        if (kind == .open_curly or kind == .open_paren or kind == .open_bracket) depth += 1
        if ((kind == .close_curly or kind == .close_paren or kind == .close_bracket) and depth > 0) depth -= 1
    }
    while (!next_is(state, .eof)) {
        kind :: current(state).kind
        if (depth == 0 and (kind == .comma or kind == .newline or kind == .close_curly)) break
        if (kind == .open_curly or kind == .open_paren or kind == .open_bracket) depth += 1
        if (kind == .close_curly or kind == .close_paren or kind == .close_bracket) {
            if (depth == 0) break
            depth -= 1
        }
        state.next_token += 1
    }
    first :: state.tokens[start].span
    end :: if (state.next_token > start) state.tokens[state.next_token - 1].span.end else first.end
    return ast.Span{
        start = first.start,
        end = end,
        source = first.source,
    }
}

@hide:file
invalid_record proc(state @mut State, start u32, recover_tail bool) ast.NodeId ! ParseError {
    diagnostic :: try unexpected_diagnostic(state)
    if (recover_tail) {
        while (!next_is(state, .newline) and !next_is(state, .close_curly) and !next_is(state, .eof)) {
            before :: state.next_token
            _ = recover_record_field(state, before)
            if (next_is(state, .comma)) state.next_token += 1
            if (state.next_token == before) break
        }
        if (next_is(state, .close_curly)) state.next_token += 1
    }
    return try ast.add_invalid_expr(state.builder, ast.Span{
        start = start,
        end = state.tokens[state.next_token - 1].span.end,
        source = state.builder.source_id,
    }, diagnostic)
}

@hide:file
parse_expr proc(state @mut State) ast.NodeId ! ParseError {
    return try parse_expr_bp(state, BindingPowerScalar(0))
}

@hide:file
parse_expr_bp proc(state @mut State, min_bp BindingPowerScalar) ast.NodeId ! ParseError {
    skip_operand_newlines(state)
    token := current(state)
    expression_start :: state.next_token
    left := if (prefix_binding_power(token.kind)) |right_bp| {
        state.next_token += 1
        operand :: try parse_expr_bp(state, right_bp)
        operand_span :: ast.builder_span(state.builder, operand)
        span :: ast.Span{
            start = token.span.start,
            end = operand_span.end,
            source = token.span.source,
        }
        operator ast.UnaryOperator :: match token.kind {
            .bang: .logical_not
            .ampersand: .address_of
            else: .negate
        }
        prefixed :: if (token.kind == .try)
            try ast.add_try_expr(state.builder, span, operand)
        else
            try ast.add_unary(state.builder, span, operator, operand)
        yield prefixed
    } else {
        yield try parse_primary(state)
    }
    left_grouped := parenthesized_guard(state, expression_start)

    while true {
        skip_continuation_newlines(state)
        token = current(state)
        if (token.kind == .caret or token.kind == .question) {
            state.next_token += 1
            operator ast.UnaryOperator :: if (token.kind == .caret) .dereference else .unwrap
            left = try ast.add_unary(state.builder, ast.Span{
                start = state.tokens[expression_start].span.start,
                end = token.span.end,
                source = token.span.source,
            }, operator, left)
            left_grouped = false
            continue
        }
        # adjacent bang calls stay intrinsics; spaced 'T ! (E)' is a fallible type.
        if (
            token.kind == .bang and next_n_is(state, 1, .open_paren)
            and state.tokens[state.next_token - 1].span.end == token.span.start
        ) {
            state.next_token += 1
            left = try parse_call(state, left, state.tokens[expression_start].span.start, true)
            left_grouped = false
            continue
        }
        if (token.kind == .open_paren) {
            left = try parse_call(state, left, state.tokens[expression_start].span.start, false)
            left_grouped = false
            continue
        }
        if (token.kind == .open_bracket) {
            left = try parse_index(state, left, state.tokens[expression_start].span.start)
            left_grouped = false
            continue
        }
        if (token.kind == .open_curly and state.allow_record_literals) {
            left = try parse_record_literal(state, left, state.tokens[expression_start].span.start)
            left_grouped = false
            continue
        }
        if (token.kind == .dot) {
            state.next_token += 1
            member :: try consume_member(state, true)
            member_id :: if (member.kind == .int)
                try ast.add_literal(state.builder, .int, member.span)
            else
                try ast.add_identifier(state.builder, member.span, member.data.str_id)
            left = try ast.add_selection(
                state.builder,
                ast.Span{
                    start = state.tokens[expression_start].span.start,
                    end = member.span.end,
                    source = member.span.source,
                },
                left, member_id,
            )
            left_grouped = false
            continue
        }
        if (token.kind == .catch) {
            if (min_bp > BindingPowerScalar(0)) break
            state.next_token += 1
            capture :: try parse_error_capture(state)
            skip_operand_newlines(state)
            handler_is_block :: next_is(state, .open_curly)
            handler :: if (handler_is_block) try parse_block(state) else try parse_expr_bp(state, BindingPowerScalar(0))
            left = try ast.add_catch_expr(state.builder, ast.Span{
                start = state.tokens[expression_start].span.start,
                end = state.tokens[state.next_token - 1].span.end,
                source = token.span.source,
            }, left, capture, handler, handler_is_block)
            left_grouped = false
            continue
        }
        if (token.kind == .bang or (token.kind == .pipe and state.allow_sum_types)) {
            power :: if (token.kind == .bang) BindingPowerScalar(1) else BindingPowerScalar(2)
            if (power < min_bp) break
            state.next_token += 1
            right :: try parse_expr_bp(state, BindingPowerScalar(u32(power) + 1))
            left = try ast.add_binary_type(state.builder, ast.Span{
                start = state.tokens[expression_start].span.start,
                end = state.tokens[state.next_token - 1].span.end,
                source = token.span.source,
            }, left, right, token.kind == .bang)
            left_grouped = false
            continue
        }
        if (token.kind == .range or token.kind == .range_inclusive) {
            if (min_bp > BindingPowerScalar(0)) break
            left = try validate_range_bound(state, left, left_grouped)
            state.next_token += 1
            right_start :: state.next_token
            right := try parse_expr_bp(state, BindingPowerScalar(1))
            right = try validate_range_bound(state, right, parenthesized_guard(state, right_start))
            left = try ast.add_range(
                state.builder,
                ast.Span{
                    start = state.tokens[expression_start].span.start,
                    end = state.tokens[state.next_token - 1].span.end,
                    source = state.builder.source_id,
                },
                left, right, token.kind == .range_inclusive,
            )
            left_grouped = false
            continue
        }
        if (infix_binding_power(token.kind)) |power| {
            if (power.left < min_bp) break
            state.next_token += 1
            right :: try parse_expr_bp(state, power.right)
            left_span :: ast.builder_span(state.builder, left)
            right_span :: ast.builder_span(state.builder, right)
            left = try ast.add_binary(
                state.builder,
                ast.Span{
                    start = left_span.start,
                    end = right_span.end,
                    source = left_span.source,
                },
                binary_operator(token.kind),
                left,
                right,
            )
            left_grouped = false
            continue
        }
        break
    }
    return left
}

@hide:file
validate_range_bound proc(
    state @mut State, bound ast.NodeId, grouped bool,
) ast.NodeId ! (mem.AllocError | diagnostics.CapacityError) {
    if (grouped) return bound
    match ast.builder_expr_kind(state.builder, bound) {
        .unary, .binary, .range: {
            span :: ast.builder_span(state.builder, bound)
            diagnostic :: try diagnostics.add(state.diagnostics, .unexpected_token, span)
            return try ast.add_invalid_expr(state.builder, span, diagnostic)
        }
        else: return bound
    }
}

@hide:file
parse_call proc(state @mut State, callee ast.NodeId, start u32, builtin bool) ast.NodeId ! ParseError {
    _ = try consume(state, .open_paren)
    previous :: state.allow_record_literals
    state.allow_record_literals = true
    defer state.allow_record_literals = previous
    state.paren_depth += 1
    defer state.paren_depth -= 1
    skip_argument_newlines(state)
    arguments arraylist.ArrayList(ast.NodeId) := arraylist.init(state.allocator)
    defer arraylist.deinit(&arguments)
    argument_start :: state.next_token
    node_count :: state.builder.storage.nodes.items.len
    extra_count :: state.builder.storage.extra.items.len
    diagnostic_count :: state.diagnostics.list.items.len

    while (!is_call_boundary(current(state).kind)) {
        argument :: try parse_expr(state)
        try arraylist.append(&arguments, argument)
        if (!next_is(state, .comma)) break
        state.next_token += 1
        skip_argument_newlines(state)
    }
    if (!previous and !next_is(state, .close_paren)) {
        # a guard's body may look like a record argument until its missing ')' is known.
        state.next_token = argument_start
        state.builder.storage.nodes.items = state.builder.storage.nodes.items.ptr[..node_count]
        state.builder.storage.spans.items = state.builder.storage.spans.items.ptr[..node_count]
        state.builder.storage.extra.items = state.builder.storage.extra.items.ptr[..extra_count]
        state.diagnostics.list.items = state.diagnostics.list.items.ptr[..diagnostic_count]
        return .unexpected_token
    }
    close :: try consume(state, .close_paren)
    span :: ast.Span{ start = start, end = close.span.end, source = state.builder.source_id }
    if (builtin) return try ast.add_builtin_call(state.builder, span, callee, arguments.items)
    return try ast.add_call(state.builder, span, callee, arguments.items)
}

@hide:file
parse_index proc(state @mut State, base ast.NodeId, start u32) ast.NodeId ! ParseError {
    _ = try consume(state, .open_bracket)
    previous :: state.allow_record_literals
    state.allow_record_literals = true
    defer state.allow_record_literals = previous
    first ?ast.NodeId := null
    if (!next_is(state, .range)) first = try parse_expr_bp(state, BindingPowerScalar(1))
    if (next_is(state, .range)) {
        state.next_token += 1
        end ?ast.NodeId := null
        sentinel ?ast.NodeId := null
        if (!next_is(state, .close_bracket) and !next_is(state, .semicolon)) end = try parse_expr(state)
        if (next_is(state, .semicolon)) {
            state.next_token += 1
            sentinel = try parse_expr(state)
        }
        close :: try consume(state, .close_bracket)
        return try ast.add_slice(state.builder, ast.Span{
            start = start, end = close.span.end, source = state.builder.source_id,
        }, base, first, end, sentinel)
    }
    if !next_is(state, .close_bracket) {
        diagnostic :: try diagnostics.add(state.diagnostics, .unexpected_token, current(state).span)
        return try ast.add_invalid_expr(state.builder, ast.Span{
            start = start, end = ast.builder_span(state.builder, first?).end, source = state.builder.source_id,
        }, diagnostic)
    }
    close :: try consume(state, .close_bracket)
    return try ast.add_index(state.builder, ast.Span{
        start = start, end = close.span.end, source = state.builder.source_id,
    }, base, first?)
}

@hide:file
array_starts_type proc(state @State) bool {
    depth usize := 0
    curly_depth := usize(0)
    for (state.next_token)..(state.tokens.len) |i| {
        kind :: state.tokens[i].kind
        if (kind == .open_bracket) depth += 1
        if (kind == .close_bracket) {
            depth -= 1
            if (depth == 0) {
                if (i + 1 >= state.tokens.len) return false
                next :: state.tokens[i + 1].kind
                return starts_type(next) or next == .mut
            }
        }
        if (kind == .open_curly) curly_depth += 1
        if (kind == .close_curly) {
            if (curly_depth == 0) return false
            curly_depth -= 1
        }
        if (kind == .eof) return false
    }
    return false
}

@hide:file
parse_array_literal proc(state @mut State) ast.NodeId ! ParseError {
    open :: try consume(state, .open_bracket)
    previous :: state.allow_record_literals
    state.allow_record_literals = true
    defer state.allow_record_literals = previous
    elements arraylist.ArrayList(ast.NodeId) := arraylist.init(state.allocator)
    defer arraylist.deinit(&elements)
    after_open :: state.next_token
    skip_newlines(state)
    if named_binding_starts(state) {
        state.next_token = after_open
        return try invalid_array_literal(state, open.span.start, open.span.end)
    }
    while !next_is(state, .close_bracket) {
        element :: try parse_expr(state)
        try arraylist.append(&elements, element)
        after_element :: state.next_token
        skip_newlines(state)
        if next_is(state, .close_bracket) break
        if !next_is(state, .comma) {
            state.next_token = after_element
            return try invalid_array_literal(state, open.span.start, ast.builder_span(state.builder, element).end)
        }
        state.next_token += 1
        after_comma :: state.next_token
        skip_newlines(state)
        if named_binding_starts(state) {
            state.next_token = after_comma
            return try invalid_array_literal(state, open.span.start, ast.builder_span(state.builder, element).end)
        }
    }
    close :: try consume(state, .close_bracket)
    return try ast.add_array_literal(state.builder, ast.Span{
        start = open.span.start,
        end = close.span.end,
        source = open.span.source,
    }, elements.items)
}

@hide:file
invalid_array_literal proc(state @mut State, start, end u32) ast.NodeId ! ParseError {
    diagnostic :: try diagnostics.add(state.diagnostics, .unexpected_token, current(state).span)
    return try ast.add_invalid_expr(state.builder, ast.Span{
        start = start,
        end = end,
        source = state.builder.source_id,
    }, diagnostic)
}

@hide:file
pointer_binding_starts proc(state @State) bool {
    depth := usize(0)
    for (state.next_token + 1)..(state.tokens.len) |i| {
        kind :: state.tokens[i].kind
        if (kind == .open_curly or kind == .open_bracket or kind == .open_paren) depth += 1
        if (kind == .close_curly or kind == .close_bracket or kind == .close_paren) {
            if (depth == 0) return false
            depth -= 1
        }
        if (depth != 0) continue
        if (kind == .double_colon or kind == .colon_equal) return true
        if (kind == .newline or kind == .eof or kind == .equal) return false
    }
    return false
}

@hide:file
named_binding_starts proc(state @State) bool {
    return (
        next_is(state, .ident)
        and (next_n_is(state, 1, .double_colon) or next_n_is(state, 1, .colon_equal)
            or next_n_is(state, 1, .ident) or next_n_is(state, 1, .proc) or next_n_is(state, 1, .match)
            or next_n_is(state, 1, .if)
            or next_n_is(state, 1, .at)
            or next_n_is(state, 1, .question)
            or (next_n_is(state, 1, .open_paren) and pointer_binding_starts(state))
            or (next_n_is(state, 1, .star) and pointer_binding_starts(state)))
    )
}

@hide:file
brace_starts_block proc(state @State) bool {
    first := state.next_token + 1
    while (first < state.tokens.len and state.tokens[first].kind == .newline) first += 1
    # empty records and braces without statement markers retain record syntax.
    if (first >= state.tokens.len or state.tokens[first].kind == .close_curly) return false
    depth := usize(0)
    for (state.next_token)..(state.tokens.len) |index| {
        kind :: state.tokens[index].kind
        if (kind == .eof) return false
        if (depth > 0
            and (state.tokens[first].kind == .if or state.tokens[first].kind == .open_curly)
            and (kind == .yield or kind == .return or kind == .defer or kind == .errdefer)
            and state.tokens[index - 1].kind != .dot
            and !(index + 1 < state.tokens.len and state.tokens[index + 1].kind == .equal)) return true
        if (depth == 1) {
            if (kind == .double_colon or kind == .colon_equal) return true
            previous :: if (index > first) state.tokens[index - 1].kind else lexer.TokenKind.open_curly
            if (previous != .dot and !(index + 1 < state.tokens.len and state.tokens[index + 1].kind == .equal)) {
                match kind {
                    .yield, .return, .break, .continue, .while, .for, .inline, .defer, .errdefer: return true
                    else: {}
                }
            }
        }
        if (kind == .open_curly or kind == .open_paren or kind == .open_bracket) depth += 1
        if (kind == .close_curly or kind == .close_paren or kind == .close_bracket) {
            if (depth == 0) return false
            depth -= 1
            if (depth == 0) return false
        }
    }
    return false
}

@hide:file
parse_primary proc(state @mut State) ast.NodeId ! ParseError {
    token :: current(state)
    match token.kind {
        .at, .star, .question, .proc, .c_func, .opaque: return try parse_type(state)
        .struct, .c_struct: return try parse_record_type(state)
        .enum: return try parse_enum_type(state)
        .union: return try parse_union_type(state)
        .distinct, .alias: return try parse_type_wrapper(state)
        .match: return try parse_match(state)
        .if: return try parse_if_expr(state)
        .dollar: {
            state.next_token += 1
            _ = try consume(state, .open_paren)
            previous :: state.allow_record_literals
            state.allow_record_literals = true
            defer state.allow_record_literals = previous
            state.paren_depth += 1
            defer state.paren_depth -= 1
            expression :: try parse_expr(state)
            skip_operand_newlines(state)
            close :: try consume(state, .close_paren)
            return try ast.add_comptime_expr(state.builder, ast.Span{
                start = token.span.start, end = close.span.end, source = token.span.source,
            }, expression)
        }
        .dot: {
            state.next_token += 1
            member :: try consume_member(state, false)
            member_id :: try ast.add_identifier(state.builder, member.span, member.data.str_id)
            return try ast.add_enum_literal(state.builder, ast.Span{
                start = token.span.start, end = member.span.end, source = token.span.source,
            }, member_id)
        }
        .open_curly: {
            if (state.allow_record_literals and brace_starts_block(state)) {
                body :: try parse_block(state)
                return try ast.add_block_expr(state.builder, ast.builder_span(state.builder, body), body)
            }
            if (state.allow_record_literals) return try parse_record_literal(state, null, token.span.start)
            diagnostic :: try diagnostics.add(state.diagnostics, .unexpected_token, token.span)
            return try ast.add_invalid_expr(state.builder, token.span, diagnostic)
        }
        .open_bracket: {
            if array_starts_type(state) return try parse_type(state)
            return try parse_array_literal(state)
        }
        .open_paren: {
            state.next_token += 1
            previous :: state.allow_record_literals
            state.allow_record_literals = true
            defer state.allow_record_literals = previous
            state.paren_depth += 1
            defer state.paren_depth -= 1
            expression :: try parse_expr(state)
            if next_is(state, .close_paren) {
                state.next_token += 1
                return expression
            }
            diagnostic :: try diagnostics.add(
                state.diagnostics,
                .unexpected_token,
                current(state).span,
            )
            return try ast.add_invalid_expr(state.builder, ast.Span{
                start = token.span.start,
                end = ast.builder_span(state.builder, expression).end,
                source = token.span.source,
            }, diagnostic)
        }
        .int: {
            state.next_token += 1
            return try ast.add_literal(state.builder, .int, token.span)
        }
        .float: {
            state.next_token += 1
            return try ast.add_literal(state.builder, .float, token.span)
        }
        .string: {
            state.next_token += 1
            return try ast.add_literal(state.builder, .string, token.span)
        }
        .true, .false: {
            state.next_token += 1
            return try ast.add_literal(state.builder, .bool, token.span)
        }
        .null: {
            state.next_token += 1
            return try ast.add_literal(state.builder, .null, token.span)
        }
        .undefined: {
            state.next_token += 1
            return try ast.add_literal(state.builder, .undefined, token.span)
        }
        .ident: {
            state.next_token += 1
            return try ast.add_identifier(state.builder, token.span, token.data.str_id)
        }
        else: {
            diagnostic :: try unexpected_diagnostic(state)

            if (!is_expression_recovery_boundary(token.kind)) state.next_token += 1

            return try ast.add_invalid_expr(state.builder, token.span, diagnostic)
        }
    }
}

@hide:file
is_expression_boundary proc(kind lexer.TokenKind) bool {
    return match kind {
        .close_paren, .newline, .close_curly, .open_curly, .else, .return, .yield, .if, .while, .for, .inline, .defer, .errdefer, .eof: true
        else: false
    }
}

@hide:file
is_call_boundary proc(kind lexer.TokenKind) bool {
    return (
        kind == .break
        or kind == .continue
        or (kind != .open_curly and is_expression_boundary(kind))
    )
}

@hide:file
is_expression_recovery_boundary proc(kind lexer.TokenKind) bool {
    return (
        kind == .comma
        or kind == .close_bracket
        or kind == .and
        or kind == .or
        or kind == .pipe
        or kind == .catch
        or is_expression_boundary(kind)
    )
}

@hide:file
skip_operand_newlines proc(state @mut State) void {
    if (state.paren_depth == 0 or !next_is(state, .newline)) return
    start :: state.next_token
    skip_newlines(state)
    kind :: current(state).kind
    if (kind != .close_paren and is_expression_boundary(kind)) state.next_token = start
    # a missing operand must not consume the declaration or assignment on the next line.
    if (
        named_binding_starts(state)
        or (next_is(state, .ident) and next_n_is(state, 1, .equal))
    ) state.next_token = start
}

@hide:file
skip_argument_newlines proc(state @mut State) void {
    skip_operand_newlines(state)
    if (!next_is(state, .newline)) return
    start :: state.next_token
    skip_newlines(state)
    if (!next_is(state, .open_curly)) state.next_token = start
}

@hide:file
skip_continuation_newlines proc(state @mut State) void {
    if (state.paren_depth == 0 or !next_is(state, .newline)) return
    start :: state.next_token
    skip_newlines(state)
    kind :: current(state).kind
    if (
        kind != .close_paren and kind != .comma and kind != .open_paren
        and kind != .close_bracket and kind != .open_bracket
        and kind != .range and kind != .range_inclusive
        and kind != .pipe and kind != .bang and kind != .catch
        and infix_binding_power(kind) == null
    ) state.next_token = start
}

@hide:file
recover_decl proc(
    state @mut State,
    start usize,
) ast.NodeId ! (mem.AllocError | diagnostics.CapacityError) {
    diagnostic :: try unexpected_diagnostic(state)
    span :: synchronize(state, start, false, false, true)
    return try ast.add_invalid_decl(state.builder, span, diagnostic)
}

@hide:file
recover_statement proc(
    state @mut State,
    start usize,
) ast.NodeId ! (mem.AllocError | diagnostics.CapacityError) {
    diagnostic :: try unexpected_diagnostic(state)
    span :: synchronize(state, start, true, false, true)
    return try ast.add_invalid_stmt(state.builder, span, diagnostic)
}

@hide:file
synchronize proc(
    state @mut State, start usize, stop_at_curly, allow_else, consume_newline bool,
) ast.Span {
    first :: state.tokens[start].span
    end := first.end
    curly usize := 0
    paren usize := 0
    square usize := 0
    for (start..state.next_token) |i| {
        kind :: state.tokens[i].kind
        if (kind == .open_paren) paren += 1
        if (kind == .close_paren and paren > 0) paren -= 1
        if (kind == .open_bracket) square += 1
        if (kind == .close_bracket and square > 0) square -= 1
    }
    while !next_is(state, .eof) {
        if (curly == 0) {
            if (stop_at_curly and next_is(state, .close_curly)) break
            if (allow_else and next_is(state, .else)) break
            if (
                next_is(state, .newline)
                and !recovery_closes_delimiters(state, paren, square)
            ) break
        }
        kind :: current(state).kind
        if (kind == .open_curly) curly += 1
        if (kind == .close_curly and curly > 0) curly -= 1
        if (kind == .open_paren) paren += 1
        if (kind == .close_paren and paren > 0) paren -= 1
        if (kind == .open_bracket) square += 1
        if (kind == .close_bracket and square > 0) square -= 1
        end = current(state).span.end
        state.next_token += 1
    }
    if (consume_newline and next_is(state, .newline)) {
        end = current(state).span.end
        state.next_token += 1
    }
    return ast.Span{
        start = first.start,
        end = end,
        source = first.source,
    }
}

@hide:file
recovery_closes_delimiters proc(state @State, paren_depth, square_depth usize) bool {
    if (paren_depth == 0 and square_depth == 0) return false
    paren := paren_depth
    square := square_depth
    for (state.next_token)..(state.tokens.len) |i| {
        kind :: state.tokens[i].kind
        match kind {
            .open_curly, .close_curly, .eof, .if, .else, .while, .for, .inline,
            .return, .break, .continue, .defer, .errdefer: return false
            .ident: {
                if (i + 1 < state.tokens.len) {
                    next :: state.tokens[i + 1].kind
                    if (next == .double_colon or next == .colon_equal or next == .ident or next == .proc) return false
                }
            }
            else: {}
        }
        if (kind == .open_paren) paren += 1
        if (kind == .close_paren and paren > 0) paren -= 1
        if (kind == .open_bracket) square += 1
        if (kind == .close_bracket and square > 0) square -= 1
        if (paren == 0 and square == 0) return true
    }
    return false
}

@hide:file
unexpected_diagnostic proc(state @mut State) diagnostics.DiagnosticId ! (mem.AllocError | diagnostics.CapacityError) {
    token :: current(state)
    if (token.kind == .invalid and token.data.diagnostic != diagnostics.no_diagnostic) return token.data.diagnostic
    return try diagnostics.add(state.diagnostics, .unexpected_token, token.span)
}

@hide:file
skip_newlines proc(state @mut State) void {
    while next_is(state, .newline) state.next_token += 1
}

@hide:file
current proc(state @State) lexer.Token {
    if (state.next_token >= state.tokens.len) return state.tokens[state.tokens.len - 1]
    return state.tokens[state.next_token]
}

@hide:file
next_is proc(state @State, kind lexer.TokenKind) bool {
    return current(state).kind == kind
}

@hide:file
next_n_is proc(state @State, count usize, kind lexer.TokenKind) bool {
    index :: state.next_token + count
    return index < state.tokens.len and state.tokens[index].kind == kind
}

@hide:file
consume proc(state @mut State, kind lexer.TokenKind) lexer.Token ! SyntaxError {
    token :: current(state)
    if (token.kind != kind) return .unexpected_token
    state.next_token += 1
    return token
}

@hide:file
consume_either proc(state @mut State, kinds []lexer.TokenKind) lexer.Token ! SyntaxError {
    token :: current(state)
    for (kinds) |kind| {
        if token.kind == kind {
            state.next_token += 1
            return token
        }
    }
    return .unexpected_token
}

@hide:file
prefix_binding_power proc(kind lexer.TokenKind) ?BindingPowerScalar {
    return match kind {
        .minus, .bang, .ampersand, .try: BindingPowerScalar(50)
        else: null
    }
}

@hide:file
infix_binding_power proc(kind lexer.TokenKind) ?BindingPower {
    return match kind {
        .or: BindingPower{ left = BindingPowerScalar(2), right = BindingPowerScalar(3) }
        .and: BindingPower{ left = BindingPowerScalar(4), right = BindingPowerScalar(5) }
        .equal_equal, .not_equal: BindingPower{ left = BindingPowerScalar(10), right = BindingPowerScalar(11) }
        .less, .less_equal, .greater, .greater_equal: BindingPower{ left = BindingPowerScalar(20), right = BindingPowerScalar(21) }
        .plus, .minus: BindingPower{ left = BindingPowerScalar(30), right = BindingPowerScalar(31) }
        .star, .slash: BindingPower{ left = BindingPowerScalar(40), right = BindingPowerScalar(41) }
        else: null
    }
}

@hide:file
binary_operator proc(kind lexer.TokenKind) ast.BinaryOperator {
    return match kind {
        .and: .logical_and
        .or: .logical_or
        .plus: .add
        .minus: .subtract
        .star: .multiply
        .slash: .divide
        .equal_equal: .equal
        .not_equal: .not_equal
        .less: .less
        .less_equal: .less_equal
        .greater: .greater
        .greater_equal: .greater_equal
        else: unreachable
    }
}
