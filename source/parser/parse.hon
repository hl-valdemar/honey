import "@std/mem"
import "@std/arraylist"

import "@source/diagnostics"
import "@source/lexer"
import "@source/ast"
import "@source/strpool"

@hide:file
SyntaxError :: enum { unexpected_token }

@hide:file
ParseError :: alias SyntaxError | mem.AllocError | diagnostics.CapacityError

@hide:file
BindingPowerScalar :: distinct u32

@hide:file
BindingPower :: struct {
    left BindingPowerScalar
    right BindingPowerScalar
}

@hide:file
State :: struct {
    builder @mut ast.Builder
    diagnostics @mut diagnostics.Store
    tokens []lexer.Token
    allocator mem.Allocator
    next_token usize
    paren_depth usize = 0
    allow_record_literals bool = true
    allow_sum_types bool = true
    match_arm_body bool = false
}

@hide:file
ParameterName :: struct {
    token lexer.Token
    start u32
    comptime bool
}

#! borrows `tokens` and `source` while parsing; the returned Tree borrows `source` until ast.deinit.
#! `allocator` supplies returned node storage and temporary lists released before return.
#! the caller owns the Tree and must release it with ast.deinit.
parse proc(
    allocator mem.Allocator,
    tokens []lexer.Token,
    source []u8,
    diagnostic_store @mut diagnostics.Store,
) ast.Tree ! (mem.AllocError | diagnostics.CapacityError) {
    builder := ast.init_builder(allocator, source)
    defer ast.deinit_builder(&builder)
    root :: try parse_source(&builder, tokens, diagnostic_store)
    return ast.finish(&builder, root)
}

#! appends one source to shared node storage; token spans must identify the builder's current source.
#! infrastructure failure rolls back all nodes, extra data, spans, and diagnostics added by this parse.
parse_source proc(
    builder @mut ast.Builder,
    tokens []lexer.Token,
    diagnostic_store @mut diagnostics.Store,
) ast.NodeId ! (mem.AllocError | diagnostics.CapacityError) {
    node_count :: builder.storage.nodes.items.len
    extra_count :: builder.storage.extra.items.len
    diagnostic_count :: diagnostic_store.list.items.len
    errdefer {
        builder.storage.nodes.items = builder.storage.nodes.items.ptr[..node_count]
        builder.storage.spans.items = builder.storage.spans.items.ptr[..node_count]
        builder.storage.extra.items = builder.storage.extra.items.ptr[..extra_count]
        diagnostic_store.list.items = diagnostic_store.list.items.ptr[..diagnostic_count]
    }
    state := State{
        builder = builder,
        diagnostics = diagnostic_store,
        tokens = tokens,
        allocator = builder.storage.nodes.allocator,
        next_token = 0,
    }
    return try parse_package(&state)
}

@hide:file
parse_package proc(state @mut State) ast.NodeId ! (mem.AllocError | diagnostics.CapacityError) {
    declarations arraylist.ArrayList(ast.NodeId) := arraylist.init(state.allocator)
    defer arraylist.deinit(&declarations)

    skip_newlines(state)
    while !next_is(state, .eof) {
        start :: state.next_token
        declaration :: parse_decl(state) catch |err| {
            match err {
                .unexpected_token: {
                    recovered :: try recover_decl(state, start)
                    try arraylist.append(&declarations, recovered)
                    skip_newlines(state)
                    continue
                }
                else: return err
            }
        }
        try arraylist.append(&declarations, declaration)
        skip_newlines(state)
    }

    return try ast.add_package(state.builder, ast.Span{
        start = 0,
        end = u32(state.builder.source.len),
        source = state.builder.source_id,
    }, declarations.items)
}

@hide:file
parse_decl proc(state @mut State) ast.NodeId ! ParseError {
    if (next_is(state, .at)) {
        start :: try consume(state, .at)
        name :: try consume(state, .ident)
        _ = try consume(state, .colon)
        qualifier :: try consume(state, .ident)
        skip_newlines(state)
        declaration :: try parse_decl(state)
        if (
            !mem.eql(state.builder.source[usize(name.span.start)..usize(name.span.end)], "hide")
            or !mem.eql(state.builder.source[usize(qualifier.span.start)..usize(qualifier.span.end)], "file")
        ) {
            span :: ast.Span{ start = start.span.start, end = qualifier.span.end, source = start.span.source }
            diagnostic :: try diagnostics.add(state.diagnostics, .unexpected_token, span)
            return try ast.add_invalid_decl(state.builder, span, diagnostic)
        }
        ast.set_file_local(state.builder, declaration)
        return declaration
    }
    if (
        next_is(state, .import) or next_is(state, .test)
        or (next_is(state, .ident) and next_n_is(state, 1, .double_colon) and next_n_is(state, 2, .import))
    ) return try parse_import_decl(state)
    if (next_is(state, .ident) and (next_n_is(state, 1, .proc) or next_n_is(state, 1, .c_func))) return try parse_func_decl(state)
    return try parse_statement_decl(state)
}

@hide:file
parse_import_decl proc(state @mut State) ast.NodeId ! ParseError {
    start :: current(state).span
    test_only :: next_is(state, .test)
    if (test_only) state.next_token += 1
    namespace ?strpool.StringId := null
    if next_is(state, .ident) {
        name :: try consume(state, .ident)
        namespace = name.data.str_id
        _ = try consume(state, .double_colon)
    }
    _ = try consume(state, .import)
    token :: try consume(state, .string)
    path :: ast.Span{ start = token.span.start + 1, end = token.span.end - 1, source = token.span.source }
    # import paths are literal filesystem paths, not escaped string values.
    valid := path.start != path.end
    for (state.builder.source[usize(path.start)..usize(path.end)]) |byte| {
        if (byte < 32 or byte == 127 or byte == '\\') valid = false
    }
    span :: ast.Span{ start = start.start, end = token.span.end, source = start.source }
    if (!valid) {
        diagnostic :: try diagnostics.add(state.diagnostics, .invalid_import_path, path)
        return try ast.add_invalid_decl(state.builder, span, diagnostic)
    }
    return try ast.add_import_decl(state.builder, span, path, namespace, test_only)
}

@hide:file
parse_func_decl proc(state @mut State) ast.NodeId ! ParseError {
    name :: try consume(state, .ident)
    external :: next_is(state, .c_func)
    _ = try consume_either(state, &[.proc, .c_func])
    _ = try consume(state, .open_paren)

    params arraylist.ArrayList(ast.NodeId) := arraylist.init(state.allocator)
    defer arraylist.deinit(&params)
    variadic :: try parse_parameters(state, &params)
    _ = try consume(state, .close_paren)
    return_type :: try parse_type(state)
    body :: if (external) try ast.add_block(state.builder, ast.builder_span(state.builder, return_type), &[]) else try parse_block(state)
    body_span :: ast.builder_span(state.builder, body)
    id :: try ast.add_function_decl(
        state.builder,
        ast.Span{
            start = name.span.start,
            end = body_span.end,
            source = name.span.source,
        },
        name.span,
        name.data.str_id,
        return_type,
        params.items,
        body,
    )
    if (external) ast.set_function_external(state.builder, id)
    if (variadic) ast.set_callable_variadic(state.builder, id)
    return id
}

@hide:file
parse_parameters proc(
    state @mut State, params @mut arraylist.ArrayList(ast.NodeId),
) bool ! ParseError {
    skip_newlines(state)
    names arraylist.ArrayList(ParameterName) := arraylist.init(state.allocator)
    defer arraylist.deinit(&names)
    while !next_is(state, .close_paren) {
        if (next_is(state, .ellipsis)) {
            state.next_token += 1
            skip_newlines(state)
            if (!next_is(state, .close_paren)) return .unexpected_token
            return true
        }
        arraylist.clear(&names)
        while true {
            start :: current(state).span.start
            comptime :: next_is(state, .dollar)
            if (comptime) state.next_token += 1
            token :: try consume(state, .ident)
            try arraylist.append(&names, ParameterName{
                token = token,
                start = start,
                comptime = comptime,
            })
            if (starts_type(current(state).kind)) break
            _ = try consume(state, .comma)
        }
        type_id :: try parse_type(state)
        type_end :: state.tokens[state.next_token - 1].span.end
        for (names.items) |parameter_name| {
            param_id :: try ast.add_param(
                state.builder,
                ast.Span{ start = parameter_name.start, end = type_end, source = parameter_name.token.span.source },
                parameter_name.token.span,
                parameter_name.token.data.str_id,
                type_id,
            )
            if (parameter_name.comptime) ast.set_param_comptime(state.builder, param_id)
            try arraylist.append(params, param_id)
        }
        skip_newlines(state)
        if next_is(state, .comma) {
            state.next_token += 1
            skip_newlines(state)
        }
    }
    return false
}

@hide:file
parse_block proc(state @mut State) ast.NodeId ! ParseError {
    open :: try consume(state, .open_curly)
    previous_depth :: state.paren_depth
    previous_record_literals :: state.allow_record_literals
    previous_sum_types :: state.allow_sum_types
    previous_match_arm_body :: state.match_arm_body
    state.paren_depth = 0
    state.allow_record_literals = true
    state.allow_sum_types = true
    state.match_arm_body = false
    defer {
        state.paren_depth = previous_depth
        state.allow_record_literals = previous_record_literals
        state.allow_sum_types = previous_sum_types
        state.match_arm_body = previous_match_arm_body
    }
    statements arraylist.ArrayList(ast.NodeId) := arraylist.init(state.allocator)
    defer arraylist.deinit(&statements)

    skip_newlines(state)
    while !next_is(state, .close_curly) and !next_is(state, .eof) {
        start :: state.next_token
        statement :: parse_statement(state, false) catch |err| {
            match err {
                .unexpected_token: {
                    recovered :: try recover_statement(state, start)
                    try arraylist.append(&statements, recovered)
                    skip_newlines(state)
                    continue
                }
                else: return err
            }
        }
        try arraylist.append(&statements, statement)
        skip_newlines(state)
    }

    close :: try consume(state, .close_curly)
    return try ast.add_block(
        state.builder,
        ast.Span{
            start = open.span.start,
            end = close.span.end,
            source = open.span.source,
        },
        statements.items,
    )
}

@hide:file
parse_statement proc(state @mut State, allow_else bool) ast.NodeId ! ParseError {
    if (
        next_is(state, .ident)
        and (next_n_is(state, 1, .ident)
            or next_n_is(state, 1, .struct) or next_n_is(state, 1, .c_struct) or next_n_is(state, 1, .opaque)
            or next_n_is(state, 1, .enum) or next_n_is(state, 1, .union)
            or next_n_is(state, 1, .distinct)
            or next_n_is(state, 1, .match)
            or next_n_is(state, 1, .at)
            or next_n_is(state, 1, .question)
            or (next_n_is(state, 1, .open_paren) and pointer_binding_starts(state))
            or (next_n_is(state, 1, .star) and pointer_binding_starts(state))
            or (next_n_is(state, 1, .open_bracket) and array_starts_type(state))
            or next_n_is(state, 1, .double_colon)
            or next_n_is(state, 1, .colon_equal))
    ) return try parse_statement_decl(state)
    match current(state).kind {
        .if: return try parse_if(state)
        .while: return try parse_while(state, allow_else)
        .for, .inline: return try parse_for(state, allow_else)
        .return: return try parse_return(state, allow_else)
        .yield: return try parse_yield(state, allow_else)
        .break, .continue: return try parse_loop_control(state, allow_else)
        .defer, .errdefer: return try parse_cleanup(state, allow_else)
        .open_curly: return try ast.add_block_stmt(state.builder, try parse_block(state))
        .ident, .int, .float, .string, .true, .false, .minus, .bang, .open_paren, .open_bracket, .struct, .c_struct, .opaque, .c_func,
        .enum, .union, .distinct, .alias, .dot, .match, .ampersand, .at, .star, .question, .null, .undefined, .try, .dollar: {
            expression :: try parse_expr(state)
            if next_is(state, .equal) return try parse_assignment(state, expression, allow_else)
            return try ast.add_expression_stmt(state.builder, expression)
        }
        else: return .unexpected_token
    }
}

@hide:file
parse_error_capture proc(state @mut State) ?ast.NodeId ! ParseError {
    capture ?ast.NodeId := null
    if (!next_is(state, .pipe)) return capture
    state.next_token += 1
    capture = try parse_capture_name(state)
    _ = try consume(state, .pipe)
    return capture
}

@hide:file
parse_cleanup proc(state @mut State, allow_else bool) ast.NodeId ! ParseError {
    keyword :: current(state)
    state.next_token += 1
    error_only :: keyword.kind == .errdefer
    capture ?ast.NodeId :: if (error_only) try parse_error_capture(state) else null
    body :: try parse_arm(state, allow_else)
    return try ast.add_cleanup_stmt(state.builder, ast.Span{
        start = keyword.span.start,
        end = ast.builder_span(state.builder, body).end,
        source = keyword.span.source,
    }, body, capture, error_only)
}

@hide:file
parse_return proc(state @mut State, allow_else bool) ast.NodeId ! ParseError {
    keyword :: try consume(state, .return)
    if (
        next_is(state, .newline) or next_is(state, .close_curly) or next_is(state, .eof)
        or (state.match_arm_body and next_is(state, .comma))
        or (allow_else and next_is(state, .else))
    ) return try ast.add_return_stmt(state.builder, keyword.span, null)
    value :: try parse_expr(state)
    if (
        !next_is(state, .newline) and !next_is(state, .close_curly) and !next_is(state, .eof)
        and !(allow_else and next_is(state, .else))
        and !(state.match_arm_body and next_is(state, .comma))
    ) return .unexpected_token
    # include consumed grouping punctuation, which has no separate expression node.
    end :: state.tokens[state.next_token - 1].span.end
    return try ast.add_return_stmt(
        state.builder,
        ast.Span{
            start = keyword.span.start,
            end = end,
            source = keyword.span.source,
        },
        value,
    )
}

@hide:file
parse_yield proc(state @mut State, allow_else bool) ast.NodeId ! ParseError {
    keyword :: try consume(state, .yield)
    value :: if (
        next_is(state, .newline) or next_is(state, .close_curly) or next_is(state, .eof)
        or (state.match_arm_body and next_is(state, .comma))
        or (allow_else and next_is(state, .else))
    ) {
        diagnostic :: try diagnostics.add(state.diagnostics, .unexpected_token, keyword.span)
        yield try ast.add_invalid_expr(state.builder, keyword.span, diagnostic)
    } else {
        yield try parse_expr(state)
    }
    if (
        !next_is(state, .newline) and !next_is(state, .close_curly) and !next_is(state, .eof)
        and !(allow_else and next_is(state, .else))
        and !(state.match_arm_body and next_is(state, .comma))
    ) return .unexpected_token
    return try ast.add_yield_stmt(state.builder, ast.Span{
        start = keyword.span.start,
        end = state.tokens[state.next_token - 1].span.end,
        source = keyword.span.source,
    }, value)
}

@hide:file
parse_loop_control proc(state @mut State, allow_else bool) ast.NodeId ! ParseError {
    keyword :: current(state)
    state.next_token += 1
    if (
        !next_is(state, .newline)
        and !next_is(state, .close_curly)
        and !next_is(state, .eof)
        and !(allow_else and next_is(state, .else))
        and !(state.match_arm_body and next_is(state, .comma))
    ) return .unexpected_token

    if (keyword.kind == .break)
        return try ast.add_break_stmt(state.builder, keyword.span)

    return try ast.add_continue_stmt(state.builder, keyword.span)
}

@hide:file
parse_assignment proc(state @mut State, target ast.NodeId, allow_else bool) ast.NodeId ! ParseError {
    _ = try consume(state, .equal)
    value :: try parse_expr(state)
    if (
        !next_is(state, .newline)
        and !next_is(state, .close_curly)
        and !next_is(state, .eof)
        and !(allow_else and next_is(state, .else))
        and !(state.match_arm_body and next_is(state, .comma))
    ) return .unexpected_token
    end :: state.tokens[state.next_token - 1].span.end
    return try ast.add_assignment_stmt(
        state.builder,
        ast.Span{
            start = ast.builder_span(state.builder, target).start,
            end = end,
            source = state.builder.source_id,
        },
        target,
        value,
    )
}

@hide:file
parse_if proc(state @mut State) ast.NodeId ! ParseError {
    keyword :: try consume(state, .if)
    condition :: try parse_guard(state)
    capture :: try parse_optional_capture(state)
    then_block :: try parse_arm(state, true)
    after_then :: state.next_token
    skip_newlines(state)
    alternative ?ast.NodeId := null
    if (next_is(state, .else) and !next_n_is(state, 1, .colon)) {
        state.next_token += 1
        alternative = try parse_arm(state, true)
    } else {
        state.next_token = after_then
    }
    end :: if (alternative) |block|
        ast.builder_span(state.builder, block).end
    else
        ast.builder_span(state.builder, then_block).end
    id :: try ast.add_if_stmt(
        state.builder,
        ast.Span{
            start = keyword.span.start,
            end = end,
            source = keyword.span.source,
        },
        condition,
        then_block,
        alternative,
    )
    if (capture) |node| ast.set_capture(state.builder, id, node)
    return id
}

@hide:file
parse_if_expr proc(state @mut State) ast.NodeId ! ParseError {
    keyword :: try consume(state, .if)
    condition :: try parse_guard(state)
    capture :: try parse_optional_capture(state)
    then_value :: try parse_expr(state)
    skip_newlines(state)
    if (!next_is(state, .else) or next_n_is(state, 1, .colon)) return .unexpected_token
    state.next_token += 1
    skip_newlines(state)
    else_value :: try parse_expr(state)
    span :: ast.Span{
        start = keyword.span.start,
        end = ast.builder_span(state.builder, else_value).end,
        source = keyword.span.source,
    }
    # canonical matches share inference, specialization and branch execution.
    patterns [1]ast.NodeId :: [try ast.add_boolean(state.builder, keyword.span, true)]
    then_arm :: try ast.add_match_arm(
        state.builder, ast.builder_span(state.builder, then_value),
        patterns[..], capture, then_value, true, false,
    )
    else_arm :: try ast.add_match_arm(
        state.builder, ast.builder_span(state.builder, else_value),
        &[], null, else_value, true, true,
    )
    arms [2]ast.NodeId :: [then_arm, else_arm]
    result :: try ast.add_match(state.builder, span, condition, arms[..])
    if (capture != null) ast.set_match_optional(state.builder, result)
    return result
}

@hide:file
parse_while proc(state @mut State, allow_else bool) ast.NodeId ! ParseError {
    keyword :: try consume(state, .while)
    condition :: try parse_guard(state)
    capture :: try parse_optional_capture(state)
    body :: try parse_arm(state, allow_else)
    id :: try ast.add_while_stmt(
        state.builder,
        ast.Span{
            start = keyword.span.start,
            end = ast.builder_span(state.builder, body).end,
            source = keyword.span.source,
        },
        condition,
        body,
    )
    if (capture) |node| ast.set_capture(state.builder, id, node)
    return id
}

@hide:file
parse_optional_capture proc(state @mut State) ?ast.NodeId ! ParseError {
    missing ?ast.NodeId :: null
    if (!next_is(state, .pipe)) return missing
    state.next_token += 1
    name :: try consume(state, .ident)
    _ = try consume(state, .pipe)
    return try ast.add_param(state.builder, name.span, name.span, name.data.str_id, maxval!(ast.NodeId))
}

@hide:file
CaptureList :: struct {
    item ?ast.NodeId = null
    index ?ast.NodeId = null
    pointer bool = false
    indexed bool = false
}

@hide:file
parse_capture_name proc(state @mut State) ?ast.NodeId ! ParseError {
    name :: try consume(state, .ident)
    capture ?ast.NodeId := null
    if (
        name.span.end != name.span.start + 1
        or state.builder.source[usize(name.span.start)] != '_'
    ) capture = try ast.add_identifier(
        state.builder,
        name.span,
        name.data.str_id,
    )
    return capture
}

@hide:file
parse_captures proc(state @mut State) CaptureList ! ParseError {
    _ = try consume(state, .pipe)
    captures := CaptureList{}
    if next_is(state, .at) {
        captures.pointer = true
        state.next_token += 1
    }
    captures.item = try parse_capture_name(state)
    if next_is(state, .comma) {
        captures.indexed = true
        state.next_token += 1
        captures.index = try parse_capture_name(state)
    }
    _ = try consume(state, .pipe)
    return captures
}

@hide:file
parse_for proc(state @mut State, allow_else bool) ast.NodeId ! ParseError {
    keyword :: current(state)
    inlined :: next_is(state, .inline)
    if (inlined) state.next_token += 1
    _ = try consume(state, .for)
    skip_newlines(state)
    iterable_start :: state.next_token
    iterable := try parse_guard_expr(state)
    grouped :: parenthesized_guard(state, iterable_start)
    skip_newlines(state)
    captures :: parse_captures(state) catch |err| {
        match err {
            .unexpected_token: {}
            else: return err
        }
        diagnostic :: try diagnostics.add(
            state.diagnostics,
            .unexpected_token,
            current(state).span,
        )
        iterable = try ast.add_invalid_expr(
            state.builder,
            ast.builder_span(state.builder, iterable),
            diagnostic,
        )
        while (
            !next_is(state, .open_curly) and !next_is(state, .close_curly)
            and !next_is(state, .newline) and !next_is(state, .eof)
            and !next_is(state, .else)
        ) state.next_token += 1
        yield CaptureList{}
    }
    after_captures :: state.next_token
    skip_newlines(state)
    if (
        !next_is(state, .open_curly) and !grouped
        and ast.builder_expr_kind(state.builder, iterable) != .call
        and ast.builder_expr_kind(state.builder, iterable) != .invalid
    ) {
        diagnostic :: try diagnostics.add(state.diagnostics, .unexpected_token, current(state).span)
        iterable = try ast.add_invalid_expr(
            state.builder, ast.builder_span(state.builder, iterable), diagnostic,
        )
    }
    # a malformed capture list must not swallow the next line's sibling.
    if (
        ast.builder_expr_kind(state.builder, iterable) == .invalid
        and !next_is(state, .open_curly)
    ) state.next_token = after_captures
    body :: try parse_arm(state, allow_else)
    id :: try ast.add_for_stmt(
        state.builder,
        ast.Span{
            start = keyword.span.start,
            end = ast.builder_span(state.builder, body).end,
            source = keyword.span.source,
        },
        iterable, captures.item, captures.index, captures.pointer, captures.indexed, body,
    )
    if (inlined) ast.set_for_inline(state.builder, id)
    return id
}

@hide:file
parse_guard_expr proc(state @mut State) ast.NodeId ! ParseError {
    previous :: state.allow_record_literals
    previous_sum_types :: state.allow_sum_types
    state.allow_record_literals = false
    # capture pipes stay boundaries even when an index/call permits record literals.
    state.allow_sum_types = false
    defer {
        state.allow_record_literals = previous
        state.allow_sum_types = previous_sum_types
    }
    return try parse_expr(state)
}

@hide:file
parse_guard proc(state @mut State) ast.NodeId ! ParseError {
    condition_start :: state.next_token
    condition := parse_guard_expr(state) catch |err| {
        match err {
            .unexpected_token: {}
            else: return err
        }
        diagnostic :: try diagnostics.add(state.diagnostics, .unexpected_token, current(state).span)
        yield try ast.add_invalid_expr(state.builder, current(state).span, diagnostic)
    }
    if (ast.builder_expr_kind(state.builder, condition) == .invalid) {
        # discard a malformed guard's tail, but leave its body and enclosing block intact.
        while (
            !next_is(state, .open_curly) and !next_is(state, .close_curly)
            and !next_is(state, .newline) and !next_is(state, .eof)
            and !next_is(state, .else) and !next_is(state, .return)
            and !next_is(state, .if) and !next_is(state, .while)
            and !next_is(state, .for) and !next_is(state, .inline)
            and !next_is(state, .break) and !next_is(state, .continue)
        ) {
            if (next_is(state, .ident) and next_n_is(state, 1, .equal)) break
            state.next_token += 1
        }
    }
    if (
        !next_is(state, .open_curly)
        and !next_is(state, .pipe)
        and !parenthesized_guard(state, condition_start)
        and ast.builder_expr_kind(state.builder, condition) != .call
        and ast.builder_expr_kind(state.builder, condition) != .comptime_expr
        and ast.builder_expr_kind(state.builder, condition) != .invalid
    ) {
        diagnostic :: try diagnostics.add(state.diagnostics, .unexpected_token, current(state).span)
        condition = try ast.add_invalid_expr(
            state.builder,
            ast.builder_span(state.builder, condition),
            diagnostic,
        )
    }
    return condition
}

@hide:file
parenthesized_guard proc(state @State, start usize) bool {
    if (state.tokens[start].kind != .open_paren) return false
    depth usize := 0
    for start..state.next_token |index| {
        kind :: state.tokens[index].kind
        if (kind == .open_paren) depth += 1
        if (kind == .close_paren) {
            depth -= 1
            if (depth == 0) return index + 1 == state.next_token
        }
    }
    return false
}

@hide:file
parse_arm proc(state @mut State, allow_else bool) ast.NodeId ! ParseError {
    if next_is(state, .open_curly) return try parse_block(state)
    start :: state.next_token
    statement :: parse_statement(state, allow_else) catch |err| {
        match err {
            .unexpected_token: {}
            else: return err
        }
        diagnostic :: try unexpected_diagnostic(state)
        span :: synchronize(state, start, true, true, false)
        yield try ast.add_invalid_stmt(state.builder, span, diagnostic)
    }
    statements [1]ast.NodeId :: [statement]
    return try ast.add_block(
        state.builder,
        ast.builder_span(state.builder, statement),
        statements[..],
    )
}


@hide:file
parse_statement_decl proc(state @mut State) ast.NodeId ! ParseError {
    name :: try consume(state, .ident)
    type_id ?ast.NodeId :: if (starts_type(current(state).kind))
        try parse_type(state)
    else
        null

    assignment :: try consume_either(state, &[.double_colon, .colon_equal])
    initializer :: try parse_expr(state)
    end :: ast.builder_span(state.builder, initializer).end
    mutability :: if (assignment.kind == .double_colon) .constant else .variable
    return try ast.add_statement_decl(
        state.builder,
        ast.Span{
            start = name.span.start,
            end = end,
            source = name.span.source,
        },
        name.span,
        name.data.str_id,
        type_id,
        mutability,
        initializer,
    )
}

@hide:file
parse_type proc(state @mut State) ast.NodeId ! ParseError {
    skip_operand_newlines(state)
    start :: current(state).span
    left := try parse_type_atom(state)
    while true {
        skip_continuation_newlines(state)
        if (!next_is(state, .pipe)) break
        state.next_token += 1
        right :: try parse_type_atom(state)
        left = try ast.add_binary_type(state.builder, ast.Span{
            start = start.start,
            end = state.tokens[state.next_token - 1].span.end,
            source = start.source,
        }, left, right, false)
    }
    if (next_is(state, .bang)) {
        state.next_token += 1
        right :: try parse_type(state)
        left = try ast.add_binary_type(state.builder, ast.Span{
            start = start.start,
            end = state.tokens[state.next_token - 1].span.end,
            source = start.source,
        }, left, right, true)
    }
    return left
}

@hide:file
parse_type_atom proc(state @mut State) ast.NodeId ! ParseError {
    skip_operand_newlines(state)
    if (next_is(state, .open_paren)) {
        state.next_token += 1
        state.paren_depth += 1
        defer state.paren_depth -= 1
        child :: try parse_type(state)
        _ = try consume(state, .close_paren)
        return child
    }
    if (next_is(state, .question)) {
        token :: current(state)
        state.next_token += 1
        child :: try parse_type_atom(state)
        return try ast.add_optional_type(state.builder, ast.Span{
            start = token.span.start, end = state.tokens[state.next_token - 1].span.end, source = token.span.source,
        }, child)
    }
    if (next_is(state, .at) or next_is(state, .star)) {
        token :: current(state)
        state.next_token += 1
        mutable :: next_is(state, .mut)
        if (mutable) state.next_token += 1
        if (next_is(state, .proc) or next_is(state, .c_func))
            return try parse_function_type(state, token.span, mutable or (token.kind == .star and !next_is(state, .c_func)))
        element :: try parse_type_atom(state)
        return try ast.add_pointer_type(state.builder, ast.Span{
            start = token.span.start,
            end = state.tokens[state.next_token - 1].span.end,
            source = token.span.source,
        }, element, mutable, token.kind == .star)
    }
    if next_is(state, .open_bracket) {
        open :: try consume(state, .open_bracket)
        if (next_is(state, .close_bracket) or next_is(state, .semicolon)) {
            sentinel ?ast.NodeId := null
            if (next_is(state, .semicolon)) {
                state.next_token += 1
                sentinel = try parse_expr(state)
            }
            _ = try consume(state, .close_bracket)
            mutable :: next_is(state, .mut)
            if (mutable) state.next_token += 1
            element :: try parse_type_atom(state)
            return try ast.add_slice_type(state.builder, ast.Span{
                start = open.span.start, end = state.tokens[state.next_token - 1].span.end, source = open.span.source,
            }, element, mutable, sentinel)
        }
        count ?ast.NodeId := null
        if (
            next_is(state, .ident)
            and current(state).span.end == current(state).span.start + 1
            and state.builder.source[usize(current(state).span.start)] == '_'
        ) {
            state.next_token += 1
        } else {
            count = try parse_expr(state)
        }
        _ = try consume(state, .close_bracket)
        mutable :: next_is(state, .mut)
        if (mutable) state.next_token += 1
        element :: try parse_type_atom(state)
        return try ast.add_array_type(
            state.builder,
            ast.Span{
                start = open.span.start,
                end = state.tokens[state.next_token - 1].span.end,
                source = open.span.source,
            },
            count, element, mutable,
        )
    }
    if (next_is(state, .proc) or next_is(state, .c_func)) return try parse_function_type(state, current(state).span, false)
    if (next_is(state, .struct) or next_is(state, .c_struct)) return try parse_record_type(state)
    if (next_is(state, .opaque)) {
        token :: try consume(state, .opaque)
        id :: try ast.add_record_type(state.builder, token.span, &[])
        ast.set_record_opaque(state.builder, id)
        return id
    }
    if next_is(state, .enum) return try parse_enum_type(state)
    if next_is(state, .union) return try parse_union_type(state)
    if next_is(state, .match) return try parse_match(state)
    if next_is(state, .if) return try parse_if_expr(state)
    if (next_is(state, .distinct) or next_is(state, .alias)) return try parse_type_wrapper(state)
    token :: try consume(state, .ident)
    type := try ast.add_identifier(state.builder, token.span, token.data.str_id)
    while true {
        if (next_is(state, .open_paren)) {
            type = try parse_call(state, type, token.span.start, false)
            continue
        }
        if (next_is(state, .open_bracket)) {
            type = try parse_index(state, type, token.span.start)
            continue
        }
        if (!next_is(state, .dot)) break
        state.next_token += 1
        member :: try consume_member(state, false)
        member_id :: try ast.add_identifier(state.builder, member.span, member.data.str_id)
        type = try ast.add_selection(state.builder, ast.Span{
            start = token.span.start,
            end = member.span.end,
            source = token.span.source,
        }, type, member_id)
    }
    return type
}

@hide:file
parse_function_type proc(state @mut State, start ast.Span, invalid bool) ast.NodeId ! ParseError {
    external :: next_is(state, .c_func)
    _ = try consume_either(state, &[.proc, .c_func])
    _ = try consume(state, .open_paren)
    params := arraylist.init(ast.NodeId, state.allocator)
    defer arraylist.deinit(&params)
    variadic :: try parse_parameters(state, &params)
    _ = try consume(state, .close_paren)
    result :: try parse_type(state)
    span :: ast.Span{
        start = start.start,
        end = state.tokens[state.next_token - 1].span.end,
        source = start.source,
    }
    if (invalid) {
        diagnostic :: try diagnostics.add(state.diagnostics, .invalid_pointer_type, span)
        return try ast.add_invalid_expr(state.builder, span, diagnostic)
    }
    id :: try ast.add_function_type(state.builder, span, result, params.items)
    if (external) ast.set_callable_foreign(state.builder, id)
    if (variadic) ast.set_callable_variadic(state.builder, id)
    return id
}

@hide:file
starts_type proc(kind lexer.TokenKind) bool {
    return (
        kind == .ident or kind == .open_bracket or kind == .struct or kind == .c_struct or kind == .opaque
        or kind == .enum or kind == .union or kind == .distinct or kind == .alias or kind == .match
        or kind == .if
        or kind == .at or kind == .star or kind == .question or kind == .open_paren or kind == .proc or kind == .c_func
    )
}

@hide:file
member_name proc(kind lexer.TokenKind) bool {
    return match kind {
        .ident, .if, .else, .for, .inline, .while, .proc, .return, .yield, .break, .continue,
        .true, .false, .and, .or, .mut, .struct, .c_struct, .opaque, .enum, .union, .distinct,
        .alias, .match, .import, .test, .c_func, .null, .undefined, .try, .catch, .defer, .errdefer: true
        else: false
    }
}

@hide:file
consume_member proc(state @mut State, numeric bool) lexer.Token ! SyntaxError {
    token :: current(state)
    if (!member_name(token.kind) and !(numeric and token.kind == .int)) return .unexpected_token
    state.next_token += 1
    return token
}

@hide:file
parse_type_wrapper proc(state @mut State) ast.NodeId ! ParseError {
    keyword :: current(state)
    state.next_token += 1
    operand :: try parse_type(state)
    return try ast.add_type_operand(state.builder, ast.Span{
        start = keyword.span.start,
        end = ast.builder_span(state.builder, operand).end,
        source = keyword.span.source,
    }, operand, keyword.kind == .alias)
}

@hide:file
parse_enum_type proc(state @mut State) ast.NodeId ! ParseError {
    keyword :: try consume(state, .enum)
    backing ?ast.NodeId := null
    if next_is(state, .open_paren) {
        state.next_token += 1
        backing = try parse_type(state)
        _ = try consume(state, .close_paren)
    }
    skip_newlines(state)
    _ = try consume(state, .open_curly)
    members arraylist.ArrayList(ast.NodeId) := arraylist.init(state.allocator)
    defer arraylist.deinit(&members)
    skip_newlines(state)
    while (!next_is(state, .close_curly) and !next_is(state, .eof)) {
        if (
            next_is(state, .ident)
            and (next_n_is(state, 1, .double_colon) or next_n_is(state, 1, .colon_equal) or next_n_is(state, 1, .proc))
        ) return try invalid_record(state, keyword.span.start, false)
        start :: state.next_token
        member :: parse_enum_member(state) catch |err| {
            match err {
