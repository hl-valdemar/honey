import "@std/mem"
import "@std/arraylist"
import "@std/testing"
import "@source/diagnostics"
import "@source/strpool"
import "@source/lexer"
import "@source/parser"
import "@source/ast"
import "@source/ir"
import "@source/interpreter"
sema :: import "@source/sema"
typecheck :: import "@source/sema/check"

@hide:file
CompileError :: alias mem.AllocError | diagnostics.CapacityError | strpool.InternError | lexer.SourceError

# every consumer test executes only after all source and frontend storage is gone.
@hide:file
compile_owned proc(text []u8, diagnostic_store @mut diagnostics.Store) ir.Module ! CompileError {
    source :: try mem.alloc(u8, mem.c_allocator, text.len)
    defer mem.free(mem.c_allocator, source)
    for (text) |byte, i| source[i] = byte
    strings := strpool.init(mem.c_allocator)
    defer strpool.deinit(&strings)
    scan_state := lexer.init(mem.c_allocator)
    defer lexer.deinit(&scan_state)
    try lexer.scan(&scan_state, source, &strings, diagnostic_store)
    tree := try parser.parse(mem.c_allocator, scan_state.tokens.items, source, diagnostic_store)
    defer ast.deinit(&tree)
    resolution := try sema.resolve(mem.c_allocator, &tree, &strings, diagnostic_store)
    defer sema.deinit(&resolution)
    checked := try typecheck.check(mem.c_allocator, &tree, &resolution, diagnostic_store)
    defer typecheck.deinit(&checked)
    return try lower(mem.c_allocator, &tree, &resolution, &checked, diagnostic_store)
}

@hide:file
expect_trap proc(
    outcome interpreter.Outcome,
    diagnostic_store @diagnostics.Store,
    code diagnostics.Code,
) void ! testing.Error {
    if (outcome.trap) |id| {
        if (diagnostics.get(diagnostic_store, id)) |diagnostic| {
            try testing.expect_equal(code, diagnostic.code)
            return
        }
    }
    return .expectation_failed
}

executes_calls_locals_arithmetic_and_nested_argument_slices test {
    diagnostic_store := diagnostics.init(mem.c_allocator)
    defer diagnostics.deinit(&diagnostic_store)
    source ::
        `add proc(left int, right int) int {
        `    result :: left + right
        `    return result
        `}
        `double proc(value int) int {
        `    return value * 2
        `}
        `main proc() int {
        `    a :: add(double(4), add(5, 6))
        `    b :: add(10, 13)
        `    return a + b
        `}
    module := try compile_owned(source, &diagnostic_store)
    defer ir.deinit(&module)
    try testing.expect_equal(0, diagnostics.count(&diagnostic_store))
    outcome := try interpreter.run(mem.c_allocator, &module, &diagnostic_store)
    defer interpreter.deinit(&outcome)
    try testing.expect(outcome.trap == null)
    try testing.expect_equal(ir.Type.int, outcome.value.type)
    try testing.expect_equal(i64(42), outcome.value.data.integer)
}

owns_decoded_strings_after_source_and_frontend_are_freed test {
    diagnostic_store := diagnostics.init(mem.c_allocator)
    defer diagnostics.deinit(&diagnostic_store)
    source ::
        `text :: "a\\\"\n\r\t\0\x41\x7a"
        `identity proc(value string) string {
        `    return value
        `}
        `main proc() string {
        `    return identity(text)
        `}
    module := try compile_owned(source, &diagnostic_store)
    defer ir.deinit(&module)
    try testing.expect_equal(0, diagnostics.count(&diagnostic_store))
    outcome := try interpreter.run(mem.c_allocator, &module, &diagnostic_store)
    defer interpreter.deinit(&outcome)
    try testing.expect(outcome.trap == null)
    try testing.expect_equal(ir.Type.string, outcome.value.type)
    try testing.expect(mem.eql(ir.string_bytes(&module, outcome.value.data.string), "a\\\"\n\r\t\x00Az"))
}

resolves_module_local_string_ids_after_frontend_cleanup test {
