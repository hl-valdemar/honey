lazy_branchful_global_initializers_and_calls_release_every_runtime_allocation test {
    diagnostic_store := diagnostics.init(mem.c_allocator)
    defer diagnostics.deinit(&diagnostic_store)
    source ::
        `first :: true and later
        `later :: false or !false
        `both proc(left bool, right bool) bool { return left and right }
        `bound proc(flag bool, value int) int {
        `    if flag { return value }
        `    return 0
        `}
        `main proc() bool {
        `    n := 3
        `    for bound(first or false, 0)..bound(both(first, true and later), 3) |i| {
        `        local :: both(first and first, later or false)
        `        if (local and i < 2) continue else break
        `    }
        `    while both(first and first, both(false or later, !false and later)) and n > 0 {
        `        n = n - 1
        `        if (n > 0) continue else break
        `    }
        `    return both(first and first, both(false or later, !false and later))
        `}
    module := try compile_owned(source, &diagnostic_store)
    defer ir.deinit(&module)
    try testing.expect_equal(0, diagnostics.count(&diagnostic_store))
    failures := usize(0)
    succeeded := false
    for (usize(0)..usize(64)) |limit| {
        state := AllocationState{ remaining = limit }
        allocator :: mem.Allocator{ context = &state, vtable = &limited_vtable }
        outcome := interpreter.run(allocator, &module, &diagnostic_store) catch |error| {
            try testing.expect(error == .out_of_memory)
            failures += 1
            try testing.expect_equal(usize(0), state.live)
            continue
        }
        defer interpreter.deinit(&outcome)
        try testing.expect(outcome.trap == null)
        try testing.expect(outcome.value.data.boolean)
        interpreter.deinit(&outcome)
        try testing.expect_equal(usize(0), state.live)
        succeeded = true
        break
    }
    try testing.expect(succeeded)
    try testing.expect(failures > 0)
    try testing.expect_equal(0, diagnostics.count(&diagnostic_store))
}

