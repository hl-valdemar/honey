executes_forward_lazy_globals_and_function_aliases test {
    diagnostic_store := diagnostics.init(mem.c_allocator)
    defer diagnostics.deinit(&diagnostic_store)
    source ::
        `forward :: later + 1
        `alias :: add
        `later :: 18
        `add proc(left int, right int) int {
        `    local_alias :: alias
        `    return left + right
        `}
        `main proc() int {
        `    invoke :: alias
        `    return invoke(forward, 23)
        `}
    module := try compile_owned(source, &diagnostic_store)
    defer ir.deinit(&module)
    try testing.expect_equal(0, diagnostics.count(&diagnostic_store))
    outcome :: try interpreter.run(mem.c_allocator, &module, &diagnostic_store)
    try testing.expect(outcome.trap == null)
    try testing.expect_equal(i64(42), outcome.value.data.integer)
    again :: try interpreter.run(mem.c_allocator, &module, &diagnostic_store)
    try testing.expect(again.trap == null)
    try testing.expect_equal(i64(42), again.value.data.integer)
}

supports_bare_void_value_returns_and_fallthrough test {
    sources [3][]u8 :: [
        "main proc() void {\n return\n}\n",
        "noop proc() void {}\nmain proc() void {\n return noop()\n}\n",
        "noop proc() void {}\nmain proc() void {\n noop()\n}\n",
    ]
    for (sources) |source| {
        diagnostic_store := diagnostics.init(mem.c_allocator)
        defer diagnostics.deinit(&diagnostic_store)
        module := try compile_owned(source, &diagnostic_store)
        defer ir.deinit(&module)
        try testing.expect_equal(0, diagnostics.count(&diagnostic_store))
        outcome :: try interpreter.run(mem.c_allocator, &module, &diagnostic_store)
        try testing.expect(outcome.trap == null)
        try testing.expect_equal(ir.Type.void, outcome.value.type)
    }
}

preserves_demanded_diagnostic_identity_and_source_location test {
    diagnostic_store := diagnostics.init(mem.c_allocator)
    defer diagnostics.deinit(&diagnostic_store)
    source ::
        `bad proc() int {
        `    return unknown
        `}
        `main proc() int {
        `    before :: 1 + 2
        `    return bad()
        `}
    module := try compile_owned(source, &diagnostic_store)
    defer ir.deinit(&module)
    try testing.expect_equal(1, diagnostics.count(&diagnostic_store))
    diagnostic :: diagnostics.get(&diagnostic_store, diagnostics.DiagnosticId(0))?
    try testing.expect_equal(diagnostics.Code.unknown_name, diagnostic.code)
    try testing.expect(mem.eql(source[usize(diagnostic.span.start)..usize(diagnostic.span.end)], "unknown"))
    outcome :: try interpreter.run(mem.c_allocator, &module, &diagnostic_store)
    try testing.expect_equal(diagnostics.DiagnosticId(0), outcome.trap?)
    try testing.expect_equal(1, diagnostics.count(&diagnostic_store))
}

skips_unreachable_and_unused_invalid_code test {
    diagnostic_store := diagnostics.init(mem.c_allocator)
    defer diagnostics.deinit(&diagnostic_store)
    source ::
        `bad proc() int {
        `    return unknown
        `}
        `unused :: "\q"
        `main proc() int {
        `    return 42
        `    9223372036854775807 + 1
        `    missing
        `    huge :: 9223372036854775808
        `}
