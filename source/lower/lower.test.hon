conditional_errors_trap_only_when_demanded_and_preserve_original_identity test {
    sources [7][]u8 :: [
        "main proc() int {\n if true {\n return 42\n } else {\n return unknown\n }\n}\n",
        "main proc() int {\n if false {\n return 42\n } else {\n return unknown\n }\n}\n",
        "main proc() int {\n if true {\n return 42\n }\n}\n",
        "main proc() int {\n if false {\n return 42\n }\n}\n",
        "main proc() void {\n if false {\n unknown\n }\n}\n",
        "main proc() int {\n if 1 {\n return 42\n } else {\n return 0\n }\n}\n",
        "main proc() int {\n if unknown {\n return 42\n }\n}\n",
    ]
    for (sources) |source, index| {
        diagnostic_store := diagnostics.init(mem.c_allocator)
        defer diagnostics.deinit(&diagnostic_store)
        module := try compile_owned(source, &diagnostic_store)
        defer ir.deinit(&module)
        try testing.expect_equal(1, diagnostics.count(&diagnostic_store))
        original :: diagnostics.get(&diagnostic_store, diagnostics.DiagnosticId(0))?
        outcome := try interpreter.run(mem.c_allocator, &module, &diagnostic_store)
        defer interpreter.deinit(&outcome)
        if (index == 0 or index == 2 or index == 4) {
            try testing.expect(outcome.trap == null)
            if (index == 4) try testing.expect_equal(ir.Type.void, outcome.value.type)
            else try testing.expect_equal(i64(42), outcome.value.data.integer)
        } else {
            try testing.expect_equal(diagnostics.DiagnosticId(0), outcome.trap?)
            code := diagnostics.Code.unknown_name
            if (index == 3) code = .missing_return
            if (index == 5) code = .condition_not_bool
            try testing.expect_equal(code, original.code)
            if (index == 5) try testing.expect(mem.eql(source[usize(original.span.start)..usize(original.span.end)], "1"))
        }
        try testing.expect_equal(1, diagnostics.count(&diagnostic_store))
    }
}

