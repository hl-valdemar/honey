        defer diagnostics.deinit(&diagnostic_store)
        module := try compile_owned(source, &diagnostic_store)
        defer ir.deinit(&module)
        try testing.expect_equal(0, diagnostics.count(&diagnostic_store))
        outcome := try interpreter.run(mem.c_allocator, &module, &diagnostic_store)
        defer interpreter.deinit(&outcome)
        try testing.expect(outcome.trap == null)
        try testing.expect_equal(ir.Type.void, outcome.value.type)
    }
}

preserves_demanded_diagnostic_identity_and_source_location test {
    diagnostic_store := diagnostics.init(mem.c_allocator)
    defer diagnostics.deinit(&diagnostic_store)
    source ::
        `bad proc() int {
        `    return unknown
        `}
        `main proc() int {
        `    before :: 1 + 2
        `    return bad()
        `}
    module := try compile_owned(source, &diagnostic_store)
    defer ir.deinit(&module)
    try testing.expect_equal(1, diagnostics.count(&diagnostic_store))
    diagnostic :: diagnostics.get(&diagnostic_store, diagnostics.DiagnosticId(0))?
    try testing.expect_equal(diagnostics.Code.unknown_name, diagnostic.code)
    try testing.expect(mem.eql(source[usize(diagnostic.span.start)..usize(diagnostic.span.end)], "unknown"))
    outcome := try interpreter.run(mem.c_allocator, &module, &diagnostic_store)
    defer interpreter.deinit(&outcome)
    try testing.expect_equal(diagnostics.DiagnosticId(0), outcome.trap?)
    try testing.expect_equal(1, diagnostics.count(&diagnostic_store))
}

