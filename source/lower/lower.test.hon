}

traps_local_forward_loads_and_global_initialization_cycles test {
    sources [3][]u8 :: [
        "main proc() int {\n before :: after\n after :: 42\n return before\n}\n",
        "left int :: right\nright int :: left\nmain proc() int {\n return left\n}\n",
        "self int :: self\nmain proc() int {\n return self\n}\n",
    ]
    for (sources) |source, i| {
        diagnostic_store := diagnostics.init(mem.c_allocator)
        defer diagnostics.deinit(&diagnostic_store)
        module := try compile_owned(source, &diagnostic_store)
        defer ir.deinit(&module)
        try testing.expect_equal(0, diagnostics.count(&diagnostic_store))
        outcome :: try interpreter.run(mem.c_allocator, &module, &diagnostic_store)
        code diagnostics.Code :: if (i == 0) .read_before_initialization else .initialization_cycle
        try expect_trap(outcome, &diagnostic_store, code)
    }
}

handles_integer_boundaries_without_host_overflow test {
    sources [3][]u8 :: [
        "main proc() int {\n return 9223372036854775807\n}\n",
        "main proc() int {\n return -9223372036854775808\n}\n",
        "main proc() int {\n return -0009223372036854775808\n}\n",
    ]
    expected [3]i64 :: [maxval!(i64), minval!(i64), minval!(i64)]
    for (sources) |source, i| {
        diagnostic_store := diagnostics.init(mem.c_allocator)
        defer diagnostics.deinit(&diagnostic_store)
        module := try compile_owned(source, &diagnostic_store)
        defer ir.deinit(&module)
        try testing.expect_equal(0, diagnostics.count(&diagnostic_store))
        outcome :: try interpreter.run(mem.c_allocator, &module, &diagnostic_store)
        try testing.expect(outcome.trap == null)
        try testing.expect_equal(expected[i], outcome.value.data.integer)
    }
}

traps_invalid_literals_escapes_and_checked_integer_arithmetic test {
    sources [8][]u8 :: [
        "main proc() int {\n return 9223372036854775808\n}\n",
        "main proc() int {\n return -9223372036854775809\n}\n",
        "main proc() int {\n return 9223372036854775807 + 1\n}\n",
        "main proc() int {\n return -(-9223372036854775808)\n}\n",
        "main proc() int {\n return -9223372036854775808 - 1\n}\n",
        "main proc() int {\n return 9223372036854775807 * 2\n}\n",
        "main proc() string {\n return \"\\q\"\n}\n",
        "main proc() string {\n return \"\\x0g\"\n}\n",
    ]
    for (sources) |source, i| {
        diagnostic_store := diagnostics.init(mem.c_allocator)
        defer diagnostics.deinit(&diagnostic_store)
        module := try compile_owned(source, &diagnostic_store)
        defer ir.deinit(&module)
        outcome :: try interpreter.run(mem.c_allocator, &module, &diagnostic_store)
        code := diagnostics.Code.integer_overflow
        if (i < 2) code = .literal_out_of_range
        if (i >= 6) code = .invalid_escape
        try expect_trap(outcome, &diagnostic_store, code)
    }
}

validates_main_and_preserves_first_declaration test {
    sources [4][]u8 :: [
        "other proc() void {}\n",
        "main :: 42\n",
        "main proc(value int) int {\n return value\n}\n",
        "main proc() int {\n return 42\n}\nmain proc() int {\n return 7\n}\n",
    ]
    for (sources) |source, i| {
        diagnostic_store := diagnostics.init(mem.c_allocator)
        defer diagnostics.deinit(&diagnostic_store)
        module := try compile_owned(source, &diagnostic_store)
        defer ir.deinit(&module)
        outcome :: try interpreter.run(mem.c_allocator, &module, &diagnostic_store)
        if (i == 3) {
            try testing.expect(outcome.trap == null)
            try testing.expect_equal(i64(42), outcome.value.data.integer)
        } else {
            code diagnostics.Code :: if (i == 0) .missing_entry else .invalid_entry
            try expect_trap(outcome, &diagnostic_store, code)
            try testing.expect_equal(module.entry_diagnostic, outcome.trap?)
        }
    }
}

