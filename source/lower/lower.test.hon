        }
    }
}

parses_float_context_without_integer_range_limits_and_rejects_float_overflow test {
    diagnostic_store := diagnostics.init(mem.c_allocator)
    defer diagnostics.deinit(&diagnostic_store)
    module := try compile_owned(
        "main proc() float {\n return 18446744073709551616\n}\n",
        &diagnostic_store,
    )
    defer ir.deinit(&module)
    outcome := try interpreter.run(mem.c_allocator, &module, &diagnostic_store)
    defer interpreter.deinit(&outcome)
    try testing.expect(outcome.trap == null)
    try testing.expect_equal(ir.Type.float, outcome.value.type)
    try testing.expect_equal(f64(18446744073709551616.0), outcome.value.data.real)
    source := arraylist.init(u8, mem.c_allocator)
    defer arraylist.deinit(&source)
    for ("main proc() float {\n return ") |byte| try arraylist.append(&source, byte)
    for (usize(0)..usize(400)) |_| try arraylist.append(&source, '9')
    for (".0\n}\n") |byte| try arraylist.append(&source, byte)
    oversized := try compile_owned(source.items, &diagnostic_store)
    defer ir.deinit(&oversized)
    trapped := try interpreter.run(mem.c_allocator, &oversized, &diagnostic_store)
    defer interpreter.deinit(&trapped)
    try expect_trap(trapped, &diagnostic_store, .literal_out_of_range)
}

