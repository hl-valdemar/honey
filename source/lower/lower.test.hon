continue_restarts_composed_calling_guards_after_branchful_body_calls test {
    guards [3][]u8 :: [
        "(positive(3 - n) and !(n == 2)) or n == 2",
        "!(n >= 3) and (positive(3 - n) or false)",
        "positive(3 - n) and ((n < 3 or false) and !false)",
    ]
    for (guards) |guard| {
        source := arraylist.init(u8, mem.c_allocator)
        defer arraylist.deinit(&source)
        for ("positive proc(n int) bool { return n > 0 }\nadvance proc(flag bool, n int) int {\n if flag { return n + 1 }\n return n + 1\n}\nmain proc() int {\n n := 0\n while ") |byte| try arraylist.append(&source, byte)
        for (guard) |byte| try arraylist.append(&source, byte)
        # bound a stale guard too, so incorrect continue lowering fails instead of hanging.
        for (" {\n n = advance(n == 0 or n == 1, n)\n if (n > 5) break\n continue\n n = n + 100\n }\n return n + 39\n}\n") |byte| try arraylist.append(&source, byte)
        diagnostic_store := diagnostics.init(mem.c_allocator)
        defer diagnostics.deinit(&diagnostic_store)
        module := try compile_owned(source.items, &diagnostic_store)
        defer ir.deinit(&module)
        try testing.expect_equal(0, diagnostics.count(&diagnostic_store))
        outcome := try interpreter.run(mem.c_allocator, &module, &diagnostic_store)
        defer interpreter.deinit(&outcome)
        try testing.expect(outcome.trap == null)
        try testing.expect_equal(i64(42), outcome.value.data.integer)
    }
}

