    sources [3][]u8 :: [
        "main proc() f64 {\n return 9007199254740994 - 9007199254740992\n}\n",
        "main proc() f64 {\n return 9007199254740993.0 - 9007199254740992\n}\n",
        "main proc() f64 {\n return 0003\n}\n",
    ]
    expected [3]f64 :: [2, 0, 3]
    for sources |source, i| {
        diagnostic_store := diagnostics.init(mem.c_allocator)
        defer diagnostics.deinit(&diagnostic_store)
        module := try compile_owned(source, &diagnostic_store)
        defer ir.deinit(&module)
        outcome := try interpreter.run(mem.c_allocator, &module, &diagnostic_store)
        defer interpreter.deinit(&outcome)
        try testing.expect_equal(0, diagnostics.count(&diagnostic_store))
        try testing.expect(outcome.trap == null)
        try testing.expect_equal(expected[i], outcome.value.data.real)
    }
}

accepts_representable_subnormals_and_rejects_underflow_to_zero test {
    zeros [2]usize :: [307, 400]
    for (zeros) |count| {
        source := arraylist.init(u8, mem.c_allocator)
        defer arraylist.deinit(&source)
        for ("main proc() float {\n return 0.") |byte| try arraylist.append(&source, byte)
        for (usize(0)..count) |_| try arraylist.append(&source, '0')
        for ("1\n}\n") |byte| try arraylist.append(&source, byte)
        diagnostic_store := diagnostics.init(mem.c_allocator)
        defer diagnostics.deinit(&diagnostic_store)
        module := try compile_owned(source.items, &diagnostic_store)
        defer ir.deinit(&module)
        outcome := try interpreter.run(mem.c_allocator, &module, &diagnostic_store)
        defer interpreter.deinit(&outcome)
        if (count == 307) {
            try testing.expect_equal(0, diagnostics.count(&diagnostic_store))
            try testing.expect(outcome.trap == null)
            try testing.expect_equal(ir.Type.float, outcome.value.type)
            try testing.expect(outcome.value.data.real > 0 and outcome.value.data.real < 1)
        } else {
            try expect_trap(outcome, &diagnostic_store, .literal_out_of_range)
        }
    }
}

@hide:file
AllocationState :: struct {
    remaining usize
    live usize = 0
}

@hide:file
limited_alloc proc(context ?@mut anyopaque, size usize, alignment usize) ?*mut u8 {
    if (context) |userdata| {
        state @mut AllocationState :: ptrcast!(userdata)
        if (state.remaining == 0) return null
        state.remaining -= 1
        memory :: mem.raw_alloc(mem.c_allocator, size, alignment)
        if (memory) |_| state.live += 1
        return memory
    }
    unreachable
}

@hide:file
limited_realloc proc(context ?@mut anyopaque, memory ?*mut u8, old_size usize, new_size usize, alignment usize) ?*mut u8 {
    if (context) |userdata| {
        state @mut AllocationState :: ptrcast!(userdata)
        if (state.remaining == 0) return null
        state.remaining -= 1
        resized :: mem.raw_realloc(mem.c_allocator, memory, old_size, new_size, alignment)
        if (resized) |_| {
            if (memory) |_| {} else state.live += 1
        }
        return resized
    }
    unreachable
}

@hide:file
limited_free proc(context ?@mut anyopaque, memory ?*mut u8, size usize, alignment usize) void {
    if (context) |userdata| {
        state @mut AllocationState :: ptrcast!(userdata)
        if (memory) |_| state.live -= 1
        mem.raw_free(mem.c_allocator, memory, size, alignment)
        return
    }
    unreachable
}

@hide:file
limited_vtable :: mem.AllocatorVTable{ alloc = limited_alloc, realloc = limited_realloc, free = limited_free }

releases_temporaries_and_partially_owned_modules_on_allocation_failure test {
    strings := strpool.init(mem.c_allocator)
    defer strpool.deinit(&strings)
    diagnostic_store := diagnostics.init(mem.c_allocator)
    defer diagnostics.deinit(&diagnostic_store)
    source ::
        `text :: "owned\nstring"
        `factor float :: 3.5
        `enabled :: true or false and false
        `compose proc(left bool, right bool) bool {
        `    return left and right
        `}
        `broken proc() bool {
        `    return compose(true and absent, false or true)
        `}
        `identity proc(value string) string {
        `    if false {
        `        return value
        `    }
        `    local :: value
        `    return local
        `}
        `rows proc(value [2][2]string) [2][2]string { return value }
        `main proc() string {
        `    computed float :: factor * 2
        `    aggregate :: rows([[text, "second"], ["third", text]])
        `    (aggregate[1])[1]
        `    remaining := 2
        `    for 0..=2 |item| {
        `        saved :: identity(text)
        `        for 0..2 |_| {
        `            nested :: identity(saved)
        `            identity(nested)
        `            if (item == 1) continue else break
        `        }
        `        if (item < 2) continue else break
        `    }
        `    while compose(remaining > 0 and enabled, compose(!false, compose(true or false, compose(true, compose(true, true))))) {
        `        pass :: identity(text)
        `        identity(pass)
        `        remaining = remaining - 1
        `        inner := 2
        `        while inner > 0 {
        `            inner = inner - 1
        `            if (inner > 0) continue else break
        `        }
        `        if (remaining > 0) continue else break
        `    }
        `    if computed > 0 and (enabled or false) {
        `        saved :: identity(text)
        `        if computed < 10 {
        `            return saved
        `        }
        `    } else {
        `        fallback :: "fallback"
        `        identity(fallback)
        `    }
        `    return identity(text)
        `}
    scan_state := lexer.init(mem.c_allocator)
    defer lexer.deinit(&scan_state)
    try lexer.scan(&scan_state, source, &strings, &diagnostic_store)
    tree := try parser.parse(mem.c_allocator, scan_state.tokens.items, source, &diagnostic_store)
    defer ast.deinit(&tree)
    resolution := try sema.resolve(mem.c_allocator, &tree, &strings, &diagnostic_store)
    defer sema.deinit(&resolution)
    checked := try typecheck.check(mem.c_allocator, &tree, &resolution, &diagnostic_store)
    defer typecheck.deinit(&checked)
    succeeded := false
    failures := usize(0)
    for (usize(0)..usize(512)) |limit| {
        state := AllocationState{ remaining = limit }
        allocator :: mem.Allocator{ context = &state, vtable = &limited_vtable }
        module := lower(allocator, &tree, &resolution, &checked, &diagnostic_store) catch |error| {
            try testing.expect(error == .out_of_memory)
            failures += 1
            try testing.expect_equal(usize(0), state.live)
            continue
        }
        errdefer ir.deinit(&module)
        outcome := try interpreter.run(mem.c_allocator, &module, &diagnostic_store)
        defer interpreter.deinit(&outcome)
        try testing.expect(outcome.trap == null)
        try testing.expect(mem.eql(ir.string_bytes(&module, outcome.value.data.string), "owned\nstring"))
        interpreter.deinit(&outcome)
        ir.deinit(&module)
        try testing.expect_equal(usize(0), state.live)
        succeeded = true
        break
    }
    try testing.expect(succeeded)
    try testing.expect(failures > 0)
}

recursive_factorial_and_conditional_returns_execute_after_frontend_cleanup test {
    diagnostic_store := diagnostics.init(mem.c_allocator)
    defer diagnostics.deinit(&diagnostic_store)
    source ::
        `factorial proc(n int) int {
        `    if n <= 1 {
        `        return 1
        `    } else {
        `        return n * factorial(n - 1)
        `    }
        `}
        `main proc() int {
        `    return factorial(5)
        `}
    module := try compile_owned(source, &diagnostic_store)
    defer ir.deinit(&module)
    try testing.expect_equal(0, diagnostics.count(&diagnostic_store))
    outcome := try interpreter.run(mem.c_allocator, &module, &diagnostic_store)
    defer interpreter.deinit(&outcome)
    try testing.expect(outcome.trap == null)
    try testing.expect_equal(i64(120), outcome.value.data.integer)
}

nested_branches_joins_calls_and_lazy_globals_preserve_execution_position test {
    diagnostic_store := diagnostics.init(mem.c_allocator)
    defer diagnostics.deinit(&diagnostic_store)
    source ::
        `seed :: classify(2)
        `enabled bool :: true
        `identity proc(value int) int { return value }
        `classify proc(n int) int {
        `    if n < 0 {
        `        return 3
        `    } else if n == 0 {
        `        return 5
        `    } else {
        `        if n > 1 {
        `            local :: identity(7)
        `            identity(local)
        `        } else {
        `            local :: identity(9)
        `            identity(local)
        `        }
        `        return identity(11)
        `    }
        `}
        `choose proc(flag bool) int {
        `    if flag {
        `        local :: identity(seed)
        `        identity(local)
        `    } else {
        `        local :: identity(13)
        `        identity(local)
        `    }
        `    return identity(seed) + classify(0) + classify(-1)
        `}
        `main proc() int {
        `    return choose(enabled) + choose(false) + classify(1) - 7
        `}
