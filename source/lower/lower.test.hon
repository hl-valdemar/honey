owned_integer_ranges_execute_exclusive_inclusive_empty_signed_and_discard_forms test {
    sources [13][]u8 :: [
        "main proc() int {\n sum := 0\n for 0..7 |i| { sum = sum + i }\n return sum\n}\n",
