escaped_nested_array_returns_survive_frontend_and_frames_and_release_on_oom test {
    diagnostic_store := diagnostics.init(mem.c_allocator)
    defer diagnostics.deinit(&diagnostic_store)
    source ::
        `later [2][2]string :: [["owned\none", "two"], ["three", "four"]]
        `first :: identity(later)
        `identity proc(value [2][2]string) [2][2]string { return value }
        `main proc() [2][2]string { return identity(identity(first)) }
    module := try compile_owned(source, &diagnostic_store)
    defer ir.deinit(&module)
    try testing.expect_equal(0, diagnostics.count(&diagnostic_store))
    succeeded := false
    failures := usize(0)
    for (usize(0)..usize(512)) |limit| {
        state := AllocationState{ remaining = limit }
        allocator :: mem.Allocator{ context = &state, vtable = &limited_vtable }
        outcome := interpreter.run(allocator, &module, &diagnostic_store) catch |error| {
            try testing.expect(error == .out_of_memory)
            failures += 1
            try testing.expect_equal(usize(0), state.live)
            continue
        }
        defer interpreter.deinit(&outcome)
        try testing.expect(outcome.trap == null)
        try testing.expect_equal(ir.Type.array, outcome.value.type)
        try testing.expect_equal(usize(4), outcome.value.data.elements.len)
        try testing.expect(mem.eql(ir.string_bytes(&module, outcome.value.data.elements[0].data.string), "owned\none"))
        try testing.expect(mem.eql(ir.string_bytes(&module, outcome.value.data.elements[3].data.string), "four"))
        try testing.expect(state.live > 0)
        interpreter.deinit(&outcome)
        try testing.expect_equal(usize(0), state.live)
        succeeded = true
        break
    }
    try testing.expect(succeeded)
    try testing.expect(failures > 0)
}

