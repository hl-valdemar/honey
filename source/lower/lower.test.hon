range_bounds_evaluate_left_to_right_before_header_errors_and_body_overflow_keeps_span test {
    sources [4][]u8 :: [
        "first :: fail()\nsecond :: absent\nfail proc() int { return 9223372036854775807 + 1 }\nmain proc() int {\n for first..second |i| {}\n return 42\n}\n",
        "fail proc() int { return 9223372036854775807 + 1 }\nmain proc() int {\n for fail()..1 |@i| {}\n return 42\n}\n",
        "main proc() int {\n for 0..1 |i| { return 9223372036854775807 + i + 1 }\n return 0\n}\n",
        "main proc() int {\n for first_absent..second_absent |i| {}\n return 42\n}\n",
    ]
    for (sources) |source, index| {
        diagnostic_store := diagnostics.init(mem.c_allocator)
        defer diagnostics.deinit(&diagnostic_store)
        module := try compile_owned(source, &diagnostic_store)
        defer ir.deinit(&module)
        before :: diagnostics.count(&diagnostic_store)
        outcome := try interpreter.run(mem.c_allocator, &module, &diagnostic_store)
        defer interpreter.deinit(&outcome)
        code diagnostics.Code :: if (index == 3) .unknown_name else .integer_overflow
        try expect_trap(outcome, &diagnostic_store, code)
        diagnostic :: diagnostics.get(&diagnostic_store, outcome.trap?)?
        span []u8 :: match index {
            0, 1: "9223372036854775807 + 1"
            2: "9223372036854775807 + i + 1"
            3: "first_absent"
            else: unreachable
        }
        try testing.expect(mem.eql(source[usize(diagnostic.span.start)..usize(diagnostic.span.end)], span))
        if (index == 3) try testing.expect_equal(diagnostics.DiagnosticId(0), outcome.trap?)
        else try testing.expect_equal(diagnostics.DiagnosticId(before), outcome.trap?)
    }
}

range_runtime_allocations_do_not_grow_with_iterations test {
    sources [2][]u8 :: [
        "main proc() int {\n count := 0\n for 0..1 |i| {\n local :: i\n count = count + 1\n if (count > 1) break\n if (local >= 0) continue\n later :: 0\n }\n return count\n}\n",
        "main proc() int {\n count := 0\n for 0..10000 |i| {\n local :: i\n count = count + 1\n if (count > 10000) break\n if (local >= 0) continue\n later :: 0\n }\n return count\n}\n",
    ]
    expected [2]i64 :: [1, 10000]
    allocations := usize(0)
    for (sources) |source, index| {
        diagnostic_store := diagnostics.init(mem.c_allocator)
        defer diagnostics.deinit(&diagnostic_store)
        module := try compile_owned(source, &diagnostic_store)
        defer ir.deinit(&module)
        try testing.expect_equal(0, diagnostics.count(&diagnostic_store))
        state := AllocationState{ remaining = 64 }
        allocator :: mem.Allocator{ context = &state, vtable = &limited_vtable }
        outcome := try interpreter.run(allocator, &module, &diagnostic_store)
        defer interpreter.deinit(&outcome)
        try testing.expect(outcome.trap == null)
        try testing.expect_equal(expected[index], outcome.value.data.integer)
        interpreter.deinit(&outcome)
        try testing.expect_equal(usize(0), state.live)
        if (index == 0) allocations = usize(64) - state.remaining
        else try testing.expect_equal(allocations, usize(64) - state.remaining)
    }
}

