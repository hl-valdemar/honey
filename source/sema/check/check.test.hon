    try testing.expect_equal(1, code_count(&fixture.diagnostics, .unknown_name))
    try testing.expect_equal(3, diagnostics.count(&fixture.diagnostics))
}

array_lengths_require_supported_constexpr_and_finalize_nested_inferred_counts test {
    source ::
        `two :: tail
        `tail :: 2
        `valid [two * 3 - 4]i64 :: [1, 2]
        `zero [3 - 3]i64 :: []
        `nested [_]mut [_]mut i64 := [[1, 2], [3, 4]]
        `negative [-1]i64 :: []
        `fraction [1.5]i64 :: []
        `runtime_count := 2
        `runtime_array [runtime_count]i64 :: [1, 2]
        `count proc() int { return 2 }
        `called [count()]i64 :: [1, 2]
        `a :: b
        `b :: a
        `cycle [a]i64 :: []
        `overflow [18446744073709551615 + 1]i64 :: []
        `wrong [2]i64 :: [1]
        `constraints [2]mut int := [1, 2]
        `floats [0]float :: []
        `voids [0]void :: []
        `missing [absent]i64 :: []
    fixture := try array_fixture(source)
    defer deinit_array_fixture(&fixture)
    tree :: &fixture.tree
    result :: &fixture.result
    _ = try expect_array(result, ast.package_decl(tree, 2), 2, false, .int)
    _ = try expect_array(result, ast.package_decl(tree, 3), 0, false, .int)
    nested :: ast.statement_decl(tree, ast.package_decl(tree, 4))
    shape :: try expect_array(result, nested.type?, 2, true, .array)
    child :: array_type(result, shape.element.array_type)
    try testing.expect_equal(2, child.len)
    try testing.expect(child.mutable)
    _ = try expect_array(result, ast.array_type(tree, nested.type?).element, 2, true, .int)
    invalid_lengths [6]usize :: [5, 6, 8, 10, 13, 14]
    for invalid_lengths |i| {
        annotation :: ast.statement_decl(tree, ast.package_decl(tree, i)).type?
        count :: ast.array_type(tree, annotation).count?
        _ = try expect_error(result, &fixture.diagnostics, annotation, .invalid_array_length, ast.node_span(tree, count))
    }
    wrong :: ast.statement_decl(tree, ast.package_decl(tree, 15)).initializer
    _ = try expect_error(result, &fixture.diagnostics, wrong, .array_length_mismatch, ast.node_span(tree, wrong))
    for usize(16)..usize(19) |i| {
        annotation :: ast.statement_decl(tree, ast.package_decl(tree, i)).type?
        child_id :: ast.array_type(tree, annotation).element
        _ = try expect_error(result, &fixture.diagnostics, annotation, .invalid_array_element_type, ast.node_span(tree, child_id))
    }
    missing :: ast.statement_decl(tree, ast.package_decl(tree, 19)).type?
    count :: ast.array_type(tree, missing).count?
    try testing.expect_equal(sema.binding(&fixture.resolution, count).data.diagnostic, type_of(result, missing).diagnostic)
    try testing.expect_equal(6, code_count(&fixture.diagnostics, .invalid_array_length))
    try testing.expect_equal(1, code_count(&fixture.diagnostics, .array_length_mismatch))
    try testing.expect_equal(3, code_count(&fixture.diagnostics, .invalid_array_element_type))
}

indexed_writes_require_mutable_local_root_and_each_array_level_but_copies_are_values test {
    source ::
        `global [1]mut i64 := [1]
        `main proc(parameter [1]mut i64) void {
        `    mutable [1]mut i64 := [1]
        `    mutable[0] = 2
        `    copied := mutable
        `    copied[0] = 3
        `    inferred := [1]
        `    inferred[0] = 4
        `    inferred = [5]
        `    constant [1]mut i64 :: [1]
        `    constant[0] = 6
        `    parameter[0] = 7
        `    global[0] = 8
        `    outer_readonly [1][1]mut i64 := [[1]]
        `    (outer_readonly[0])[0] = 9
        `    inner_readonly [1]mut [1]i64 := [[1]]
        `    (inner_readonly[0])[0] = 10
        `    both [1]mut [1]mut i64 := [[1]]
        `    (both[0])[0] = 11
        `    both[0] = [12]
        `    mismatch [1]mut i64 := inner_readonly[0]
        `}
    fixture := try array_fixture(source)
    defer deinit_array_fixture(&fixture)
    tree :: &fixture.tree
    result :: &fixture.result
    body :: ast.function_decl(tree, ast.package_decl(tree, 1)).body
    valid [6]usize :: [1, 3, 6, 16, 17, 2]
    for valid |i| {
        id :: ast.block_statement(tree, body, i)
        kind TypeKind :: if (i == 2) .array else .void
        try expect_kind(result, id, kind)
    }
    invalid [6]usize :: [5, 8, 9, 10, 12, 14]
    for invalid |i| {
        id :: ast.block_statement(tree, body, i)
        target :: ast.assignment_stmt(tree, id).target
        _ = try expect_error(result, &fixture.diagnostics, id, .invalid_index_assignment, ast.node_span(tree, target))
        try expect_kind(result, target, .int)
        try expect_kind(result, ast.index_expr(tree, target).index, .usize)
    }
    mismatch :: ast.statement_decl(tree, ast.block_statement(tree, body, 18)).initializer
    _ = try expect_error(result, &fixture.diagnostics, mismatch, .type_mismatch, ast.node_span(tree, mismatch))
    _ = try expect_array(result, ast.block_statement(tree, body, 4), 1, false, .int)
    _ = try expect_array(result, ast.function_param(tree, ast.package_decl(tree, 1), 0), 1, true, .int)
    try testing.expect_equal(6, code_count(&fixture.diagnostics, .invalid_index_assignment))
    try testing.expect_equal(1, code_count(&fixture.diagnostics, .type_mismatch))
}

usize_arithmetic_ranges_and_readonly_captures_keep_the_bound_family test {
    source ::
        `limit usize :: 18446744073709551615
        `arithmetic usize :: (limit - 2) * 1 + 1
        `ordered :: 0 < limit
        `equal :: limit == 18446744073709551615
        `negated :: -limit
        `divided :: limit / 2
        `fixed i64 :: 1
        `mixed :: fixed + limit
        `main proc() void {
        `    source [2]i64 :: [1, 2]
        `    for 0..limit |index| {
        `        source[index]
        `        index = 1
        `    }
        `    for 0..2 |index| { source[index] }
        `    for limit..=limit |_| {}
        `}
    fixture := try array_fixture(source)
    defer deinit_array_fixture(&fixture)
    tree :: &fixture.tree
    result :: &fixture.result
    try expect_kind(result, ast.package_decl(tree, 0), .usize)
    try expect_kind(result, ast.package_decl(tree, 1), .usize)
    try expect_kind(result, ast.package_decl(tree, 2), .bool)
    try expect_kind(result, ast.package_decl(tree, 3), .bool)
    for usize(4)..usize(8) |i| {
        if (i == 6) continue
        value :: ast.statement_decl(tree, ast.package_decl(tree, i)).initializer
        code diagnostics.Code :: if (i == 5) .integer_division else .invalid_operand
        _ = try expect_error(result, &fixture.diagnostics, value, code, ast.node_span(tree, value))
    }
    body :: ast.function_decl(tree, ast.package_decl(tree, 8)).body
    unsigned_loop :: ast.for_stmt(tree, ast.block_statement(tree, body, 1))
    try expect_kind(result, unsigned_loop.capture?, .usize)
    try testing.expect_equal(TypeKind.usize, type_of(result, unsigned_loop.iterable).range_element)
    interval :: ast.range_expr(tree, unsigned_loop.iterable)
    try expect_kind(result, interval.start, .usize)
    try expect_kind(result, interval.end, .usize)
    read :: ast.statement_expr(tree, ast.block_statement(tree, unsigned_loop.body, 0))
    try expect_kind(result, read, .int)
    try expect_kind(result, ast.index_expr(tree, read).index, .usize)
    readonly :: ast.block_statement(tree, unsigned_loop.body, 1)
    target :: ast.assignment_stmt(tree, readonly).target
    _ = try expect_error(result, &fixture.diagnostics, readonly, .invalid_assignment_target, ast.node_span(tree, target))
    try expect_kind(result, target, .usize)
    signed_loop :: ast.for_stmt(tree, ast.block_statement(tree, body, 2))
    try expect_kind(result, signed_loop.capture?, .int)
    signed_read :: ast.statement_expr(tree, ast.block_statement(tree, signed_loop.body, 0))
    bad_index :: ast.index_expr(tree, signed_read).index
    _ = try expect_error(result, &fixture.diagnostics, bad_index, .invalid_index_type, ast.node_span(tree, bad_index))
    try testing.expect_equal(TypeKind.int, type_of(result, signed_loop.iterable).range_element)
    _ = try expect_array(result, ast.block_statement(tree, body, 0), 2, false, .int)
    ignored :: ast.for_stmt(tree, ast.block_statement(tree, body, 3))
    try testing.expect_equal(TypeKind.usize, type_of(result, ignored.iterable).range_element)
    try testing.expect_equal(1, code_count(&fixture.diagnostics, .invalid_index_type))
    try testing.expect_equal(0, code_count(&fixture.diagnostics, .invalid_range_bound))
}

array_assignment_rhs_is_contextual_but_does_not_retarget_established_sources test {
    source ::
        `main proc() void {
        `    target [2]mut f64 := [1, 2]
        `    seed := 3
        `    source [2]i64 :: [4, 5]
        `    target = [seed, 6]
        `    target = source
        `    target = [1]
        `    matrix [1]mut [2]mut i64 := [[1, 2]]
        `    matrix[0] = [7, 8]
        `    matrix[0] = [true, false]
        `    unknown [1]mut i64 := [absent]
        `    unknown[0] = 9
        `    good := 10
        `}
    fixture := try array_fixture(source)
    defer deinit_array_fixture(&fixture)
    tree :: &fixture.tree
    result :: &fixture.result
    body :: ast.function_decl(tree, ast.package_decl(tree, 0)).body
    _ = try expect_array(result, ast.block_statement(tree, body, 0), 2, true, .float)
    try expect_kind(result, ast.block_statement(tree, body, 1), .int)
    _ = try expect_array(result, ast.block_statement(tree, body, 2), 2, false, .int)
    contextual :: ast.assignment_stmt(tree, ast.block_statement(tree, body, 3)).value
    _ = try expect_error(result, &fixture.diagnostics, ast.array_element(tree, contextual, 0), .type_mismatch, ast.node_span(tree, ast.array_element(tree, contextual, 0)))
    try expect_kind(result, ast.array_element(tree, contextual, 1), .float)
    copied :: ast.assignment_stmt(tree, ast.block_statement(tree, body, 4)).value
    _ = try expect_error(result, &fixture.diagnostics, copied, .type_mismatch, ast.node_span(tree, copied))
    wrong_len :: ast.assignment_stmt(tree, ast.block_statement(tree, body, 5)).value
    _ = try expect_error(result, &fixture.diagnostics, wrong_len, .array_length_mismatch, ast.node_span(tree, wrong_len))
    try expect_kind(result, ast.block_statement(tree, body, 7), .void)
    literal :: ast.statement_decl(tree, ast.block_statement(tree, body, 9)).initializer
    missing :: ast.array_element(tree, literal, 0)
    original :: sema.binding(&fixture.resolution, missing).data.diagnostic
    try testing.expect_equal(original, type_of(result, literal).diagnostic)
    try testing.expect_equal(original, type_of(result, ast.block_statement(tree, body, 9)).diagnostic)
    try testing.expect_equal(original, type_of(result, ast.block_statement(tree, body, 10)).diagnostic)
    try expect_kind(result, ast.block_statement(tree, body, 11), .int)
}

array_signature_identity_includes_recursive_counts_and_mutability test {
    source ::
        `accept proc(value [1]mut i64) [1]mut i64 { return value }
        `different_count proc(value [2]mut i64) [1]mut i64 { return [1] }
        `different_mutability proc(value [1]i64) [1]mut i64 { return [1] }
        `functions :: [accept, different_count, different_mutability]
        `wrong_return proc() [1]mut i64 {
        `    value [1]i64 :: [1]
        `    return value
        `}
        `take proc(value [2]i64) void {}
        `caller proc() void {
        `    take([1])
        `    take([true, false])
        `}
    fixture := try array_fixture(source)
    defer deinit_array_fixture(&fixture)
    tree :: &fixture.tree
    result :: &fixture.result
    functions :: ast.statement_decl(tree, ast.package_decl(tree, 3)).initializer
    for usize(1)..usize(3) |i| {
        value :: ast.array_element(tree, functions, i)
        _ = try expect_error(result, &fixture.diagnostics, value, .type_mismatch, ast.node_span(tree, value))
        try expect_kind(result, ast.package_decl(tree, i), .function)
    }
    wrong :: ast.package_decl(tree, 4)
    wrong_body :: ast.function_decl(tree, wrong).body
    value :: ast.return_stmt(tree, ast.block_statement(tree, wrong_body, 1)).value?
    _ = try expect_error(result, &fixture.diagnostics, value, .return_type_mismatch, ast.node_span(tree, value))
    _ = try expect_array(result, ast.block_statement(tree, wrong_body, 0), 1, false, .int)
    try expect_kind(result, wrong, .function)
    caller :: ast.function_decl(tree, ast.package_decl(tree, 6)).body
    call :: ast.statement_expr(tree, ast.block_statement(tree, caller, 0))
    argument :: ast.call_arg(tree, call, 0)
    _ = try expect_error(result, &fixture.diagnostics, argument, .array_length_mismatch, ast.node_span(tree, argument))
    second :: ast.statement_expr(tree, ast.block_statement(tree, caller, 1))
    literal :: ast.call_arg(tree, second, 0)
    for 0..ast.array_element_count(tree, literal) |i| {
        child :: ast.array_element(tree, literal, i)
        _ = try expect_error(result, &fixture.diagnostics, child, .type_mismatch, ast.node_span(tree, child))
    }
    try expect_kind(result, ast.package_decl(tree, 5), .function)
}

inferred_counts_follow_forward_fixed_aliases_empty_shapes_and_reject_local_counts test {
    source ::
        `forward [_]i64 :: later
        `later [_]i64 :: [1, 2]
        `zero [_]mut bool := []
        `nested [_][_]bool :: [[], []]
        `unsigned usize :: 5
        `main proc() void {
        `    local_count :: 2
        `    unsupported [local_count]i64 :: [1, 2]
        `    values [2]i64 :: [1, 2]
        `    for 0..(unsigned + 1) |index| { values[index] }
        `}
    fixture := try array_fixture(source)
    defer deinit_array_fixture(&fixture)
    tree :: &fixture.tree
    result :: &fixture.result
    for 0..usize(2) |i| {
        declaration :: ast.statement_decl(tree, ast.package_decl(tree, i))
        _ = try expect_array(result, declaration.type?, 2, false, .int)
        _ = try expect_array(result, ast.package_decl(tree, i), 2, false, .int)
    }
    _ = try expect_array(result, ast.package_decl(tree, 2), 0, true, .bool)
    shape :: try expect_array(result, ast.package_decl(tree, 3), 2, false, .array)
    child :: array_type(result, shape.element.array_type)
    try testing.expect_equal(0, child.len)
    try testing.expect_equal(TypeKind.bool, child.element.kind)
    body :: ast.function_decl(tree, ast.package_decl(tree, 5)).body
    unsupported :: ast.statement_decl(tree, ast.block_statement(tree, body, 1)).type?
    count :: ast.array_type(tree, unsupported).count?
    _ = try expect_error(result, &fixture.diagnostics, unsupported, .invalid_array_length, ast.node_span(tree, count))
    try expect_kind(result, ast.block_statement(tree, body, 0), .int)
    loop :: ast.for_stmt(tree, ast.block_statement(tree, body, 3))
    try expect_kind(result, loop.capture?, .usize)
    try testing.expect_equal(TypeKind.usize, type_of(result, loop.iterable).range_element)
    read :: ast.statement_expr(tree, ast.block_statement(tree, loop.body, 0))
    try expect_kind(result, read, .int)
    try testing.expect_equal(1, code_count(&fixture.diagnostics, .invalid_array_length))
    try testing.expect_equal(1, diagnostics.count(&fixture.diagnostics))
}
