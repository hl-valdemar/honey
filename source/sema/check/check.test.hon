    tree :: &fixture.tree
    result :: &fixture.result
    try expect_kind(result, ast.package_decl(tree, 0), .int)
    try expect_kind(result, ast.package_decl(tree, 1), .usize)
    _ = try expect_array(result, ast.package_decl(tree, 2), 2, false, .int)
    bad_id :: ast.statement_decl(tree, ast.package_decl(tree, 3)).initializer
    bad :: ast.index_expr(tree, bad_id)
    original :: try expect_error(result, &fixture.diagnostics, bad.index, .invalid_index_type, ast.node_span(tree, bad.index))
    try testing.expect_equal(original, type_of(result, bad_id).diagnostic)
    try testing.expect_equal(original, type_of(result, ast.package_decl(tree, 3)).diagnostic)
    _ = try expect_array(result, bad.base, 2, false, .int)
    try expect_kind(result, ast.package_decl(tree, 4), .int)
    boolean :: ast.index_expr(tree, ast.statement_decl(tree, ast.package_decl(tree, 5)).initializer).index
    _ = try expect_error(result, &fixture.diagnostics, boolean, .invalid_index_type, ast.node_span(tree, boolean))
    missing :: ast.index_expr(tree, ast.statement_decl(tree, ast.package_decl(tree, 6)).initializer).index
    try testing.expect_equal(sema.binding(&fixture.resolution, missing).data.diagnostic, type_of(result, missing).diagnostic)
    try expect_kind(result, ast.package_decl(tree, 7), .int)
