            owned = try ast.add_typed_constant(state.builder, span, field.type?, value)
        member :: try ast.add_field(state.builder, span, field.name, null, owned)
        try arraylist.append(&fields, member)
        try refresh(state)
    }
    literal :: try ast.add_record_literal(state.builder, span, null, fields.items)
    result :: try ast.add_typed_constant(state.builder, span, type, literal)
    try refresh(state)
    return result
}

@hide:file
metadata_schema proc(state @mut State, type ast.NodeId, names [][]u8, types []ast.NodeId) bool ! Error {
    if (
        type == no_node or ast.expr_kind(&state.tree, type) != .record_type
        or ast.record_field_count(&state.tree, type) != names.len
    ) return false
    for (names) |name, i| {
        field :: ast.field(&state.tree, ast.record_field(&state.tree, type, i))
        if (
            field.name == null or field.type == null
            or !mem.eql(ast.literal_text(&state.tree, field.name?), name)
            or !try same_type(state, field.type?, types[i])
        ) return false
    }
    return true
}

@hide:file
metadata_abi proc(state @mut State, at ast.NodeId, types []ast.NodeId) bool ! Error {
    info :: types[0]
    if (
        info == no_node or ast.expr_kind(&state.tree, info) != .union_type
        or !ast.union_type(&state.tree, info).auto_tag
    ) return false
    span :: ast.node_span(&state.tree, at)
    byte_string :: try ast.add_slice_type(state.builder, span, try builtin(state, at, .u8), false, null)
    optional_name :: try ast.add_optional_type(state.builder, span, byte_string)
    fields :: try ast.add_slice_type(state.builder, span, types[2], false, null)
    usize_type :: try builtin(state, at, .usize)
    type_type :: try builtin(state, at, .type)
    bool_type :: try builtin(state, at, .bool)
    try refresh(state)
    array_names [2][]u8 :: ["child", "len"]
    array_types [2]ast.NodeId :: [type_type, usize_type]
    field_names [3][]u8 :: ["name", "type", "index"]
    field_types [3]ast.NodeId :: [byte_string, type_type, usize_type]
    record_names [4][]u8 :: ["name", "fields", "is_tuple", "layout"]
    record_types [4]ast.NodeId :: [optional_name, fields, bool_type, types[5]]
    enum_names [1][]u8 :: ["fields"]
    enum_types [1]ast.NodeId :: [fields]
    if (
        !try metadata_schema(state, types[1], array_names[..], array_types[..])
        or !try metadata_schema(state, types[2], field_names[..], field_types[..])
        or !try metadata_schema(state, types[3], record_names[..], record_types[..])
        or !try metadata_schema(state, types[4], enum_names[..], enum_types[..])
    ) return false
    layout :: types[5]
    if (
        layout == no_node or ast.expr_kind(&state.tree, layout) != .enum_type
        or ast.enum_member_count(&state.tree, layout) != 2
    ) return false
    for (0..usize(2)) |i| {
        name :: ast.field(&state.tree, ast.enum_member(&state.tree, layout, i)).name
        expected :: if (i == 0) "auto" else "c"
        if (name == null or !mem.eql(ast.literal_text(&state.tree, name?), expected)) return false
    }
    names [18][]u8 :: ["invalid", "void", "noreturn", "anyopaque", "bool", "integer", "float",
        "array", "pointer", "slice", "range", "optional", "function", "enum", "record", "union", "fallible", "distinct"]
    if (ast.record_field_count(&state.tree, info) != names.len) return false
    void_type :: try builtin(state, at, .void)
    for (names) |name, i| {
        field :: ast.field(&state.tree, ast.record_field(&state.tree, info, i))
        expected := void_type
        if (i == 7) expected = types[1]
        if (i == 13) expected = types[4]
        if (i == 14) expected = types[3]
        if (i == 17) expected = type_type
        if (
            field.name == null or field.type == null
            or !mem.eql(ast.literal_text(&state.tree, field.name?), name)
            or !try same_type(state, field.type?, expected)
        ) return false
    }
    return true
}

@hide:file
expand_typeinfo proc(state @mut State, id ast.NodeId) void ! Error {
    if (ast.call_arg_count(&state.tree, id) != 1) {
        try reject(state, id, .argument_count_mismatch)
        return
    }
    begin_type_execution(state)
    defer state.type_execution_depth -= 1
    state.evaluation_diagnostic = diagnostics.no_diagnostic
    argument :: ast.call_arg(&state.tree, id, 0)
    value :: try evaluate(state, argument)
    if (value.kind != .type) {
        if (state.evaluation_diagnostic != diagnostics.no_diagnostic) try reject_evaluation(state, id)
        else try reject(state, id, .expected_type)
        return
    }
    package :: metadata_import(state)
    if (package == no_node) {
        try reject(state, id, .missing_metadata_import)
        return
    }
    types [6]mut ast.NodeId := undefined
    names [6][]u8 :: ["TypeInfo", "ArrayInfo", "FieldInfo", "RecordInfo", "EnumInfo", "Layout"]
    for (names) |name, i| {
        types[i] = try metadata_type(state, package, name)
        if (types[i] == no_node) {
            try reject(state, id, .invalid_metadata_abi)
            return
        }
    }
    if (!try metadata_abi(state, id, types[..])) {
        try reject(state, id, .invalid_metadata_abi)
        return
    }
    type :: value.node
    if (type_record_storage(state, type, 0)) {
        if (!try type_record_check(state, type)) {
            try reject_evaluation(state, id)
            return
        }
    } else if (binding(state, type).kind != .builtin) {
        constraint :: try ast.add_type_operand(state.builder, ast.node_span(&state.tree, argument), argument, true)
        try refresh(state)
        try arraylist.append(&state.rewrites.constraints, constraint)
    }
    kind :: ast.expr_kind(&state.tree, type)
    tag []u8 := "invalid"
    payload := no_node
    shape := type
    resolved :: binding(state, type)
    if (resolved.kind == .builtin) {
        builtin_kind :: builtin_identity(resolved.data.builtin)
        if (try integer_type(state, type)) tag = "integer"
        else if (builtin_kind == .float) tag = "float"
        else if (builtin_kind == .bool) tag = "bool"
        else if (builtin_kind == .void) tag = "void"
        else if (builtin_kind == .noreturn) tag = "noreturn"
        else if (builtin_kind == .anyopaque) tag = "anyopaque"
        else if (builtin_kind == .string) tag = "pointer"
    } else if (kind == .array_type) {
        tag = "array"
        array :: ast.array_type(&state.tree, type)
        length := Value{}
        if (array.count) |count| length = try evaluate(state, count)
        if (length.kind != .integer or length.negative) {
            try reject(state, id, .invalid_array_length)
            return
        }
        child :: (try materialize(state, try evaluate(state, array.element))).node
        count :: try ast.add_integer(state.builder, ast.node_span(&state.tree, id), length.magnitude)
        values [2]ast.NodeId :: [child, count]
        payload = try metadata_record(state, id, types[1], values[..])
    } else if (kind == .distinct_type) {
        tag = "distinct"
        payload = (try materialize(state, try evaluate(state, ast.type_operand(&state.tree, type)))).node
    } else if (kind == .pointer_type) tag = "pointer"
    else if (kind == .slice_type) tag = "slice"
    else if (kind == .optional_type) tag = "optional"
    else if (kind == .function_type) tag = "function"
    else if (kind == .fallible_type) tag = "fallible"
    else if (kind == .union_type) tag = "union"
    else if (kind == .record_type) tag = "record"
    else if (kind == .enum_type or kind == .union_tag_type) {
        tag = "enum"
        if (kind == .union_tag_type) {
            variants :: try inline_match_shape(state, try canonical_type(state, ast.type_operand(&state.tree, type)))
            shape = try metadata_tags(state, variants)
        }
    } else if (kind == .sum_type) {
        shape = try inline_match_shape(state, type)
        if (shape == no_node) {
            try reject_evaluation(state, id)
            return
        }
        tag = if (ast.expr_kind(&state.tree, shape) == .enum_type) "enum" else "union"
    }
    span :: ast.node_span(&state.tree, id)
    if (mem.eql(tag, "record") or mem.eql(tag, "enum")) {
        enumeration :: mem.eql(tag, "enum")
        fields := arraylist.init(ast.NodeId, state.allocator)
        defer arraylist.deinit(&fields)
        count :: if (enumeration) ast.enum_member_count(&state.tree, shape) else ast.record_field_count(&state.tree, shape)
        tuple := !enumeration
        for (0..count) |i| {
            if (!try type_step(state, id)) {
                try reject_evaluation(state, id)
                return
            }
            field_id :: if (enumeration) ast.enum_member(&state.tree, shape, i)
                else ast.record_field(&state.tree, shape, i)
            field :: ast.field(&state.tree, field_id)
            ordinal :: try ast.add_integer(state.builder, span, u64(i))
            try refresh(state)
            name := ordinal
            if (field.name) |member| {
                name = member
                tuple = false
            }
            text :: try ast.add_string(state.builder, span, ast.literal_text(&state.tree, name))
            child_type :: if (enumeration) type else field.type?
            child :: (try materialize(state, try evaluate(state, child_type))).node
            values [3]ast.NodeId :: [text, child, ordinal]
            try arraylist.append(&fields, try metadata_record(state, id, types[2], values[..]))
        }
        collection :: try ast.add_array_literal(state.builder, span, fields.items)
        if (enumeration) {
            values [1]ast.NodeId :: [collection]
            payload = try metadata_record(state, id, types[4], values[..])
        } else {
            name := try ast.add_literal(state.builder, .null, span)
            try refresh(state)
            for (state.declarations.items) |declaration| {
                if (ast.node_class(&state.tree, declaration) == .statement
                    and ast.statement_decl(&state.tree, declaration).initializer == type) {
                    name = try ast.add_string(state.builder, span, strpool.get_str(state.strings, ast.name_id(&state.tree, declaration))?)
                    break
                }
            }
            tuple_value :: try ast.add_boolean(state.builder, span, tuple)
            try refresh(state)
            layout_text :: if (ast.record_c_layout(&state.tree, type)) "c" else "auto"
            layout_name :: try metadata_member(state, id, layout_text)
            layout :: try ast.add_enum_literal(state.builder, span, layout_name)
            values [4]ast.NodeId :: [name, collection, tuple_value, layout]
            payload = try metadata_record(state, id, types[3], values[..])
        }
    }
    if (payload == no_node) payload = try ast.add_literal(state.builder, .void, span)
    member :: try metadata_member(state, id, tag)
    field :: try ast.add_field(state.builder, span, member, null, payload)
    fields [1]ast.NodeId :: [field]
    literal :: try ast.add_record_literal(state.builder, span, null, fields[..])
    result :: try ast.add_typed_constant(state.builder, span, types[0], literal)
    try replace(state, id, result)
    try refresh(state)
}

# erase only the name: ordinary selection checks the base and retains its place,
# evaluation order, mutability and active-union checks through both backends.
@hide:file
expand_field proc(state @mut State, id ast.NodeId) void ! Error {
    if (ast.call_arg_count(&state.tree, id) != 2) {
        try reject(state, id, .argument_count_mismatch)
        return
    }
    base :: ast.call_arg(&state.tree, id, 0)
    argument :: ast.call_arg(&state.tree, id, 1)
    state.evaluation_diagnostic = diagnostics.no_diagnostic
    value :: try evaluate(state, argument)
    if (value.kind != .string) {
        if (state.evaluation_diagnostic == diagnostics.no_diagnostic)
            state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
                .comptime_argument_required, ast.node_span(&state.tree, argument))
        try reject_evaluation(state, id)
        return
    }
    try arraylist.append(&state.rewrites.constraints, argument)
    text :: ast.literal_text(&state.tree, value.node)
    bytes := arraylist.init(u8, state.allocator)
    defer arraylist.deinit(&bytes)
    cursor := usize(1)
    while (cursor < text.len - 1) {
        byte :: ast.string_next(text, &cursor) catch {
            try reject(state, id, .invalid_escape)
            return
        }
        try arraylist.append(&bytes, byte)
    }
    # only canonical decimal names denote tuple ordinals; "01" is a name.
    numeric := bytes.items.len > 0 and (bytes.items.len == 1 or bytes.items[0] != '0')
    ordinal := u64(0)
    for (bytes.items) |byte| {
        if (byte < '0' or byte > '9') {
            numeric = false
            break
        }
        digit :: u64(byte - '0')
        if (ordinal > divtrunc!(maxval!(u64) - digit, u64(10))) {
            numeric = false
            break
        }
        ordinal = ordinal * 10 + digit
    }
    span :: ast.node_span(&state.tree, argument)
    member := no_node
    if (numeric) member = try ast.add_integer(state.builder, span, ordinal)
    else {
        interned :: try strpool.intern(state.strings, bytes.items)
        member = try ast.add_generated_identifier(state.builder, span, interned, bytes.items)
    }
    selection :: try ast.add_selection(state.builder, ast.node_span(&state.tree, id), base, member)
    try replace(state, id, selection)
    try refresh(state)
    state.expanded.items[usize(id)] = 0
    try expand(state, id)
}

# literal collections deliberately retain per-field context: generated records
# may pair heterogeneous types and optional defaults in arrays as well as tuples.
@hide:file
struct_collection proc(state @mut State, input ast.NodeId) ast.NodeId ! Error {
    if (!try type_step(state, input)) return no_node
    try expand(state, input)
    resolved :: binding(state, input)
    if (resolved.kind == .invalid) {
        state.evaluation_diagnostic = resolved.data.diagnostic
        return no_node
    }
    if (resolved.kind == .declaration
        and ast.node_class(&state.tree, resolved.data.declaration) == .statement) {
        declaration :: ast.statement_decl(&state.tree, resolved.data.declaration)
        if (declaration.mutability != .constant) return no_node
        if (declaration.type) |annotation| {
            value :: try type_execution_value(state, declaration.initializer, annotation)
            if (value == no_node) return no_node
            return try struct_collection(state, value)
        }
        return try struct_collection(state, declaration.initializer)
    }
    kind :: ast.expr_kind(&state.tree, input)
    if (kind == .array_literal) return input
    if (kind == .record_literal) {
        if (ast.record_literal(&state.tree, input).type != null) {
            annotation :: try expression_type(state, input, 0)
            value :: try type_execution_value(state, input, annotation)
            if (value == no_node) return no_node
            return try struct_collection(state, value)
        }
        for (0..ast.record_field_count(&state.tree, input)) |i| {
            if (ast.field(&state.tree, ast.record_field(&state.tree, input, i)).name != null) return no_node
        }
        return input
    }
    if (kind == .typed_constant) {
        value :: ast.typed_constant(&state.tree, input)
        annotation :: try canonical_type(state, value.type)
        if (annotation == no_node) return no_node
        if (ast.expr_kind(&state.tree, annotation) != .array_type) {
            if (ast.expr_kind(&state.tree, annotation) != .record_type) return no_node
            for (0..ast.record_field_count(&state.tree, annotation)) |i| {
                if (ast.field(&state.tree, ast.record_field(&state.tree, annotation, i)).name != null) return no_node
            }
        }
        if (!try type_array_initialized(state, input, input)) return no_node
        return input
    }
    value :: try evaluate(state, input)
    if (value.kind != .aggregate or value.annotation == no_node) return no_node
    owned :: try ast.add_typed_constant(state.builder, ast.node_span(&state.tree, input),
        value.annotation, value.node)
    try refresh(state)
    return try struct_collection(state, owned)
}

@hide:file
struct_collection_count proc(state @State, input ast.NodeId) usize {
    value :: if (ast.expr_kind(&state.tree, input) == .typed_constant)
        ast.typed_constant(&state.tree, input).value else input
    return if (ast.expr_kind(&state.tree, value) == .array_literal)
        ast.array_element_count(&state.tree, value) else ast.record_field_count(&state.tree, value)
}

@hide:file
struct_collection_item proc(state @mut State, input ast.NodeId, index usize) ast.NodeId ! Error {
    value := input
    annotation := no_node
