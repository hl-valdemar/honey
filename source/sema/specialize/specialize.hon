        field_type :: (try materialize(state, type_value)).node
        default_input :: try struct_collection_item(state, collections[2], i)
        optional :: try ast.add_optional_type(state.builder, span, field_type)
        contextual :: try ast.add_typed_constant(state.builder, ast.node_span(&state.tree, default_input), optional, default_input)
        capture :: try ast.add_identifier(state.builder, span, strpool.no_str)
        try refresh(state)
        present :: try type_capture_guard(state, contextual, capture)
        if (present.kind != .boolean) {
            try reject_evaluation(state, id)
            return
        }
        default ?ast.NodeId := null
        if (present.boolean) {
            unwrapped :: try ast.add_unary(state.builder,
                ast.node_span(&state.tree, default_input), .unwrap, contextual)
            try refresh(state)
            value :: try type_execution_value(state, unwrapped, field_type)
            if (value == no_node) {
                try reject_evaluation(state, id)
                return
            }
            default = value
        }
        field :: try ast.add_field(state.builder, span, name, field_type, default)
        try refresh(state)
        try arraylist.append(&fields, field)
    }
    record :: try ast.add_record_type(state.builder, ast.node_span(&state.tree, id), fields.items)
    if (c_layout) ast.set_record_c_layout(state.builder, record)
    try replace(state, id, record)
    try refresh(state)
    state.expanded.items[usize(id)] = 0
    try expand(state, id)
}

# composed struct variants use declaration IDs internally, but generated syntax
# must not embed those declarations and make dependency discovery treat them as owned.
@hide:file
member_name proc(state @mut State, name ast.NodeId) ast.NodeId ! Error {
    if (ast.node_class(&state.tree, name) != .statement) return name
    result :: try ast.add_identifier(state.builder, ast.node_span(&state.tree, name), ast.name_id(&state.tree, name))
    try refresh(state)
    return result
}

# flatten source names and payloads with native (name, payload) variant identity,
# not AST provenance; ordinary checking still validates the original composition.
@hide:file
inline_sum_fields proc(state @mut State, input ast.NodeId, fields @mut arraylist.ArrayList(ast.NodeId)) bool ! Error {
    if (!try type_step(state, input)) return false
    type :: try canonical_type(state, input)
    if (type == no_node) return false
    kind :: ast.expr_kind(&state.tree, type)
    if (kind == .sum_type) {
        sum :: ast.binary_expr(&state.tree, type)
        if (!try inline_sum_fields(state, sum.left, fields)) return false
        return try inline_sum_fields(state, sum.right, fields)
    }
    if (kind == .record_type) {
        for (0..ast.node_count(&state.tree)) |i| {
            declaration :: ast.NodeId(i)
            if (ast.node_class(&state.tree, declaration) != .statement
                or ast.stmt_kind(&state.tree, declaration) != .declaration) continue
            if (ast.statement_decl(&state.tree, declaration).initializer != type) continue
            name :: try member_name(state, declaration)
            for (fields.items) |previous| {
                field :: ast.field(&state.tree, previous)
                if (ast.name_id(&state.tree, field.name?) != ast.name_id(&state.tree, name)) continue
                return try same_type(state, field.type?, type)
            }
            field :: try ast.add_field(state.builder, ast.node_span(&state.tree, type), name, type, null)
            try refresh(state)
            try arraylist.append(fields, field)
            return true
        }
        return false
    }
    if (kind != .enum_type and kind != .union_type) return false
    if (kind == .enum_type and ast.enum_type(&state.tree, type).backing != null) return false
    if (kind == .union_type and !ast.union_type(&state.tree, type).auto_tag
        and ast.union_type(&state.tree, type).tag == null) return false
    count :: if (kind == .enum_type) ast.enum_member_count(&state.tree, type)
        else ast.record_field_count(&state.tree, type)
    for (0..count) |i| {
        if (!try type_step(state, input)) return false
        member :: if (kind == .enum_type) ast.enum_member(&state.tree, type, i)
            else ast.record_field(&state.tree, type, i)
        field :: ast.field(&state.tree, member)
        if (field.name == null) return false
        if (kind == .union_type and field.type == null) return false
        payload :: if (kind == .enum_type) try builtin(state, member, .void) else field.type?
        duplicate := false
        for (fields.items) |previous| {
            previous_field :: ast.field(&state.tree, previous)
            if (ast.name_id(&state.tree, previous_field.name?) != ast.name_id(&state.tree, field.name?)) continue
            if (!try same_type(state, previous_field.type?, payload)) return false
            duplicate = true
        }
        if (duplicate) continue
        generated :: try ast.add_field(state.builder, field.span, field.name, payload, null)
        try refresh(state)
        try arraylist.append(fields, generated)
    }
    return true
}

@hide:file
inline_match_shape proc(state @mut State, annotation ast.NodeId) ast.NodeId ! Error {
    if (ast.expr_kind(&state.tree, annotation) != .sum_type) return annotation
    begin_type_execution(state)
    defer state.type_execution_depth -= 1
    fields := arraylist.init(ast.NodeId, state.allocator)
    defer arraylist.deinit(&fields)
    if (!try inline_sum_fields(state, annotation, &fields)) return no_node
    tagged := false
    for (fields.items) |member| {
        payload :: try canonical_type(state, ast.field(&state.tree, member).type?)
        if (payload == no_node) return no_node
        resolved :: binding(state, payload)
        if (resolved.kind != .builtin or resolved.data.builtin != .void) tagged = true
    }
    span :: ast.node_span(&state.tree, annotation)
    result :: if (tagged) try ast.add_union_type(state.builder, span, null, true, fields.items)
        else try ast.add_enum_type(state.builder, span, null, fields.items)
    try refresh(state)
    return result
}

# expand dispatch, not the subject: ordinary checking/lowering retains its single
# evaluation and by-value payload captures. only tags are compile-time constants.
@hide:file
expand_inline_match proc(state @mut State, id, subject_type ast.NodeId) void ! Error {
    inline_arm := no_node
    for (0..ast.match_arm_count(&state.tree, id)) |i| {
        candidate :: ast.match_arm(&state.tree, id, i)
        if (ast.match_arm_view(&state.tree, candidate).is_inline) {
            inline_arm = candidate
            break
        }
    }
    if (inline_arm == no_node) return
    begin_type_execution(state)
    defer state.type_execution_depth -= 1
    state.evaluation_diagnostic = diagnostics.no_diagnostic
    arm :: ast.match_arm_view(&state.tree, inline_arm)
    for (0..usize(2)) |i| {
        capture :: if (i == 0) arm.capture else arm.tag_capture
        if (capture) |name| {
            resolved :: binding(state, name)
            if (resolved.kind == .invalid) {
                state.evaluation_diagnostic = resolved.data.diagnostic
                try reject_evaluation(state, id)
                return
            }
        }
    }
    count :: ast.match_arm_count(&state.tree, id)
    if (ast.match_arm(&state.tree, id, count - 1) != inline_arm) {
        try reject(state, id, .unreachable_match_arm)
        return
    }
    subject :: ast.match_expr(&state.tree, id).subject
    annotation := subject_type
    if (annotation == no_node) {
        try expand(state, subject)
        annotation = try expression_type(state, subject, 0)
    }
    if (annotation == no_node) {
        try reject(state, id, .invalid_inline_match_subject)
        return
    }
    kind :: ast.expr_kind(&state.tree, annotation)
    tag_only :: kind == .union_tag_type
    members_type := annotation
    if (tag_only) members_type = try canonical_type(state, ast.type_operand(&state.tree, annotation))
    if (members_type != no_node) members_type = try inline_match_shape(state, members_type)
    if (members_type == no_node) {
        if (state.evaluation_diagnostic != diagnostics.no_diagnostic) try reject_evaluation(state, id)
        else try reject(state, id, .invalid_sum_type)
        return
    }
    tagged := false
    if (!tag_only and ast.expr_kind(&state.tree, members_type) == .union_type) {
        view :: ast.union_type(&state.tree, members_type)
        tagged = view.auto_tag or view.tag != null
    }
    if (ast.expr_kind(&state.tree, members_type) != .enum_type and !tag_only and !tagged) {
        try reject(state, id, .invalid_inline_match_subject)
        return
    }
    if (!tagged and arm.tag_capture_present) {
        try reject(state, id, .invalid_inline_match_capture)
        return
    }
    arms := arraylist.init(ast.NodeId, state.allocator)
    defer arraylist.deinit(&arms)
    for (0..(count - 1)) |i| {
        prior :: ast.match_arm(&state.tree, id, i)
        if (ast.match_arm_view(&state.tree, prior).catch_all) {
            try reject(state, id, .unreachable_match_arm)
            return
        }
        try arraylist.append(&arms, prior)
    }
    execution := TypeExecution{
        locals = arraylist.init(state.allocator),
        mapping = try mem.alloc(ast.NodeId, state.allocator, ast.node_count(&state.tree)),
        first_owned = ast.NodeId(0), result_type = no_node,
    }
    defer type_execution_deinit(state, &execution)
    defer mem.free(state.allocator, execution.mapping)
    span :: ast.node_span(&state.tree, inline_arm)
    static_capture :: if (tagged) arm.tag_capture else arm.capture
    tag_type := annotation
    if (static_capture != null) {
        if (tagged) {
            union_view :: ast.union_type(&state.tree, members_type)
            if (kind != .sum_type and union_view.tag != null)
                tag_type = try canonical_type(state, union_view.tag?)
            else if (type_record_storage(state, annotation, 0)) tag_type = try metadata_tags(state, members_type)
            else {
                concrete :: try materialize(state, Value{ kind = .type, node = annotation })
                tag_type = try ast.add_union_tag_type(state.builder, span, concrete.node)
                try refresh(state)
            }
        }
        concrete_tag :: try materialize(state, Value{ kind = .type, node = tag_type })
        tag_type = concrete_tag.node
    }
    union_members :: tagged or tag_only
    members :: if (union_members) ast.record_field_count(&state.tree, members_type)
        else ast.enum_member_count(&state.tree, members_type)
    for (0..members) |i| {
        member :: if (union_members) ast.record_field(&state.tree, members_type, i)
            else ast.enum_member(&state.tree, members_type, i)
        field :: ast.field(&state.tree, member)
        if (field.name == null or (tagged and field.type == null)) {
            try reject(state, id, .invalid_record_field_type)
            return
        }
        covered := false
        for (arms.items) |prior| {
            for (0..ast.match_pattern_count(&state.tree, prior)) |j| {
                pattern :: ast.match_pattern(&state.tree, prior, j)
                if (ast.expr_kind(&state.tree, pattern) == .enum_literal
                    and ast.name_id(&state.tree, ast.enum_literal(&state.tree, pattern))
                        == ast.name_id(&state.tree, field.name?)) covered = true
            }
        }
        if (covered) continue
        if (!try type_step(state, inline_arm)) {
            try reject_evaluation(state, id)
            return
        }
        execution.locals.items = execution.locals.items[..0]
        mem.set(execution.mapping, no_node)
        literal :: try ast.add_enum_literal(state.builder, span, field.name?)
        if (static_capture) |capture| {
            # runtime patterns use the union's dispatch enum, not its declared tag enum.
            tag_literal :: try ast.add_enum_literal(state.builder, span, field.name?)
            tag :: try ast.add_typed_constant(state.builder, span, tag_type, tag_literal)
            try refresh(state)
            try arraylist.append(&execution.locals, TypeLocal{
                declaration = capture, value = tag, annotation = tag_type,
            })
        }
        payload_capture ?ast.NodeId := null
        if (tagged and arm.capture != null) {
            payload_type :: if (is_type(state, field.type?)) field.type? else try canonical_type(state, field.type?)
            if (payload_type == no_node) {
                try reject(state, id, .invalid_record_field_type)
                return
            }
            if (binding(state, payload_type).kind == .builtin
                and binding(state, payload_type).data.builtin == .void) {
                value :: try ast.add_literal(state.builder, .void, span)
                try refresh(state)
                try arraylist.append(&execution.locals, TypeLocal{
                    declaration = arm.capture?, value = value, annotation = payload_type,
                })
            } else {
                name :: arm.capture?
                payload_capture = try ast.add_identifier(state.builder,
                    ast.node_span(&state.tree, name), ast.name_id(&state.tree, name))
                try refresh(state)
                state.bindings.items[usize(payload_capture?)] = sema.Binding{
                    kind = .declaration, data = sema.BindingData{ declaration = payload_capture? },
                }
                execution.mapping[usize(name)] = payload_capture?
                hashmap.put(&state.capture_types, payload_capture?, payload_type) catch |err| {
                    match err {
                        .key_exists: unreachable
                        else: return err
                    }
                }
            }
        }
        body :: try type_snapshot(state, &execution, arm.body)
        patterns [1]ast.NodeId :: [literal]
        generated :: try ast.add_match_arm(state.builder, span, patterns[..],
            payload_capture, body, arm.expression, false)
        try refresh(state)
        try arraylist.append(&arms, generated)
    }
    if (arms.items.len == count - 1) {
        try reject(state, id, .unreachable_match_arm)
        return
    }
    replacement :: try ast.add_match(state.builder, ast.node_span(&state.tree, id), subject, arms.items)
    try replace(state, id, replacement)
    try refresh(state)
}

# runtime bodies share the type-producer selector, but retain ordinary runtime
# parameters and control transfers in the selected arm.
@hide:file
specialize_match proc(state @mut State, id, statement, expected ast.NodeId) bool ! Error {
    explicit :: ast.expr_kind(&state.tree, ast.match_expr(&state.tree, id).subject) == .comptime_expr
    try expand_inline_match(state, id, no_node)
    if (ast.expr_kind(&state.tree, id) != .match_expr) return true
    subject :: ast.match_expr(&state.tree, id).subject
    annotation := no_node
    for (0..ast.match_arm_count(&state.tree, id)) |i| {
        arm_id :: ast.match_arm(&state.tree, id, i)
        arm :: ast.match_arm_view(&state.tree, arm_id)
        if (explicit or arm.capture == null or ast.match_pattern_count(&state.tree, arm_id) == 0) continue
        if (hashmap.get(&state.capture_types, arm.capture?) != null) continue
        if (annotation == no_node) {
            annotation = try expression_type(state, subject, 0)
            if (annotation != no_node) annotation = try inline_match_shape(state, annotation)
        }
        if (annotation == no_node) break
        payload := no_node
        if (ast.match_expr(&state.tree, id).optional_capture) {
            if (ast.expr_kind(&state.tree, annotation) != .optional_type) break
            payload = ast.type_operand(&state.tree, annotation)
        } else {
            if (ast.expr_kind(&state.tree, annotation) != .union_type) break
            pattern :: ast.match_pattern(&state.tree, arm_id, 0)
            if (ast.expr_kind(&state.tree, pattern) != .enum_literal) continue
            slot :: type_record_slot(&state.tree, annotation, ast.enum_literal(&state.tree, pattern))
            if (slot == no_index) continue
            field :: ast.field(&state.tree, ast.record_field(&state.tree, annotation, slot))
            if (field.type) |type| payload = type
        }
        if (payload != no_node) {
            hashmap.put(&state.capture_types, arm.capture?, payload) catch |err| {
                match err {
                    .key_exists: unreachable
                    else: return err
                }
            }
        }
    }
    try expand(state, subject)
    metadata :: type_record_storage(state, try expression_type(state, subject, 0), 0)
    if (!explicit and usize(id) < state.original_count and !metadata) return false
    if (!explicit and !metadata and !branch_constant(state, subject, 0)) return false
    state.evaluation_diagnostic = diagnostics.no_diagnostic
    index :: try type_match_arm(state, id)
    if (index == no_index) {
        try reject_evaluation(state, id)
        return true
    }
    arm :: ast.match_arm_view(&state.tree, ast.match_arm(&state.tree, id, index))
    selected := try type_match_body(state, id, arm)
    if (selected != no_node and !arm.expression) {
        selected = try ast.add_block_expr(state.builder, ast.node_span(&state.tree, selected), selected)
        try refresh(state)
    }
    if (selected == no_node) {
        try reject_evaluation(state, id)
        return true
    }
    try expand_expected(state, selected, expected)
    if (statement != no_node) {
        replacement :: try ast.add_expression_stmt(state.builder, selected)
        try replace(state, statement, replacement)
    } else {
        resolved :: binding(state, selected)
        try remember(state, id)
        ast.replace_node_from_source(state.builder, id, selected)
        try refresh(state)
        state.bindings.items[usize(id)] = resolved
    }
    try refresh(state)
    return true
}

# implicit probing is limited to constants and effect-free, fully bound type
# helpers. ordinary runtime calls still require an explicit evaluation request.
@hide:file
branch_constant proc(state @State, id ast.NodeId, depth usize) bool {
    if (depth >= 128) return false
    resolved :: binding(state, id)
    if (resolved.kind == .builtin) return true
    if (resolved.kind == .declaration) {
        target :: resolved.data.declaration
        if (ast.node_class(&state.tree, target) == .function) return true
        if (ast.node_class(&state.tree, target) != .statement) return false
        declaration :: ast.statement_decl(&state.tree, target)
        initializer :: ast.expr_kind(&state.tree, declaration.initializer)
        # contextual aggregates may omit defaults with runtime calls.
        if (declaration.type != null and (initializer == .record_literal or initializer == .array_literal)) return false
        return (
            declaration.mutability == .constant
            and branch_constant(state, declaration.initializer, depth + 1)
        )
    }
    match ast.expr_kind(&state.tree, id) {
        .literal_int, .literal_float, .literal_bool, .literal_string, .literal_null, .literal_void,
        .slice_constant, .memory_constant, .address_constant: return true
        .typed_constant: return branch_constant(state, ast.typed_constant(&state.tree, id).value, depth + 1)
        .enum_literal: return true
        .call: return branch_type_call(state, id, depth + 1)
        .block_expr: return branch_body_constant(state, ast.block_expr(&state.tree, id), depth + 1)
        .builtin_call: {
            name :: ast.literal_text(&state.tree, ast.builtin_call(&state.tree, id).name)
            if (ast.call_arg_count(&state.tree, id) != 1
                or (!mem.eql(name, "minval") and !mem.eql(name, "maxval") and !mem.eql(name, "some")
                    and !mem.eql(name, "sizeof") and !mem.eql(name, "alignof"))) return false
            # folding presence can replay its payload; replaying owned backing changes
            # observable address identity. explicit some! evaluation still reuses the captured payload.
            if (mem.eql(name, "some") and constant_addresses(state, ast.call_arg(&state.tree, id, 0), depth + 1))
                return false
            return branch_constant(state, ast.call_arg(&state.tree, id, 0), depth + 1)
        }
        .record_literal: {
            # typed literals may omit defaults; materialized constants are complete
            # contextual literals inside a typed_constant wrapper.
            for (0..ast.record_field_count(&state.tree, id)) |i| {
                field :: ast.field(&state.tree, ast.record_field(&state.tree, id, i))
                if (field.value == null or !branch_constant(state, field.value?, depth + 1)) return false
            }
            return ast.record_literal(&state.tree, id).type == null
        }
        .array_literal: {
            for (0..ast.array_element_count(&state.tree, id)) |i| {
                if (!branch_constant(state, ast.array_element(&state.tree, id, i), depth + 1)) return false
            }
            return true
        }
        .selection: return branch_constant(state, ast.selection_expr(&state.tree, id).base, depth + 1)
        .index: {
            view :: ast.index_expr(&state.tree, id)
            return branch_constant(state, view.base, depth + 1) and branch_constant(state, view.index, depth + 1)
        }
        .unary: {
            view :: ast.unary_expr(&state.tree, id)
            return (
                (view.operator == .negate or view.operator == .logical_not or view.operator == .bit_not)
                and branch_constant(state, view.operand, depth + 1)
            )
        }
        .binary: {
            view :: ast.binary_expr(&state.tree, id)
            return (
                branch_constant(state, view.left, depth + 1)
                and branch_constant(state, view.right, depth + 1)
            )
        }
        .pointer_type: return branch_constant(state, ast.pointer_type(&state.tree, id).element, depth + 1)
        .optional_type, .alias_expr: return branch_constant(state, ast.type_operand(&state.tree, id), depth + 1)
        .record_type, .union_type, .enum_type, .distinct_type, .array_type, .slice_type, .function_type,
        .fallible_type, .sum_type, .union_tag_type: return true
        else: return false
    }
}

@hide:file
branch_type_call proc(state @State, id ast.NodeId, depth usize) bool {
    if (depth >= 128 or ast.call_arg_count(&state.tree, id) != 0) return false
    callee :: binding(state, ast.call_expr(&state.tree, id).callee)
    if (callee.kind != .declaration) return false
    function :: callee.data.declaration
    if (ast.node_class(&state.tree, function) != .function
        or ast.function_external(&state.tree, function)
        or ast.function_param_count(&state.tree, function) != 0) return false
    for (state.instances.items) |instance| {
        if (instance.declaration != function) continue
        for (0..ast.function_param_count(&state.tree, instance.function)) |i| {
            parameter :: ast.param(&state.tree, ast.function_param(&state.tree, instance.function, i))
            if (parameter.comptime and is_type(state, parameter.type))
                return branch_body_constant(state, ast.function_decl(&state.tree, function).body, depth + 1)
        }
        return false
    }
    return false
}

@hide:file
branch_body_constant proc(state @State, id ast.NodeId, depth usize) bool {
    if (depth >= 128) return false
    if (ast.node_class(&state.tree, id) == .block) {
        for (0..ast.block_statement_count(&state.tree, id)) |i| {
            if (!branch_body_constant(state, ast.block_statement(&state.tree, id, i), depth + 1)) return false
        }
        return true
    }
    if (ast.node_class(&state.tree, id) != .statement) return false
    match ast.stmt_kind(&state.tree, id) {
        .return_stmt, .yield_stmt: {
            value :: if (ast.stmt_kind(&state.tree, id) == .yield_stmt)
                ast.yield_stmt(&state.tree, id).value else ast.return_stmt(&state.tree, id).value
            return value == null or branch_constant(state, value?, depth + 1)
        }
        .block_stmt: return branch_body_constant(state, ast.statement_block(&state.tree, id), depth + 1)
        .expression: return branch_constant(state, ast.statement_expr(&state.tree, id), depth + 1)
        .declaration: {
            declaration :: ast.statement_decl(&state.tree, id)
            initializer :: ast.expr_kind(&state.tree, declaration.initializer)
            if (declaration.type != null and (initializer == .record_literal or initializer == .array_literal)) return false
            return (
                declaration.mutability == .constant
                and branch_constant(state, declaration.initializer, depth + 1)
            )
        }
        .if_stmt: {
            conditional :: ast.if_stmt(&state.tree, id)
            return (
                conditional.capture == null
                and branch_constant(state, conditional.condition, depth + 1)
                and branch_body_constant(state, conditional.then_block, depth + 1)
                and (conditional.else_block == null
                    or branch_body_constant(state, conditional.else_block?, depth + 1))
            )
        }
        else: return false
    }
}

@hide:file
builtin proc(state @mut State, at ast.NodeId, kind sema.BuiltinType) ast.NodeId ! Error {
    id :: try ast.add_identifier(state.builder, ast.node_span(&state.tree, at), strpool.no_str)
    try refresh(state)
    state.bindings.items[usize(id)] = sema.Binding{ kind = .builtin, data = sema.BindingData{ builtin = kind } }
    return id
}

@hide:file
reference proc(state @mut State, at, target ast.NodeId) ast.NodeId ! Error {
    id :: try ast.add_identifier(state.builder, ast.node_span(&state.tree, at), strpool.no_str)
    try refresh(state)
    state.bindings.items[usize(id)] = sema.Binding{ kind = .declaration, data = sema.BindingData{ declaration = target } }
    return id
}

@hide:file
is_type proc(state @State, id ast.NodeId) bool {
    value :: binding(state, id)
    return value.kind == .builtin and value.data.builtin == .type
}

# recognize erased storage without evaluating dependent lengths or elaborating
# bodies. pointers retain the runtime materialization boundary.
@hide:file
type_storage_annotation proc(tree @ast.Tree, bindings []sema.Binding, input ast.NodeId, depth usize) bool {
    if (depth >= 128 or usize(input) >= bindings.len) return false
    resolved :: bindings[usize(input)]
    if (resolved.kind == .builtin) return resolved.data.builtin == .type
    if (resolved.kind == .declaration) {
        declaration :: resolved.data.declaration
        if (ast.node_class(tree, declaration) != .statement) return false
        view :: ast.statement_decl(tree, declaration)
        return (view.mutability == .constant
            and type_storage_annotation(tree, bindings, view.initializer, depth + 1))
    }
    kind :: ast.expr_kind(tree, input)
    if (kind == .alias_expr or kind == .optional_type)
        return type_storage_annotation(tree, bindings, ast.type_operand(tree, input), depth + 1)
    if (kind == .fallible_type or kind == .sum_type) {
        channels :: ast.binary_expr(tree, input)
        return (type_storage_annotation(tree, bindings, channels.left, depth + 1)
            or type_storage_annotation(tree, bindings, channels.right, depth + 1))
    }
    if (kind == .array_type)
        return type_storage_annotation(tree, bindings, ast.array_type(tree, input).element, depth + 1)
    if (kind == .slice_type)
        return type_storage_annotation(tree, bindings, ast.slice_type(tree, input).element, depth + 1)
    if (kind == .pointer_type)
        return type_storage_annotation(tree, bindings, ast.pointer_type(tree, input).element, depth + 1)
    if (kind != .record_type and kind != .union_type) return false
    for (0..ast.record_field_count(tree, input)) |i| {
        field :: ast.field(tree, ast.record_field(tree, input, i))
        if (field.type != null and type_storage_annotation(tree, bindings, field.type?, depth + 1)) return true
    }
    return false
}

@hide:file
storage_schema proc(tree @ast.Tree, bindings []sema.Binding, input ast.NodeId, depth usize) ast.NodeId {
    if (depth >= 128 or usize(input) >= bindings.len) return no_node
    resolved :: bindings[usize(input)]
    if (resolved.kind == .declaration) {
        target :: resolved.data.declaration
        if (ast.node_class(tree, target) == .function) return target
        if (ast.node_class(tree, target) == .statement)
            return storage_schema(tree, bindings, ast.statement_decl(tree, target).initializer, depth + 1)
    }
    if (ast.expr_kind(tree, input) == .alias_expr)
        return storage_schema(tree, bindings, ast.type_operand(tree, input), depth + 1)
    return input
}

# read only existing annotations: discovery must not specialize recursive calls.
@hide:file
storage_expression_annotation proc(
    tree @ast.Tree,
    bindings []sema.Binding,
    input ast.NodeId,
    depth usize,
) ast.NodeId {
    if (depth >= 128 or usize(input) >= bindings.len) return no_node
    resolved :: bindings[usize(input)]
    if (resolved.kind == .declaration) {
        target :: resolved.data.declaration
        class :: ast.node_class(tree, target)
        if (class == .parameter) return ast.param(tree, target).type
        if (class == .statement) {
            declaration :: ast.statement_decl(tree, target)
            if (declaration.type) |annotation| return annotation
            return storage_expression_annotation(tree, bindings, declaration.initializer, depth + 1)
        }
        return no_node
    }
    kind :: ast.expr_kind(tree, input)
    if (kind == .typed_constant) return ast.typed_constant(tree, input).type
    if (kind == .slice_constant) return ast.slice_constant(tree, input).type
    if (kind == .memory_constant) return ast.memory_constant(tree, input).type
    if (kind == .address_constant) return ast.address_constant(tree, input).type
    if (kind == .record_literal) {
        if (ast.record_literal(tree, input).type) |type| return type
        return no_node
    }
    if (kind == .call) {
        callee :: storage_schema(tree, bindings, ast.call_expr(tree, input).callee, depth + 1)
        if (callee != no_node and ast.node_class(tree, callee) == .function)
            return ast.function_decl(tree, callee).return_type
        return no_node
    }
    base := no_node
    if (kind == .selection) base = ast.selection_expr(tree, input).base
    else if (kind == .index) base = ast.index_expr(tree, input).base
    else if (kind == .slice) base = ast.slice_expr(tree, input).base
    else if (kind == .unary) base = ast.unary_expr(tree, input).operand
    else if (kind == .try_expr) base = ast.type_operand(tree, input)
    else if (kind == .catch_expr) base = ast.catch_expr(tree, input).operand
    else if (kind == .comptime_expr) return storage_expression_annotation(tree, bindings,
        ast.comptime_operand(tree, input), depth + 1)
    if (base == no_node) return no_node
    annotation :: storage_schema(tree, bindings,
        storage_expression_annotation(tree, bindings, base, depth + 1), depth + 1)
    if (annotation == no_node) return no_node
    shape :: ast.expr_kind(tree, annotation)
    if (kind == .slice) return annotation
    if (kind == .try_expr or kind == .catch_expr)
        return if (shape == .fallible_type) ast.binary_expr(tree, annotation).left else no_node
    if (kind == .unary) {
        operator :: ast.unary_expr(tree, input).operator
        if (shape == .optional_type and operator == .unwrap) return ast.type_operand(tree, annotation)
        if (shape == .pointer_type and operator == .dereference) return ast.pointer_type(tree, annotation).element
        return no_node
    }
    if (kind == .index) {
        if (shape == .array_type) return ast.array_type(tree, annotation).element
        if (shape == .slice_type) return ast.slice_type(tree, annotation).element
        return no_node
    }
    if (shape != .record_type and shape != .union_type) return no_node
    member :: ast.selection_expr(tree, input).member
    slot :: type_record_slot(tree, annotation, member)
    if (slot == no_index) return no_node
    if (ast.field(tree, ast.record_field(tree, annotation, slot)).type) |type| return type
    return no_node
}

@hide:file
type_storage_yields proc(
    tree @ast.Tree,
    bindings []sema.Binding,
    id ast.NodeId,
    scalar_type bool,
    depth usize,
) bool {
    if (depth >= 128) return false
    class :: ast.node_class(tree, id)
    if (class != .block and class != .statement) return false
    if (class == .statement and ast.stmt_kind(tree, id) == .yield_stmt) {
        value :: ast.yield_stmt(tree, id).value
        return value != null and type_storage_initializer(tree, bindings, value?, scalar_type, depth + 1)
    }
    for (0..ast.child_count(tree, id)) |i| {
        if (type_storage_yields(tree, bindings, ast.child(tree, id, i), scalar_type, depth + 1)) return true
    }
    return false
}

# discover inferred storage without elaborating calls or executing initializers.
# immutable scalar type bindings remain aliases in ordinary runtime procedures.
@hide:file
type_storage_initializer proc(
    tree @ast.Tree, bindings []sema.Binding, input ast.NodeId, scalar_type bool, depth usize,
) bool {
    if (depth >= 128 or usize(input) >= bindings.len) return false
    annotation :: storage_schema(tree, bindings,
        storage_expression_annotation(tree, bindings, input, depth + 1), depth + 1)
    if (annotation != no_node) {
        if (!scalar_type and bindings[usize(annotation)].kind == .builtin
            and bindings[usize(annotation)].data.builtin == .type) return false
        return type_storage_annotation(tree, bindings, annotation, depth + 1)
    }
    if (ast.expr_kind(tree, input) == .unary) {
        view :: ast.unary_expr(tree, input)
        if (view.operator == .address_of or (scalar_type and view.operator == .dereference))
            return type_storage_initializer(tree, bindings, view.operand, true, depth + 1)
    }
    if (ast.expr_kind(tree, input) == .selection
        and mem.eql(ast.literal_text(tree, ast.selection_expr(tree, input).member), "ptr"))
        return type_storage_initializer(tree, bindings, ast.selection_expr(tree, input).base, true, depth + 1)
    if (ast.expr_kind(tree, input) == .binary and ast.binary_expr(tree, input).operator == .add)
        return type_storage_initializer(tree, bindings, ast.binary_expr(tree, input).left, true, depth + 1)
    resolved :: bindings[usize(input)]
    if (resolved.kind == .builtin) return scalar_type
    if (resolved.kind == .declaration) {
        target :: resolved.data.declaration
        class :: ast.node_class(tree, target)
        if (class == .statement) {
            declaration :: ast.statement_decl(tree, target)
            if (declaration.type != null) return false
            return type_storage_initializer(tree, bindings, declaration.initializer, scalar_type, depth + 1)
        }
        return false
    }
    kind :: ast.expr_kind(tree, input)
    match kind {
        .record_type, .array_type, .slice_type, .pointer_type, .function_type, .optional_type,
        .enum_type, .union_type, .union_tag_type, .distinct_type, .fallible_type, .sum_type, .alias_expr:
            return scalar_type
        .record_literal: {
            for (0..ast.record_field_count(tree, input)) |i| {
                field :: ast.field(tree, ast.record_field(tree, input, i))
                if (field.value != null
                    and type_storage_initializer(tree, bindings, field.value?, true, depth + 1)) return true
            }
            return false
        }
        .array_literal: {
            for (0..ast.array_element_count(tree, input)) |i| {
                if (type_storage_initializer(tree, bindings, ast.array_element(tree, input, i), true, depth + 1))
                    return true
            }
            return false
        }
        .comptime_expr:
            return type_storage_initializer(tree, bindings, ast.comptime_operand(tree, input), scalar_type, depth + 1)
        .match_expr: {
            for (0..ast.match_arm_count(tree, input)) |i| {
                arm :: ast.match_arm_view(tree, ast.match_arm(tree, input, i))
                if (arm.expression) {
                    if (type_storage_initializer(tree, bindings, arm.body, scalar_type, depth + 1)) return true
                } else if (type_storage_yields(tree, bindings, arm.body, scalar_type, depth + 1)) return true
            }
            return false
        }
        .block_expr:
            return type_storage_yields(tree, bindings, ast.block_expr(tree, input), scalar_type, depth + 1)
        .builtin_call: {
            name :: ast.literal_text(tree, ast.builtin_call(tree, input).name)
            if (mem.eql(name, "typeinfo")) return true
            if (mem.eql(name, "struct_type")) return scalar_type
            if (mem.eql(name, "some") and ast.call_arg_count(tree, input) == 1)
                return type_storage_initializer(tree, bindings, ast.call_arg(tree, input, 0), true, depth + 1)
            return false
        }
        else: return false
    }
}

@hide:file
type_local_storage proc(tree @ast.Tree, bindings []sema.Binding, id ast.NodeId, depth usize) bool {
    if (depth >= 128) return false
    if (ast.node_class(tree, id) == .statement and ast.stmt_kind(tree, id) == .declaration) {
        declaration :: ast.statement_decl(tree, id)
        if (declaration.type) |annotation| {
            if (type_storage_annotation(tree, bindings, annotation, 0)) return true
        }
        else if (type_storage_initializer(tree, bindings, declaration.initializer,
            declaration.mutability == .variable, 0)) return true
    }
    for (0..ast.child_count(tree, id)) |i| {
        if (type_local_storage(tree, bindings, ast.child(tree, id, i), depth + 1)) return true
    }
    return false
}

# local metadata does not make unrelated parameters constant. retain constant-input
# execution only when a parameter participates in constructing or updating metadata.
@hide:file
metadata_local proc(state @State, id ast.NodeId) bool {
    if (ast.node_class(&state.tree, id) != .statement
        or ast.stmt_kind(&state.tree, id) != .declaration) return false
    declaration :: ast.statement_decl(&state.tree, id)
    if (declaration.type) |annotation| return type_record_storage(state, annotation, 0)
    return type_storage_initializer(&state.tree, state.bindings.items, declaration.initializer,
        declaration.mutability == .variable, 0)
}

@hide:file
assignment_root proc(state @State, id ast.NodeId) ast.NodeId {
    kind :: ast.expr_kind(&state.tree, id)
    if (kind == .selection) return assignment_root(state, ast.selection_expr(&state.tree, id).base)
    if (kind == .index) return assignment_root(state, ast.index_expr(&state.tree, id).base)
    if (kind == .unary and ast.unary_expr(&state.tree, id).operator == .dereference)
        return assignment_root(state, ast.unary_expr(&state.tree, id).operand)
    if (kind == .builtin_call
        and mem.eql(ast.literal_text(&state.tree, ast.builtin_call(&state.tree, id).name), "field")
        and ast.call_arg_count(&state.tree, id) == 2)
        return assignment_root(state, ast.call_arg(&state.tree, id, 0))
    resolved :: binding(state, id)
    return if (resolved.kind == .declaration) resolved.data.declaration else no_node
}

@hide:file
DependencyPath :: struct { declaration ast.NodeId, parent ?@DependencyPath }

@hide:file
parameter_dependency proc(state @State, id, body ast.NodeId, path ?@DependencyPath, depth usize) bool {
    if (depth >= 128) return true
    resolved :: binding(state, id)
    if (resolved.kind == .declaration) {
        declaration :: resolved.data.declaration
        class :: ast.node_class(&state.tree, declaration)
        if (class == .parameter and ast.param(&state.tree, declaration).type != no_node)
            return !ast.param(&state.tree, declaration).comptime
        if (class == .statement or class == .expression or class == .parameter) {
            current := path
            while (current) |entry| {
                if (entry.declaration == declaration) return false
                current = entry.parent
            }
            entry :: DependencyPath{ declaration = declaration, parent = path }
            if (class == .statement
                and parameter_dependency(state, ast.statement_decl(&state.tree, declaration).initializer,
                    body, &entry, depth + 1)) return true
            if (class == .statement and ast.statement_decl(&state.tree, declaration).mutability == .constant)
                return false
            return declaration_parameter_dependency(state, body, declaration, body, &entry, false, depth + 1)
        }
    }
    for (0..ast.child_count(&state.tree, id)) |i|
        if (parameter_dependency(state, ast.child(&state.tree, id, i), body, path, depth + 1)) return true
    return false
}

@hide:file
subtree_has proc(state @State, root, node ast.NodeId) bool {
    if (root == node) return true
    for (0..ast.child_count(&state.tree, root)) |i|
        if (subtree_has(state, ast.child(&state.tree, root, i), node)) return true
    return false
}

# follow writes as well as initializers; the declaration path breaks assignment cycles.
@hide:file
declaration_parameter_dependency proc(
    state @State, id, declaration, body ast.NodeId, path @DependencyPath, dynamic bool, depth usize,
) bool {
    if (depth >= 128) return true
    selected := dynamic
    class :: ast.node_class(&state.tree, id)
    if (class == .statement) {
        kind :: ast.stmt_kind(&state.tree, id)
        if (kind == .assignment_stmt) {
            assignment :: ast.assignment_stmt(&state.tree, id)
            if (assignment_root(state, assignment.target) == declaration)
                return (dynamic or parameter_dependency(state, assignment.target, body, path, depth + 1)
                    or parameter_dependency(state, assignment.value, body, path, depth + 1))
        }
        if (kind == .if_stmt or kind == .while_stmt or kind == .for_stmt) {
            condition := no_node
            captured := false
            if (kind == .if_stmt) {
                view :: ast.if_stmt(&state.tree, id)
                condition = view.condition
                captured = view.capture != null and view.capture? == declaration
            } else if (kind == .while_stmt) {
                view :: ast.while_stmt(&state.tree, id)
                condition = view.condition
                captured = view.capture != null and view.capture? == declaration
            } else {
                view :: ast.for_stmt(&state.tree, id)
                condition = view.iterable
                captured = ((view.capture != null and view.capture? == declaration)
                    or (view.index != null and view.index? == declaration))
            }
            if (captured) return parameter_dependency(state, condition, body, path, depth + 1)
            if (!subtree_has(state, id, declaration))
                selected = dynamic or parameter_dependency(state, condition, body, path, depth + 1)
        }
    }
    if (class == .expression and ast.expr_kind(&state.tree, id) == .match_expr) {
        subject :: ast.match_expr(&state.tree, id).subject
        for (0..ast.match_arm_count(&state.tree, id)) |i| {
            arm :: ast.match_arm_view(&state.tree, ast.match_arm(&state.tree, id, i))
            if (arm.capture != null and arm.capture? == declaration)
                return parameter_dependency(state, subject, body, path, depth + 1)
        }
        if (!subtree_has(state, id, declaration))
            selected = dynamic or parameter_dependency(state, subject, body, path, depth + 1)
    }
    for (0..ast.child_count(&state.tree, id)) |i|
        if (declaration_parameter_dependency(state, ast.child(&state.tree, id, i),
            declaration, body, path, selected, depth + 1)) return true
    return false
}

@hide:file
metadata_parameter_dependency proc(state @State, id, body, dynamic ast.NodeId) bool {
    class :: ast.node_class(&state.tree, id)
    if (metadata_local(state, id) and parameter_dependency(state, id, body, null, 0)) return true
    if (class == .statement) {
        kind :: ast.stmt_kind(&state.tree, id)
        if (kind == .assignment_stmt) {
            assignment :: ast.assignment_stmt(&state.tree, id)
            root :: assignment_root(state, assignment.target)
            if (root != no_node and metadata_local(state, root))
                return ((dynamic != no_node and !subtree_has(state, dynamic, root))
                    or parameter_dependency(state, assignment.target, body, null, 0)
                    or parameter_dependency(state, assignment.value, body, null, 0))
        }
        if (kind == .if_stmt or kind == .while_stmt or kind == .for_stmt) {
            condition :: if (kind == .if_stmt) ast.if_stmt(&state.tree, id).condition
                else if (kind == .while_stmt) ast.while_stmt(&state.tree, id).condition
                else ast.for_stmt(&state.tree, id).iterable
            selected :: if (parameter_dependency(state, condition, body, null, 0)) id else dynamic
            for (0..ast.child_count(&state.tree, id)) |i|
                if (metadata_parameter_dependency(state, ast.child(&state.tree, id, i), body, selected)) return true
            return false
        }
    }
    for (0..ast.child_count(&state.tree, id)) |i|
        if (metadata_parameter_dependency(state, ast.child(&state.tree, id, i), body, dynamic)) return true
    return false
}

@hide:file
compiletime_call proc(state @State, function ast.NodeId) bool {
    if (type_record_storage(state, ast.function_decl(&state.tree, function).return_type, 0)) return true
    runtime_input := false
    for (0..ast.function_param_count(&state.tree, function)) |i| {
        parameter :: ast.param(&state.tree, ast.function_param(&state.tree, function, i))
        if (!parameter.comptime and type_record_storage(state, parameter.type, 0)) return true
        if (!parameter.comptime) runtime_input = true
    }
    if (!runtime_input or ast.function_external(&state.tree, function)) return false
    body :: ast.function_decl(&state.tree, function).body
    if (!type_local_storage(&state.tree, state.bindings.items, body, 0)) return false
    return metadata_parameter_dependency(state, body, body, no_node)
}

@hide:file
inference_contextual proc(state @State, id ast.NodeId) bool {
    kind :: ast.expr_kind(&state.tree, id)
    if (kind == .literal_null or kind == .literal_string) return true
    if (ast.expr_kind(&state.tree, id) == .record_literal) {
        annotation :: ast.record_literal(&state.tree, id).type
        return annotation == null or ast.expr_kind(&state.tree, annotation?) == .enum_literal
    }
    return flexible(state, id) or contextual_literal(state, id)
}

@hide:file
inference_phase proc(state @State, id ast.NodeId) usize {
    if (inference_contextual(state, id)) return 2
    if (ast.expr_kind(&state.tree, id) == .call) {
        callee :: binding(state, ast.call_expr(&state.tree, id).callee)
        if (
            callee.kind == .declaration and ast.node_class(&state.tree, callee.data.declaration) == .function
            and template(state, callee.data.declaration)
            and ast.call_arg_count(&state.tree, id) != ast.function_param_count(&state.tree, callee.data.declaration)
        ) return 1
    }
    return 0
}

@hide:file
annotation_ready proc(
    state @State, function, id ast.NodeId, arguments []Value, depth usize,
) bool {
    if (depth >= 128) return false
    resolved :: binding(state, id)
    if (resolved.kind == .declaration) {
        index :: parameter_index(state, function, resolved.data.declaration)
        if (index != no_index) return arguments[index].kind != .invalid
    }
    for (0..ast.child_count(&state.tree, id)) |i| {
        if (!annotation_ready(state, function, ast.child(&state.tree, id, i), arguments, depth + 1)) return false
    }
    return true
}

# dependent values are explicit inputs unless an ordinary input or result carries
# their value in its type, as nominal callback arguments do.
@hide:file
annotation_mentions proc(state @State, id, parameter ast.NodeId) bool {
    resolved :: binding(state, id)
    if (resolved.kind == .declaration and resolved.data.declaration == parameter) return true
    for (0..ast.child_count(&state.tree, id)) |i|
        if (annotation_mentions(state, ast.child(&state.tree, id, i), parameter)) return true
    return false
}

@hide:file
dependent_input proc(state @State, function, declaration ast.NodeId) bool {
    parameter :: ast.param(&state.tree, declaration)
    if (!parameter.comptime or !annotation_generic(state, function, parameter.type, 0)) return false
    if (annotation_mentions(state, ast.function_decl(&state.tree, function).return_type, declaration)) return false
    for (0..ast.function_param_count(&state.tree, function)) |i| {
        candidate :: ast.param(&state.tree, ast.function_param(&state.tree, function, i))
        if (!candidate.comptime and annotation_mentions(state, candidate.type, declaration)) return false
    }
    return true
}

@hide:file
specialization_argument proc(
    state @mut State, function, parameter, argument ast.NodeId,
    arguments []Value, metadata_result bool,
) Value ! Error {
    view :: ast.param(&state.tree, parameter)
    annotation :: try argument_annotation(state, function, view.type, arguments)
    try expand_expected(state, argument, annotation)
    state.evaluation_diagnostic = diagnostics.no_diagnostic
    value := try evaluate_expected(state, argument, annotation)
    if ((view.comptime or !metadata_result) and value.kind == .aggregate
        and metadata_has_view(state, value.node)) {
        wrapped :: try ast.add_typed_constant(state.builder, ast.node_span(&state.tree, argument),
            value.annotation, value.node)
        try refresh(state)
        owned :: try metadata_own(state, wrapped, argument)
        if (owned == no_node or !try type_array_initialized(state, owned, argument)) return Value{}
        value.node = ast.typed_constant(&state.tree, owned).value
    }
    return value
}

@hide:file
specialize_call proc(state @mut State, call, function, expected ast.NodeId) void ! Error {
    if (state.depth >= 128 or state.instances.items.len >= 4096) {
        try reject(state, call, .specialization_limit)
        return
    }
    state.depth += 1
    defer state.depth -= 1
    count :: ast.function_param_count(&state.tree, function)
    # constant arguments alone never demand a runtime-parameter procedure.
    metadata_result :: compiletime_call(state, function)
    demanded :: !metadata_result and (closed_zero_runtime_call(state, function)
        or (state.demand_depth > 0 and try needs_demand_execution(state, function)))
    type_result :: metadata_result or demanded
    inputs := usize(0)
    for (0..count) |i| {
        parameter :: ast.param(&state.tree, ast.function_param(&state.tree, function, i))
        if (!metadata_result and (!parameter.comptime
            or dependent_input(state, function, ast.function_param(&state.tree, function, i)))) inputs += 1
    }
    supplied :: ast.call_arg_count(&state.tree, call)
    explicit :: supplied == count
    if (!explicit and (metadata_result or supplied < inputs or supplied > count)) {
        try reject(state, call, .argument_count_mismatch)
        return
    }
    arguments :: try mem.alloc(Value, state.allocator, count)
    defer mem.free(state.allocator, arguments)
    mem.set(arguments, Value{})
    parameter_arguments := arraylist.init(ast.NodeId, state.allocator)
    defer arraylist.deinit(&parameter_arguments)
    try arraylist.reserve(&parameter_arguments, count)
    for (0..count) |_| try arraylist.append(&parameter_arguments, no_node)
    # independent compile-time arguments form a prefix; dependent values remain inputs.
    supplied_comptime :: if (metadata_result) count else supplied - inputs
    comptime_position := usize(0)
    position := 0
    for (0..count) |i| {
        parameter :: ast.function_param(&state.tree, function, i)
        view :: ast.param(&state.tree, parameter)
        dependent :: !metadata_result and dependent_input(state, function, parameter)
        if (view.comptime and !metadata_result and !dependent) {
            if (comptime_position >= supplied_comptime) continue
            comptime_position += 1
        }
        argument :: ast.call_arg(&state.tree, call, position)
        position += 1
        parameter_arguments.items[i] = argument
        if (!type_result and unsigned_parameter(state, parameter)) {
            try expand(state, argument)
            actual := if (flexible(state, argument)) try builtin(state, argument, .u64)
                else try expression_type(state, argument, 0)
            if (actual != no_node) actual = try canonical_type(state, actual)
            if (actual == no_node or !try unsigned_type(state, actual)) {
                try reject(state, call, .type_mismatch)
                return
            }
            if (binding(state, actual).kind == .builtin and binding(state, actual).data.builtin == .uint)
                actual = try builtin(state, argument, .u64)
            arguments[i] = Value{ kind = .type, node = actual }
        }
        if ((type_result or view.comptime) and (explicit or !dependent)
            and annotation_ready(state, function, view.type, arguments, 0)) {
            arguments[i] = try specialization_argument(state, function, parameter, argument, arguments, metadata_result)
            if (arguments[i].kind == .invalid) {
                try reject_evaluation(state, call)
                return
            }
            if (is_type(state, view.type) != (arguments[i].kind == .type)) {
                try reject(state, call, .type_mismatch)
                return
            }
        }
    }
    if (!explicit) {
        # rigid arguments constrain first; result context then types nested generic
        # calls before flexible literals choose their default widths.
        for (0..usize(3)) |phase| {
            if (phase == 1 and expected != no_node) {
                result :: ast.function_decl(&state.tree, function).return_type
                if (!try infer_result(state, function, result, expected, arguments)) {
                    try reject(state, call, .cannot_infer_generic)
                    return
                }
            }
            for (0..count) |i| {
                parameter :: ast.function_param(&state.tree, function, i)
                view :: ast.param(&state.tree, parameter)
                if (view.comptime and !dependent_input(state, function, parameter)) continue
                argument :: parameter_arguments.items[i]
                contextual :: inference_contextual(state, argument)
                if (inference_phase(state, argument) != phase) continue
                if (ast.expr_kind(&state.tree, argument) == .array_literal
                    and ast.expr_kind(&state.tree, view.type) == .array_type) {
                    if (ast.array_type(&state.tree, view.type).count) |length| {
                        literal :: try ast.add_integer(state.builder, ast.node_span(&state.tree, argument),
                            u64(ast.array_element_count(&state.tree, argument)))
                        try refresh(state)
                        value :: Value{ kind = .integer, node = literal,
                            magnitude = u64(ast.array_element_count(&state.tree, argument)) }
                        if (!try infer_value(state, function, length, value, arguments, false)) {
                            try reject(state, call, .cannot_infer_generic)
                            return
                        }
                    }
                }
                if (annotation_ready(state, function, view.type, arguments, 0)) {
                    annotation :: try argument_annotation(state, function, view.type, arguments)
                    try expand_expected(state, argument, annotation)
                }
                actual :: try expression_type(state, argument, 0)
                # contextual literals need not have an independent type; the rewritten
                # call checks them against the substituted signature after inference.
                if (
                    (actual == no_node or !try infer(state, function, view.type, actual, arguments, contextual))
                    and !contextual
                ) {
                    try reject(state, call, .cannot_infer_generic)
                    return
                }
            }
        }
    }
    for (0..count) |i| {
        parameter :: ast.function_param(&state.tree, function, i)
        view :: ast.param(&state.tree, parameter)
        deferred :: !explicit and !metadata_result and dependent_input(state, function, parameter)
        if ((type_result or view.comptime) and (deferred or arguments[i].kind == .invalid)
            and parameter_arguments.items[i] != no_node
            and annotation_ready(state, function, view.type, arguments, 0)) {
            value :: try specialization_argument(state, function, parameter,
                parameter_arguments.items[i], arguments, metadata_result)
            if (value.kind == .invalid) {
                try reject_evaluation(state, call)
                return
            }
            if (is_type(state, view.type) != (value.kind == .type)) {
                try reject(state, call, .type_mismatch)
                return
            }
            if (arguments[i].kind != .invalid and !try value_equal(state, arguments[i], value)) {
                try reject(state, call, .cannot_infer_generic)
                return
            }
            arguments[i] = value
        }
        if (ast.param(&state.tree, parameter).comptime and arguments[i].kind == .invalid) {
            try reject(state, call, .cannot_infer_generic)
            return
        }
    }
    for (0..count) |i| {
        view :: ast.param(&state.tree, ast.function_param(&state.tree, function, i))
        if (view.comptime or type_result) continue
        argument :: parameter_arguments.items[i]
        if (state.expanded.items[usize(argument)] != 0) continue
        annotation :: try argument_annotation(state, function, view.type, arguments)
        try expand_expected(state, argument, annotation)
    }
    borrowed := false
    for arguments |argument| {
        if (argument.kind != .invalid and metadata_has_view(state, argument.node)) borrowed = true
    }
    if (borrowed) {
        readonly := true
        for arguments |argument| {
            if (argument.kind != .invalid and !try metadata_readonly_views(state, argument.node, argument.annotation))
                readonly = false
        }
        if (readonly) {
            for arguments |@argument| {
                if (argument.kind == .invalid or !metadata_has_view(state, argument.node)) continue
                wrapped :: try ast.add_typed_constant(state.builder, ast.node_span(&state.tree, argument.node),
                    argument.annotation, argument.node)
                try refresh(state)
                owned :: try metadata_own(state, wrapped, call)
                if (owned == no_node or !try type_array_initialized(state, owned, call)) {
                    try reject_evaluation(state, call)
                    return
                }
                argument.node = ast.typed_constant(&state.tree, owned).value
            }
            borrowed = false
        }
    }
    demand_key :: if (demanded) usize(1) else usize(0)
    if (demanded) {
        for (arguments) |argument| {
            if (argument.kind != .invalid and constant_addresses(state, argument.node, 0)) borrowed = true
        }
    }
    key := mix(usize(function), demand_key)
    for arguments |argument| {
        if (argument.kind != .invalid) key = mix(key, try value_hash(state, argument))
    }
    head := no_index
    if (!borrowed) {
        if (hashmap.get(&state.cache, key)) |found| head = found
    }
    current := head
    instance := no_index
    while (current != no_index) {
        entry :: state.instances.items[current]
        equal := entry.function == function and entry.arguments.len == count and entry.demanded == demanded
        # separate invocations own separate retained mutable backing.
        if (equal and entry.value != no_node and constant_addresses(state, entry.value, 0)) equal = false
        if (equal) {
            for (0..count) |i| {
                if (!try value_equal(state, entry.arguments[i], arguments[i])) {
                    equal = false
                    break
                }
            }
        }
        if (equal) {
            instance = current
            break
        }
        current = entry.next
    }
    if (instance == no_index) {
        for (0..count) |i| {
            if (arguments[i].kind != .invalid) arguments[i] = try materialize(state, arguments[i])
        }
        values :: try mem.alloc(Value, state.allocator, count)
        memcopy!(values, arguments)
        instance = state.instances.items.len
        arraylist.append(&state.instances, Instance{
            function = function, arguments = values, next = head, demanded = demanded,
        }) catch |err| {
            mem.free(state.allocator, values)
            return err
        }
        # cache heads are replaced without reallocating a second entry for the same hash.
        if (borrowed) {
            # live places carry effects and must never reuse a cached execution.
        } else if (head != no_index) {
            for (state.cache.entries) |@entry| {
                if (entry.hash != 0 and entry.key == key) {
                    entry.value = instance
                    break
                }
            }
        } else {
            hashmap.put(&state.cache, key, instance) catch |err| {
                match err {
                    .key_exists: unreachable
                    else: return err
                }
            }
        }
        try instantiate(state, instance, call)
        if (binding(state, call).kind == .invalid) {
            state.instances.items[instance].diagnostic = binding(state, call).data.diagnostic
            return
        }
    }
    diagnostic :: state.instances.items[instance].diagnostic
    if (diagnostic != diagnostics.no_diagnostic) {
        invalid :: try ast.add_invalid_expr(state.builder, ast.node_span(&state.tree, call), diagnostic)
        try replace(state, call, invalid)
        try refresh(state)
        state.bindings.items[usize(call)] = sema.Binding{ kind = .invalid, data = sema.BindingData{ diagnostic = diagnostic } }
        return
    }
    target :: state.instances.items[instance].declaration
    if (target == no_node and state.instances.items[instance].value == no_node) {
        try reject(state, call, .specialization_cycle)
        return
    }
    if (type_result or supplied != 0) {
        signature :: state.instances.items[instance].signature
        for (0..count) |i| {
            parameter :: ast.function_param(&state.tree, signature, i)
            view :: ast.param(&state.tree, parameter)
            original :: parameter_arguments.items[i]
            if (original == no_node) continue
            if (
                (!type_result and !view.comptime) or is_type(state, view.type)
                or type_record_storage(state, view.type, 0)
            ) continue
            constraint :: try ast.add_typed_constant(state.builder, ast.node_span(&state.tree, original), view.type, original)
            try refresh(state)
            try arraylist.append(&state.rewrites.constraints, constraint)
        }
    }
    replacement := state.instances.items[instance].value
    if (replacement == no_node) {
        callee :: try reference(state, call, target)
        if (state.instances.items[instance].type != no_node)
            replacement = try ast.add_type_operand(state.builder, ast.node_span(&state.tree, call), callee, true)
        else {
            retained := usize(0)
            for (0..count) |i| {
                if (ast.param(&state.tree, ast.function_param(&state.tree, function, i)).comptime) continue
                parameter_arguments.items[retained] = parameter_arguments.items[i]
                retained += 1
            }
            replacement = try ast.add_call(state.builder, ast.node_span(&state.tree, call),
                callee, parameter_arguments.items[..retained])
        }
    }
    try replace(state, call, replacement)
    try refresh(state)
}

@hide:file
instantiate proc(state @mut State, index usize, call ast.NodeId) void ! Error {
    function :: state.instances.items[index].function
    type_result :: compiletime_call(state, function) or state.instances.items[index].demanded
    count :: state.original_count
    clone_start :: ast.node_count(&state.tree)
    mapping :: state.mapping
    mem.set(mapping, no_node)
    parameters :: ast.function_param_count(&state.tree, function)
    for (0..parameters) |i| {
        parameter :: ast.function_param(&state.tree, function, i)
        if (!type_result and !ast.param(&state.tree, parameter).comptime) continue
        value :: state.instances.items[index].arguments[i]
        replacement := value.node
        annotation :: ast.param(&state.tree, parameter).type
        if (!is_type(state, annotation)) {
            concrete_type :: try ast.clone_subtree(state.builder, annotation, mapping)
            replacement = try ast.add_typed_constant(state.builder, ast.node_span(&state.tree, parameter), concrete_type, value.node)
            try refresh(state)
        }
        for (0..count) |n| {
            resolved :: binding(state, ast.NodeId(n))
            if (
                resolved.kind == .declaration and resolved.data.declaration == parameter
                and ast.node_class(&state.tree, ast.NodeId(n)) == .expression
            ) mapping[n] = replacement
        }
    }
    clone :: try ast.clone_subtree(state.builder, function, mapping)
    try refresh(state)
    # copy original resolution, remapping references to cloned locals and runtime parameters.
    for (0..count) |i| {
        target :: mapping[i]
        if (target == no_node or usize(target) < clone_start) continue
        if (ast.node_class(&state.tree, target) == .expression and ast.expr_kind(&state.tree, target) == .typed_constant) continue
        value := state.bindings.items[i]
        if (value.kind == .declaration) {
            original :: value.data.declaration
            if (original != function and usize(original) < count and mapping[usize(original)] != no_node)
                value.data.declaration = mapping[usize(original)]
        }
        state.bindings.items[usize(target)] = value
    }
    if (!type_result) {
        for (0..parameters) |i| {
            if (!unsigned_parameter(state, ast.function_param(&state.tree, function, i))) continue
            parameter :: ast.function_param(&state.tree, clone, i)
            original :: ast.param(&state.tree, parameter)
            concrete :: try ast.add_param(state.builder, original.span, original.name,
                ast.name_id(&state.tree, parameter), state.instances.items[index].arguments[i].node)
            ast.replace_node(state.builder, parameter, concrete)
            try refresh(state)
        }
    }
    state.instances.items[index].signature = try ast.copy_node(state.builder, clone)
    try refresh(state)
    view :: ast.function_decl(&state.tree, clone)
    for (0..parameters) |i| {
        parameter :: ast.function_param(&state.tree, clone, i)
        annotation :: ast.param(&state.tree, parameter).type
        if ((type_result or ast.param(&state.tree, parameter).comptime) and !is_type(state, annotation)) {
            if (!try valid_value(state, annotation, state.instances.items[index].arguments[i])) {
                value :: state.instances.items[index].arguments[i]
                code :: if (value.kind == .integer and try integer_type(state, annotation))
                    diagnostics.Code.literal_out_of_range else diagnostics.Code.type_mismatch
                try reject(state, call, code)
                return
            }
        }
    }
    if (type_result) {
        state.demand_depth += 1
        defer state.demand_depth -= 1
        begin_type_execution(state)
        defer state.type_execution_depth -= 1
        state.evaluation_diagnostic = diagnostics.no_diagnostic
        if (state.instances.items[index].demanded and !try needs_demand_execution(state, function)) {
            # ordinary results keep one interpreter frame, including mutable local
            # backing shared by returned pointers and slices.
            value :: try evaluate_ir_body(state, call, view.body, view.return_type)
            if (value.kind == .invalid) {
                try reject_evaluation(state, call)
                return
            }
            concrete :: try materialize(state, value)
            state.instances.items[index].value = try ast.add_typed_constant(state.builder,
                ast.node_span(&state.tree, call), view.return_type, concrete.node)
            try refresh(state)
            return
        }
        constraints_start :: state.rewrites.constraints.items.len
        returned :: try return_type_value(state, view.body, ast.NodeId(clone_start), view.return_type)
        if (returned == no_node) {
            try reject_type_result(state, call, returned, constraints_start)
            return
        }
        if (!is_type(state, view.return_type)) {
            state.instances.items[index].value = returned
            constraint_count :: state.rewrites.constraints.items.len
            for (constraints_start..constraint_count) |i| {
                constraint :: state.rewrites.constraints.items[i]
                if (!try expand_type_matches(state, constraint)) {
                    try reject_type_result(state, call, returned, constraints_start)
                    return
                }
                try expand(state, constraint)
            }
            return
        }
        result := returned
        kind :: ast.expr_kind(&state.tree, returned)
        if (kind != .record_type and kind != .union_type and kind != .enum_type and kind != .distinct_type) {
            result = try ast.add_type_operand(state.builder, ast.node_span(&state.tree, returned), returned, true)
            try refresh(state)
        }
        declaration :: try ast.add_statement_decl(state.builder, view.span, view.name,
            ast.name_id(&state.tree, function), null, .constant, result)
        try refresh(state)
        state.instances.items[index].declaration = declaration
        state.instances.items[index].type = returned
        state.bindings.items[usize(declaration)] = sema.Binding{ kind = .declaration, data = sema.BindingData{ declaration = declaration } }
        try arraylist.append(&state.declarations, declaration)
        if (!try expand_type_matches(state, declaration)) {
            try reject_type_result(state, call, result, constraints_start)
            return
        }
        try expand(state, declaration)
        constraint_count :: state.rewrites.constraints.items.len
        for (constraints_start..constraint_count) |i| {
            constraint :: state.rewrites.constraints.items[i]
            if (!try expand_type_matches(state, constraint)) {
                try reject_type_result(state, call, result, constraints_start)
                return
            }
            try expand(state, constraint)
        }
    } else {
        runtime := arraylist.init(ast.NodeId, state.allocator)
        defer arraylist.deinit(&runtime)
        for (0..parameters) |i| {
            parameter :: ast.function_param(&state.tree, clone, i)
            if (!ast.param(&state.tree, parameter).comptime) try arraylist.append(&runtime, parameter)
        }
        concrete :: try ast.add_function_decl(state.builder, view.span, view.name,
            ast.name_id(&state.tree, function), view.return_type, runtime.items, view.body)
        ast.replace_node(state.builder, clone, concrete)
        try refresh(state)
        state.instances.items[index].declaration = clone
        state.bindings.items[usize(clone)] = sema.Binding{ kind = .declaration, data = sema.BindingData{ declaration = clone } }
        try arraylist.append(&state.declarations, clone)
        try expand(state, clone)
    }
}

@hide:file
reject_evaluation proc(state @mut State, call ast.NodeId) void ! Error {
    diagnostic :: state.evaluation_diagnostic
    if (diagnostic == diagnostics.no_diagnostic) {
        try reject(state, call, .comptime_argument_required)
        return
    }
    invalid :: try ast.add_invalid_expr(state.builder, ast.node_span(&state.tree, call), diagnostic)
    try replace(state, call, invalid)
    try refresh(state)
    state.bindings.items[usize(call)] = sema.Binding{ kind = .invalid, data = sema.BindingData{ diagnostic = diagnostic } }
}

# failed deferred elaboration must not leave unchecked type expressions in the package.
@hide:file
reject_type_result proc(state @mut State, call, result ast.NodeId, constraints_start usize) void ! Error {
    try reject_evaluation(state, call)
    state.evaluation_diagnostic = binding(state, call).data.diagnostic
    if (result != no_node) try reject_evaluation(state, result)
    for (constraints_start..(state.rewrites.constraints.items.len)) |i|
        try reject_evaluation(state, state.rewrites.constraints.items[i])
}

@hide:file
evaluation_dependencies proc(
    state @mut State, id ast.NodeId, flags []mut u8, declarations @mut arraylist.ArrayList(ast.NodeId),
) bool ! Error {
    if ((flags[usize(id)] & 4) != 0) return true
    flags[usize(id)] = flags[usize(id)] | 4
    if (ast.node_class(&state.tree, id) == .expression and ast.expr_kind(&state.tree, id) == .typed_constant) {
        if (!try type_array_initialized(state, id, id)) return false
    }
    resolved :: binding(state, id)
    if (resolved.kind == .declaration) {
        target :: resolved.data.declaration
        if ((flags[usize(target)] & 8) == 0 and (flags[usize(target)] & 2) == 0) {
            class :: ast.node_class(&state.tree, target)
            if (class == .parameter) return false
            # references must reach a concrete instance before evaluation checking;
            # an unbound template is not an executable dependency.
            if (class == .function and template(state, target)) return false
            if (class == .statement and ast.statement_decl(&state.tree, target).mutability == .variable) return false
            flags[usize(target)] = flags[usize(target)] | 2
            try arraylist.append(declarations, target)
        }
    }
    for (0..ast.child_count(&state.tree, id)) |i| {
        if (!try evaluation_dependencies(state, ast.child(&state.tree, id, i), flags, declarations)) return false
    }
    return true
}

@hide:file
evaluation_owned proc(state @State, id ast.NodeId, flags []mut u8) void {
    if ((flags[usize(id)] & 8) != 0) return
    flags[usize(id)] = flags[usize(id)] | 8
    for (0..ast.child_count(&state.tree, id)) |i| evaluation_owned(state, ast.child(&state.tree, id, i), flags)
}

@hide:file
contextual_literal proc(state @State, id ast.NodeId) bool {
    kind :: ast.expr_kind(&state.tree, id)
    if (kind == .builtin_call)
        return mem.eql(ast.literal_text(&state.tree, ast.builtin_call(&state.tree, id).name), "some")
    if (kind == .unary) return ast.unary_expr(&state.tree, id).operator == .bit_not and flexible(state, id)
    if (kind == .binary) {
        operator :: ast.binary_expr(&state.tree, id).operator
        return (
            (operator == .bit_and or operator == .bit_or or operator == .bit_xor
                or operator == .shift_left or operator == .shift_right or operator == .shift_left_saturating)
            and flexible(state, id)
        )
    }
    return kind == .record_literal or kind == .array_literal or kind == .enum_literal or kind == .block_expr
}

@hide:file
annotation_generic proc(state @State, function, id ast.NodeId, depth usize) bool {
    if (depth >= 128) return true
    resolved :: binding(state, id)
    if (
        resolved.kind == .declaration
        and parameter_index(state, function, resolved.data.declaration) != no_index
    ) return true
    for (0..ast.child_count(&state.tree, id)) |i| {
        if (annotation_generic(state, function, ast.child(&state.tree, id, i), depth + 1)) return true
    }
    return false
}

@hide:file
argument_annotation proc(
    state @mut State, function, annotation ast.NodeId, arguments []Value,
) ast.NodeId ! Error {
    if (!annotation_generic(state, function, annotation, 0)) return annotation
    mapping :: try mem.alloc(ast.NodeId, state.allocator, state.original_count)
    defer mem.free(state.allocator, mapping)
    mem.set(mapping, no_node)
    for (0..ast.function_param_count(&state.tree, function)) |i| {
        if (arguments[i].kind == .invalid) continue
        parameter :: ast.function_param(&state.tree, function, i)
        value := try materialize(state, arguments[i])
        if (value.kind != .type and value.annotation != no_node) {
            value.node = try ast.add_typed_constant(state.builder,
                ast.node_span(&state.tree, value.node), value.annotation, value.node)
            try refresh(state)
        }
        for (0..mapping.len) |n| {
            resolved :: binding(state, ast.NodeId(n))
            if (
                resolved.kind == .declaration and resolved.data.declaration == parameter
                and ast.node_class(&state.tree, ast.NodeId(n)) == .expression
            ) mapping[n] = value.node
        }
    }
    start :: ast.node_count(&state.tree)
    result :: try ast.clone_subtree(state.builder, annotation, mapping)
    try refresh(state)
    for (0..mapping.len) |i| {
        target :: mapping[i]
        if (target != no_node and usize(target) >= start) state.bindings.items[usize(target)] = state.bindings.items[i]
    }
    return result
}

@hide:file
evaluate_expected proc(state @mut State, id, annotation ast.NodeId) Value ! Error {
    state.demand_depth += 1
    defer state.demand_depth -= 1
    try expand_expected(state, id, annotation)
    if (!is_type(state, annotation) and type_record_storage(state, annotation, 0)) {
        begin_type_execution(state)
        defer state.type_execution_depth -= 1
        constant :: try type_execution_value(state, id, annotation)
        if (constant == no_node or !try type_array_initialized(state, constant, id)) return Value{}
        value :: ast.typed_constant(&state.tree, constant)
        return Value{ kind = .aggregate, node = value.value, annotation = value.type }
    }
    if (!is_type(state, annotation)) {
        type :: try canonical_type(state, annotation)
        if (type != no_node and ast.expr_kind(&state.tree, type) == .array_type
            and !try type_array_initialized(state, id, id)) return Value{}
        if (type != no_node and ast.expr_kind(&state.tree, type) == .optional_type) {
            kind :: ast.expr_kind(&state.tree, id)
            explicit_presence :: (
                kind == .builtin_call
                and mem.eql(ast.literal_text(&state.tree, ast.builtin_call(&state.tree, id).name), "some")
            )
            if (kind != .typed_constant and !explicit_presence) {
                actual :: try expression_type(state, id, 0)
                if (actual != no_node and try same_type(state, type, actual)) return try evaluate(state, id)
            }
            constant :: try type_optional_value(state, id, type)
            if (constant == no_node or !try type_array_initialized(state, constant, id)) return Value{}
            value :: ast.typed_constant(&state.tree, constant)
            return Value{ kind = .aggregate, node = value.value, annotation = value.type }
        }
        if (type != no_node and (contextual_literal(state, id)
            or ast.expr_kind(&state.tree, id) == .block_expr
            or ast.expr_kind(&state.tree, id) == .slice
            or ast.expr_kind(&state.tree, type) == .fallible_type))
            return try evaluate_ir(state, id, type)
    }
    return try evaluate(state, id)
}

@hide:file
SnapshotRoot :: struct {
    identity usize
    node ast.NodeId = no_node
    serializing bool = false
}

# ponytail: linear root lookup; use an identity-keyed map if address graphs grow.
@hide:file
snapshot_root_index proc(state @State, identity usize) usize {
    for (state.snapshot_roots?.items) |root, index|
        if (root.identity == identity) return index
    return no_index
}

# reserve pointer/mutable-slice roots before serializing readonly views, so their
# aliases do not depend on record field order. ordinary readonly snapshots remain content-based.
@hide:file
snapshot_reserve proc(
    state @mut State, module @ir.Module, checked @typecheck.Result,
    outcome @interpreter.Outcome, type typecheck.Type, value ir.Value, depth usize,
) void ! Error {
    if (value.uninitialized or state.snapshot_scan_remaining == 0) return
    if (depth >= 128) {
        state.snapshot_scan_remaining = 0
        return
    }
    state.snapshot_scan_remaining -= 1
    if (type.kind == .pointer or type.kind == .slice) {
        pointer :: if (type.kind == .pointer) value else ir.aggregate_item(module, value, 0)
        mutable :: type.kind == .pointer or typecheck.array_type(checked, type.array_type).mutable
        if (mutable) {
            if (interpreter.evaluation_pointer(outcome, module, pointer)) |location| {
                if (snapshot_root_index(state, location.identity) == no_index) {
                    try arraylist.append(state.snapshot_roots?, SnapshotRoot{ identity = location.identity })
                    borrowed :: interpreter.evaluation_storage(outcome, module, pointer)?
                    if (borrowed.len > state.snapshot_scan_remaining) {
                        state.snapshot_scan_remaining = 0
                        return
                    }
                    state.snapshot_scan_remaining -= borrowed.len
                    # collect edges before recursion invalidates raw-view scratch.
                    children := arraylist.init(ir.Value, state.allocator)
                    defer arraylist.deinit(&children)
                    for (borrowed) |byte, index| {
                        if (byte.relocation != .pointer or byte.relocation_byte != 0) continue
                        if (borrowed.len - index < 8) continue
                        try arraylist.append(&children,
                            ir.read_storage(module, .pointer, ir.no_array, borrowed[index..], true))
                    }
                    for (children.items) |child| {
                        if (state.snapshot_scan_remaining == 0) return
                        try snapshot_reserve(state, module, checked, outcome,
                            typecheck.Type{ kind = .pointer }, child, depth + 1)
                    }
                }
            }
        }
        if (type.kind == .slice) {
            descriptor :: typecheck.array_type(checked, type.array_type)
            count :: ir.aggregate_item(module, value, 1)
            if (count.uninitialized or count.data.unsigned > u64(state.snapshot_scan_remaining)) {
                state.snapshot_scan_remaining = 0
                return
            }
            shape :: module.arrays.items[usize(value.array_type)]
            for (0..usize(count.data.unsigned)) |i| {
                if (state.snapshot_scan_remaining == 0) return
                borrowed :: interpreter.evaluation_element(outcome, module, pointer, i, shape.element, shape.element_array)
                if (borrowed == null) return
                child := borrowed?
                owned []mut ir.Value := &[]
                scratch_backed :: ir.aggregate(child.type) and child.raw
                if (scratch_backed) {
                    owned = try mem.alloc(ir.Value, state.allocator, child.data.elements.len)
                    memcopy!(owned, child.data.elements)
                    child.data = ir.ValueData{ elements = owned }
                }
                defer if (scratch_backed) mem.free(state.allocator, owned)
                try snapshot_reserve(state, module, checked, outcome, descriptor.element, child, depth + 1)
            }
        }
        return
    }
    if (type.kind == .optional) {
        child :: typecheck.array_type(checked, type.array_type).element
        if (child.kind == .pointer or child.kind == .function) {
            if (value.data.unsigned != maxval!(u64))
                try snapshot_reserve(state, module, checked, outcome, child, value, depth + 1)
        } else if (ir.aggregate_item(module, value, 0).data.boolean)
            try snapshot_reserve(state, module, checked, outcome, child, ir.aggregate_item(module, value, 1), depth + 1)
    } else if (type.kind == .array) {
        array :: typecheck.array_type(checked, type.array_type)
        for (0..array.len) |i| {
            if (state.snapshot_scan_remaining == 0) return
            try snapshot_reserve(state, module, checked, outcome, array.element, ir.aggregate_item(module, value, i), depth + 1)
        }
    } else if (type.kind == .fallible) {
        channels :: typecheck.array_type(checked, type.array_type)
        failed :: ir.union_tag(module, value).data.integer == 1
        channel :: if (failed) channels.error_type else channels.element
        index :: if (failed) usize(1) else usize(0)
        try snapshot_reserve(state, module, checked, outcome,
            channel, ir.aggregate_item(module, value, index), depth + 1)
    } else if (type.kind == .record) {
        record :: typecheck.record_type(checked, type.record_type)
        if (record.is_union and record.tag_type.kind != .enumeration) {
            for (value.data.elements) |byte, i| {
                if (state.snapshot_scan_remaining == 0) return
                state.snapshot_scan_remaining -= 1
                if (byte.relocation != .pointer or byte.relocation_byte != 0
                    or value.data.elements.len - i < 8) continue
                pointer :: ir.read_storage(module, .pointer, ir.no_array, value.data.elements[i..], true)
                try snapshot_reserve(state, module, checked, outcome, typecheck.Type{ kind = .pointer }, pointer, depth + 1)
            }
        } else {
            for (record.fields) |field, i| {
                if (state.snapshot_scan_remaining == 0) return
                if (!record.is_union or ir.union_active(module, value, i))
                    try snapshot_reserve(state, module, checked, outcome, field.type, ir.aggregate_item(module, value, i), depth + 1)
            }
        }
    }
}

# native layout mirrors the existing IR layout; only bounds are needed here.
@hide:file
snapshot_layout proc(checked @typecheck.Result, type typecheck.Type, depth usize) [2]usize {
    if (depth >= 128) return [no_index, 1]
    match type.kind {
        .void, .anyopaque: return [0, 1]
        .bool, .i8, .u8: return [1, 1]
        .i16, .u16: return [2, 2]
        .i32, .u32: return [4, 4]
        .int, .isize, .usize, .u64, .float, .pointer, .function: return [8, 8]
        .string, .slice: return [16, 8]
        .enumeration: return snapshot_layout(checked,
            typecheck.Type{ kind = typecheck.enum_type(checked, type.enum_type).backing }, depth + 1)
        .array: {
            descriptor :: typecheck.array_type(checked, type.array_type)
            child :: snapshot_layout(checked, descriptor.element, depth + 1)
            if (child[0] == no_index or (child[0] != 0
                and descriptor.len > divtrunc!(maxval!(usize), child[0]))) return [no_index, 1]
            return [child[0] * descriptor.len, child[1]]
        }
        .optional: {
            child_type :: typecheck.array_type(checked, type.array_type).element
            if (child_type.kind == .pointer or child_type.kind == .function) return [8, 8]
            child :: snapshot_layout(checked, child_type, depth + 1)
            if (child[0] > maxval!(usize) - child[1] * 2) return [no_index, 1]
            return [divtrunc!(child[1] + child[0] + child[1] - 1, child[1]) * child[1], child[1]]
        }
        .fallible: {
            descriptor :: typecheck.array_type(checked, type.array_type)
            left :: snapshot_layout(checked, descriptor.element, depth + 1)
            right :: snapshot_layout(checked, descriptor.error_type, depth + 1)
            size :: if (left[0] > right[0]) left[0] else right[0]
            if (size > maxval!(usize) - 15) return [no_index, 1]
            return [divtrunc!(size + 7, usize(8)) * 8 + 8, 8]
        }
        .record: {
            record :: typecheck.record_type(checked, type.record_type)
            size := usize(0)
            alignment := usize(1)
            for (record.fields) |field| {
                child :: snapshot_layout(checked, field.type, depth + 1)
                if (child[0] == no_index or size > maxval!(usize) - child[1]) return [no_index, 1]
                if (record.is_union) {
                    if (child[0] > size) size = child[0]
                } else {
                    size = divtrunc!(size + child[1] - 1, child[1]) * child[1]
                    if (child[0] > maxval!(usize) - size) return [no_index, 1]
                    size += child[0]
                }
                if (child[1] > alignment) alignment = child[1]
            }
            if (record.is_union) {
                alignment = 8
                if (record.tag_type.kind == .enumeration) {
                    if (size > maxval!(usize) - 8) return [no_index, 1]
                    size += 8
                }
            }
            if (size > maxval!(usize) - alignment) return [no_index, 1]
            return [divtrunc!(size + alignment - 1, alignment) * alignment, alignment]
        }
        else: return [no_index, 1]
    }
}

@hide:file
snapshot_address proc(
    state @mut State, module @ir.Module, checked @typecheck.Result, outcome @interpreter.Outcome,
    functions []ast.NodeId, pointer ir.Value, annotation ast.NodeId, size usize,
    mutable bool, span ast.Span, remaining @mut usize,
) ast.NodeId ! Error {
    location :: interpreter.evaluation_pointer(outcome, module, pointer)
    if (location == null or size == no_index) {
        state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .invalid_pointer_access, span)
        return no_node
    }
    if (size > location?.byte_size - location?.byte_offset or (mutable and location?.readonly)) {
        state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .invalid_pointer_access, span)
        return no_node
    }
    borrowed :: interpreter.evaluation_storage(outcome, module, pointer)?
    for (borrowed[location?.byte_offset..location?.byte_offset + size]) |byte| {
        if (byte.uninitialized) {
            state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .read_before_initialization, span)
            return no_node
        }
    }
    index := snapshot_root_index(state, location?.identity)
    if (index == no_index) {
        index = state.snapshot_roots?.items.len
        try arraylist.append(state.snapshot_roots?, SnapshotRoot{ identity = location?.identity })
    }
    if (state.snapshot_roots?.items[index].serializing) {
        state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .comptime_execution_limit, span)
        return no_node
    }
    if (state.snapshot_roots?.items[index].node == no_node) {
        if (borrowed.len > remaining^) {
            state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .comptime_execution_limit, span)
            return no_node
        }
        bytes :: try mem.alloc(ir.Value, state.allocator, borrowed.len)
        defer mem.free(state.allocator, bytes)
        memcopy!(bytes, borrowed)
        count :: try ast.add_integer(state.builder, span, u64(bytes.len))
        byte_type :: try builtin(state, annotation, .u8)
        array_type :: try ast.add_array_type(state.builder, span, count, byte_type, true)
        try refresh(state)
        state.snapshot_roots?.items[index].serializing = true
        root :: try snapshot_memory(state, module, checked, outcome, functions,
            array_type, bytes, true, span, remaining)
        state.snapshot_roots?.items[index].serializing = false
        if (root == no_node) return no_node
        state.snapshot_roots?.items[index].node = root
    }
    offset :: try ast.add_integer(state.builder, span, u64(location?.byte_offset))
    result :: try ast.add_address_constant(state.builder, span, annotation, state.snapshot_roots?.items[index].node, offset)
    try refresh(state)
    return result
}

@hide:file
snapshot_memory proc(
    state @mut State, module @ir.Module, checked @typecheck.Result, outcome @interpreter.Outcome,
    functions []ast.NodeId, annotation ast.NodeId, bytes []mut ir.Value, allow_uninitialized bool,
    span ast.Span, remaining @mut usize,
) ast.NodeId ! Error {
    if (bytes.len > remaining^ or state.depth >= 128) {
        state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .comptime_execution_limit, span)
        return no_node
    }
    remaining^ -= bytes.len
    state.depth += 1
    defer state.depth -= 1
    parts := arraylist.init(ast.NodeId, state.allocator)
    defer arraylist.deinit(&parts)
    try arraylist.append(&parts, no_node)
    index := usize(0)
    while (index < bytes.len) {
        byte :: bytes[index]
        if (byte.relocation == .invalid) {
            index += 1
            continue
        }
        width :: ir.storage_size(module, byte.relocation, ir.no_array)
        valid := byte.relocation_byte == 0 and width <= bytes.len - index
        if (valid) {
            for (0..width) |i| {
                if (bytes[index + i].relocation != byte.relocation or usize(bytes[index + i].relocation_byte) != i)
                    valid = false
            }
        }
        if (!valid) {
            state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .invalid_pointer_access, span)
            return no_node
        }
        value :: ir.read_storage(module, byte.relocation, ir.no_array, bytes[index..], true)
        if (value.uninitialized) {
            if (!allow_uninitialized and !state.snapshot_uninitialized) {
                state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .read_before_initialization, span)
                return no_node
            }
            for (0..width) |i| {
                if (!bytes[index + i].uninitialized) {
                    state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .read_before_initialization, span)
                    return no_node
                }
            }
            for (0..width) |i| bytes[index + i].relocation = .invalid
            index += width
            continue
        }
        node := no_node
        if ((byte.relocation == .pointer and value.data.unsigned == maxval!(u64))
            or (byte.relocation == .function and value.data.function == maxval!(ir.FunctionId))) {
            child_type :: try builtin(state, annotation, .u8)
            pointer_type :: try ast.add_pointer_type(state.builder, span, child_type, true, true)
            optional_type :: try ast.add_optional_type(state.builder, span, pointer_type)
            literal :: try ast.add_literal(state.builder, .null, span)
            node = try ast.add_typed_constant(state.builder, span, optional_type, literal)
            try refresh(state)
        } else if (byte.relocation == .pointer) {
            child_type :: try builtin(state, annotation, .u8)
            pointer_type :: try ast.add_pointer_type(state.builder, span, child_type, true, true)
            try refresh(state)
            node = try snapshot_address(state, module, checked, outcome, functions,
                value, pointer_type, 0, false, span, remaining)
        } else if (byte.relocation == .function) {
            function :: usize(value.data.function)
            if (function < functions.len and functions[function] != no_node)
                node = try reference(state, functions[function], functions[function])
        } else if (byte.relocation == .string and usize(value.data.string) < module.strings.items.len) {
            node = try ast.add_string(state.builder, span, ir.string_bytes(module, value.data.string))
        }
        if (node == no_node) {
            if (state.evaluation_diagnostic == diagnostics.no_diagnostic)
                state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .invalid_pointer_access, span)
            return no_node
        }
        try arraylist.append(&parts, try ast.add_integer(state.builder, span, u64(index)))
        try arraylist.append(&parts, node)
        for (0..width) |i| bytes[index + i] = ir.Value{ type = .u8 }
        index += width
    }
    elements := arraylist.init(ast.NodeId, state.allocator)
    defer arraylist.deinit(&elements)
    for (bytes) |byte| {
        if (byte.uninitialized and !allow_uninitialized and !state.snapshot_uninitialized) {
            state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .read_before_initialization, span)
            return no_node
        }
        node :: if (byte.uninitialized) try ast.add_literal(state.builder, .undefined, span)
            else try ast.add_integer(state.builder, span, byte.data.unsigned)
        try arraylist.append(&elements, node)
    }
    count :: try ast.add_integer(state.builder, span, u64(bytes.len))
    byte_type :: try builtin(state, annotation, .u8)
    array_type :: try ast.add_array_type(state.builder, span, count, byte_type, true)
    literal :: try ast.add_array_literal(state.builder, span, elements.items)
    parts.items[0] = try ast.add_typed_constant(state.builder, span, array_type, literal)
    payload :: try ast.add_array_literal(state.builder, span, parts.items)
    result :: try ast.add_memory_constant(state.builder, span, annotation, payload)
    try refresh(state)
    return result
}

# rebuild exact slice backing annotations without retaining temporary checker IDs.
@hide:file
serialized_type proc(
    state @mut State,
    checked @typecheck.Result,
    type typecheck.Type,
    span ast.Span,
    depth usize,
) ast.NodeId ! Error {
    if (depth >= 128) return no_node
    source := type.nominal
    if (source == no_node and type.kind == .record) {
        record :: typecheck.record_type(checked, type.record_type)
        source = if (record.declaration != no_node) record.declaration else record.source
    }
    if (source == no_node and type.kind == .enumeration)
        source = typecheck.enum_type(checked, type.enum_type).declaration
    if (source == no_node and type.kind == .function) source = type.function
    if (source != no_node) {
        if (ast.node_class(&state.tree, source) == .function) {
            params := arraylist.init(ast.NodeId, state.allocator)
            defer arraylist.deinit(&params)
            for (0..ast.function_param_count(&state.tree, source)) |i|
                try arraylist.append(&params, ast.function_param(&state.tree, source, i))
            source = try ast.add_function_type(state.builder, span,
                ast.callable_result(&state.tree, source), params.items)
            try refresh(state)
        }
        return (try materialize(state, Value{ kind = .type, node = source })).node
    }
    result := no_node
    if (type.kind == .array or type.kind == .slice or type.kind == .optional or type.kind == .fallible) {
        descriptor :: typecheck.array_type(checked, type.array_type)
        child :: try serialized_type(state, checked, descriptor.element, span, depth + 1)
        if (child == no_node) return no_node
        if (type.kind == .array) {
            count :: try ast.add_integer(state.builder, span, u64(descriptor.len))
            result = try ast.add_array_type(state.builder, span, count, child, descriptor.mutable)
        } else if (type.kind == .slice) {
            sentinel ?ast.NodeId := null
            if (descriptor.sentinel) |value| {
                unsigned :: (descriptor.element.kind == .u8 or descriptor.element.kind == .u16
                    or descriptor.element.kind == .u32 or descriptor.element.kind == .u64 or descriptor.element.kind == .usize)
                negative :: value < 0 and !unsigned
                magnitude :: if (negative) u64(-(value + 1)) + 1 else ptrcast!(@u64, &value)^
                literal := try ast.add_integer(state.builder, span, magnitude)
                if (negative) literal = try ast.add_unary(state.builder, span, .negate, literal)
                sentinel = literal
            }
            result = try ast.add_slice_type(state.builder, span, child, descriptor.mutable, sentinel)
        } else if (type.kind == .optional) result = try ast.add_optional_type(state.builder, span, child)
        else {
            error_type :: try serialized_type(state, checked, descriptor.error_type, span, depth + 1)
            if (error_type == no_node) return no_node
            result = try ast.add_binary_type(state.builder, span, child, error_type, true)
        }
    } else if (type.kind == .pointer) {
        descriptor :: typecheck.pointer_type(checked, type.pointer_type)
        child :: try serialized_type(state, checked, descriptor.element, span, depth + 1)
        if (child == no_node) return no_node
        result = try ast.add_pointer_type(state.builder, span, child, descriptor.mutable, descriptor.many)
    } else {
        kind sema.BuiltinType :: match type.kind {
            .int: .i64
            .i8: .i8
            .i16: .i16
            .i32: .i32
            .isize: .isize
            .u8: .u8
            .u16: .u16
            .u32: .u32
            .u64: .u64
            .usize: .usize
            .float: .f64
            .bool: .bool
            .string: .string
            .void: .void
            .anyopaque: .anyopaque
            else: return no_node
        }
        result = try ast.add_identifier(state.builder, span, strpool.no_str)
        try refresh(state)
        state.bindings.items[usize(result)] = sema.Binding{ kind = .builtin, data = sema.BindingData{ builtin = kind } }
    }
    try refresh(state)
    return result
}

# values leaving temporary evaluation must own no interpreter addresses or module IDs.
# snapshot owned storage and rebuild source literals/references before releasing their backing.
@hide:file
serialize_value proc(
    state @mut State,
    module @ir.Module,
    checked @typecheck.Result,
    outcome @interpreter.Outcome,
    functions []ast.NodeId,
    type typecheck.Type,
    value ir.Value,
    span ast.Span,
    remaining @mut usize,
) ast.NodeId ! Error {
    if (remaining^ == 0 or state.depth >= 128) {
        state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .comptime_execution_limit, span)
        return no_node
    }
    remaining^ -= 1
    state.depth += 1
    defer state.depth -= 1
    uninitialized := value.uninitialized
    if (ir.aggregate(value.type)) {
        if (module.arrays.items[usize(value.array_type)].is_union)
            uninitialized = ir.union_tag(module, value).uninitialized
        else if (type.kind == .optional)
            uninitialized = ir.aggregate_item(module, value, 0).uninitialized
    }
    if (uninitialized) {
        if (state.snapshot_uninitialized) return try ast.add_literal(state.builder, .undefined, span)
        state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .read_before_initialization, span)
        return no_node
    }
    if (!ir.aggregate(value.type) and value.type != .pointer and value.type != .function and value.type != .string
        and (value.relocation != .invalid or value.provenance_kinds != 0 or value.forged)) {
        if (value.forged) {
            state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .invalid_pointer_access, span)
            return no_node
        }
        annotation :: try serialized_type(state, checked, type, span, 0)
        if (annotation == no_node) return no_node
        bytes [16]mut ir.Value := undefined
        size :: ir.storage_size(module, value.type, value.array_type)
        ir.write_storage(module, bytes[..size], value)
        return try snapshot_memory(state, module, checked, outcome, functions, annotation, bytes[..size], false, span, remaining)
    }
    result := no_node
    if (type.kind == .slice) {
        slice :: typecheck.array_type(checked, type.array_type)
        pointer :: ir.aggregate_item(module, value, 0)
        length :: ir.aggregate_item(module, value, 1)
        if (pointer.uninitialized or length.uninitialized) {
            state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .read_before_initialization, span)
            return no_node
        }
        location :: interpreter.evaluation_pointer(outcome, module, pointer)
        if (location == null) {
            state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .invalid_pointer_access, span)
            return no_node
        }
        count :: usize(length.data.unsigned)
        extra :: if (slice.sentinel != null) usize(1) else usize(0)
        if (count > remaining^ or extra > remaining^ - count) {
            state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .comptime_execution_limit, span)
            return no_node
        }
        if (slice.mutable or snapshot_root_index(state, location?.identity) != no_index) {
            layout :: snapshot_layout(checked, slice.element, 0)
            if (layout[0] == no_index or (layout[0] != 0 and count + extra > divtrunc!(maxval!(usize), layout[0]))) {
                state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .invalid_pointer_access, span)
                return no_node
            }
            size :: (count + extra) * layout[0]
            if (size > location?.byte_size - location?.byte_offset or (slice.mutable and location?.readonly)) {
                state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .invalid_pointer_access, span)
                return no_node
            }
            storage :: interpreter.evaluation_storage(outcome, module, pointer)?
            for (storage[location?.byte_offset..location?.byte_offset + size]) |byte| {
                if (byte.uninitialized) {
                    state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .read_before_initialization, span)
                    return no_node
                }
            }
            if (slice.sentinel != null) {
                shape :: module.arrays.items[usize(value.array_type)]
                sentinel :: interpreter.evaluation_element(outcome, module, pointer, count, shape.element, shape.element_array)
                if (sentinel == null or sentinel?.data.integer != slice.sentinel?) {
                    state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .sentinel_mismatch, span)
                    return no_node
                }
            }
            annotation :: try serialized_type(state, checked, type, span, 0)
            if (annotation == no_node) return no_node
            bytes [16]mut ir.Value := undefined
            mem.set(bytes[..], ir.Value{ type = .u8 })
            ir.write_storage(module, bytes[..], pointer)
            ir.write_storage(module, bytes[8..], length)
            return try snapshot_memory(state, module, checked, outcome, functions, annotation, bytes[..], false, span, remaining)
        }
        if (slice.element.kind != .u8 or slice.element.nominal != no_node) {
            shape :: module.arrays.items[usize(value.array_type)]
            if (count != 0 and interpreter.evaluation_element(outcome, module, pointer,
                count - 1, shape.element, shape.element_array) == null) return no_node
            elements := arraylist.init(ast.NodeId, state.allocator)
            defer arraylist.deinit(&elements)
            for (0..(count + extra)) |index| {
                borrowed :: interpreter.evaluation_element(outcome, module, pointer,
                    index, shape.element, shape.element_array)
                if (borrowed == null) return no_node
                child := borrowed?
                # recursive slice reads may overwrite the accessor's raw-view scratch.
                scratch_backed :: ir.aggregate(child.type) and child.raw
                owned []mut ir.Value := &[]
                if (scratch_backed) {
                    owned = try mem.alloc(ir.Value, state.allocator, child.data.elements.len)
                    memcopy!(owned, child.data.elements)
                    child.data = ir.ValueData{ elements = owned }
                }
                defer if (scratch_backed) mem.free(state.allocator, owned)
                node :: try serialize_value(state, module, checked, outcome, functions,
                    slice.element, child, span, remaining)
                if (node == no_node) return no_node
                if (index == count and slice.sentinel != null) {
                    # checker sentinels retain full-width integer bits, including u64 maxima.
                    if (child.data.integer != slice.sentinel?) {
                        state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .sentinel_mismatch, span)
                        return no_node
                    }
                }
                try arraylist.append(&elements, node)
            }
            annotation :: try serialized_type(state, checked, type, span, 0)
            if (annotation == no_node) return no_node
            child_type :: if (type.nominal == no_node) ast.slice_type(&state.tree, annotation).element
                else try serialized_type(state, checked, slice.element, span, 0)
            if (child_type == no_node) return no_node
            length_node :: try ast.add_integer(state.builder, span, u64(count + extra))
            array_type :: try ast.add_array_type(state.builder, span, length_node, child_type, false)
            literal :: try ast.add_array_literal(state.builder, span, elements.items)
            backing :: try ast.add_typed_constant(state.builder, span, array_type, literal)
            result = try ast.add_slice_constant(state.builder, span, annotation, backing)
            try refresh(state)
            return result
        }
        if (
            length.data.unsigned != 0
            and interpreter.evaluation_byte(outcome, module, pointer, usize(length.data.unsigned - 1)) == null
        ) return no_node
        nonzero_sentinel :: slice.sentinel != null and slice.sentinel? != 0
        length_bytes :: usize(length.data.unsigned)
        if (nonzero_sentinel and length_bytes == maxval!(usize)) return no_node
        byte_extra :: if (nonzero_sentinel) usize(1) else usize(0)
        remaining^ -= length_bytes + byte_extra
        bytes :: try mem.alloc(u8, state.allocator, length_bytes + byte_extra)
        defer mem.free(state.allocator, bytes)
        for (0..length_bytes) |index| {
            byte :: interpreter.evaluation_byte(outcome, module, pointer, index)
            if (byte == null) return no_node
            if (byte?.uninitialized) {
                state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .read_before_initialization, span)
                return no_node
            }
            bytes[index] = u8(byte?.data.unsigned)
        }
        if (slice.sentinel != null) {
            sentinel :: interpreter.evaluation_byte(outcome, module, pointer, length_bytes)
            if (sentinel == null) return no_node
            if (sentinel?.uninitialized) {
                state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .read_before_initialization, span)
                return no_node
            }
            if (sentinel?.data.unsigned != u64(slice.sentinel?)) {
                state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .sentinel_mismatch, span)
                return no_node
            }
            if (nonzero_sentinel) bytes[length_bytes] = u8(slice.sentinel?)
        }
        result = try ast.add_string(state.builder, span, bytes)
        if (nonzero_sentinel) {
            end :: try ast.add_integer(state.builder, span, u64(length_bytes))
            sentinel :: try ast.add_integer(state.builder, span, u64(slice.sentinel?))
            result = try ast.add_slice(state.builder, span, result, null, end, sentinel)
        }
    } else if (type.kind == .array) {
        array :: typecheck.array_type(checked, type.array_type)
        elements := arraylist.init(ast.NodeId, state.allocator)
        defer arraylist.deinit(&elements)
        for (0..array.len) |i| {
            child :: ir.aggregate_item(module, value, i)
            node :: try serialize_value(
                state,
                module,
                checked,
                outcome,
                functions,
                array.element,
                child,
                span,
                remaining,
            )
            if (node == no_node) return no_node
            try arraylist.append(&elements, node)
        }
        result = try ast.add_array_literal(state.builder, span, elements.items)
    } else if (type.kind == .record) {
        record :: typecheck.record_type(checked, type.record_type)
        if (record.is_union and record.tag_type.kind != .enumeration) {
            bytes :: try mem.alloc(ir.Value, state.allocator, value.data.elements.len)
            defer mem.free(state.allocator, bytes)
            memcopy!(bytes, value.data.elements)
            annotation :: if (type.nominal != no_node) type.nominal
                else if (record.declaration != no_node) record.declaration else record.source
            concrete :: try materialize(state, Value{ kind = .type, node = annotation })
            return try snapshot_memory(state, module, checked, outcome, functions,
                concrete.node, bytes, false, span, remaining)
        }
        fields := arraylist.init(ast.NodeId, state.allocator)
        defer arraylist.deinit(&fields)
        for (record.fields) |field, i| {
            if (record.is_union and !ir.union_active(module, value, i)) continue
            if (record.is_union and field.type.kind == .void) {
                name :: try member_name(state, field.name?)
                result = try ast.add_enum_literal(state.builder, span, name)
                try refresh(state)
                return result
            }
            child :: ir.aggregate_item(module, value, i)
            node :: try serialize_value(state, module, checked, outcome, functions, field.type, child, span, remaining)
            if (node == no_node) return no_node
            name := field.name
            if (name != null) name = try member_name(state, name?)
            generated :: try ast.add_field(state.builder, span, name, null, node)
            try refresh(state)
            try arraylist.append(&fields, generated)
        }
        result = try ast.add_record_literal(state.builder, span, null, fields.items)
    } else if (type.kind == .fallible) {
        container :: typecheck.array_type(checked, type.array_type)
        failed :: ir.union_tag(module, value).data.integer == 1
        index :: if (failed) usize(1) else usize(0)
        channel :: if (failed) container.error_type else container.element
        child :: ir.aggregate_item(module, value, index)
        result = try serialize_value(state, module, checked, outcome, functions, channel, child, span, remaining)
        if (result == no_node) return no_node
        # keep named success/error types distinct even when their members overlap.
        annotation := no_node
        if (channel.nominal != no_node) annotation = channel.nominal
        else if (channel.kind == .enumeration) annotation = typecheck.enum_type(checked, channel.enum_type).declaration
        else if (channel.kind == .record) annotation = typecheck.record_type(checked, channel.record_type).declaration
        if (annotation != no_node) {
            concrete :: try materialize(state, Value{ kind = .type, node = annotation })
            result = try ast.add_typed_constant(state.builder, span, concrete.node, result)
        }
    } else if (type.kind == .enumeration) {
        enumeration :: typecheck.enum_type(checked, type.enum_type)
        negative :: !ir.unsigned_integer(value.type) and value.data.integer < 0
        magnitude :: if (negative) u64(-(value.data.integer + 1)) + 1 else value.data.unsigned
        for (enumeration.members) |member| {
            if (member.magnitude == magnitude and member.negative == negative) {
                name :: try member_name(state, member.name)
                result = try ast.add_enum_literal(state.builder, span, name)
                break
            }
        }
    } else if (type.kind == .optional) {
        container :: typecheck.array_type(checked, type.array_type)
        if (container.element.kind == .pointer or container.element.kind == .function) {
            if (value.forged) {
                state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .invalid_pointer_access, span)
                return no_node
            }
            absent :: if (container.element.kind == .function)
                value.data.function == maxval!(ir.FunctionId)
                else value.data.unsigned == maxval!(u64)
            if (absent) result = try ast.add_literal(state.builder, .null, span)
            else result = try serialize_value(state, module, checked, outcome, functions, container.element, value, span, remaining)
        } else if (!ir.aggregate_item(module, value, 0).data.boolean) {
            result = try ast.add_literal(state.builder, .null, span)
        } else {
            child :: ir.aggregate_item(module, value, 1)
            payload :: try serialize_value(state, module, checked, outcome, functions, container.element, child, span, remaining)
            if (payload == no_node) return no_node
            name :: try ast.add_generated_identifier(state.builder, span,
                try strpool.intern(state.strings, "some"), "some")
            arguments [1]ast.NodeId :: [payload]
            result = try ast.add_builtin_call(state.builder, span, name, arguments[..])
        }
    } else if (type.kind == .function) {
        if (value.forged) {
            state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .invalid_pointer_access, span)
            return no_node
        }
        index :: usize(value.data.function)
        if (index >= functions.len or functions[index] == no_node) return no_node
        result = try reference(state, functions[index], functions[index])
    } else if (type.kind == .pointer) {
        descriptor :: typecheck.pointer_type(checked, type.pointer_type)
        annotation :: try serialized_type(state, checked, type, span, 0)
        if (annotation == no_node) return no_node
        layout :: snapshot_layout(checked, descriptor.element, 0)
        return try snapshot_address(state, module, checked, outcome, functions,
            value, annotation, layout[0], descriptor.mutable, span, remaining)
    } else if (ir.integer_bits(value.type) != 0 and type.kind != .pointer) {
        negative :: !ir.unsigned_integer(value.type) and value.data.integer < 0
        magnitude :: if (negative) u64(-(value.data.integer + 1)) + 1 else value.data.unsigned
        result = try ast.add_integer(state.builder, span, magnitude)
        if (negative) result = try ast.add_unary(state.builder, span, .negate, result)
    } else if (type.kind == .float) {
        result = try ast.add_float(state.builder, span, value.data.real)
    } else if (type.kind == .bool) {
        result = try ast.add_boolean(state.builder, span, value.data.boolean)
    } else if (type.kind == .string) {
        if (value.forged or usize(value.data.string) >= module.strings.items.len) {
            state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .invalid_pointer_access, span)
            return no_node
        }
        result = try ast.add_string(state.builder, span, ir.string_bytes(module, value.data.string))
    } else if (type.kind == .void) {
        result = try ast.add_literal(state.builder, .void, span)
    }
    try refresh(state)
    return result
}

@hide:file
constant_equal proc(state @mut State, left, right ast.NodeId) bool ! Error {
    kind :: ast.expr_kind(&state.tree, left)
    if (kind != ast.expr_kind(&state.tree, right)) return false
    if (kind == .literal_void) return true
    if (kind == .address_constant) {
        a :: ast.address_constant(&state.tree, left)
        b :: ast.address_constant(&state.tree, right)
        return (
            a.value == b.value and try same_type_context(state, a.type, b.type, true)
            and try constant_equal(state, ast.address_constant_offset(&state.tree, left), ast.address_constant_offset(&state.tree, right))
        )
    }
    if (kind == .memory_constant) {
        a :: ast.memory_constant(&state.tree, left)
        b :: ast.memory_constant(&state.tree, right)
        return try same_type_context(state, a.type, b.type, true) and try constant_equal(state, a.value, b.value)
    }
    if (kind == .typed_constant or kind == .slice_constant) {
        a :: if (kind == .slice_constant) ast.slice_constant(&state.tree, left) else ast.typed_constant(&state.tree, left)
        b :: if (kind == .slice_constant) ast.slice_constant(&state.tree, right) else ast.typed_constant(&state.tree, right)
        return try same_type_context(state, a.type, b.type, true) and try constant_equal(state, a.value, b.value)
    }
    if (kind == .slice) {
        a :: ast.slice_expr(&state.tree, left)
        b :: ast.slice_expr(&state.tree, right)
        # serialized nonzero-sentinel views have a canonical owned string and explicit end.
        return (
            try constant_equal(state, a.base, b.base)
            and try constant_equal(state, a.end?, b.end?)
            and try constant_equal(state, a.sentinel?, b.sentinel?)
        )
    }
    if (kind == .array_literal) {
        count :: ast.array_element_count(&state.tree, left)
        if (count != ast.array_element_count(&state.tree, right)) return false
        for (0..count) |i| {
            if (!try constant_equal(state, ast.array_element(&state.tree, left, i), ast.array_element(&state.tree, right, i))) return false
        }
        return true
    }
    if (kind == .record_literal) {
        count :: ast.record_field_count(&state.tree, left)
        if (count != ast.record_field_count(&state.tree, right)) return false
        for (0..count) |i| {
            a :: ast.field(&state.tree, ast.record_field(&state.tree, left, i))
            b :: ast.field(&state.tree, ast.record_field(&state.tree, right, i))
            if ((a.name == null) != (b.name == null)) return false
            if (a.name != null and ast.name_id(&state.tree, a.name?) != ast.name_id(&state.tree, b.name?)) return false
            if (!try constant_equal(state, a.value?, b.value?)) return false
        }
        return true
    }
    if (kind == .builtin_call and contextual_literal(state, left) and contextual_literal(state, right)) {
        return try constant_equal(state, ast.call_arg(&state.tree, left, 0), ast.call_arg(&state.tree, right, 0))
    }
    if (kind == .enum_literal)
        return ast.name_id(&state.tree, ast.enum_literal(&state.tree, left)) == ast.name_id(&state.tree, ast.enum_literal(&state.tree, right))
    return try value_equal(state, try evaluate(state, left), try evaluate(state, right))
}

@hide:file
constant_hash proc(state @mut State, id ast.NodeId) usize ! Error {
    kind :: ast.expr_kind(&state.tree, id)
    hash :: enum_index(kind)
    if (kind == .literal_void) return hash
    if (kind == .address_constant) {
        value :: ast.address_constant(&state.tree, id)
        return mix(mix(mix(hash, usize(value.value)), try type_hash_context(state, value.type, true)),
            try constant_hash(state, ast.address_constant_offset(&state.tree, id)))
    }
    if (kind == .memory_constant) {
        value :: ast.memory_constant(&state.tree, id)
        return mix(mix(hash, try type_hash_context(state, value.type, true)), try constant_hash(state, value.value))
    }
    if (kind == .typed_constant or kind == .slice_constant) {
        value :: if (kind == .slice_constant) ast.slice_constant(&state.tree, id) else ast.typed_constant(&state.tree, id)
        return mix(mix(hash, try type_hash_context(state, value.type, true)), try constant_hash(state, value.value))
    }
    if (kind == .slice) {
        view :: ast.slice_expr(&state.tree, id)
        return mix(mix(mix(hash, try constant_hash(state, view.base)),
            try constant_hash(state, view.end?)), try constant_hash(state, view.sentinel?))
    }
    if (kind == .array_literal) {
        result := hash
        for (0..ast.array_element_count(&state.tree, id)) |i|
            result = mix(result, try constant_hash(state, ast.array_element(&state.tree, id, i)))
        return result
    }
    if (kind == .record_literal) {
        result := hash
        for (0..ast.record_field_count(&state.tree, id)) |i| {
            field :: ast.field(&state.tree, ast.record_field(&state.tree, id, i))
            if (field.name) |name| result = mix(result, usize(ast.name_id(&state.tree, name)))
            result = mix(result, try constant_hash(state, field.value?))
        }
        return result
    }
    if (kind == .builtin_call and contextual_literal(state, id))
        return mix(hash, try constant_hash(state, ast.call_arg(&state.tree, id, 0)))
    if (kind == .enum_literal) return mix(hash, usize(ast.name_id(&state.tree, ast.enum_literal(&state.tree, id))))
    return try value_hash(state, try evaluate(state, id))
}

@hide:file
constant_addresses proc(state @State, id ast.NodeId, depth usize) bool {
    if (depth >= 128) return true
    if (ast.node_class(&state.tree, id) == .expression
        and ast.expr_kind(&state.tree, id) == .address_constant) return true
    for (0..ast.child_count(&state.tree, id)) |i|
        if (constant_addresses(state, ast.child(&state.tree, id, i), depth + 1)) return true
    return false
}

@hide:file
evaluate_call proc(state @mut State, call ast.NodeId) Value ! Error {
    callee :: try evaluate(state, ast.call_expr(&state.tree, call).callee)
    if (callee.kind != .function and callee.kind != .type) return Value{}
    result_type := callee.node
    function := no_node
    if (callee.kind == .function) {
        resolved :: binding(state, callee.node)
        if (resolved.kind != .declaration) return Value{}
        function = resolved.data.declaration
        result_type = ast.function_decl(&state.tree, resolved.data.declaration).return_type
    }
    arguments := arraylist.init(ast.NodeId, state.allocator)
    defer arraylist.deinit(&arguments)
    for (0..ast.call_arg_count(&state.tree, call)) |i| {
        argument :: ast.call_arg(&state.tree, call, i)
        value := Value{}
        if (function != no_node and i < ast.function_param_count(&state.tree, function)) {
            annotation :: ast.param(&state.tree, ast.function_param(&state.tree, function, i)).type
            value = try evaluate_expected(state, argument, annotation)
        } else value = try evaluate(state, argument)
        if (value.kind == .invalid) return Value{}
        concrete := try materialize(state, value)
        if (value.annotation != no_node) {
            concrete.node = try ast.add_typed_constant(state.builder, ast.node_span(&state.tree, value.node),
                value.annotation, concrete.node)
            try refresh(state)
        }
        try arraylist.append(&arguments, concrete.node)
    }
    # reuse checking, typed IR and the interpreter: compile-time arithmetic and local
    # inference must have exactly the same semantics as an ordinary runtime call.
    span :: ast.node_span(&state.tree, call)
    invocation :: try ast.add_call(state.builder, span, callee.node, arguments.items)
    try refresh(state)
    return try evaluate_ir(state, invocation, result_type)
}

@hide:file
evaluate_ir proc(state @mut State, expression, result_type ast.NodeId) Value ! Error {
    if (result_type == no_node) return Value{}
    span :: ast.node_span(&state.tree, expression)
    returned :: try ast.add_return_stmt(state.builder, span, expression)
    statements [1]ast.NodeId :: [returned]
    body :: try ast.add_block(state.builder, span, statements[..])
    try refresh(state)
    return try evaluate_ir_body(state, expression, body, result_type)
}

@hide:file
evaluate_ir_body proc(state @mut State, at, body, result_type ast.NodeId) Value ! Error {
    span :: ast.node_span(&state.tree, at)
    wrapper :: try ast.add_function_decl(state.builder, span, span, strpool.no_str, result_type, &[], body)
    try refresh(state)
    declarations := arraylist.init(ast.NodeId, state.allocator)
    defer arraylist.deinit(&declarations)
    try arraylist.append(&declarations, wrapper)
    flags := arraylist.init(u8, state.allocator)
    defer arraylist.deinit(&flags)
    index := usize(0)
    while (index < declarations.items.len) {
        declaration :: declarations.items[index]
        try expand(state, declaration)
        previous_count :: flags.items.len
        count :: ast.node_count(&state.tree)
        try arraylist.reserve(&flags, count)
        flags.items = flags.items.ptr[..count]
        mem.set(flags.items[previous_count..], 0)
        flags.items[usize(declaration)] = flags.items[usize(declaration)] | 2
        evaluation_owned(state, declaration, flags.items)
        if (!try evaluation_dependencies(state, declaration, flags.items, &declarations)) return Value{}
        index += 1
    }
    root :: try ast.add_package(state.builder, span, declarations.items)
    try refresh(state)
    # checking and lowering only read bindings; serialization may grow the arena afterward.
    resolution := sema.borrow_bindings(state.resolution, state.bindings.items)
    defer sema.deinit(&resolution)
    tree :: ast.view(state.builder, root)
    diagnostic_store := diagnostics.init(state.allocator)
    defer diagnostics.deinit(&diagnostic_store)
    # Resolution's existing diagnostic IDs remain valid in this temporary store.
    for (state.diagnostics.list.items) |diagnostic| {
        if (diagnostic.custom_message) |text| {
            _ = try diagnostics.add_message(&diagnostic_store, diagnostic.code, diagnostic.span, text)
        } else _ = try diagnostics.add(&diagnostic_store, diagnostic.code, diagnostic.span)
    }
    original_diagnostics :: diagnostics.count(&diagnostic_store)
    checked := try typecheck.check(state.allocator, &tree, &resolution, &diagnostic_store)
    defer typecheck.deinit(&checked)
    if (diagnostics.count(&diagnostic_store) != original_diagnostics) {
        diagnostic :: diagnostic_store.list.items[original_diagnostics]
        state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, diagnostic.code, diagnostic.span)
        return Value{}
    }
    functions := arraylist.init(ast.NodeId, state.allocator)
    defer arraylist.deinit(&functions)
    module := try lower.lower_evaluation(state.allocator, &tree, &resolution, &checked,
        wrapper, &functions, &diagnostic_store)
    defer ir.deinit(&module)
    outcome := try interpreter.run_evaluation(state.allocator, &module, &diagnostic_store)
    defer interpreter.deinit(&outcome)
    if (outcome.trap) |trap| {
        if (usize(trap) < original_diagnostics) state.evaluation_diagnostic = trap
        else {
            diagnostic :: diagnostics.get(&diagnostic_store, trap)?
            state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, diagnostic.code, diagnostic.span)
        }
        return Value{}
    }
    value :: outcome.value
    source_type :: typecheck.type_of(&checked, result_type)
    remaining := usize(100000)
    roots := arraylist.init(SnapshotRoot, state.allocator)
    defer arraylist.deinit(&roots)
    previous_roots :: state.snapshot_roots
    state.snapshot_roots = &roots
    defer state.snapshot_roots = previous_roots
    previous_scan :: state.snapshot_scan_remaining
    state.snapshot_scan_remaining = 100000
    defer state.snapshot_scan_remaining = previous_scan
    try snapshot_reserve(state, &module, &checked, &outcome, source_type, value, 0)
    if (state.snapshot_scan_remaining == 0) {
        state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .comptime_execution_limit, span)
        return Value{}
    }
    node :: try serialize_value(state, &module, &checked, &outcome, functions.items, source_type, value, span, &remaining)
    if (node == no_node) {
        if (state.evaluation_diagnostic == diagnostics.no_diagnostic)
            state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .comptime_value_escape, span)
        return Value{}
    }
    if (
        (ir.aggregate(value.type) and source_type.kind != .slice)
        or (source_type.kind == .slice and (ast.expr_kind(&state.tree, node) == .slice
            or ast.expr_kind(&state.tree, node) == .slice_constant or ast.expr_kind(&state.tree, node) == .memory_constant))
        or source_type.kind == .enumeration or source_type.kind == .void or source_type.kind == .pointer
    )
        return Value{ kind = .aggregate, node = node, annotation = result_type }
    result := try evaluate(state, node)
    result.annotation = result_type
    return result
}

@hide:file
TypeLocal :: struct {
    declaration ast.NodeId
    value ast.NodeId
    annotation ast.NodeId
    # unannotated numeric literal origins stay contextual while executing constants;
    # annotations, casts and rigid assignment sources retain ordinary exact types.
    contextual bool = false
}

@hide:file
TypeExecution :: struct {
    locals arraylist.ArrayList(TypeLocal)
    mapping []mut ast.NodeId
    first_owned ast.NodeId
    returned ast.NodeId = no_node
    view_identity ast.NodeId = no_node
    result_type ast.NodeId
    failed bool = false
    yielded ast.NodeId = no_node
    yield_type ast.NodeId = no_node
    yield_depth usize = 0
    cleanup_yield_depth usize = 0
    cleanup_depth usize = 0
    cleanup_loop_depth usize = 0
    evaluate_values bool = false
    # dispatch snapshots must retain match shape until ordinary arm validation.
    resolve_views bool = true
    pending_flow TypeFlow = .next
    loop_depth usize = 0
    inline_body ast.NodeId = no_node
    inline_blocks ?@mut arraylist.ArrayList(ast.NodeId) = null
    residual ?@mut arraylist.ArrayList(ast.NodeId) = null
    residual_boundary usize = 0
    residual_body ast.NodeId = no_node
    residual_flow TypeFlow = .next
}

# unique empty AST literals identify views in metadata_view_indices. owner teardown
# invalidates handles before its stack frame disappears; only owned leaves reach IR.
@hide:file
MetadataView :: struct {
    owner @mut TypeExecution
    owner_identity ast.NodeId = no_node
    place ast.NodeId
    start usize
    count usize
    # single places address a whole value; sequence places address array elements.
    single bool = false
    active bool = true
}

@hide:file
metadata_view_index proc(state @State, id ast.NodeId) usize {
    if (id == no_node) return no_index
    if (ast.node_class(&state.tree, id) != .expression) return no_index
    marker :: if (ast.expr_kind(&state.tree, id) == .typed_constant)
        ast.typed_constant(&state.tree, id).value else id
    if (hashmap.get(&state.metadata_view_indices, marker)) |index| return index
    return no_index
}

@hide:file
metadata_has_view proc(state @State, id ast.NodeId) bool {
    if (id == no_node or state.metadata_views.items.len == 0) return false
    if (metadata_view_index(state, id) != no_index) return true
    for (0..ast.child_count(&state.tree, id)) |i| {
        if (metadata_has_view(state, ast.child(&state.tree, id, i))) return true
    }
    return false
}

@hide:file
metadata_uses_views proc(state @State, execution @TypeExecution, id ast.NodeId) bool {
    if (metadata_has_view(state, id)) return true
    if (type_call_metadata_borrows(state, execution, id)) return true
    for (execution.locals.items) |local| {
        if (metadata_has_view(state, local.value) and metadata_reads(state, id, local.declaration, 0))
            return true
    }
    return false
}

@hide:file
type_execution_deinit proc(state @mut State, execution @mut TypeExecution) void {
    if (execution.view_identity != no_node) {
        for (state.metadata_views.items) |@view| {
            if (view.owner_identity == execution.view_identity) view.active = false
        }
    }
    arraylist.deinit(&execution.locals)
}

# handles refer to live type-control places, never to temporary interpreter storage.
@hide:file
metadata_view_read proc(state @mut State, index usize, at ast.NodeId) ast.NodeId ! Error {
    view :: state.metadata_views.items[index]
    if (view.active) {
        root :: assignment_root(state, view.place)
        for (view.owner.locals.items) |local| {
            if (local.declaration != root) continue
            result :: try type_collection_read(state, view.owner, view.place)
            if (!try expand_type_matches(state, result)) return no_node
            return result
        }
    }
    state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
        .comptime_value_escape, ast.node_span(&state.tree, at))
    return no_node
}

@hide:file
metadata_view_snapshot proc(state @mut State, value, at ast.NodeId) ast.NodeId ! Error {
    index :: metadata_view_index(state, value)
    if (index == no_index) return value
    view :: state.metadata_views.items[index]
    annotation :: ast.typed_constant(&state.tree, value).type
    span :: ast.node_span(&state.tree, at)
    source :: try metadata_view_read(state, index, at)
    if (source == no_node) return no_node
    array :: ast.typed_constant(&state.tree, source).value
    count :: ast.array_element_count(&state.tree, array)
    if (view.start > count or view.count > count - view.start) {
        state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
            .invalid_slice_bounds, ast.node_span(&state.tree, at))
        return no_node
    }
    elements := arraylist.init(ast.NodeId, state.allocator)
    defer arraylist.deinit(&elements)
    for (view.start..(view.start + view.count)) |i| {
        if (!try type_step(state, at)) return no_node
        try arraylist.append(&elements, ast.array_element(&state.tree, array, i))
    }
    literal :: try ast.add_array_literal(state.builder, span, elements.items)
    result :: try ast.add_typed_constant(state.builder, span, annotation, literal)
    try refresh(state)
    return result
}

# readonly boundary values own their leaves before cleanup invalidates local places.
@hide:file
metadata_own proc(state @mut State, input, at ast.NodeId) ast.NodeId ! Error {
    value := input
    if (!metadata_has_view(state, value)) return value
    if (metadata_view_index(state, value) != no_index) {
        if (ast.expr_kind(&state.tree, value) != .typed_constant) return no_node
        type :: try canonical_type(state, ast.typed_constant(&state.tree, value).type)
        if (ast.expr_kind(&state.tree, type) != .slice_type or ast.slice_type(&state.tree, type).mutable) {
            state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
                .comptime_value_escape, ast.node_span(&state.tree, at))
            return no_node
        }
        value = try metadata_view_snapshot(state, value, at)
        if (value == no_node) return no_node
        if (!metadata_has_view(state, value)) return value
    }
    mapping :: try mem.alloc(ast.NodeId, state.allocator, ast.node_count(&state.tree))
    defer mem.free(state.allocator, mapping)
    mem.set(mapping, no_node)
    for (0..ast.child_count(&state.tree, value)) |i| {
        child :: ast.child(&state.tree, value, i)
        owned :: if (metadata_has_view(state, child)) try metadata_own(state, child, at) else child
        if (owned == no_node) return no_node
        mapping[usize(child)] = owned
    }
    result :: try ast.clone_subtree(state.builder, value, mapping)
    try refresh(state)
    return result
}

@hide:file
metadata_readonly_views proc(state @mut State, id, annotation ast.NodeId) bool ! Error {
    if (!metadata_has_view(state, id)) return true
    if (metadata_view_index(state, id) != no_index) {
        type := annotation
        if (ast.node_class(&state.tree, id) == .expression
            and ast.expr_kind(&state.tree, id) == .typed_constant)
            type = ast.typed_constant(&state.tree, id).type
        type = try canonical_type(state, type)
        return (type != no_node and ast.expr_kind(&state.tree, type) == .slice_type
            and !ast.slice_type(&state.tree, type).mutable)
    }
    for (0..ast.child_count(&state.tree, id)) |i| {
        if (!try metadata_readonly_views(state, ast.child(&state.tree, id, i), no_node)) return false
    }
    return true
}

@hide:file
MetadataPlace :: struct {
    owner @mut TypeExecution
    place ast.NodeId
    mutable bool
}

@hide:file
metadata_view_value proc(state @mut State, input MetadataView, type, at ast.NodeId) ast.NodeId ! Error {
    view := input
    span :: ast.node_span(&state.tree, at)
    marker :: try ast.add_array_literal(state.builder, span, &[])
    result :: try ast.add_typed_constant(state.builder, span, type, marker)
    try refresh(state)
    if (view.owner.view_identity == no_node) view.owner.view_identity = marker
    if (view.owner_identity == no_node) view.owner_identity = view.owner.view_identity
    index :: state.metadata_views.items.len
    try arraylist.append(&state.metadata_views, view)
    hashmap.put(&state.metadata_view_indices, marker, index) catch |err| {
        match err {
            .key_exists: unreachable
            else: return err
        }
    }
    return result
}

@hide:file
metadata_pointer_place proc(state @mut State, value, offset, at ast.NodeId) MetadataPlace ! Error {
    index :: metadata_view_index(state, value)
    view :: state.metadata_views.items[index]
    result := MetadataPlace{ owner = view.owner, place = no_node, mutable = false }
    if (try metadata_view_read(state, index, at) == no_node) return result
    type :: try canonical_type(state, ast.typed_constant(&state.tree, value).type)
    pointer :: ast.pointer_type(&state.tree, type)
    if (offset != no_node and !pointer.many) {
        child :: try canonical_type(state, pointer.element)
        if (child != no_node and ast.expr_kind(&state.tree, child) == .array_type) {
            descriptor :: ast.array_type(&state.tree, child)
            count :: try evaluate(state, descriptor.count?)
            position :: try type_array_index(state, offset, usize(count.magnitude), false)
            if (position == no_index) return result
            index_node :: try ast.add_integer(state.builder, ast.node_span(&state.tree, at), u64(position))
            result.place = try ast.add_index(state.builder, ast.node_span(&state.tree, at), view.place, index_node)
            result.mutable = pointer.mutable and descriptor.mutable
            try refresh(state)
            return result
        }
    }
    position :: if (offset == no_node) usize(0) else try type_array_index(state, offset, view.count, false)
    if (position == no_index) return result
    if ((offset != no_node and !pointer.many) or view.count == 0) {
        code :: if (view.count == 0) diagnostics.Code.index_out_of_bounds else diagnostics.Code.invalid_operand
        state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, code, ast.node_span(&state.tree, at))
        return result
    }
    result.mutable = pointer.mutable
    result.place = view.place
    if (!view.single) {
        index_node :: try ast.add_integer(state.builder, ast.node_span(&state.tree, at), u64(view.start + position))
        result.place = try ast.add_index(state.builder, ast.node_span(&state.tree, at), view.place, index_node)
        try refresh(state)
    }
    return result
}

@hide:file
metadata_pointer_create proc(state @mut State, execution @mut TypeExecution, id ast.NodeId) ast.NodeId ! Error {
    kind :: ast.expr_kind(&state.tree, id)
    span :: ast.node_span(&state.tree, id)
    if (kind == .selection and mem.eql(ast.literal_text(&state.tree, ast.selection_expr(&state.tree, id).member), "ptr")) {
        base :: ast.selection_expr(&state.tree, id).base
        slice :: try ast.add_slice(state.builder, span, base, null, null, null)
        try refresh(state)
        value :: try metadata_view_create(state, execution, slice)
        if (value == no_node) return no_node
        type :: ast.slice_type(&state.tree, try canonical_type(state, ast.typed_constant(&state.tree, value).type))
        pointer :: try ast.add_pointer_type(state.builder, span, type.element, type.mutable, true)
        try refresh(state)
        return try metadata_view_value(state, state.metadata_views.items[metadata_view_index(state, value)], pointer, id)
    }
    if (kind != .unary or ast.unary_expr(&state.tree, id).operator != .address_of) return no_node
    operand :: try type_assignment_target(state, execution, ast.unary_expr(&state.tree, id).operand)
    if (operand == no_node) return no_node
    element :: try expression_type(state, operand, 0)
    if (!type_record_storage(state, element, 0)) return no_node
    if (ast.expr_kind(&state.tree, operand) == .index) {
        index :: ast.index_expr(&state.tree, operand)
        slice :: try ast.add_slice(state.builder, span, index.base, null, null, null)
        try refresh(state)
        value :: try metadata_view_create(state, execution, slice)
        if (value != no_node) {
            base := state.metadata_views.items[metadata_view_index(state, value)]
            snapshot :: try type_snapshot(state, execution, index.index)
            offset :: try type_array_index(state, snapshot, base.count, false)
            if (offset == no_index) return no_node
            base.start += offset
            base.count -= offset
            descriptor :: ast.slice_type(&state.tree, ast.typed_constant(&state.tree, value).type)
            pointer :: try ast.add_pointer_type(state.builder, span, element, descriptor.mutable, false)
            try refresh(state)
            return try metadata_view_value(state, base, pointer, id)
        }
    }
    frozen :: try type_collection_place(state, execution, operand)
    if (frozen == no_node) {
        state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .invalid_assignment_target, span)
        return no_node
    }
    place :: try metadata_place(state, execution, frozen)
    if (place.place == no_node) return no_node
    pointer :: try ast.add_pointer_type(state.builder, span, element, place.mutable, false)
    try refresh(state)
    return try metadata_view_value(state, MetadataView{
        owner = place.owner, place = place.place, start = 0, count = 1, single = true,
    }, pointer, id)
}

# only address expressions adopt an expected many-pointer shape; pointer values do not.
@hide:file
metadata_address_context proc(state @mut State, value, annotation, at ast.NodeId) ast.NodeId ! Error {
    if (metadata_view_index(state, value) == no_index or annotation == no_node) return value
    expected :: try canonical_type(state, annotation)
    if (expected == no_node or ast.expr_kind(&state.tree, expected) != .pointer_type
        or !ast.pointer_type(&state.tree, expected).many) return value
    actual :: ast.typed_constant(&state.tree, value)
    type :: try canonical_type(state, actual.type)
    if (ast.expr_kind(&state.tree, type) != .pointer_type) return value
    descriptor :: ast.pointer_type(&state.tree, type)
    pointer :: try ast.add_pointer_type(state.builder, ast.node_span(&state.tree, at),
        descriptor.element, descriptor.mutable, true)
    result :: try ast.add_typed_constant(state.builder, ast.node_span(&state.tree, at), pointer, actual.value)
    try refresh(state)
    return result
}

@hide:file
metadata_pointer_read proc(state @mut State, value, offset, at ast.NodeId) ast.NodeId ! Error {
    place :: try metadata_pointer_place(state, value, offset, at)
    if (place.place == no_node) return no_node
    result :: try type_collection_read(state, place.owner, place.place)
    if (!try expand_type_matches(state, result)) return no_node
    if (ast.expr_kind(&state.tree, result) == .literal_undefined) {
        state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
            .read_before_initialization, ast.node_span(&state.tree, at))
        return no_node
    }
    if (nominal_type_value(state, result)) {
        selected :: try ast.add_type_operand(state.builder, ast.node_span(&state.tree, at), result, true)
        try refresh(state)
        return selected
    }
    return result
}

@hide:file
metadata_same_place proc(state @mut State, left, right ast.NodeId) bool ! Error {
    a :: binding(state, left)
    b :: binding(state, right)
    if (a.kind == .declaration or b.kind == .declaration)
        return a.kind == .declaration and b.kind == .declaration and a.data.declaration == b.data.declaration
    kind :: ast.expr_kind(&state.tree, left)
    if (kind != ast.expr_kind(&state.tree, right)) return false
    if (kind == .selection) {
        p :: ast.selection_expr(&state.tree, left)
        q :: ast.selection_expr(&state.tree, right)
        return (ast.name_id(&state.tree, p.member) == ast.name_id(&state.tree, q.member)
            and try metadata_same_place(state, p.base, q.base))
    }
    if (kind == .index) {
        p :: ast.index_expr(&state.tree, left)
        q :: ast.index_expr(&state.tree, right)
        return try constant_equal(state, p.index, q.index) and try metadata_same_place(state, p.base, q.base)
    }
    return false
}

@hide:file
metadata_pointer_location proc(state @mut State, value ast.NodeId) ast.NodeId ! Error {
    view :: state.metadata_views.items[metadata_view_index(state, value)]
    if (view.single) return view.place
    span :: ast.node_span(&state.tree, value)
    index :: try ast.add_integer(state.builder, span, u64(view.start))
    result :: try ast.add_index(state.builder, span, view.place, index)
    try refresh(state)
    return result
}

@hide:file
metadata_pointer_binary proc(state @mut State, id ast.NodeId) bool ! Error {
    binary :: ast.binary_expr(&state.tree, id)
    left :: metadata_view_index(state, binary.left)
    right :: metadata_view_index(state, binary.right)
    if (left == no_index and right == no_index) return true
    if (left == no_index or ast.expr_kind(&state.tree,
        try canonical_type(state, ast.typed_constant(&state.tree, binary.left).type)) != .pointer_type) return true
    if (try metadata_view_read(state, left, id) == no_node) return false
    type :: ast.typed_constant(&state.tree, binary.left).type
    descriptor :: ast.pointer_type(&state.tree, try canonical_type(state, type))
    span :: ast.node_span(&state.tree, id)
    result := no_node
    if (binary.operator == .add and descriptor.many) {
        view := state.metadata_views.items[left]
        offset :: try type_array_index(state, binary.right, view.count, true)
        if (offset == no_index) return false
        view.start += offset
        view.count -= offset
        result = try metadata_view_value(state, view, type, id)
    } else if (binary.operator == .equal or binary.operator == .not_equal) {
        equal := false
        if (right != no_index) {
            other :: ast.typed_constant(&state.tree, binary.right).type
            other_type :: try canonical_type(state, other)
            if (ast.expr_kind(&state.tree, other_type) != .pointer_type
                or !try same_type(state, descriptor.element, ast.pointer_type(&state.tree, other_type).element)) {
                state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .type_mismatch, span)
                return false
            }
            if (try metadata_view_read(state, right, id) == no_node) return false
            a :: state.metadata_views.items[left]
            b :: state.metadata_views.items[right]
            equal = (a.owner_identity == b.owner_identity
                and try metadata_same_place(state, try metadata_pointer_location(state, binary.left),
                    try metadata_pointer_location(state, binary.right)))
        } else if (ast.expr_kind(&state.tree, binary.right) != .literal_null) {
            state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .invalid_operand, span)
            return false
        }
        result = try ast.add_boolean(state.builder, span, equal == (binary.operator == .equal))
    } else {
        state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .invalid_operand, span)
        return false
    }
    try refresh(state)
    try replace(state, id, result)
    try refresh(state)
    return true
}

@hide:file
metadata_place proc(
    state @mut State, execution @mut TypeExecution, place ast.NodeId,
) MetadataPlace ! Error {
    kind :: ast.expr_kind(&state.tree, place)
    root :: assignment_root(state, place)
    if (kind == .unary and ast.unary_expr(&state.tree, place).operator == .dereference) {
        value :: try type_snapshot(state, execution, ast.unary_expr(&state.tree, place).operand)
        if (metadata_view_index(state, value) != no_index)
            return try metadata_pointer_place(state, value, no_node, place)
        return MetadataPlace{ owner = execution, place = no_node, mutable = false }
    }
    if (kind != .selection and kind != .index) {
        return MetadataPlace{ owner = execution, place = place,
            mutable = (root != no_node and ast.node_class(&state.tree, root) == .statement
                and ast.statement_decl(&state.tree, root).mutability == .variable) }
    }
    parent :: if (kind == .index) ast.index_expr(&state.tree, place).base
        else ast.selection_expr(&state.tree, place).base
    base :: try type_snapshot(state, execution, parent)
    if (!try expand_type_matches(state, base))
        return MetadataPlace{ owner = execution, place = no_node, mutable = false }
    borrowed :: metadata_view_index(state, base)
    if (borrowed != no_index
        and ast.expr_kind(&state.tree, try canonical_type(state, ast.typed_constant(&state.tree, base).type)) == .pointer_type) {
        offset :: if (kind == .index) ast.index_expr(&state.tree, place).index else no_node
        result := try metadata_pointer_place(state, base, offset, place)
        if (result.place != no_node and kind == .selection) {
            result.place = try ast.add_selection(state.builder, ast.node_span(&state.tree, place),
                result.place, ast.selection_expr(&state.tree, place).member)
            try refresh(state)
        }
        return result
    }
    if (kind == .index and borrowed != no_index) {
        view :: state.metadata_views.items[borrowed]
        if (try metadata_view_read(state, borrowed, place) == no_node)
            return MetadataPlace{ owner = execution, place = no_node, mutable = false }
        offset :: try type_array_index(state, ast.index_expr(&state.tree, place).index, view.count, false)
        if (offset == no_index)
            return MetadataPlace{ owner = execution, place = no_node, mutable = false }
        span :: ast.node_span(&state.tree, place)
        type :: try canonical_type(state, ast.typed_constant(&state.tree, base).type)
        mutable :: ast.slice_type(&state.tree, type).mutable
        index :: try ast.add_integer(state.builder, span, u64(view.start + offset))
        result :: try ast.add_index(state.builder, span, view.place, index)
        try refresh(state)
        return MetadataPlace{ owner = view.owner, place = result, mutable = mutable }
    }
    result := try metadata_place(state, execution, parent)
    if (result.place == no_node) return result
    if (kind == .index) {
        type :: try canonical_type(state, try expression_type(state, base, 0))
        if (type == no_node or ast.expr_kind(&state.tree, type) != .array_type) {
            result.mutable = false
        } else result.mutable = result.mutable and ast.array_type(&state.tree, type).mutable
        result.place = try ast.add_index(state.builder, ast.node_span(&state.tree, place),
            result.place, ast.index_expr(&state.tree, place).index)
    } else result.place = try ast.add_selection(state.builder, ast.node_span(&state.tree, place),
        result.place, ast.selection_expr(&state.tree, place).member)
    try refresh(state)
    return result
}

@hide:file
metadata_view_create proc(
    state @mut State, execution @mut TypeExecution, id ast.NodeId,
) ast.NodeId ! Error {
    view :: ast.slice_expr(&state.tree, id)
    normalized :: try type_assignment_target(state, execution, view.base)
    if (normalized == no_node) return no_node
    place :: try type_collection_place(state, execution, normalized)
    source := no_node
    if (place != no_node) source = try type_collection_read(state, execution, place)
    else source = try type_snapshot(state, execution, normalized)
    if (source == no_node or !try expand_type_matches(state, source)) return no_node
    annotation :: try expression_type(state, source, 0)
    if (!type_record_storage(state, annotation, 0)) return no_node
    if (view.sentinel != null) {
        state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
            .invalid_operand, ast.node_span(&state.tree, id))
        return no_node
    }
    type :: try canonical_type(state, annotation)
    kind :: ast.expr_kind(&state.tree, type)
    if (kind != .array_type and kind != .slice_type and kind != .pointer_type) return no_node
    previous :: metadata_view_index(state, source)
    if (place == no_node and previous == no_index) return no_node
    base := MetadataView{ owner = execution, place = place, start = 0, count = 0 }
    mutable := false
    element := no_node
    if (previous != no_index) {
        base = state.metadata_views.items[previous]
        if (kind == .pointer_type) {
            pointer :: ast.pointer_type(&state.tree, type)
            mutable = pointer.mutable
            element = pointer.element
            child :: try canonical_type(state, element)
            if (!pointer.many) {
                if (!base.single or ast.expr_kind(&state.tree, child) != .array_type) {
                    state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .invalid_operand,
                        ast.node_span(&state.tree, id))
                    return no_node
                }
                array :: ast.array_type(&state.tree, child)
                length :: try evaluate(state, array.count?)
                base.single = false
                base.count = usize(length.magnitude)
                mutable = mutable and array.mutable
                element = array.element
            } else if (view.end == null) {
                state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .invalid_slice_bounds,
                    ast.node_span(&state.tree, id))
                return no_node
            }
        } else {
            mutable = ast.slice_type(&state.tree, type).mutable
            element = ast.slice_type(&state.tree, type).element
        }
    } else if (kind == .array_type) {
        descriptor :: ast.array_type(&state.tree, type)
        storage :: try metadata_place(state, execution, place)
        if (storage.place == no_node) return no_node
        base.owner = storage.owner
        base.place = storage.place
        mutable = descriptor.mutable and storage.mutable
        element = descriptor.element
        base.count = ast.array_element_count(&state.tree, ast.typed_constant(&state.tree, source).value)
    } else return no_node
    start := usize(0)
    end := base.count
    if (view.start) |bound| {
        snapshot :: try type_snapshot(state, execution, bound)
        if (snapshot == no_node) return no_node
        start = try type_array_index(state, snapshot, base.count, true)
    }
    if (start == no_index) return no_node
    if (view.end) |bound| {
        snapshot :: try type_snapshot(state, execution, bound)
        if (snapshot == no_node) return no_node
        end = try type_array_index(state, snapshot, base.count, true)
    }
    if (end == no_index) return no_node
    if (start > end) {
        state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
            .invalid_slice_bounds, ast.node_span(&state.tree, id))
        return no_node
    }
    span :: ast.node_span(&state.tree, id)
    slice :: try ast.add_slice_type(state.builder, span, element, mutable, null)
    try refresh(state)
    base.start += start
    base.count = end - start
    return try metadata_view_value(state, base, slice, id)
}

@hide:file
metadata_resolve_views proc(state @mut State, id ast.NodeId) bool ! Error {
    if (!metadata_has_view(state, id)) return true
    if (ast.node_class(&state.tree, id) == .expression
        and ast.expr_kind(&state.tree, id) == .typed_constant) return true
    if (ast.node_class(&state.tree, id) == .expression
        and ast.expr_kind(&state.tree, id) == .binary) {
        binary :: ast.binary_expr(&state.tree, id)
        if (binary.operator == .logical_and or binary.operator == .logical_or) {
            if (!try metadata_resolve_views(state, binary.left)) return false
            if (branch_constant(state, binary.left, 0)) {
                value :: try evaluate_ir(state, binary.left, try builtin(state, id, .bool))
                if (value.kind != .boolean) return false
                if (value.boolean == (binary.operator == .logical_or)) {
                    # inspect the skipped call's signature without executing its body.
                    right :: storage_expression_annotation(&state.tree, state.bindings.items, binary.right, 0)
                    if (!try same_type(state, right, try builtin(state, id, .bool))) {
                        state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
                            .invalid_operand, ast.node_span(&state.tree, binary.right))
                        return false
                    }
                    result :: try ast.add_boolean(state.builder, ast.node_span(&state.tree, id), value.boolean)
                    try replace(state, id, result)
                    try refresh(state)
                    return true
                }
                return try metadata_resolve_views(state, binary.right)
            }
            state.metadata_runtime_depth += 1
            defer state.metadata_runtime_depth -= 1
            return try metadata_resolve_views(state, binary.right)
        }
    }
    if (ast.node_class(&state.tree, id) == .expression
        and ast.expr_kind(&state.tree, id) == .match_expr) {
        subject :: ast.match_expr(&state.tree, id).subject
        if (!try metadata_resolve_views(state, subject)) return false
        if (try specialize_match(state, id, no_node, no_node)) {
            if (binding(state, id).kind == .invalid) return false
            return try metadata_resolve_views(state, id)
        }
        state.metadata_runtime_depth += 1
        defer state.metadata_runtime_depth -= 1
        for (0..ast.match_arm_count(&state.tree, id)) |i| {
            if (!try metadata_resolve_views(state, ast.match_arm(&state.tree, id, i))) return false
        }
        return true
    }
    for (0..ast.child_count(&state.tree, id)) |i| {
        if (!try metadata_resolve_views(state, ast.child(&state.tree, id, i))) return false
    }
    if (ast.node_class(&state.tree, id) != .expression) return true
    if (ast.expr_kind(&state.tree, id) == .call) {
        try expand(state, id)
        if (binding(state, id).kind == .invalid) {
            state.evaluation_diagnostic = binding(state, id).data.diagnostic
            return false
        }
    }
    return try type_array_projection(state, id)
}

@hide:file
type_place_root proc(state @State, id ast.NodeId) ast.NodeId {
    kind :: ast.expr_kind(&state.tree, id)
    if (kind == .selection) return type_place_root(state, ast.selection_expr(&state.tree, id).base)
    if (kind == .index) return type_place_root(state, ast.index_expr(&state.tree, id).base)
    return id
}

@hide:file
metadata_assignment proc(
    state @mut State, execution @mut TypeExecution, target, input ast.NodeId,
) bool ! Error {
    kind :: ast.expr_kind(&state.tree, target)
    if ((kind != .selection and kind != .index
        and !(kind == .unary and ast.unary_expr(&state.tree, target).operator == .dereference))
        or !metadata_uses_views(state, execution, target)) return false
    frozen :: try type_collection_place(state, execution, target)
    if (frozen == no_node) return true
    storage :: try metadata_place(state, execution, frozen)
    if (storage.place == no_node) return true
    if (!storage.mutable) {
        state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
            .invalid_index_assignment, ast.node_span(&state.tree, target))
        return true
    }
    if (state.metadata_runtime_depth > 0) {
        state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
            .comptime_argument_required, ast.node_span(&state.tree, target))
        return true
    }
    expression :: try type_snapshot(state, execution, input)
    if (expression == no_node or !try expand_type_matches(state, expression)) return true
    root :: assignment_root(state, storage.place)
    for (storage.owner.locals.items) |local, i| {
        if (local.declaration != root) continue
        if (storage.owner.residual != null and i < storage.owner.residual_boundary) {
            state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
                .comptime_argument_required, ast.node_span(&state.tree, target))
            return true
        }
        updated :: if (binding(state, storage.place).kind == .declaration)
            try type_execution_value(state, expression, local.annotation)
            else try type_array_update(state, storage.owner, storage.place,
                type_place_root(state, storage.place), local.value, expression)
        if (updated != no_node) storage.owner.locals.items[i].value = updated
        return true
    }
    return true
}

@hide:file
TypeFlow :: enum { next, returned, yielded, break, continue, invalid }

@hide:file
ResidualCleanup :: struct { position usize, statement ast.NodeId }

@hide:file
metadata_reads proc(state @State, id, declaration ast.NodeId, depth usize) bool {
    if (depth >= 128) return false
    resolved :: binding(state, id)
    if (resolved.kind == .declaration) {
        if (resolved.data.declaration == declaration) return true
        if (ast.node_class(&state.tree, resolved.data.declaration) == .statement)
            return metadata_reads(state, ast.statement_decl(&state.tree, resolved.data.declaration).initializer,
                declaration, depth + 1)
    }
    for (0..ast.child_count(&state.tree, id)) |i|
        if (metadata_reads(state, ast.child(&state.tree, id, i), declaration, depth + 1)) return true
    return false
}

@hide:file
metadata_updates_outer proc(state @State, id, scope ast.NodeId) bool {
    if (ast.node_class(&state.tree, id) == .statement and ast.stmt_kind(&state.tree, id) == .assignment_stmt) {
        root :: assignment_root(state, ast.assignment_stmt(&state.tree, id).target)
        if (root != no_node and metadata_local(state, root) and !subtree_has(state, scope, root)) return true
    }
    if (ast.node_class(&state.tree, id) == .statement and ast.stmt_kind(&state.tree, id) == .for_stmt) {
        loop :: ast.for_stmt(&state.tree, id)
        if (loop.pointer_capture
            and type_storage_initializer(&state.tree, state.bindings.items, loop.iterable, true, 0)) return true
    }
    for (0..ast.child_count(&state.tree, id)) |i|
        if (metadata_updates_outer(state, ast.child(&state.tree, id, i), scope)) return true
    return false
}

@hide:file
metadata_updates proc(state @State, id ast.NodeId) bool {
    return metadata_updates_outer(state, id, id)
}

@hide:file
metadata_needs proc(state @State, id, declaration ast.NodeId) bool {
    if (metadata_local(state, id) and metadata_reads(state, id, declaration, 0)) return true
    if (ast.node_class(&state.tree, id) == .statement) {
        kind :: ast.stmt_kind(&state.tree, id)
        if (kind == .assignment_stmt) {
            root :: assignment_root(state, ast.assignment_stmt(&state.tree, id).target)
            if (root != no_node and metadata_local(state, root)
                and metadata_reads(state, id, declaration, 0)) return true
        }
        if ((kind == .while_stmt or kind == .for_stmt or kind == .if_stmt) and metadata_updates(state, id)) {
            condition :: if (kind == .while_stmt) ast.while_stmt(&state.tree, id).condition
                else if (kind == .for_stmt) ast.for_stmt(&state.tree, id).iterable
                else ast.if_stmt(&state.tree, id).condition
            if (metadata_reads(state, condition, declaration, 0)) return true
        }
    }
    for (0..ast.child_count(&state.tree, id)) |i|
        if (metadata_needs(state, ast.child(&state.tree, id, i), declaration)) return true
    return false
}

# erase metadata storage before ordinary checking. runtime scopes may create their
# own metadata, but cannot change a snapshot belonging to an enclosing runtime path.
@hide:file
residual_block proc(state @mut State, execution @mut TypeExecution, block ast.NodeId, boundary usize) ast.NodeId ! Error {
    saved :: execution.locals.items.len
    saved_output :: execution.residual
    saved_boundary :: execution.residual_boundary
    statements := arraylist.init(ast.NodeId, state.allocator)
    defer arraylist.deinit(&statements)
    cleanups := arraylist.init(ResidualCleanup, state.allocator)
    defer arraylist.deinit(&cleanups)
    execution.residual = &statements
    execution.residual_boundary = boundary
    execution.residual_flow = .next
    defer {
        execution.locals.items = execution.locals.items[..saved]
        execution.residual = saved_output
        execution.residual_boundary = saved_boundary
    }
    for (0..ast.block_statement_count(&state.tree, block)) |i| {
        statement :: ast.block_statement(&state.tree, block, i)
        if (!try type_control_step(state, statement)) return no_node
        kind :: ast.stmt_kind(&state.tree, statement)
        if ((kind == .break_stmt or kind == .continue_stmt) and execution.loop_depth > 0) {
            execution.residual_flow = if (kind == .break_stmt) TypeFlow.break else TypeFlow.continue
            break
        }
        if (kind == .defer_stmt) {
            try arraylist.append(&cleanups, ResidualCleanup{ position = statements.items.len, statement = statement })
            try arraylist.append(&statements, statement)
            continue
        }
        constant := metadata_local(state, statement)
        if (kind == .declaration and !constant) {
            declaration :: ast.statement_decl(&state.tree, statement)
            constant = (type_storage_initializer(&state.tree, state.bindings.items,
                declaration.initializer, true, 0)
                or metadata_needs(state, execution.residual_body, statement))
        }
        if (kind == .assignment_stmt) {
            root :: assignment_root(state, ast.assignment_stmt(&state.tree, statement).target)
            for (execution.locals.items) |local, index| {
                if (root != local.declaration) continue
                if (index < boundary) {
                    state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
                        .comptime_argument_required, ast.node_span(&state.tree, statement))
                    return no_node
                }
                constant = true
            }
        }
        if (constant) {
            saved_values :: execution.evaluate_values
            execution.evaluate_values = true
            flow :: execute_type_statement(state, execution, statement) catch |err| {
                execution.evaluate_values = saved_values
                return err
            }
            execution.evaluate_values = saved_values
            if (flow != .next) return no_node
            continue
        }
        if (kind == .block_stmt) {
            child :: try residual_block(state, execution, ast.statement_block(&state.tree, statement), boundary)
            if (child == no_node) return no_node
            try arraylist.append(&statements, try ast.add_block_stmt(state.builder, child))
            try refresh(state)
            if (execution.residual_flow != .next) break
            continue
        }
        if (kind == .expression
            and ast.expr_kind(&state.tree, ast.statement_expr(&state.tree, statement)) == .match_expr) {
            expression :: ast.statement_expr(&state.tree, statement)
            subject :: try type_snapshot(state, execution, ast.match_expr(&state.tree, expression).subject)
            if (subject == no_node) return no_node
            try expand(state, subject)
            if (type_record_storage(state, try expression_type(state, subject, 0), 0)
                or branch_constant(state, subject, 0)) {
                arms := arraylist.init(ast.NodeId, state.allocator)
                defer arraylist.deinit(&arms)
                for (0..ast.match_arm_count(&state.tree, expression)) |position|
                    try arraylist.append(&arms, ast.match_arm(&state.tree, expression, position))
                dispatch :: try ast.add_match(state.builder, ast.node_span(&state.tree, expression), subject, arms.items)
                try refresh(state)
                try expand_inline_match(state, dispatch, try expression_type(state, subject, 0))
                index :: try type_match_arm(state, dispatch)
                if (index == no_index) return no_node
                arm :: ast.match_arm_view(&state.tree, ast.match_arm(&state.tree, dispatch, index))
                selected :: try type_match_body(state, dispatch, arm)
                if (selected == no_node) return no_node
                if (arm.expression) {
                    snapshot :: try type_snapshot(state, execution, selected)
                    if (snapshot == no_node) return no_node
                    try arraylist.append(&statements, try ast.add_expression_stmt(state.builder, snapshot))
                } else {
                    body :: try residual_block(state, execution, selected, boundary)
                    if (body == no_node) return no_node
                    value :: try ast.add_block_expr(state.builder, ast.node_span(&state.tree, expression), body)
                    try arraylist.append(&statements, try ast.add_expression_stmt(state.builder, value))
                    if (execution.residual_flow == .yielded) execution.residual_flow = .next
                }
                try refresh(state)
                if (execution.residual_flow != .next) break
                continue
            }
        }
        if (kind == .if_stmt and ast.if_stmt(&state.tree, statement).capture != null) {
            condition :: try type_snapshot(state, execution, ast.if_stmt(&state.tree, statement).condition)
            if (condition == no_node) return no_node
            try expand(state, condition)
            if (type_record_storage(state, try expression_type(state, condition, 0), 0)) {
                flow :: try execute_type_statement(state, execution, statement)
                if (flow == .invalid) return no_node
                execution.residual_flow = flow
                if (flow != .next) break
                continue
            }
        }
        if (kind == .if_stmt and ast.if_stmt(&state.tree, statement).capture == null) {
            condition :: try type_snapshot(state, execution, ast.if_stmt(&state.tree, statement).condition)
            if (condition == no_node) return no_node
            try expand(state, condition)
            if (branch_constant(state, condition, 0)) {
                value :: try evaluate_ir(state, condition, try builtin(state, condition, .bool))
                if (value.kind != .boolean) return no_node
                view :: ast.if_stmt(&state.tree, statement)
                selected := if (value.boolean) view.then_block else no_node
                if (!value.boolean and view.else_block != null) selected = view.else_block?
                if (selected != no_node) {
                    child :: try residual_block(state, execution, selected, boundary)
                    if (child == no_node) return no_node
                    try arraylist.append(&statements, try ast.add_block_stmt(state.builder, child))
                    try refresh(state)
                    if (execution.residual_flow != .next) break
                }
                continue
            }
        }
        if ((kind == .for_stmt or kind == .while_stmt) and metadata_updates(state, statement)) {
            flow :: try execute_type_statement(state, execution, statement)
            if (flow == .invalid) return no_node
            execution.residual_flow = flow
            if (flow != .next) break
            continue
        }
        snapshot :: try type_snapshot(state, execution, statement)
        if (snapshot == no_node) return no_node
        try arraylist.append(&statements, snapshot)
        if (kind == .return_stmt or kind == .yield_stmt) {
            execution.residual_flow = if (kind == .return_stmt) TypeFlow.returned else TypeFlow.yielded
            break
        }
    }
    remaining := cleanups.items.len
    while (remaining > 0) {
        remaining -= 1
        cleanup :: cleanups.items[remaining]
        saved_flow :: execution.residual_flow
        body :: try residual_block(state, execution, ast.cleanup_stmt(&state.tree, cleanup.statement).body, boundary)
        if (body == no_node) return no_node
        statements.items[cleanup.position] = try ast.add_cleanup_stmt(state.builder,
            ast.node_span(&state.tree, cleanup.statement), body, null, false)
        try refresh(state)
        execution.residual_flow = saved_flow
    }
    result :: try ast.add_block(state.builder, ast.node_span(&state.tree, block), statements.items)
    try refresh(state)
    return result
}

@hide:file
expand_runtime_metadata proc(state @mut State, function ast.NodeId) void ! Error {
    view :: ast.function_decl(&state.tree, function)
    begin_type_execution(state)
    defer state.type_execution_depth -= 1
    state.evaluation_diagnostic = diagnostics.no_diagnostic
    execution := TypeExecution{
        locals = arraylist.init(state.allocator),
        mapping = try mem.alloc(ast.NodeId, state.allocator, ast.node_count(&state.tree)),
        first_owned = ast.NodeId(0), result_type = view.return_type, residual_body = view.body,
    }
    defer type_execution_deinit(state, &execution)
    defer mem.free(state.allocator, execution.mapping)
    mem.set(execution.mapping, no_node)
    body := try residual_block(state, &execution, view.body, 0)
    if (body == no_node) {
        diagnostic := state.evaluation_diagnostic
        if (diagnostic == diagnostics.no_diagnostic)
            diagnostic = try diagnostics.add(state.diagnostics, .comptime_argument_required, view.span)
        invalid :: try ast.add_invalid_stmt(state.builder, view.span, diagnostic)
        statements [1]ast.NodeId :: [invalid]
        body = try ast.add_block(state.builder, view.span, statements[..])
    }
    try replace(state, view.body, body)
    try refresh(state)
    try expand(state, view.return_type)
    for (0..ast.function_param_count(&state.tree, function)) |i|
        try expand(state, ast.function_param(&state.tree, function, i))
    try expand(state, view.body)
}

# type values cannot enter runtime IR. execute their control flow here, substituting
# owned constants into snapshots; ordinary value operations still use checked IR.
@hide:file
return_type_value proc(state @mut State, block, first_owned, result_type ast.NodeId) ast.NodeId ! Error {
    # ponytail: snapshots recheck scalar IR; retain a finite type-control budget
    # until type values can share one persistent checked execution frame.
    execution := TypeExecution{
        locals = arraylist.init(state.allocator),
        mapping = try mem.alloc(ast.NodeId, state.allocator, ast.node_count(&state.tree)),
        first_owned = first_owned,
        result_type = result_type,
        evaluate_values = true,
    }
    defer type_execution_deinit(state, &execution)
    defer mem.free(state.allocator, execution.mapping)
    mem.set(execution.mapping, no_node)
    flow :: try execute_type_block(state, &execution, block)
    if (flow == .returned) return execution.returned
    if (flow == .next) return try type_void_completion(state, result_type, block)
    return no_node
}

@hide:file
type_void_completion proc(state @mut State, annotation, at ast.NodeId) ast.NodeId ! Error {
    type :: try canonical_type(state, annotation)
    if (type == no_node) return no_node
    child :: if (ast.expr_kind(&state.tree, type) == .fallible_type)
        try canonical_type(state, ast.binary_expr(&state.tree, type).left) else type
    resolved :: binding(state, child)
    if (resolved.kind != .builtin or resolved.data.builtin != .void) return no_node
    value :: try ast.add_literal(state.builder, .void, ast.node_span(&state.tree, at))
    try refresh(state)
    return try type_execution_value(state, value, annotation)
}

@hide:file
evaluate_type_value_block proc(state @mut State, expression, annotation ast.NodeId) ast.NodeId ! Error {
    begin_type_execution(state)
    defer state.type_execution_depth -= 1
    execution := TypeExecution{
        locals = arraylist.init(state.allocator),
        mapping = try mem.alloc(ast.NodeId, state.allocator, ast.node_count(&state.tree)),
        first_owned = ast.NodeId(0),
        result_type = no_node,
        evaluate_values = true,
    }
    defer type_execution_deinit(state, &execution)
    defer mem.free(state.allocator, execution.mapping)
    mem.set(execution.mapping, no_node)
    return try execute_type_value_block(state, &execution, ast.block_expr(&state.tree, expression), annotation)
}

@hide:file
execute_type_value_block proc(
    state @mut State, execution @mut TypeExecution, block, annotation ast.NodeId,
) ast.NodeId ! Error {
    saved_value :: execution.yielded
    saved_type :: execution.yield_type
    execution.yielded = no_node
    execution.yield_type = annotation
    execution.yield_depth += 1
    defer {
        execution.yielded = saved_value
        execution.yield_type = saved_type
        execution.yield_depth -= 1
    }
    flow :: try execute_type_block(state, execution, block)
    if (flow == .yielded) return execution.yielded
    if (flow != .next) execution.pending_flow = flow
    else {
        inferred :: if (annotation == no_node) try value_block_type(state, block, 0) else annotation
        result :: binding(state, inferred)
        if (result.kind == .builtin and result.data.builtin == .void) {
            value :: try ast.add_literal(state.builder, .void, ast.node_span(&state.tree, block))
            try refresh(state)
            return value
        }
        state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
            .missing_yield, ast.node_span(&state.tree, block))
        execution.pending_flow = .invalid
    }
    return no_node
}

@hide:file
begin_type_execution proc(state @mut State) void {
    if (state.type_execution_depth == 0) {
        state.type_execution_remaining = type_execution_limit
        state.type_control_remaining = type_control_limit
    }
    state.type_execution_depth += 1
}

@hide:file
type_control_step proc(state @mut State, at ast.NodeId) bool ! Error {
    if (!try type_step(state, at)) return false
    if (state.type_control_remaining == 0) {
        state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
            .comptime_execution_limit, ast.node_span(&state.tree, at))
        return false
    }
    state.type_control_remaining -= 1
    return true
}

@hide:file
type_step proc(state @mut State, at ast.NodeId) bool ! Error {
    if (state.type_execution_remaining == 0) {
        state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
            .comptime_execution_limit, ast.node_span(&state.tree, at))
        return false
    }
    state.type_execution_remaining -= 1
    return true
}

@hide:file
prepare_type_snapshot proc(state @mut State, execution @mut TypeExecution, id ast.NodeId) void ! Error {
    if (id == no_node or usize(id) >= execution.mapping.len or execution.pending_flow != .next) return
    resolved_capture :: binding(state, id)
    if (execution.residual != null and !execution.evaluate_values
        and (ast.node_class(&state.tree, id) == .expression or ast.node_class(&state.tree, id) == .parameter)
        and resolved_capture.kind == .declaration and resolved_capture.data.declaration == id) return
    if (execution.residual != null and !execution.evaluate_values) {
        # captures precede their bodies semantically, regardless of AST child order.
        for (0..ast.child_count(&state.tree, id)) |i| {
            child :: ast.child(&state.tree, id, i)
            resolved :: binding(state, child)
            if ((ast.node_class(&state.tree, child) != .expression and ast.node_class(&state.tree, child) != .parameter)
                or resolved.kind != .declaration or resolved.data.declaration != child) continue
            capture :: try ast.copy_node(state.builder, child)
            try refresh(state)
            execution.mapping[usize(child)] = capture
            state.bindings.items[usize(capture)] = sema.Binding{
                kind = .declaration, data = sema.BindingData{ declaration = capture },
            }
        }
    }
    if (execution.residual != null and !execution.evaluate_values and ast.node_class(&state.tree, id) == .block) {
        saved_flow :: execution.residual_flow
        saved_loop :: execution.loop_depth
        execution.loop_depth = 0
        defer {
            execution.residual_flow = saved_flow
            execution.loop_depth = saved_loop
        }
        execution.mapping[usize(id)] = try residual_block(state, execution, id, execution.locals.items.len)
        if (execution.mapping[usize(id)] == no_node) execution.pending_flow = .invalid
        return
    }
    # substituted arguments belong to the caller, including nominal type identity.
    if (id < execution.first_owned) {
        execution.mapping[usize(id)] = id
        return
    }
    execution.mapping[usize(id)] = no_node
    resolved :: binding(state, id)
    if (resolved.kind == .declaration) {
        for (execution.locals.items) |local| {
            if (local.declaration == resolved.data.declaration) {
                value := local.value
                if (local.contextual and ast.expr_kind(&state.tree, value) == .typed_constant)
                    value = ast.typed_constant(&state.tree, value).value
                execution.mapping[usize(id)] = value
                return
            }
        }
    }
    if (execution.evaluate_values and ast.node_class(&state.tree, id) == .field) {
        field :: ast.field(&state.tree, id)
        if (field.type != null and field.value != null) {
            annotation :: try type_snapshot(state, execution, field.type?)
            if (annotation == no_node) return
            value :: try type_snapshot_expected(state, execution, field.value?, annotation)
            execution.mapping[usize(field.value?)] = value
            if (value == no_node and execution.pending_flow == .next) execution.pending_flow = .invalid
            return
        }
    }
    if (execution.residual != null and !execution.evaluate_values
        and ast.node_class(&state.tree, id) == .expression and metadata_uses_views(state, execution, id)) {
        kind :: ast.expr_kind(&state.tree, id)
        if (kind == .binary) {
            binary :: ast.binary_expr(&state.tree, id)
            if (binary.operator == .logical_and or binary.operator == .logical_or) {
                left :: try type_snapshot(state, execution, binary.left)
                if (left == no_node) return
                known :: branch_constant(state, left, 0)
                if (known) {
                    value :: try evaluate_ir(state, left, try builtin(state, id, .bool))
                    if (value.kind != .boolean) {
                        execution.pending_flow = .invalid
                        return
                    }
                    if (value.boolean == (binary.operator == .logical_or)) {
                        right :: storage_expression_annotation(&state.tree, state.bindings.items, binary.right, 0)
                        if (!try same_type(state, right, try builtin(state, id, .bool))) {
                            state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
                                .invalid_operand, ast.node_span(&state.tree, binary.right))
                            execution.pending_flow = .invalid
                            return
                        }
                        execution.mapping[usize(id)] = try ast.add_boolean(state.builder,
                            ast.node_span(&state.tree, id), value.boolean)
                        try refresh(state)
                        return
                    }
                }
                if (!known) state.metadata_runtime_depth += 1
                defer if (!known) state.metadata_runtime_depth -= 1
                right :: try type_snapshot(state, execution, binary.right)
                execution.mapping[usize(binary.left)] = left
                execution.mapping[usize(binary.right)] = right
                if (right == no_node) execution.pending_flow = .invalid
                return
            }
        }
        if (kind == .match_expr) {
            subject :: try type_snapshot(state, execution, ast.match_expr(&state.tree, id).subject)
            if (subject == no_node) return
            if (!branch_constant(state, subject, 0)) {
                state.metadata_runtime_depth += 1
                defer state.metadata_runtime_depth -= 1
                for (0..ast.child_count(&state.tree, id)) |i|
                    try prepare_type_snapshot(state, execution, ast.child(&state.tree, id, i))
                return
            }
        }
    }
    if ((execution.evaluate_values or execution.residual != null) and ast.node_class(&state.tree, id) == .expression) {
        kind :: ast.expr_kind(&state.tree, id)
        if ((kind == .unary and ast.unary_expr(&state.tree, id).operator == .address_of)
            or (kind == .selection and mem.eql(ast.literal_text(&state.tree,
                ast.selection_expr(&state.tree, id).member), "ptr"))) {
            previous :: state.evaluation_diagnostic
            result :: try metadata_pointer_create(state, execution, id)
            if (result != no_node) {
                execution.mapping[usize(id)] = result
                return
            }
            if (state.evaluation_diagnostic != previous) {
                execution.pending_flow = .invalid
                return
            }
        }
    }
    if ((execution.evaluate_values or execution.residual != null)
        and ast.node_class(&state.tree, id) == .expression and ast.expr_kind(&state.tree, id) == .slice) {
        result :: try metadata_view_create(state, execution, id)
        if (result != no_node) {
            execution.mapping[usize(id)] = result
            return
        }
        if (state.evaluation_diagnostic != diagnostics.no_diagnostic) {
            execution.pending_flow = .invalid
            return
        }
    }
    if (execution.evaluate_values and ast.node_class(&state.tree, id) == .expression) {
        kind :: ast.expr_kind(&state.tree, id)
        if (kind == .call and type_call_borrows(state, execution, id)
            and !type_call_metadata_borrows(state, execution, id)) {
            execution.mapping[usize(id)] = try type_borrow_call(state, execution, id)
            if (execution.mapping[usize(id)] == no_node) execution.pending_flow = .invalid
            return
        }
        if (kind == .block_expr) {
            execution.mapping[usize(id)] = try execute_type_value_block(state, execution,
                ast.block_expr(&state.tree, id), no_node)
            if (execution.mapping[usize(id)] == no_node and execution.pending_flow == .next)
                execution.pending_flow = .invalid
            return
        }
        if (kind == .match_expr) {
            execution.mapping[usize(id)] = try type_snapshot_match(state, execution, id, no_node)
            if (execution.mapping[usize(id)] == no_node and execution.pending_flow == .next)
                execution.pending_flow = .invalid
            return
        }
        if (kind == .binary) {
            view :: ast.binary_expr(&state.tree, id)
            if (view.operator == .logical_and or view.operator == .logical_or) {
                boolean :: try builtin(state, id, .bool)
                left :: try type_snapshot_expected(state, execution, view.left, boolean)
                if (left == no_node) return
                value :: try evaluate_ir(state, left, boolean)
                if (value.kind != .boolean) {
                    execution.pending_flow = .invalid
                    return
                }
                right := no_node
                if (value.boolean == (view.operator == .logical_or)) {
                    if (metadata_uses_views(state, execution, view.right)) {
                        annotation :: storage_expression_annotation(&state.tree, state.bindings.items, view.right, 0)
                        if (!try same_type(state, annotation, boolean)) {
                            state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
                                .invalid_operand, ast.node_span(&state.tree, view.right))
                            execution.pending_flow = .invalid
                            return
                        }
                        execution.mapping[usize(id)] = try ast.add_boolean(state.builder,
                            ast.node_span(&state.tree, id), value.boolean)
                        try refresh(state)
                        return
                    }
                    saved :: execution.evaluate_values
                    saved_views :: execution.resolve_views
                    defer {
                        execution.evaluate_values = saved
                        execution.resolve_views = saved_views
                    }
                    execution.evaluate_values = false
                    execution.resolve_views = false
                    right = try type_snapshot(state, execution, view.right)
                    if (right != no_node and !try skip_type_value_blocks(state, right)) {
                        execution.pending_flow = .invalid
                        return
                    }
                } else right = try type_snapshot_expected(state, execution, view.right, boolean)
                if (right == no_node and execution.pending_flow == .next) {
                    execution.pending_flow = .invalid
                    return
                }
                # retain the operator and skipped operand for ordinary type validation.
                execution.mapping[usize(view.left)] = left
                execution.mapping[usize(view.right)] = right
                return
            }
        }
        if (kind == .try_expr) {
            execution.mapping[usize(id)] = try type_snapshot_try(state, execution, id)
            if (execution.mapping[usize(id)] == no_node and execution.pending_flow == .next)
                execution.pending_flow = .invalid
            return
        }
        if (kind == .catch_expr) {
            execution.mapping[usize(id)] = try type_snapshot_catch(state, execution, id, no_node)
            if (execution.mapping[usize(id)] == no_node and execution.pending_flow == .next)
                execution.pending_flow = .invalid
            return
        }
    }
    for (0..ast.child_count(&state.tree, id)) |i|
        try prepare_type_snapshot(state, execution, ast.child(&state.tree, id, i))
    if (ast.node_class(&state.tree, id) == .expression and ast.expr_kind(&state.tree, id) == .call) {
        function :: storage_schema(&state.tree, state.bindings.items, ast.call_expr(&state.tree, id).callee, 0)
        if (function != no_node and ast.node_class(&state.tree, function) == .function
            and ast.function_param_count(&state.tree, function) == ast.call_arg_count(&state.tree, id)) {
            for (0..ast.call_arg_count(&state.tree, id)) |i| {
                argument :: ast.call_arg(&state.tree, id, i)
                if (usize(argument) >= execution.mapping.len or ast.expr_kind(&state.tree, argument) != .unary
                    or ast.unary_expr(&state.tree, argument).operator != .address_of) continue
                parameter :: ast.param(&state.tree, ast.function_param(&state.tree, function, i))
                execution.mapping[usize(argument)] = try metadata_address_context(state,
                    execution.mapping[usize(argument)], parameter.type, argument)
            }
        }
    }
}

@hide:file
bind_type_snapshot proc(state @mut State, execution @TypeExecution, id, start ast.NodeId) void ! Error {
    if (usize(id) >= execution.mapping.len) return
    target :: execution.mapping[usize(id)]
    if (target == no_node or target < start) return
    resolved := binding(state, id)
    if (resolved.kind == .declaration) {
        declaration :: resolved.data.declaration
        if (usize(declaration) < execution.mapping.len and execution.mapping[usize(declaration)] != no_node)
            resolved.data.declaration = execution.mapping[usize(declaration)]
    }
    state.bindings.items[usize(target)] = resolved
    if (hashmap.get(&state.capture_types, id)) |annotation| {
        hashmap.put(&state.capture_types, target, annotation) catch |err| {
            match err {
                .key_exists: {}
                else: return err
            }
        }
    }
    for (0..ast.child_count(&state.tree, id)) |i|
        try bind_type_snapshot(state, execution, ast.child(&state.tree, id, i), start)
}

@hide:file
skip_type_value_blocks proc(state @mut State, id ast.NodeId) bool ! Error {
    if (ast.node_class(&state.tree, id) == .expression and ast.expr_kind(&state.tree, id) == .block_expr) {
        annotation :: try expression_type(state, id, 0)
        if (annotation == no_node) return false
        span :: ast.node_span(&state.tree, id)
        # skipped type-control bodies retain only their result type for checked IR.
        placeholder :: try ast.add_literal(state.builder, .undefined, span)
        local :: try ast.add_statement_decl(state.builder, span, span, strpool.no_str,
            annotation, .variable, placeholder)
        try refresh(state)
        yielded :: try ast.add_yield_stmt(state.builder, span, try reference(state, id, local))
        statements [2]ast.NodeId :: [local, yielded]
        body :: try ast.add_block(state.builder, span, statements[..])
        replacement :: try ast.add_block_expr(state.builder, span, body)
        ast.replace_node_from_source(state.builder, id, replacement)
        try refresh(state)
        return true
    }
    for (0..ast.child_count(&state.tree, id)) |i|
        if (!try skip_type_value_blocks(state, ast.child(&state.tree, id, i))) return false
    return true
}

@hide:file
type_snapshot proc(state @mut State, execution @mut TypeExecution, id ast.NodeId) ast.NodeId ! Error {
    if (id == no_node or execution.pending_flow != .next) return no_node
    if (execution.mapping.len < ast.node_count(&state.tree)) {
        previous :: execution.mapping.len
        execution.mapping = try mem.realloc(state.allocator, execution.mapping, ast.node_count(&state.tree))
        mem.set(execution.mapping[previous..], no_node)
    }
    try prepare_type_snapshot(state, execution, id)
    if (execution.pending_flow != .next) return no_node
    start :: ast.NodeId(ast.node_count(&state.tree))
    result :: try ast.clone_subtree(state.builder, id, execution.mapping)
    try refresh(state)
    try bind_type_snapshot(state, execution, id, start)
    if (execution.resolve_views and !try metadata_resolve_views(state, result)) return no_node
    return result
}

@hide:file
type_snapshot_expected proc(
    state @mut State, execution @mut TypeExecution, id, annotation ast.NodeId,
) ast.NodeId ! Error {
    if (id == no_node or execution.pending_flow != .next) return no_node
    if (execution.evaluate_values and ast.expr_kind(&state.tree, id) == .block_expr)
        return try execute_type_value_block(state, execution, ast.block_expr(&state.tree, id), annotation)
    if (execution.evaluate_values and ast.expr_kind(&state.tree, id) == .match_expr)
        return try type_snapshot_match(state, execution, id, annotation)
    if (execution.evaluate_values and ast.expr_kind(&state.tree, id) == .catch_expr)
        return try type_snapshot_catch(state, execution, id, annotation)
    result :: try type_snapshot(state, execution, id)
    if (ast.expr_kind(&state.tree, id) == .unary and ast.unary_expr(&state.tree, id).operator == .address_of)
        return try metadata_address_context(state, result, annotation, id)
    return result
}

@hide:file
type_fallible_failed proc(
    state @mut State,
    owned, type, at ast.NodeId,
) ?bool ! Error {
    missing ?bool :: null
    if (type_record_storage(state, type, 0)) {
        if (!try type_array_initialized(state, owned, at)) return missing
        return !try same_type(state,
            ast.typed_constant(&state.tree, ast.typed_constant(&state.tree, owned).value).type,
            ast.binary_expr(&state.tree, type).left)
    }
    span :: ast.node_span(&state.tree, at)
    boolean :: try builtin(state, at, .bool)
    yes :: try ast.add_boolean(state.builder, span, true)
    no :: try ast.add_boolean(state.builder, span, false)
    returned :: try ast.add_return_stmt(state.builder, span, yes)
    failure_statements [1]ast.NodeId :: [returned]
    handler :: try ast.add_block(state.builder, span, failure_statements[..])
    caught :: try ast.add_catch_expr(state.builder, span, owned, null, handler, true)
    discarded :: try ast.add_expression_stmt(state.builder, caught)
    success :: try ast.add_return_stmt(state.builder, span, no)
    statements [2]ast.NodeId :: [discarded, success]
    body :: try ast.add_block(state.builder, span, statements[..])
    try refresh(state)
    guard :: try evaluate_ir_body(state, at, body, boolean)
    if (guard.kind != .boolean) return missing
    return guard.boolean
}

@hide:file
type_snapshot_catch proc(
    state @mut State,
    execution @mut TypeExecution,
    id, annotation ast.NodeId,
) ast.NodeId ! Error {
    view :: ast.catch_expr(&state.tree, id)
    operand :: try type_snapshot(state, execution, view.operand)
    if (operand == no_node) return no_node
    try expand_expected(state, operand, annotation)
    operand_type :: try expression_type(state, operand, 0)
    if (operand_type == no_node or ast.expr_kind(&state.tree, operand_type) != .fallible_type) return no_node
    channels :: ast.binary_expr(&state.tree, operand_type)
    owned :: try type_execution_value(state, operand, operand_type)
    if (owned == no_node) return no_node
    failure :: try type_fallible_failed(state, owned, operand_type, id)
    if (failure == null) return no_node
    failed :: failure?
    payload :: ast.typed_constant(&state.tree, owned).value
    if (!failed) return try type_execution_value(state, payload, channels.left)
    saved :: execution.locals.items.len
    defer execution.locals.items = execution.locals.items[..saved]
    if (view.capture) |capture| {
        error :: try type_execution_value(state, payload, channels.right)
        if (error == no_node) return no_node
        try arraylist.append(&execution.locals, TypeLocal{
            declaration = capture, value = error, annotation = channels.right,
        })
    }
    result_type := channels.left
    if (annotation != no_node and !is_type(state, annotation)) {
        contextual :: try canonical_type(state, annotation)
        if (contextual != no_node) {
            kind :: ast.expr_kind(&state.tree, contextual)
            if (kind == .optional_type
                and try same_type(state, ast.type_operand(&state.tree, contextual), channels.left))
                result_type = annotation
            if (kind == .fallible_type
                and try same_type(state, ast.binary_expr(&state.tree, contextual).left, channels.left))
                result_type = annotation
        }
    }
    if (view.handler_is_block)
        return try execute_type_value_block(state, execution, view.handler, result_type)
    selected :: try type_snapshot_expected(state, execution, view.handler, result_type)
    return try type_execution_value(state, selected, result_type)
}

@hide:file
specialize_type_catch proc(state @mut State, id, annotation, expected ast.NodeId) void ! Error {
    view :: ast.catch_expr(&state.tree, id)
    value :: try evaluate_expected(state, view.operand, annotation)
    if (value.kind != .aggregate) {
        try reject_evaluation(state, id)
        return
    }
    channels :: ast.binary_expr(&state.tree, annotation)
    payload :: value.node
    success :: try same_type(state, ast.typed_constant(&state.tree, payload).type, channels.left)
    selected := no_node
    if (success) selected = try type_execution_value(state, payload, channels.left)
    else {
        execution := TypeExecution{
            locals = arraylist.init(state.allocator),
            mapping = try mem.alloc(ast.NodeId, state.allocator, ast.node_count(&state.tree)),
            first_owned = ast.NodeId(0),
            result_type = no_node,
        }
        defer type_execution_deinit(state, &execution)
        defer mem.free(state.allocator, execution.mapping)
        mem.set(execution.mapping, no_node)
        if (view.capture) |capture| {
            resolved :: binding(state, capture)
            if (resolved.kind == .invalid) {
                state.evaluation_diagnostic = resolved.data.diagnostic
                try reject_evaluation(state, id)
                return
            }
            error :: try type_execution_value(state, payload, channels.right)
            if (error == no_node) {
                try reject_evaluation(state, id)
                return
            }
            try arraylist.append(&execution.locals, TypeLocal{
                declaration = capture, value = error, annotation = channels.right,
            })
        }
        selected = try type_snapshot(state, &execution, view.handler)
        if (view.handler_is_block and selected != no_node) {
            selected = try ast.add_block_expr(state.builder, ast.node_span(&state.tree, id), selected)
            try refresh(state)
        }
    }
    if (selected == no_node) {
        try reject_evaluation(state, id)
        return
    }
    context :: if (expected != no_node) expected else channels.left
    try expand_expected(state, selected, context)
    if (is_type(state, channels.left) or type_record_storage(state, channels.left, 0)) {
        selected = try type_execution_value(state, selected, channels.left)
        if (selected == no_node) {
            try reject_evaluation(state, id)
            return
        }
    } else {
        result_type := channels.left
        contextual :: try canonical_type(state, context)
        if (contextual != no_node) {
            kind :: ast.expr_kind(&state.tree, contextual)
            if (kind == .optional_type
                and try same_type(state, ast.type_operand(&state.tree, contextual), channels.left))
                result_type = context
            if (kind == .fallible_type
                and try same_type(state, ast.binary_expr(&state.tree, contextual).left, channels.left))
                result_type = context
        }
        selected = try ast.add_typed_constant(state.builder, ast.node_span(&state.tree, id), result_type, selected)
        try refresh(state)
    }
    if (is_type(state, try expression_type(state, selected, 0))) {
        selected = try ast.add_type_operand(state.builder, ast.node_span(&state.tree, id), selected, true)
        try refresh(state)
    }
    try replace(state, id, selected)
    try refresh(state)
    state.bindings.items[usize(id)] = binding(state, selected)
}

@hide:file
type_snapshot_try proc(state @mut State, execution @mut TypeExecution, id ast.NodeId) ast.NodeId ! Error {
    operand :: try type_snapshot(state, execution, ast.type_operand(&state.tree, id))
    if (operand == no_node) return no_node
    try expand(state, operand)
    annotation :: try expression_type(state, operand, 0)
    if (annotation == no_node or ast.expr_kind(&state.tree, annotation) != .fallible_type) {
        state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
            .invalid_fallible_operand, ast.node_span(&state.tree, id))
        return no_node
    }
    result :: try canonical_type(state, execution.result_type)
    if (execution.cleanup_depth > 0 or result == no_node
        or ast.expr_kind(&state.tree, result) != .fallible_type) {
        code diagnostics.Code :: if (execution.cleanup_depth > 0)
            .cleanup_control_flow else .try_outside_fallible
        state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, code, ast.node_span(&state.tree, id))
        return no_node
    }
    channels :: ast.binary_expr(&state.tree, annotation)
    if (!try type_subset(state, channels.right, ast.binary_expr(&state.tree, result).right)) {
        state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
            .incompatible_propagated_error, ast.node_span(&state.tree, id))
        return no_node
    }
    # propagation is a catch whose error branch returns from the enclosing frame.
    span :: ast.node_span(&state.tree, id)
    capture :: try ast.add_identifier(state.builder, span, strpool.no_str)
    try refresh(state)
    value :: try reference(state, id, capture)
    returned :: try ast.add_return_stmt(state.builder, span, value)
    statements [1]ast.NodeId :: [returned]
    handler :: try ast.add_block(state.builder, span, statements[..])
    caught :: try ast.add_catch_expr(state.builder, span, operand, capture, handler, true)
    try refresh(state)
    return try type_snapshot_catch(state, execution, caught, channels.left)
}

@hide:file
type_dispatch_snapshot proc(state @mut State, execution @mut TypeExecution, id ast.NodeId) ast.NodeId ! Error {
    subject :: try type_snapshot(state, execution, ast.match_expr(&state.tree, id).subject)
    if (subject == no_node) return no_node
    subject_type :: try expression_type(state, subject, 0)
    try expand_inline_match(state, id, subject_type)
    if (ast.expr_kind(&state.tree, id) != .match_expr) return no_node
    saved :: execution.evaluate_values
    saved_views :: execution.resolve_views
    execution.resolve_views = false
    defer execution.resolve_views = saved_views
    execution.evaluate_values = false
    defer execution.evaluate_values = saved
    snapshot :: try type_snapshot(state, execution, id)
    if (snapshot == no_node) return no_node
    arms := arraylist.init(ast.NodeId, state.allocator)
    defer arraylist.deinit(&arms)
    for (0..ast.match_arm_count(&state.tree, snapshot)) |i|
        try arraylist.append(&arms, ast.match_arm(&state.tree, snapshot, i))
    optional_capture :: ast.match_expr(&state.tree, id).optional_capture
    result :: try ast.add_match(state.builder, ast.node_span(&state.tree, id), subject, arms.items)
    if (optional_capture) ast.set_match_optional(state.builder, result)
    try refresh(state)
    return result
}

@hide:file
type_snapshot_match proc(
    state @mut State, execution @mut TypeExecution, id, annotation ast.NodeId,
) ast.NodeId ! Error {
    snapshot :: try type_dispatch_snapshot(state, execution, id)
    if (snapshot == no_node) return no_node
    index :: try type_match_arm(state, snapshot)
    if (index == no_index) return no_node
    arm :: ast.match_arm_view(&state.tree, ast.match_arm(&state.tree, id, index))
    saved :: execution.locals.items.len
    defer execution.locals.items = execution.locals.items[..saved]
    if (arm.capture) |capture| {
        value :: try type_match_capture(state, snapshot)
        if (value == no_node) return no_node
        constant :: ast.typed_constant(&state.tree, value)
        payload :: if (is_type(state, constant.type)) constant.value else value
        try arraylist.append(&execution.locals, TypeLocal{
            declaration = capture,
            value = payload,
            annotation = constant.type,
        })
    }
    if (!arm.expression) return try execute_type_value_block(state, execution, arm.body, annotation)
    return try type_snapshot_expected(state, execution, arm.body, annotation)
}

@hide:file
nominal_type_value proc(state @State, id ast.NodeId) bool {
    kind :: ast.expr_kind(&state.tree, id)
    return kind == .record_type or kind == .union_type or kind == .enum_type or kind == .distinct_type
}

# transfers targeting an inline loop must be selected before checking runtime
# bodies. nested loops own their transfers and are elaborated independently.
@hide:file
inline_has_transfer proc(state @State, id ast.NodeId) bool {
    class :: ast.node_class(&state.tree, id)
    if (class == .function) return false
    if (class == .statement) {
        kind :: ast.stmt_kind(&state.tree, id)
        if (kind == .for_stmt or kind == .while_stmt) return false
        if (kind == .break_stmt or kind == .continue_stmt) return true
    }
    for (0..ast.child_count(&state.tree, id)) |i| {
        if (inline_has_transfer(state, ast.child(&state.tree, id, i))) return true
    }
    return false
}

@hide:file
inline_statement proc(state @mut State, id ast.NodeId) TypeFlow ! Error {
    kind :: ast.stmt_kind(&state.tree, id)
    if (kind == .break_stmt) return .break
    if (kind == .continue_stmt) return .continue
    if (kind == .unreachable_stmt) return .returned
    if (kind == .yield_stmt or kind == .return_stmt) {
        try expand(state, id)
        return if (kind == .yield_stmt) TypeFlow.yielded else TypeFlow.returned
    }
    if (kind == .block_stmt)
        return try inline_block(state, ast.statement_block(&state.tree, id))
    selected := no_node
    value_source := false
    if (kind == .if_stmt) {
        conditional :: ast.if_stmt(&state.tree, id)
        explicit :: ast.expr_kind(&state.tree, conditional.condition) == .comptime_expr
        condition :: if (explicit) ast.comptime_operand(&state.tree, conditional.condition) else conditional.condition
        try expand(state, condition)
        if (conditional.capture == null and (explicit or branch_constant(state, condition, 0))) {
            value :: try evaluate_ir(state, condition, try builtin(state, condition, .bool))
            if (value.kind != .boolean) return .invalid
            if (value.boolean) selected = conditional.then_block
            else if (conditional.else_block) |other| selected = other
            else selected = try ast.add_block(state.builder, conditional.span, &[])
        }
    }
    if (kind == .expression) {
        expression :: ast.statement_expr(&state.tree, id)
        if (ast.expr_kind(&state.tree, expression) == .match_expr) {
            subject :: ast.match_expr(&state.tree, expression).subject
            explicit :: ast.expr_kind(&state.tree, subject) == .comptime_expr
            try expand(state, subject)
            if (explicit or branch_constant(state, subject, 0)) {
                index :: try type_match_arm(state, expression)
                if (index == no_index) return .invalid
                arm :: ast.match_arm_view(&state.tree, ast.match_arm(&state.tree, expression, index))
                body :: try type_match_body(state, expression, arm)
                if (body == no_node) return .invalid
                if (!arm.expression) {
                    selected = body
                    value_source = true
                } else {
                    statement :: try ast.add_expression_stmt(state.builder, body)
                    statements [1]ast.NodeId :: [statement]
                    selected = try ast.add_block(state.builder, ast.node_span(&state.tree, id), statements[..])
                }
            }
        }
    }
    if (selected != no_node) {
        try refresh(state)
        flow := try inline_block(state, selected)
        replacement := no_node
        if (value_source) {
            value :: try ast.add_block_expr(state.builder, ast.node_span(&state.tree, selected), selected)
            replacement = try ast.add_expression_stmt(state.builder, value)
            if (flow == .yielded) flow = .next
        } else replacement = try ast.add_block_stmt(state.builder, selected)
        try replace(state, id, replacement)
        try refresh(state)
        return flow
    }
    if (inline_has_transfer(state, id)) {
        state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
            .inline_loop_control, ast.node_span(&state.tree, id))
        return .invalid
    }
    try expand(state, id)
    return .next
}

@hide:file
inline_block proc(state @mut State, block ast.NodeId) TypeFlow ! Error {
    statements := arraylist.init(ast.NodeId, state.allocator)
    defer arraylist.deinit(&statements)
    flow := TypeFlow.next
    for (0..ast.block_statement_count(&state.tree, block)) |i| {
        statement :: ast.block_statement(&state.tree, block, i)
        if (!try type_control_step(state, statement)) return .invalid
        flow = try inline_statement(state, statement)
        if (flow == .invalid) return flow
        kind :: ast.stmt_kind(&state.tree, statement)
        if (kind != .break_stmt and kind != .continue_stmt) try arraylist.append(&statements, statement)
        if (flow != .next) break
    }
    replacement :: try ast.add_block(state.builder, ast.node_span(&state.tree, block), statements.items)
    try replace(state, block, replacement)
    try refresh(state)
    return flow
}

@hide:file
expand_inline_for proc(state @mut State, id ast.NodeId) void ! Error {
    state.demand_depth += 1
    defer state.demand_depth -= 1
    loop :: ast.for_stmt(&state.tree, id)
    begin_type_execution(state)
    defer state.type_execution_depth -= 1
    state.evaluation_diagnostic = diagnostics.no_diagnostic
    blocks := arraylist.init(ast.NodeId, state.allocator)
    defer arraylist.deinit(&blocks)
    execution := TypeExecution{
        locals = arraylist.init(state.allocator),
        mapping = try mem.alloc(ast.NodeId, state.allocator, ast.node_count(&state.tree)),
        first_owned = ast.NodeId(0), result_type = no_node,
        inline_body = loop.body, inline_blocks = &blocks,
    }
    defer type_execution_deinit(state, &execution)
    defer mem.free(state.allocator, execution.mapping)
    mem.set(execution.mapping, no_node)
    for (0..usize(2)) |i| {
        capture :: if (i == 0) loop.capture else loop.index
        if (capture) |node| {
            resolved :: binding(state, node)
            if (resolved.kind == .invalid) state.evaluation_diagnostic = resolved.data.diagnostic
        }
    }
    if (loop.pointer_capture)
        state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .comptime_value_escape, loop.span)
    flow := TypeFlow.invalid
    if (state.evaluation_diagnostic == diagnostics.no_diagnostic)
        flow = try execute_type_for(state, &execution, id)
    if ((flow != .next and flow != .yielded and flow != .returned)
        or state.evaluation_diagnostic != diagnostics.no_diagnostic) {
        if (state.evaluation_diagnostic == diagnostics.no_diagnostic)
            state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .comptime_argument_required, loop.span)
        invalid :: try ast.add_invalid_stmt(state.builder, loop.span, state.evaluation_diagnostic)
        try replace(state, id, invalid)
        try refresh(state)
        return
    }
    statements := arraylist.init(ast.NodeId, state.allocator)
    defer arraylist.deinit(&statements)
    for (blocks.items) |block| {
        statement :: try ast.add_block_stmt(state.builder, block)
        try arraylist.append(&statements, statement)
    }
    block :: try ast.add_block(state.builder, loop.span, statements.items)
    replacement :: try ast.add_block_stmt(state.builder, block)
    try replace(state, id, replacement)
    try refresh(state)
}

# select with ordinary checked IR so patterns, overlap and exhaustiveness have
# the same rules as runtime matching, without checking unexecuted type bodies.
@hide:file
type_match_arm proc(state @mut State, id ast.NodeId) usize ! Error {
    try expand_inline_match(state, id, no_node)
    if (ast.expr_kind(&state.tree, id) != .match_expr) return no_index
    optional_capture :: ast.match_expr(&state.tree, id).optional_capture
    if (!try expand_type_matches(state, ast.match_expr(&state.tree, id).subject)) return no_index
    try expand(state, ast.match_expr(&state.tree, id).subject)
    arms := arraylist.init(ast.NodeId, state.allocator)
    defer arraylist.deinit(&arms)
    patterns := arraylist.init(ast.NodeId, state.allocator)
    defer arraylist.deinit(&patterns)
    subject :: ast.match_expr(&state.tree, id).subject
    annotation :: try expression_type(state, subject, 0)
    metadata :: type_record_storage(state, annotation, 0)
    dispatch := subject
    if (metadata) {
        value :: try evaluate_expected(state, subject, annotation)
        if (value.kind != .aggregate) return no_index
        span :: ast.node_span(&state.tree, subject)
        if (ast.expr_kind(&state.tree, annotation) == .optional_type) {
            present :: ast.expr_kind(&state.tree, value.node) != .literal_null
            boolean :: try ast.add_boolean(state.builder, span, true)
            payload :: if (present) boolean else try ast.add_literal(state.builder, .null, span)
            optional :: try ast.add_optional_type(state.builder, span, try builtin(state, subject, .bool))
            dispatch = try ast.add_typed_constant(state.builder, span, optional, payload)
        } else {
            if (ast.expr_kind(&state.tree, value.node) != .record_literal) return no_index
            active :: ast.field(&state.tree, ast.record_field(&state.tree, value.node, 0))
            tags :: try metadata_variant_tags(state, try inline_match_shape(state, annotation))
            tag :: try ast.add_enum_literal(state.builder, span, active.name?)
            dispatch = try ast.add_typed_constant(state.builder, span, tags, tag)
        }
        try refresh(state)
    }
    for (0..ast.match_arm_count(&state.tree, id)) |i| {
        arm_id :: ast.match_arm(&state.tree, id, i)
        arm :: ast.match_arm_view(&state.tree, arm_id)
        # selector bodies omit source capture uses, but must retain their resolver failures.
        if (arm.capture) |capture| {
            resolved :: binding(state, capture)
            if (resolved.kind == .invalid) {
                state.evaluation_diagnostic = resolved.data.diagnostic
                return no_index
            }
        }
        patterns.items = patterns.items[..0]
        for (0..ast.match_pattern_count(&state.tree, arm_id)) |j| {
            pattern :: ast.match_pattern(&state.tree, arm_id, j)
            if (!try expand_type_matches(state, pattern)) return no_index
            try expand(state, pattern)
            try arraylist.append(&patterns, pattern)
        }
        if (metadata and !optional_capture and arm.capture != null) {
            expected := no_node
            valid := !arm.catch_all and patterns.items.len > 0
            for (patterns.items) |pattern| {
                if (ast.expr_kind(&state.tree, pattern) != .enum_literal) {
                    valid = false
                    continue
                }
                shape :: try inline_match_shape(state, annotation)
                slot :: type_record_slot(&state.tree, shape, ast.enum_literal(&state.tree, pattern))
                if (slot == no_index) {
                    valid = false
                    continue
                }
                payload :: ast.field(&state.tree, ast.record_field(&state.tree, shape, slot)).type?
                if (binding(state, payload).kind == .builtin and binding(state, payload).data.builtin == .void)
                    valid = false
                if (expected != no_node and !try same_type(state, expected, payload)) valid = false
                expected = payload
            }
            if (!valid) {
                state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
                    .invalid_match_capture, ast.node_span(&state.tree, arm_id))
                return no_index
            }
        }
        span :: ast.node_span(&state.tree, arm_id)
        index :: try ast.add_integer(state.builder, span, u64(i))
        capture :: if (metadata) null else arm.capture
        selector :: try ast.add_match_arm(state.builder, span, patterns.items,
            capture, index, true, arm.catch_all)
        try refresh(state)
        try arraylist.append(&arms, selector)
    }
    selector :: try ast.add_match(state.builder, ast.node_span(&state.tree, id),
        dispatch, arms.items)
    if (optional_capture)
        ast.set_match_optional(state.builder, selector)
    try refresh(state)
    # selector arms contain only indices. do not specialize this synthetic match
    # again while its checked evaluation expands the wrapper.
    state.expanded.items[usize(selector)] = 1
    selected :: try evaluate_ir(state, selector, try builtin(state, id, .usize))
    if (selected.kind != .integer) return no_index
    return usize(selected.magnitude)
}

# match checking has already validated every capture. copy the active payload
# out of owned constant storage, never an address in the temporary interpreter.
@hide:file
type_match_capture proc(state @mut State, id ast.NodeId) ast.NodeId ! Error {
    subject :: ast.match_expr(&state.tree, id).subject
    if (ast.match_expr(&state.tree, id).optional_capture) {
        unwrapped :: try ast.add_unary(state.builder,
            ast.node_span(&state.tree, subject), .unwrap, subject)
        try refresh(state)
        child :: try expression_type(state, unwrapped, 0)
        payload :: try type_execution_value(state, unwrapped, child)
        if (payload == no_node or !is_type(state, child)) return payload
        result :: try ast.add_typed_constant(state.builder, ast.node_span(&state.tree, subject), child, payload)
        try refresh(state)
        return result
    }
    annotation :: try expression_type(state, subject, 0)
    value :: if (type_record_storage(state, annotation, 0))
        try evaluate_expected(state, subject, annotation) else try evaluate_ir(state, subject, annotation)
    if (value.kind != .aggregate or ast.expr_kind(&state.tree, value.node) != .record_literal) return no_node
    payload :: ast.field(&state.tree, ast.record_field(&state.tree, value.node, 0))
    shape :: try inline_match_shape(state, annotation)
    if (shape == no_node) return no_node
    for (0..ast.record_field_count(&state.tree, shape)) |i| {
        field :: ast.field(&state.tree, ast.record_field(&state.tree, shape, i))
        if (
            field.name != null and payload.name != null
            and ast.name_id(&state.tree, field.name?) == ast.name_id(&state.tree, payload.name?)
        ) {
            if (
                ast.expr_kind(&state.tree, payload.value?) == .typed_constant
                and try same_type(state, field.type?, ast.typed_constant(&state.tree, payload.value?).type)
            ) return payload.value?
            result :: try ast.add_typed_constant(state.builder,
                ast.node_span(&state.tree, subject), field.type?, payload.value?)
            try refresh(state)
            return result
        }
    }
    return no_node
}

@hide:file
type_match_body proc(state @mut State, id ast.NodeId, arm ast.MatchArmView) ast.NodeId ! Error {
    if (arm.capture == null) return arm.body
    value :: try type_match_capture(state, id)
    if (value == no_node) return no_node
    snapshot :: ast.typed_constant(&state.tree, value)
    execution := TypeExecution{
        locals = arraylist.init(state.allocator),
        mapping = try mem.alloc(ast.NodeId, state.allocator, ast.node_count(&state.tree)),
        first_owned = ast.NodeId(0),
        result_type = no_node,
    }
    defer type_execution_deinit(state, &execution)
    defer mem.free(state.allocator, execution.mapping)
    mem.set(execution.mapping, no_node)
    captured :: if (is_type(state, snapshot.type)) snapshot.value else value
    try arraylist.append(&execution.locals, TypeLocal{
        declaration = arm.capture?, value = captured,
        annotation = snapshot.type,
    })
    return try type_snapshot(state, &execution, arm.body)
}

@hide:file
type_value_expression proc(state @mut State, input ast.NodeId) ast.NodeId ! Error {
    if (input == no_node) return no_node
    expression := input
    while (ast.expr_kind(&state.tree, expression) == .match_expr) {
        if (!try type_step(state, expression)) return no_node
        index :: try type_match_arm(state, expression)
        if (index == no_index) return no_node
        arm :: ast.match_arm_view(&state.tree, ast.match_arm(&state.tree, expression, index))
        expression = try type_match_body(state, expression, arm)
        if (!arm.expression and expression != no_node) {
            expression = try ast.add_block_expr(state.builder, ast.node_span(&state.tree, expression), expression)
            try refresh(state)
        }
        if (expression == no_node) return no_node
    }
    if (expression != no_node and ast.expr_kind(&state.tree, expression) == .block_expr) {
        annotation :: try value_block_type(state, ast.block_expr(&state.tree, expression), 0)
        if (annotation != no_node and (is_type(state, annotation) or type_record_storage(state, annotation, 0)))
            return try evaluate_type_value_block(state, expression, annotation)
    }
    return expression
}

# normalize selected value sources before ordinary expansion can visit their bodies.
# nominal results enter here after their instance declaration is cached.
@hide:file
expand_type_matches proc(state @mut State, id ast.NodeId) bool ! Error {
    if (id == no_node) return false
    if (ast.node_class(&state.tree, id) == .expression and ast.expr_kind(&state.tree, id) == .binary) {
        view :: ast.binary_expr(&state.tree, id)
        if (view.operator == .logical_and or view.operator == .logical_or) {
            if (!try expand_type_matches(state, view.left)) return false
            saved_demand :: state.demand_depth
            defer state.demand_depth = saved_demand
            if (state.demand_depth > 0 and branch_constant(state, view.left, 0)) {
                value :: try evaluate_ir(state, view.left, try builtin(state, id, .bool))
                if (value.kind == .boolean and value.boolean == (view.operator == .logical_or))
                    state.demand_depth = 0
            }
            return try expand_type_matches(state, view.right)
        }
    }
    if (ast.node_class(&state.tree, id) == .expression and ast.expr_kind(&state.tree, id) == .match_expr) {
        selected :: try type_value_expression(state, id)
        if (selected == no_node) return false
        resolved :: binding(state, selected)
        try remember(state, id)
        ast.replace_node_from_source(state.builder, id, selected)
        try refresh(state)
        state.bindings.items[usize(id)] = resolved
    }
    for (0..ast.child_count(&state.tree, id)) |i| {
        if (!try expand_type_matches(state, ast.child(&state.tree, id, i))) return false
    }
    return try type_array_projection(state, id)
}

@hide:file
type_array_projection proc(state @mut State, id ast.NodeId) bool ! Error {
    if (ast.node_class(&state.tree, id) != .expression) return true
    kind :: ast.expr_kind(&state.tree, id)
    if (kind == .binary and metadata_has_view(state, id))
        return try metadata_pointer_binary(state, id)
    if (kind == .unary and ast.unary_expr(&state.tree, id).operator == .dereference) {
        operand :: ast.unary_expr(&state.tree, id).operand
        if (metadata_view_index(state, operand) == no_index) return true
        value :: try metadata_pointer_read(state, operand, no_node, id)
        if (value == no_node) return false
        resolved :: binding(state, value)
        try remember(state, id)
        ast.replace_node_from_source(state.builder, id, value)
        try refresh(state)
        state.bindings.items[usize(id)] = resolved
        return true
    }
    if (kind == .slice) {
        annotation :: try expression_type(state, id, 0)
        if (!try metadata_sequence(state, annotation)) return true
        value :: try type_slice_value(state, id, annotation)
        if (value == no_node) return false
        try replace(state, id, value)
        try refresh(state)
        return true
    }
    if (kind == .unary and ast.unary_expr(&state.tree, id).operator == .unwrap) {
        operand :: ast.unary_expr(&state.tree, id).operand
        annotation :: try expression_type(state, operand, 0)
        if (!type_record_storage(state, annotation, 0)) return true
        type :: try canonical_type(state, annotation)
        if (type == no_node or ast.expr_kind(&state.tree, type) != .optional_type) return true
        value :: try type_execution_value(state, operand, type)
        if (value == no_node or !try type_array_initialized(state, value, id)) return false
        payload :: ast.typed_constant(&state.tree, value).value
        if (ast.expr_kind(&state.tree, payload) == .literal_null) {
            state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
                .null_unwrap, ast.node_span(&state.tree, id))
            return false
        }
        selected :: ast.call_arg(&state.tree, payload, 0)
        resolved :: binding(state, selected)
        try remember(state, id)
        ast.replace_node_from_source(state.builder, id, selected)
        try refresh(state)
        state.bindings.items[usize(id)] = resolved
        return true
    }
    if (kind == .index or kind == .selection) {
        base :: if (kind == .index) ast.index_expr(&state.tree, id).base else ast.selection_expr(&state.tree, id).base
        base_binding :: binding(state, base)
        if (base_binding.kind == .invalid) {
            state.evaluation_diagnostic = base_binding.data.diagnostic
            return false
        }
        if (ast.expr_kind(&state.tree, base) != .typed_constant) return true
        array := ast.typed_constant(&state.tree, base)
        if (state.demand_depth == 0 and !type_record_storage(state, array.type, 0)) return true
        if (metadata_view_index(state, base) != no_index
            and ast.expr_kind(&state.tree, try canonical_type(state, array.type)) == .pointer_type) {
            offset :: if (kind == .index) ast.index_expr(&state.tree, id).index else no_node
            value :: try metadata_pointer_read(state, base, offset, id)
            if (value == no_node) return false
            if (kind == .index) {
                resolved :: binding(state, value)
                try remember(state, id)
                ast.replace_node_from_source(state.builder, id, value)
                try refresh(state)
                state.bindings.items[usize(id)] = resolved
                return true
            }
            selected :: try ast.add_selection(state.builder, ast.node_span(&state.tree, id),
                value, ast.selection_expr(&state.tree, id).member)
            try refresh(state)
            if (!try type_array_projection(state, selected)) return false
            resolved :: binding(state, selected)
            try remember(state, id)
            ast.replace_node_from_source(state.builder, id, selected)
            try refresh(state)
            state.bindings.items[usize(id)] = resolved
            return true
        }
        if (metadata_view_index(state, base) != no_index) {
            snapshot :: try metadata_view_snapshot(state, base, id)
            if (snapshot == no_node) return false
            array = ast.typed_constant(&state.tree, snapshot)
        }
        type :: try canonical_type(state, array.type)
        record :: (type != no_node and (ast.expr_kind(&state.tree, type) == .record_type
            or (type_record_storage(state, type, 0) and ast.expr_kind(&state.tree, type) == .union_type)))
        if (
            !record and !try execution_array_storage(state, array.type)
            and !try metadata_sequence(state, array.type)
        ) return true
        if (
            (try metadata_sequence(state, array.type) or record)
            and ast.expr_kind(&state.tree, array.value) == .literal_undefined
        ) {
            state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
                .read_before_initialization, ast.node_span(&state.tree, id))
            return false
        }
        selected := no_node
        selected_type := no_node
        if (record) {
            if (kind != .selection) return true
            member :: ast.selection_expr(&state.tree, id).member
            slot :: type_record_slot(&state.tree, type, member)
            if (slot == no_index) {
                state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
                    .unknown_field, ast.node_span(&state.tree, member))
                return false
            }
            if (ast.expr_kind(&state.tree, type) == .union_type) {
                active :: ast.field(&state.tree, ast.record_field(&state.tree, array.value, 0))
                if (active.name == null or ast.name_id(&state.tree, active.name?) != ast.name_id(&state.tree, member)) {
                    state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
                        .inactive_union_field, ast.node_span(&state.tree, id))
                    return false
                }
                selected = active.value?
            } else selected = ast.field(&state.tree, ast.record_field(&state.tree, array.value, slot)).value?
            if (!type_record_storage(state, array.type, 0))
                selected_type = ast.field(&state.tree, ast.record_field(&state.tree, type, slot)).type?
        } else if (kind == .index) {
            index :: try type_array_index(state, ast.index_expr(&state.tree, id).index,
                ast.array_element_count(&state.tree, array.value), false)
            if (index == no_index) return false
            selected = ast.array_element(&state.tree, array.value, index)
            if (!type_record_storage(state, array.type, 0))
                selected_type = ast.array_type(&state.tree, type).element
        } else {
            member :: ast.selection_expr(&state.tree, id).member
            if (!type_record_storage(state, array.type, 0)
                and !mem.eql(ast.literal_text(&state.tree, member), "len")) return true
            if (!mem.eql(ast.literal_text(&state.tree, member), "len")) {
                state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
                    .unknown_field, ast.node_span(&state.tree, member))
                return false
            }
            count :: try ast.add_integer(state.builder, ast.node_span(&state.tree, id),
                u64(ast.array_element_count(&state.tree, array.value)))
            selected = try ast.add_typed_constant(state.builder, ast.node_span(&state.tree, id),
                try builtin(state, id, .usize), count)
            try refresh(state)
        }
        if (ast.expr_kind(&state.tree, selected) == .literal_undefined) {
            state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
                .read_before_initialization, ast.node_span(&state.tree, id))
            return false
        }
        if (selected_type != no_node and ast.expr_kind(&state.tree, selected) != .typed_constant) {
            selected = try ast.add_typed_constant(state.builder, ast.node_span(&state.tree, id),
                selected_type, selected)
            try refresh(state)
        }
        # copying a nominal definition into the projection would create a new
        # identity on every read. retain its original node behind a type alias.
        if (nominal_type_value(state, selected)) {
            selected = try ast.add_type_operand(state.builder, ast.node_span(&state.tree, id), selected, true)
            try refresh(state)
        }
        resolved :: binding(state, selected)
        try remember(state, id)
        ast.replace_node_from_source(state.builder, id, selected)
        try refresh(state)
        state.bindings.items[usize(id)] = resolved
    }
    return true
}

# type-control arrays are persistent AST snapshots, including uninitialized leaves.
# only fully initialized ordinary values may enter checked runtime IR.
@hide:file
execution_array_storage proc(state @mut State, annotation ast.NodeId) bool ! Error {
    current :: try canonical_type(state, annotation)
    return current != no_node and ast.expr_kind(&state.tree, current) == .array_type
}

@hide:file
metadata_sequence proc(state @mut State, annotation ast.NodeId) bool ! Error {
    type :: try canonical_type(state, annotation)
    return (type != no_node and ast.expr_kind(&state.tree, type) == .slice_type
        and type_record_storage(state, type, 0))
}

@hide:file
type_record_storage proc(state @State, annotation ast.NodeId, depth usize) bool {
    return type_storage_annotation(&state.tree, state.bindings.items, annotation, depth)
}

@hide:file
type_record_slot proc(tree @ast.Tree, record, member ast.NodeId) usize {
    if (ast.expr_kind(tree, member) != .literal_int) {
        for (0..ast.record_field_count(tree, record)) |i| {
            field :: ast.field(tree, ast.record_field(tree, record, i))
            if (field.name != null and ast.name_id(tree, field.name?) == ast.name_id(tree, member))
                return i
        }
        return no_index
    }
    ordinal := usize(0)
    for (ast.literal_text(tree, member)) |byte| {
        if (byte < '0' or byte > '9') return no_index
        digit :: usize(byte - '0')
        if (ordinal > divtrunc!(maxval!(usize) - digit, usize(10))) return no_index
        ordinal = ordinal * 10 + digit
    }
    if (ordinal >= ast.record_field_count(tree, record)) return no_index
    if (ast.field(tree, ast.record_field(tree, record, ordinal)).name != null) return no_index
    return ordinal
}

@hide:file
type_union_value proc(state @mut State, expression, type ast.NodeId) ast.NodeId ! Error {
    if (!try type_record_check(state, type)) return no_node
    if (ast.expr_kind(&state.tree, expression) == .literal_undefined) {
        result :: try ast.add_typed_constant(state.builder, ast.node_span(&state.tree, expression), type, expression)
        try refresh(state)
        return result
    }
    if (ast.expr_kind(&state.tree, expression) == .typed_constant) {
        value :: ast.typed_constant(&state.tree, expression)
        if (try same_type(state, type, value.type)) return expression
        state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
            .type_mismatch, ast.node_span(&state.tree, expression))
        return no_node
    }
    name := no_node
    input := no_node
    kind :: ast.expr_kind(&state.tree, expression)
    if (kind == .enum_literal) name = ast.enum_literal(&state.tree, expression)
    else if (kind == .record_literal) {
        literal :: ast.record_literal(&state.tree, expression)
        if (literal.type != null and ast.expr_kind(&state.tree, literal.type?) == .enum_literal) {
            name = ast.enum_literal(&state.tree, literal.type?)
            count :: ast.record_field_count(&state.tree, expression)
            if (count == 1 and ast.field(&state.tree, ast.record_field(&state.tree, expression, 0)).name == null) {
                input = ast.field(&state.tree, ast.record_field(&state.tree, expression, 0)).value?
            } else {
                fields := arraylist.init(ast.NodeId, state.allocator)
                defer arraylist.deinit(&fields)
                for (0..count) |i| try arraylist.append(&fields, ast.record_field(&state.tree, expression, i))
                input = try ast.add_record_literal(state.builder, ast.node_span(&state.tree, expression), null, fields.items)
                try refresh(state)
            }
        } else {
            if (literal.type != null and !try same_type(state, type, literal.type?)) {
                state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
                    .type_mismatch, ast.node_span(&state.tree, expression))
                return no_node
            }
            if (ast.record_field_count(&state.tree, expression) != 1) {
                state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
                    .union_initializer_count, ast.node_span(&state.tree, expression))
                return no_node
            }
            field :: ast.field(&state.tree, ast.record_field(&state.tree, expression, 0))
            if (field.name) |member| name = member
            if (field.value) |value| input = value
        }
    }
    slot :: if (name != no_node) type_record_slot(&state.tree, type, name) else no_index
    if (slot == no_index) {
        code diagnostics.Code :: if (name != no_node) .unknown_field else .union_initializer_count
        state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
            code, ast.node_span(&state.tree, expression))
        return no_node
    }
    field :: ast.field(&state.tree, ast.record_field(&state.tree, type, slot))
    payload_type :: try canonical_type(state, field.type?)
    empty :: (binding(state, payload_type).kind == .builtin
        and binding(state, payload_type).data.builtin == .void)
    span :: ast.node_span(&state.tree, expression)
    if (
        empty and kind == .record_literal
        and ast.record_literal(&state.tree, expression).type != null
        and ast.expr_kind(&state.tree, ast.record_literal(&state.tree, expression).type?) == .enum_literal
        and ast.record_field_count(&state.tree, expression) == 0
    ) input = no_node
    if (input == no_node and empty) input = try ast.add_literal(state.builder, .void, span)
    if (input == no_node) {
        state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .missing_field, span)
        return no_node
    }
    try refresh(state)
    value :: try type_execution_value(state, input, field.type?)
    if (value == no_node) return no_node
    member :: try ast.add_field(state.builder, span, field.name, null, value)
    fields [1]ast.NodeId :: [member]
    literal :: try ast.add_record_literal(state.builder, span, null, fields[..])
    result :: try ast.add_typed_constant(state.builder, span, type, literal)
    try refresh(state)
    return result
}

# keep ordinary field/default diagnostics even though the enclosing metadata record
# has no runtime layout. type leaves are checked here; value leaves use the checker.
@hide:file
type_record_check proc(state @mut State, annotation ast.NodeId) bool ! Error {
    if (is_type(state, annotation)) return true
    type :: try canonical_type(state, annotation)
    if (type == no_node) return false
    if (!type_record_storage(state, type, 0)) {
        constraint :: try ast.add_type_operand(state.builder, ast.node_span(&state.tree, type), type, true)
        try refresh(state)
        try arraylist.append(&state.rewrites.constraints, constraint)
        return true
    }
    if (ast.expr_kind(&state.tree, type) == .pointer_type)
        return try type_record_check(state, ast.pointer_type(&state.tree, type).element)
    if (ast.expr_kind(&state.tree, type) == .optional_type)
        return try type_record_check(state, ast.type_operand(&state.tree, type))
    if (ast.expr_kind(&state.tree, type) == .fallible_type) {
        channels :: ast.binary_expr(&state.tree, type)
        error_type :: try canonical_type(state, channels.right)
        if (error_type == no_node) return false
        kind :: ast.expr_kind(&state.tree, error_type)
        if (kind != .enum_type and kind != .record_type and kind != .union_type and kind != .sum_type) {
            state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
                .invalid_fallible_type, ast.node_span(&state.tree, type))
            return false
        }
        if (!type_record_storage(state, error_type, 0)) {
            checked :: try ast.add_binary_type(state.builder, ast.node_span(&state.tree, type),
                try builtin(state, type, .void), error_type, true)
            constraint :: try ast.add_type_operand(state.builder, ast.node_span(&state.tree, type), checked, true)
            try refresh(state)
            try arraylist.append(&state.rewrites.constraints, constraint)
        } else if (kind == .union_type and !ast.union_type(&state.tree, error_type).auto_tag
            and ast.union_type(&state.tree, error_type).tag == null) {
            state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
                .invalid_fallible_type, ast.node_span(&state.tree, type))
            return false
        }
        if (!try type_record_check(state, channels.left)) return false
        return try type_record_check(state, channels.right)
    }
    if (ast.expr_kind(&state.tree, type) == .sum_type) {
        members :: ast.binary_expr(&state.tree, type)
        if (!try type_record_check(state, members.left) or !try type_record_check(state, members.right)) return false
        if (try inline_match_shape(state, type) != no_node) return true
        if (state.evaluation_diagnostic == diagnostics.no_diagnostic)
            state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
                .invalid_sum_type, ast.node_span(&state.tree, type))
        return false
    }
    if (ast.expr_kind(&state.tree, type) == .slice_type) {
        descriptor :: ast.slice_type(&state.tree, type)
        if (descriptor.sentinel != null) {
            code diagnostics.Code :: .invalid_operand
            state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, code, ast.node_span(&state.tree, type))
            return false
        }
        return try type_record_check(state, descriptor.element)
    }
    if (ast.expr_kind(&state.tree, type) == .array_type) {
        if (!try type_step(state, type)) return false
        descriptor :: ast.array_type(&state.tree, type)
        if (descriptor.count) |count| {
            value :: try evaluate(state, count)
            if (value.kind != .integer or value.negative) {
                state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
                    .invalid_array_length, ast.node_span(&state.tree, count))
                return false
            }
        }
        return try type_record_check(state, descriptor.element)
    }
    tagged :: ast.expr_kind(&state.tree, type) == .union_type
    tag := no_node
    if (tagged) {
        descriptor :: ast.union_type(&state.tree, type)
        if (!descriptor.auto_tag and descriptor.tag == null) {
            state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
                .invalid_record_field_type, ast.node_span(&state.tree, type))
            return false
        }
        if (descriptor.tag) |tag_annotation| {
            tag = try canonical_type(state, tag_annotation)
            if (tag == no_node or ast.expr_kind(&state.tree, tag) != .enum_type) {
                state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
                    .invalid_union_tag, ast.node_span(&state.tree, tag_annotation))
                return false
            }
            if (!try type_record_check(state, tag)) return false
        }
    }
    for (0..ast.record_field_count(&state.tree, type)) |i| {
        field_id :: ast.record_field(&state.tree, type, i)
        field :: ast.field(&state.tree, field_id)
        if (!try type_step(state, field_id)) return false
        if (tagged) {
            if (field.type == null or field.value != null) {
                state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .invalid_record_field_type, field.span)
                return false
            }
            if (field.name == null) {
                state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .duplicate_field, field.span)
                return false
            }
            if (tag != no_node) {
                found := false
                for (0..ast.enum_member_count(&state.tree, tag)) |j| {
                    member :: ast.field(&state.tree, ast.enum_member(&state.tree, tag, j))
                    if (member.name != null and ast.name_id(&state.tree, member.name?) == ast.name_id(&state.tree, field.name?)) {
                        found = true
                        break
                    }
                }
                if (!found) {
                    state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .invalid_union_tag, field.span)
                    return false
                }
            }
        }
        if (field.name != null and type_record_slot(&state.tree, type, field.name?) != i) {
            state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .duplicate_field, field.span)
            return false
        }
        if (ast.expr_kind(&state.tree, type) == .union_type) {
            payload :: try canonical_type(state, field.type?)
            if (
                payload != no_node and binding(state, payload).kind == .builtin
                and binding(state, payload).data.builtin == .void
            ) continue
        }
        if (type_record_storage(state, field.type?, 0)) {
            if (!try type_record_check(state, field.type?)) return false
            if (field.value != null and try type_execution_value(state, field.value?, field.type?) == no_node) return false
        } else {
            fields [1]ast.NodeId :: [field_id]
            record :: try ast.add_record_type(state.builder, field.span, fields[..])
            constraint :: try ast.add_type_operand(state.builder, field.span, record, true)
            try refresh(state)
            try arraylist.append(&state.rewrites.constraints, constraint)
            if (field.value != null and try type_execution_value(state, field.value?, field.type?) == no_node) return false
        }
    }
    return true
}

# normalize record snapshots in declaration order through their declared context.
# undefined records retain per-leaf initialization state without applying defaults.
@hide:file
type_record_value proc(state @mut State, expression, annotation ast.NodeId) ast.NodeId ! Error {
    type :: try canonical_type(state, annotation)
    if (ast.expr_kind(&state.tree, type) == .union_type)
        return try type_union_value(state, expression, type)
    if (ast.expr_kind(&state.tree, expression) == .literal_undefined)
        return try type_storage_undefined(state, expression, annotation)
    if (ast.expr_kind(&state.tree, expression) == .typed_constant) {
        actual :: ast.typed_constant(&state.tree, expression)
        if (try same_type(state, type, actual.type)) return expression
    } else if (ast.expr_kind(&state.tree, expression) == .record_literal) {
        if (!try type_record_check(state, type)) return no_node
        literal :: ast.record_literal(&state.tree, expression)
        if (literal.type != null and !try same_type(state, type, literal.type?)) {
            state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
                .type_mismatch, ast.node_span(&state.tree, expression))
            return no_node
        }
        count :: ast.record_field_count(&state.tree, type)
        values :: try mem.alloc(ast.NodeId, state.allocator, count)
        defer mem.free(state.allocator, values)
        mem.set(values, no_node)
        for (0..ast.record_field_count(&state.tree, expression)) |i| {
            field :: ast.field(&state.tree, ast.record_field(&state.tree, expression, i))
            slot := i
            if (field.name) |name| slot = type_record_slot(&state.tree, type, name)
            if (slot >= count or values[slot] != no_node) {
                code :: if (slot < count) diagnostics.Code.duplicate_field
                    else if (field.name != null) diagnostics.Code.unknown_field else diagnostics.Code.tuple_arity_mismatch
                state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, code, field.span)
                return no_node
            }
            values[slot] = field.value?
        }
        fields := arraylist.init(ast.NodeId, state.allocator)
        defer arraylist.deinit(&fields)
        for (0..count) |i| {
            field :: ast.field(&state.tree, ast.record_field(&state.tree, type, i))
            if (field.name) |name| {
                if (type_record_slot(&state.tree, type, name) != i) {
                    state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .duplicate_field, field.span)
                    return no_node
                }
            }
            input := values[i]
            if (input == no_node and field.value != null) input = field.value?
            if (input == no_node) {
                code :: if (field.name == null) diagnostics.Code.tuple_arity_mismatch else diagnostics.Code.missing_field
                state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, code, ast.node_span(&state.tree, expression))
                return no_node
            }
            if (!try type_step(state, input)) return no_node
            value :: try type_execution_value(state, input, field.type?)
            if (value == no_node) return no_node
            generated :: try ast.add_field(state.builder, field.span, field.name, null, value)
            try refresh(state)
            try arraylist.append(&fields, generated)
        }
        span :: ast.node_span(&state.tree, expression)
        normalized :: try ast.add_record_literal(state.builder, span, null, fields.items)
        result :: try ast.add_typed_constant(state.builder, span, type, normalized)
        try refresh(state)
        return result
    }
    state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
        .type_mismatch, ast.node_span(&state.tree, expression))
    return no_node
}

@hide:file
type_array_index proc(state @mut State, expression ast.NodeId, count usize, boundary bool) usize ! Error {
    usize_type :: try builtin(state, expression, .usize)
    actual :: try expression_type(state, expression, 0)
    if (!flexible(state, expression) and (actual == no_node or !try same_type(state, actual, usize_type))) {
        state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
            .invalid_index_type, ast.node_span(&state.tree, expression))
        return no_index
    }
    value :: try evaluate_ir(state, expression, usize_type)
    if (value.kind != .integer) return no_index
    if (value.magnitude > u64(count) or (!boundary and value.magnitude == u64(count))) {
        code diagnostics.Code :: if (boundary) .invalid_slice_bounds else .index_out_of_bounds
        state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, code, ast.node_span(&state.tree, expression))
        return no_index
    }
    return usize(value.magnitude)
}

@hide:file
type_array_compatible proc(state @mut State, expected, actual ast.NodeId) bool ! Error {
    if (is_type(state, expected) or is_type(state, actual))
        return is_type(state, expected) and is_type(state, actual)
    left :: try canonical_type(state, expected)
    right :: try canonical_type(state, actual)
    if (left == no_node or right == no_node) return false
    if (ast.expr_kind(&state.tree, left) != .array_type or ast.expr_kind(&state.tree, right) != .array_type)
        return try same_type(state, left, right)
    a :: ast.array_type(&state.tree, left)
    b :: ast.array_type(&state.tree, right)
    if (a.mutable != b.mutable or b.count == null) return false
    if (a.count) |count| {
        if (!try value_equal(state, try evaluate(state, count), try evaluate(state, b.count?))) return false
    }
    return try type_array_compatible(state, a.element, b.element)
}

# undefined leaves are initialization state, not type values. snapshots may copy
# that state locally; procedure boundaries require every leaf to be initialized.
@hide:file
type_array_initialized proc(state @mut State, value, at ast.NodeId) bool ! Error {
    kind :: ast.expr_kind(&state.tree, value)
    if (kind == .literal_undefined) {
        state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
            .read_before_initialization, ast.node_span(&state.tree, at))
        return false
    }
    if (kind == .typed_constant)
        return try type_array_initialized(state, ast.typed_constant(&state.tree, value).value, at)
    if (kind == .builtin_call and contextual_literal(state, value))
        return try type_array_initialized(state, ast.call_arg(&state.tree, value, 0), at)
    if (kind == .array_literal) {
        for (0..ast.array_element_count(&state.tree, value)) |i| {
            if (!try type_array_initialized(state, ast.array_element(&state.tree, value, i), at)) return false
        }
    }
    if (kind == .record_literal) {
        for (0..ast.record_field_count(&state.tree, value)) |i| {
            field :: ast.field(&state.tree, ast.record_field(&state.tree, value, i))
            if (field.value != null and !try type_array_initialized(state, field.value?, at)) return false
        }
    }
    return true
}

# bound the expanded snapshot, not just its dimensions, so later reads and
# initialization checks cannot traverse an exponentially shared empty shape.
@hide:file
type_storage_undefined proc(state @mut State, expression, annotation ast.NodeId) ast.NodeId ! Error {
    if (is_type(state, annotation)) return expression
    type :: try canonical_type(state, annotation)
    if (
        type != no_node and ast.expr_kind(&state.tree, type) == .union_type
        and type_record_storage(state, type, 0)
    ) {
        if (!try type_record_check(state, type)) return no_node
        result :: try ast.add_typed_constant(state.builder, ast.node_span(&state.tree, expression), type, expression)
        try refresh(state)
        return result
    }
    if (type != no_node and ast.expr_kind(&state.tree, type) == .record_type) {
        if (!try type_record_check(state, type)) return no_node
        fields := arraylist.init(ast.NodeId, state.allocator)
        defer arraylist.deinit(&fields)
        for (0..ast.record_field_count(&state.tree, type)) |i| {
            field :: ast.field(&state.tree, ast.record_field(&state.tree, type, i))
            if (!try type_step(state, expression)) return no_node
            value :: try type_storage_undefined(state, expression, field.type?)
            if (value == no_node) return no_node
            generated :: try ast.add_field(state.builder, field.span, field.name, null, value)
            try refresh(state)
            try arraylist.append(&fields, generated)
        }
        span :: ast.node_span(&state.tree, expression)
        literal :: try ast.add_record_literal(state.builder, span, null, fields.items)
        result :: try ast.add_typed_constant(state.builder, span, type, literal)
        try refresh(state)
        return result
    }
    if (type == no_node or ast.expr_kind(&state.tree, type) != .array_type) return expression
    descriptor :: ast.array_type(&state.tree, type)
    length := Value{}
    if (descriptor.count) |count| length = try evaluate(state, count)
    if (length.kind != .integer or length.negative) {
        state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
            .invalid_array_length, ast.node_span(&state.tree, annotation))
        return no_node
    }
    # validate child dimensions even when this dimension is empty.
    child :: try type_storage_undefined(state, expression, descriptor.element)
    if (child == no_node) return no_node
    elements := arraylist.init(ast.NodeId, state.allocator)
    defer arraylist.deinit(&elements)
    for (0..length.magnitude) |i| {
        if (!try type_step(state, expression)) return no_node
        element := child
        if (i != 0) element = try type_storage_undefined(state, expression, descriptor.element)
        if (element == no_node) return no_node
        try arraylist.append(&elements, element)
    }
    span :: ast.node_span(&state.tree, expression)
    type_span :: ast.node_span(&state.tree, annotation)
    element_type :: if (ast.expr_kind(&state.tree, child) == .typed_constant)
        ast.typed_constant(&state.tree, child).type else descriptor.element
    count :: try ast.add_integer(state.builder, span, length.magnitude)
    concrete :: try ast.add_array_type(state.builder, type_span, count, element_type, descriptor.mutable)
    literal :: try ast.add_array_literal(state.builder, span, elements.items)
    result :: try ast.add_typed_constant(state.builder, span, concrete, literal)
    try refresh(state)
    return result
}

@hide:file
type_array_value proc(state @mut State, expression, annotation ast.NodeId) ast.NodeId ! Error {
    if (ast.expr_kind(&state.tree, expression) == .literal_undefined)
        return try type_storage_undefined(state, expression, annotation)
    type :: try canonical_type(state, annotation)
    array :: ast.array_type(&state.tree, type)
    if (ast.expr_kind(&state.tree, expression) == .typed_constant) {
        actual :: ast.typed_constant(&state.tree, expression)
        if (try type_array_compatible(state, type, actual.type)) return expression
        if (!try type_array_initialized(state, expression, expression)) return no_node
    } else if (ast.expr_kind(&state.tree, expression) == .array_literal) {
        count :: ast.array_element_count(&state.tree, expression)
        if (array.count) |length| {
            value :: try evaluate(state, length)
            if (value.kind != .integer or value.negative) {
                state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
                    .invalid_array_length, ast.node_span(&state.tree, length))
                return no_node
            }
            if (value.magnitude != u64(count)) {
                state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
                    .array_length_mismatch, ast.node_span(&state.tree, expression))
                return no_node
            }
        }
        elements := arraylist.init(ast.NodeId, state.allocator)
        defer arraylist.deinit(&elements)
        element_type := array.element
        for (0..count) |i| {
            element :: try type_execution_value(state,
                ast.array_element(&state.tree, expression, i), element_type)
            if (element == no_node) return no_node
            if (ast.expr_kind(&state.tree, element) == .typed_constant)
                element_type = ast.typed_constant(&state.tree, element).type
            try arraylist.append(&elements, element)
        }
        # empty outer arrays still need concrete, valid child dimensions.
        if (count == 0) {
            child := element_type
            while (!is_type(state, child)) {
                child = try canonical_type(state, child)
                if (child == no_node or ast.expr_kind(&state.tree, child) != .array_type) break
                descriptor :: ast.array_type(&state.tree, child)
                value := Value{}
                if (descriptor.count) |length| value = try evaluate(state, length)
                if (value.kind != .integer or value.negative) {
                    state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
                        .invalid_array_length, ast.node_span(&state.tree, child))
                    return no_node
                }
                child = descriptor.element
            }
            if (type_record_storage(state, child, 0) and !try type_record_check(state, child)) return no_node
        }
        span :: ast.node_span(&state.tree, expression)
        length :: try ast.add_integer(state.builder, span, u64(count))
        concrete :: try ast.add_array_type(state.builder, ast.node_span(&state.tree, annotation),
            length, element_type, array.mutable)
        literal :: try ast.add_array_literal(state.builder, span, elements.items)
        result :: try ast.add_typed_constant(state.builder, span, concrete, literal)
        try refresh(state)
        return result
    }
    if (type_record_storage(state, annotation, 0)) {
        state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
            .type_mismatch, ast.node_span(&state.tree, expression))
        return no_node
    }
    value :: try evaluate_ir(state, expression, annotation)
    if (value.kind == .invalid) return no_node
    result :: try ast.add_typed_constant(state.builder, ast.node_span(&state.tree, expression), annotation, value.node)
    try refresh(state)
    return result
}

# local handles retain borrowing; owned readonly literals cross execution boundaries.
@hide:file
type_slice_value proc(state @mut State, expression, annotation ast.NodeId) ast.NodeId ! Error {
    begin_type_execution(state)
    defer state.type_execution_depth -= 1
    type :: try canonical_type(state, annotation)
    if (!try type_record_check(state, type)) return no_node
    descriptor :: ast.slice_type(&state.tree, type)
    span :: ast.node_span(&state.tree, expression)
    kind :: ast.expr_kind(&state.tree, expression)
    if (kind == .literal_undefined) {
        result :: try ast.add_typed_constant(state.builder, span, type, expression)
        try refresh(state)
        return result
    }
    if (kind == .typed_constant) {
        actual :: ast.typed_constant(&state.tree, expression)
        if (try same_type(state, type, actual.type)) return expression
        index :: metadata_view_index(state, expression)
        if (index != no_index) {
            actual_type :: try canonical_type(state, actual.type)
            if (ast.expr_kind(&state.tree, actual_type) == .slice_type) {
                source :: ast.slice_type(&state.tree, actual_type)
                if ((!descriptor.mutable or source.mutable)
                    and try same_type(state, descriptor.element, source.element)) {
                    result :: try ast.add_typed_constant(state.builder, span, type, actual.value)
                    try refresh(state)
                    return result
                }
            }
            state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .type_mismatch, span)
            return no_node
        }
    }
    source := expression
    if (descriptor.mutable) {
        state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .comptime_value_escape, span)
        return no_node
    }
    start := usize(0)
    end := no_index
    if (kind == .slice) {
        view :: ast.slice_expr(&state.tree, expression)
        if (view.sentinel != null) {
            state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .invalid_operand, span)
            return no_node
        }
        source = view.base
    }
    if (ast.expr_kind(&state.tree, source) == .array_literal) {
        for (0..ast.array_element_count(&state.tree, source)) |_| {
            if (!try type_step(state, expression)) return no_node
        }
        length :: try ast.add_integer(state.builder, span, u64(ast.array_element_count(&state.tree, source)))
        array :: try ast.add_array_type(state.builder, span, length, descriptor.element, false)
        try refresh(state)
        source = try type_array_value(state, source, array)
    } else {
        actual :: try expression_type(state, source, 0)
        if (actual == no_node) return no_node
        actual_kind :: ast.expr_kind(&state.tree, actual)
        if ((actual_kind != .array_type and actual_kind != .slice_type)
            or (actual_kind == .array_type and kind != .slice)) {
            state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .type_mismatch, span)
            return no_node
        }
        mutable :: if (actual_kind == .array_type) ast.array_type(&state.tree, actual).mutable
            else ast.slice_type(&state.tree, actual).mutable
        element :: if (actual_kind == .array_type) ast.array_type(&state.tree, actual).element
            else ast.slice_type(&state.tree, actual).element
        if (mutable) {
            state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .comptime_value_escape, span)
            return no_node
        }
        if (!try same_type(state, descriptor.element, element)) {
            state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .type_mismatch, span)
            return no_node
        }
        source = try type_execution_value(state, source, actual)
    }
    if (source == no_node) return no_node
    values :: ast.typed_constant(&state.tree, source).value
    if (ast.expr_kind(&state.tree, values) == .literal_undefined) {
        state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .read_before_initialization, span)
        return no_node
    }
    count :: ast.array_element_count(&state.tree, values)
    end = count
    if (kind == .slice) {
        view :: ast.slice_expr(&state.tree, expression)
        if (view.start) |bound| start = try type_array_index(state, bound, count, true)
        if (start == no_index) return no_node
        if (view.end) |bound| end = try type_array_index(state, bound, count, true)
        if (end == no_index) return no_node
        if (start > end) {
            state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .invalid_slice_bounds, span)
            return no_node
        }
    }
    elements := arraylist.init(ast.NodeId, state.allocator)
    defer arraylist.deinit(&elements)
    for (start..end) |i| {
        if (!try type_step(state, expression)) return no_node
        try arraylist.append(&elements, ast.array_element(&state.tree, values, i))
    }
    literal :: try ast.add_array_literal(state.builder, span, elements.items)
    result :: try ast.add_typed_constant(state.builder, span, type, literal)
    try refresh(state)
    return result
}

# rebuild only the field/index path so previous snapshots retain their owned values.
@hide:file
type_array_update proc(
    state @mut State, execution @mut TypeExecution, target, root, current, input ast.NodeId,
) ast.NodeId ! Error {
    # find the outermost projection; rebuild its child before copying this parent.
    first := target
    while (true) {
        kind :: ast.expr_kind(&state.tree, first)
        if (kind != .index and kind != .selection) {
            state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
                .invalid_assignment_target, ast.node_span(&state.tree, target))
            return no_node
        }
        base :: if (kind == .index) ast.index_expr(&state.tree, first).base
            else ast.selection_expr(&state.tree, first).base
        if (base == root) break
        first = base
    }
    array :: ast.typed_constant(&state.tree, current)
    type :: try canonical_type(state, array.type)
    if (
        type == no_node
        or (ast.expr_kind(&state.tree, type) != .record_type and ast.expr_kind(&state.tree, type) != .array_type
            and (ast.expr_kind(&state.tree, type) != .union_type or !type_record_storage(state, type, 0)))
    ) {
        state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
            .invalid_index_assignment, ast.node_span(&state.tree, target))
        return no_node
    }
    tagged :: ast.expr_kind(&state.tree, type) == .union_type
    record :: ast.expr_kind(&state.tree, type) == .record_type or tagged
    if (tagged and ast.expr_kind(&state.tree, array.value) == .literal_undefined) {
        state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
            .read_before_initialization, ast.node_span(&state.tree, target))
        return no_node
    }
    index := no_index
    element_type := no_node
    count := usize(0)
    previous := no_node
    if (record) {
        if (ast.expr_kind(&state.tree, first) == .selection)
            index = type_record_slot(&state.tree, type, ast.selection_expr(&state.tree, first).member)
        if (index == no_index) {
            state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
                .unknown_field, ast.node_span(&state.tree, first))
            return no_node
        }
        element_type = ast.field(&state.tree, ast.record_field(&state.tree, type, index)).type?
        count = ast.record_field_count(&state.tree, array.value)
        if (tagged) {
            active :: ast.field(&state.tree, ast.record_field(&state.tree, array.value, 0))
            member :: ast.field(&state.tree, ast.record_field(&state.tree, type, index)).name?
            if (active.name == null or ast.name_id(&state.tree, active.name?) != ast.name_id(&state.tree, member)) {
                state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
                    .inactive_union_field, ast.node_span(&state.tree, first))
                return no_node
            }
            index = 0
        }
        previous = ast.field(&state.tree, ast.record_field(&state.tree, array.value, index)).value?
    } else {
        descriptor :: ast.array_type(&state.tree, type)
        if (!descriptor.mutable or ast.expr_kind(&state.tree, first) != .index) {
            state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
                .invalid_index_assignment, ast.node_span(&state.tree, target))
            return no_node
        }
        expression :: try type_snapshot(state, execution, ast.index_expr(&state.tree, first).index)
        if (!try expand_type_matches(state, expression)) return no_node
        count = ast.array_element_count(&state.tree, array.value)
        index = try type_array_index(state, expression, count, false)
        if (index == no_index) return no_node
        element_type = descriptor.element
        previous = ast.array_element(&state.tree, array.value, index)
    }
    updated := no_node
    if (first == target) updated = try type_execution_value(state, input, element_type)
    else {
        if (ast.expr_kind(&state.tree, previous) != .typed_constant) {
            previous = try type_execution_value(state, previous, element_type)
            if (previous == no_node) return no_node
        }
        updated = try type_array_update(state, execution, target, first, previous, input)
    }
    if (updated == no_node) return no_node
    elements := arraylist.init(ast.NodeId, state.allocator)
    defer arraylist.deinit(&elements)
    for (0..count) |i| {
        element := no_node
        if (record) {
            field :: ast.field(&state.tree, ast.record_field(&state.tree, array.value, i))
            value :: if (i == index) updated else field.value?
            element = try ast.add_field(state.builder, field.span, field.name, null, value)
            try refresh(state)
        } else element = if (i == index) updated else ast.array_element(&state.tree, array.value, i)
        try arraylist.append(&elements, element)
    }
    span :: ast.node_span(&state.tree, target)
    literal := no_node
    if (record) literal = try ast.add_record_literal(state.builder, span, null, elements.items)
    else literal = try ast.add_array_literal(state.builder, span, elements.items)
    result :: try ast.add_typed_constant(state.builder, span, array.type, literal)
    try refresh(state)
    return result
}

# optional metadata uses the same explicit presence encoding as serialized values.
# an inner null is a payload only when wrapped in some!, never outer absence.
@hide:file
type_optional_value proc(state @mut State, expression, type ast.NodeId) ast.NodeId ! Error {
    if (!try type_record_check(state, type)) return no_node
    kind :: ast.expr_kind(&state.tree, expression)
    if (kind == .literal_undefined or kind == .literal_null) {
        result :: try ast.add_typed_constant(state.builder, ast.node_span(&state.tree, expression), type, expression)
        try refresh(state)
        return result
    }
    child :: ast.type_operand(&state.tree, type)
    input := expression
    if (kind == .typed_constant) {
        actual :: ast.typed_constant(&state.tree, expression)
        if (try same_type(state, type, actual.type)) return expression
    } else if (kind == .builtin_call
        and mem.eql(ast.literal_text(&state.tree, ast.builtin_call(&state.tree, expression).name), "some")) {
        if (ast.call_arg_count(&state.tree, expression) != 1) {
            state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
                .argument_count_mismatch, ast.node_span(&state.tree, expression))
            return no_node
        }
        input = ast.call_arg(&state.tree, expression, 0)
    }
    payload :: try type_execution_value(state, input, child)
    if (payload == no_node) return no_node
    span :: ast.node_span(&state.tree, expression)
    name :: try metadata_member(state, expression, "some")
    arguments [1]ast.NodeId :: [payload]
    present :: try ast.add_builtin_call(state.builder, span, name, arguments[..])
    result :: try ast.add_typed_constant(state.builder, span, type, present)
    try refresh(state)
    return result
}

@hide:file
type_variant proc(state @mut State, annotation, name ast.NodeId) bool ! Error {
    type :: try canonical_type(state, annotation)
    if (type == no_node) return false
    kind :: ast.expr_kind(&state.tree, type)
    if (kind == .sum_type) {
        members :: ast.binary_expr(&state.tree, type)
        return try type_variant(state, members.left, name) or try type_variant(state, members.right, name)
    }
    if (kind == .union_type) return type_record_slot(&state.tree, type, name) != no_index
    if (kind != .enum_type) return false
    for (0..ast.enum_member_count(&state.tree, type)) |i| {
        member :: ast.field(&state.tree, ast.enum_member(&state.tree, type, i)).name?
        if (ast.name_id(&state.tree, member) == ast.name_id(&state.tree, name)) return true
    }
    return false
}

# the payload's declared channel is retained even when success and error values
# have overlapping shapes. no type-bearing snapshot enters runtime IR.
@hide:file
type_fallible_value proc(state @mut State, expression, type ast.NodeId) ast.NodeId ! Error {
    if (!try type_record_check(state, type)) return no_node
    span :: ast.node_span(&state.tree, expression)
    kind :: ast.expr_kind(&state.tree, expression)
    if (kind == .literal_undefined) {
        result :: try ast.add_typed_constant(state.builder, span, type, expression)
        try refresh(state)
        return result
    }
    channels :: ast.binary_expr(&state.tree, type)
    actual :: try expression_type(state, expression, 0)
    if (actual != no_node and ast.expr_kind(&state.tree, actual) == .fallible_type) {
        if (try same_type(state, actual, type)) return expression
        source :: ast.binary_expr(&state.tree, actual)
        if (!try same_type(state, source.left, channels.left)
            or !try type_subset(state, source.right, channels.right)) {
            state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .type_mismatch, span)
            return no_node
        }
        return try type_fallible_value(state, ast.typed_constant(&state.tree, expression).value, type)
    }
    channel := channels.left
    if (actual != no_node and !try same_type(state, actual, channels.left)
        and try type_subset(state, actual, channels.right)) channel = channels.right
    name := no_node
    if (kind == .enum_literal) name = ast.enum_literal(&state.tree, expression)
    if (kind == .record_literal and ast.record_literal(&state.tree, expression).type != null) {
        tag :: ast.record_literal(&state.tree, expression).type?
        if (ast.expr_kind(&state.tree, tag) == .enum_literal) name = ast.enum_literal(&state.tree, tag)
    }
    if (name != no_node and try type_variant(state, channels.right, name)
        and !try type_variant(state, channels.left, name)) channel = channels.right
    if (kind == .record_literal and ast.record_literal(&state.tree, expression).type == null) {
        success :: try canonical_type(state, channels.left)
        failure :: try canonical_type(state, channels.right)
        if ((success == no_node or ast.expr_kind(&state.tree, success) != .record_type)
            and ast.expr_kind(&state.tree, failure) == .record_type) channel = channels.right
    }
    payload := try type_execution_value(state, expression, channel)
    if (payload == no_node) return no_node
    if (ast.expr_kind(&state.tree, payload) != .typed_constant) {
        payload = try ast.add_typed_constant(state.builder, span, channel, payload)
        try refresh(state)
    }
    result :: try ast.add_typed_constant(state.builder, span, type, payload)
    try refresh(state)
    return result
}

@hide:file
type_sum_value proc(state @mut State, expression, type ast.NodeId) ast.NodeId ! Error {
    if (!try type_record_check(state, type)) return no_node
    actual :: try expression_type(state, expression, 0)
    if (actual != no_node and try same_type(state, actual, type)) return expression
    shape :: try inline_match_shape(state, type)
    if (shape == no_node) return no_node
    span :: ast.node_span(&state.tree, expression)
    input := expression
    if (actual != no_node and try type_subset(state, actual, type)) {
        source :: try canonical_type(state, actual)
        if (ast.expr_kind(&state.tree, source) == .record_type) {
            for (0..ast.record_field_count(&state.tree, shape)) |i| {
                field :: ast.field(&state.tree, ast.record_field(&state.tree, shape, i))
                if (!try same_type(state, field.type?, actual)) continue
                member :: try ast.add_field(state.builder, span, field.name, null, expression)
                fields [1]ast.NodeId :: [member]
                input = try ast.add_record_literal(state.builder, span, null, fields[..])
                try refresh(state)
                break
            }
        } else if (ast.expr_kind(&state.tree, expression) == .typed_constant)
            input = ast.typed_constant(&state.tree, expression).value
    }
    value :: try type_union_value(state, input, shape)
    if (value == no_node) return no_node
    result :: try ast.add_typed_constant(state.builder, span, type,
        ast.typed_constant(&state.tree, value).value)
    try refresh(state)
    return result
}

@hide:file
type_execution_value proc(state @mut State, input, annotation ast.NodeId) ast.NodeId ! Error {
    if (input == no_node or annotation == no_node) return no_node
    if (ast.expr_kind(&state.tree, input) == .block_expr
        and (is_type(state, annotation) or type_record_storage(state, annotation, 0)))
        return try evaluate_type_value_block(state, input, annotation)
    expression :: try type_value_expression(state, input)
    if (expression == no_node) return no_node
    if (!try expand_type_matches(state, annotation)) return no_node
    # a recursive record needs its cached declaration before expanding its fields.
    if (is_type(state, annotation) and nominal_type_value(state, expression)) {
        concrete :: try materialize(state, Value{ kind = .type, node = expression })
        if (type_record_storage(state, expression, 0)) {
            if (!try type_record_check(state, expression)) return no_node
            return concrete.node
        }
        constraint :: try ast.add_type_operand(state.builder, ast.node_span(&state.tree, expression), concrete.node, true)
        try refresh(state)
        try arraylist.append(&state.rewrites.constraints, constraint)
        return concrete.node
    }
    if (!try expand_type_matches(state, expression)) return no_node
    try expand_expected(state, expression, annotation)
    resolved :: binding(state, expression)
    if (resolved.kind == .invalid) {
        state.evaluation_diagnostic = resolved.data.diagnostic
        return no_node
    }
    if (!is_type(state, annotation) and type_record_storage(state, annotation, 0)
        and resolved.kind == .declaration
        and ast.node_class(&state.tree, resolved.data.declaration) == .statement) {
        declaration :: ast.statement_decl(&state.tree, resolved.data.declaration)
        if (declaration.mutability != .constant or !try type_step(state, expression)) return no_node
        if (declaration.type != null and !try same_type(state, annotation, declaration.type?)) {
            if (try metadata_sequence(state, annotation))
                return try type_slice_value(state, expression, annotation)
            state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
                .type_mismatch, ast.node_span(&state.tree, expression))
            return no_node
        }
        return try type_execution_value(state, declaration.initializer, annotation)
    }
    if (try execution_array_storage(state, annotation)) {
        value :: try type_array_value(state, expression, annotation)
        if (value != no_node and !type_record_storage(state, annotation, 0)) {
            # erased snapshots still owe ordinary array-element/layout checking.
            constraint :: try ast.add_type_operand(state.builder, ast.node_span(&state.tree, expression),
                ast.typed_constant(&state.tree, value).type, true)
            try refresh(state)
            try arraylist.append(&state.rewrites.constraints, constraint)
        }
        return value
    }
    if (try metadata_sequence(state, annotation))
        return try type_slice_value(state, expression, annotation)
    if (!is_type(state, annotation) and type_record_storage(state, annotation, 0)) {
        type :: try canonical_type(state, annotation)
        if (type != no_node and ast.expr_kind(&state.tree, type) == .pointer_type) {
            if (ast.expr_kind(&state.tree, expression) == .literal_undefined) {
                result :: try ast.add_typed_constant(state.builder, ast.node_span(&state.tree, expression), type, expression)
                try refresh(state)
                return result
            }
            if (metadata_view_index(state, expression) != no_index) {
                actual :: ast.typed_constant(&state.tree, expression)
                source :: try canonical_type(state, actual.type)
                if (ast.expr_kind(&state.tree, source) == .pointer_type) {
                    p :: ast.pointer_type(&state.tree, type)
                    q :: ast.pointer_type(&state.tree, source)
                    if ((!p.mutable or q.mutable) and p.many == q.many
                        and try same_type(state, p.element, q.element)) {
                        result :: try ast.add_typed_constant(state.builder, ast.node_span(&state.tree, expression), type, actual.value)
                        try refresh(state)
                        return result
                    }
                }
            }
            state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
                .type_mismatch, ast.node_span(&state.tree, expression))
            return no_node
        }
        if (type != no_node and ast.expr_kind(&state.tree, type) == .optional_type)
            return try type_optional_value(state, expression, type)
        if (type != no_node and ast.expr_kind(&state.tree, type) == .fallible_type)
            return try type_fallible_value(state, expression, type)
        if (type != no_node and ast.expr_kind(&state.tree, type) == .sum_type)
            return try type_sum_value(state, expression, type)
    }
    if (!is_type(state, annotation) and type_record_storage(state, annotation, 0))
        return try type_record_value(state, expression, annotation)
    if (is_type(state, annotation)) {
        if (ast.expr_kind(&state.tree, expression) == .literal_undefined) {
            state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
                .read_before_initialization, ast.node_span(&state.tree, expression))
            return no_node
        }
        value :: try evaluate(state, expression)
        if (value.kind != .type) {
            if (state.evaluation_diagnostic == diagnostics.no_diagnostic)
                state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
                    .type_mismatch, ast.node_span(&state.tree, expression))
            return no_node
        }
        concrete :: try materialize(state, value)
        if (type_record_storage(state, concrete.node, 0)) {
            if (!try type_record_check(state, concrete.node)) return no_node
            return concrete.node
        }
        constraint :: try ast.add_type_operand(state.builder, ast.node_span(&state.tree, expression), concrete.node, true)
        try refresh(state)
        try arraylist.append(&state.rewrites.constraints, constraint)
        return concrete.node
    }
    kind :: ast.expr_kind(&state.tree, expression)
    result_type :: binding(state, try canonical_type(state, annotation))
    # keep captured roots when reading an owned constant or unwrapping its presence.
    # compatibility remains a deferred checking obligation.
    if (
        kind == .address_constant or kind == .memory_constant or kind == .slice_constant
        or kind == .typed_constant or (kind == .unary and ast.unary_expr(&state.tree, expression).operator == .unwrap)
    ) {
        value :: try evaluate(state, expression)
        primitive :: match value.kind {
            .integer, .boolean, .string, .function, .null, .real: true
            else: false
        }
        if (
            value.annotation != no_node and try same_type(state, annotation, value.annotation)
            and (primitive or (value.kind == .aggregate and constant_addresses(state, value.node, 0)))
        ) {
            concrete :: if (primitive) try materialize(state, value) else value
            result :: try ast.add_typed_constant(state.builder, ast.node_span(&state.tree, expression), annotation, concrete.node)
            try refresh(state)
            try arraylist.append(&state.rewrites.constraints, expression)
            return result
        }
    }
    if (result_type.kind == .builtin and result_type.data.builtin == .void) {
        if (kind == .literal_void) return expression
        value :: try evaluate_ir(state, expression, annotation)
        if (value.kind == .invalid) return no_node
        return (try materialize(state, value)).node
    }
    if (kind == .literal_string or kind == .typed_constant) {
        value :: try evaluate(state, expression)
        if (
            value.kind == .string and try valid_value(state, annotation, value)
            and (value.annotation == no_node or try same_type(state, annotation, value.annotation))
        ) {
            result :: try ast.add_typed_constant(state.builder, ast.node_span(&state.tree, expression),
                annotation, value.node)
            try refresh(state)
            return result
        }
    }
    # check the leaf as an assignment, not as the evaluation wrapper's return:
    # exact value-type failures belong to the source leaf and use type_mismatch.
    contextual :: try ast.add_typed_constant(state.builder,
        ast.node_span(&state.tree, expression), annotation, expression)
    try refresh(state)
    value :: try evaluate_ir(state, contextual, annotation)
    if (value.kind == .invalid) return no_node
    concrete :: try materialize(state, value)
    result :: try ast.add_typed_constant(state.builder, ast.node_span(&state.tree, expression), annotation, concrete.node)
    try refresh(state)
    return result
}

# check capture guards with ordinary IR without elaborating either source body.
@hide:file
type_capture_guard proc(state @mut State, expression, capture ast.NodeId) Value ! Error {
    resolved :: binding(state, capture)
    if (resolved.kind == .invalid) {
        state.evaluation_diagnostic = resolved.data.diagnostic
        return Value{}
    }
    annotation :: try expression_type(state, expression, 0)
    if (type_record_storage(state, annotation, 0)) {
        type :: try canonical_type(state, annotation)
        if (type != no_node and ast.expr_kind(&state.tree, type) == .optional_type) {
            value :: try type_execution_value(state, expression, type)
            if (value == no_node or !try type_array_initialized(state, value, expression)) return Value{}
            return Value{ kind = .boolean, node = expression,
                boolean = ast.expr_kind(&state.tree, ast.typed_constant(&state.tree, value).value) != .literal_null }
        }
    }
    span :: ast.node_span(&state.tree, expression)
    yes :: try ast.add_boolean(state.builder, span, true)
    no :: try ast.add_boolean(state.builder, span, false)
    taken :: try ast.add_return_stmt(state.builder, span, yes)
    skipped :: try ast.add_return_stmt(state.builder, span, no)
    taken_statements [1]ast.NodeId :: [taken]
    skipped_statements [1]ast.NodeId :: [skipped]
    then_block :: try ast.add_block(state.builder, span, taken_statements[..])
    else_block :: try ast.add_block(state.builder, span, skipped_statements[..])
    selector :: try ast.add_if_stmt(state.builder, span, expression, then_block, else_block)
    ast.set_capture(state.builder, selector, capture)
    statements [1]ast.NodeId :: [selector]
    body :: try ast.add_block(state.builder, span, statements[..])
    try refresh(state)
    return try evaluate_ir_body(state, expression, body, try builtin(state, expression, .bool))
}

# update one owned aggregate through ordinary assignment checking and execution.
# only the target's root becomes a temporary local; indices and RHS retain their
# pre-assignment snapshots, and no interpreter storage survives the evaluation.
@hide:file
type_assignment_value proc(
    state @mut State, execution @mut TypeExecution, statement ast.NodeId, index usize,
) ast.NodeId ! Error {
    assignment :: ast.assignment_stmt(&state.tree, statement)
    local :: execution.locals.items[index]
    span :: ast.node_span(&state.tree, statement)
    value :: try type_snapshot(state, execution, assignment.value)
    if (value == no_node) return no_node
    mutability :: if (ast.node_class(&state.tree, local.declaration) == .statement)
        ast.statement_decl(&state.tree, local.declaration).mutability else ast.Mutability.constant
    temporary :: try ast.add_statement_decl(state.builder, span, span, strpool.no_str,
        local.annotation, mutability, local.value)
    try refresh(state)
    target := no_node
    {
        execution.locals.items[index].value = try reference(state, assignment.target, temporary)
        defer execution.locals.items[index].value = local.value
        target = try type_snapshot(state, execution, assignment.target)
    }
    if (!try expand_type_matches(state, target) or !try expand_type_matches(state, value)) return no_node
    update :: try ast.add_assignment_stmt(state.builder, span, target, value)
    returned :: try ast.add_return_stmt(state.builder, span, try reference(state, statement, temporary))
    statements [3]ast.NodeId :: [temporary, update, returned]
    body :: try ast.add_block(state.builder, span, statements[..])
    try refresh(state)
    result :: try evaluate_ir_body(state, statement, body, local.annotation)
    if (result.kind == .invalid) return no_node
    concrete :: try materialize(state, result)
    owned :: try ast.add_typed_constant(state.builder, span, local.annotation, concrete.node)
    try refresh(state)
    return owned
}

# borrowed places live only in one checked interpreter invocation. its result owns
# snapshots of the changed roots; neither slice pointers nor interpreter cells escape.
@hide:file
type_borrowed_place proc(state @State, id, declaration ast.NodeId, borrowed bool) bool {
    resolved :: binding(state, id)
    if (borrowed and resolved.kind == .declaration and resolved.data.declaration == declaration) return true
    borrowing := borrowed
    if (ast.node_class(&state.tree, id) == .expression) {
        kind :: ast.expr_kind(&state.tree, id)
        borrowing = borrowing or kind == .slice
        if (kind == .unary) borrowing = borrowing or ast.unary_expr(&state.tree, id).operator == .address_of
    }
    for (0..ast.child_count(&state.tree, id)) |i|
        if (type_borrowed_place(state, ast.child(&state.tree, id, i), declaration, borrowing)) return true
    return false
}

@hide:file
type_call_borrows proc(state @State, execution @TypeExecution, call ast.NodeId) bool {
    for (execution.locals.items) |local| {
        if (type_borrowed_place(state, call, local.declaration, false)) return true
    }
    return false
}

@hide:file
type_call_metadata_borrows proc(state @State, execution @TypeExecution, call ast.NodeId) bool {
    for (execution.locals.items) |local| {
        if (type_record_storage(state, local.annotation, 0)
            and type_borrowed_place(state, call, local.declaration, false)) return true
    }
    return false
}

@hide:file
TypeBorrow :: struct { index usize, previous ast.NodeId, temporary ast.NodeId }

@hide:file
type_snapshot_uninitialized proc(state @State, id ast.NodeId) bool {
    if (ast.expr_kind(&state.tree, id) == .literal_undefined) return true
    if (ast.expr_kind(&state.tree, id) == .typed_constant)
        return type_snapshot_uninitialized(state, ast.typed_constant(&state.tree, id).value)
    if (ast.expr_kind(&state.tree, id) == .array_literal) {
        for (0..ast.array_element_count(&state.tree, id)) |i|
            if (type_snapshot_uninitialized(state, ast.array_element(&state.tree, id, i))) return true
    }
    if (ast.expr_kind(&state.tree, id) == .record_literal) {
        for (0..ast.record_field_count(&state.tree, id)) |i| {
            field :: ast.field(&state.tree, ast.record_field(&state.tree, id, i))
            if (field.value != null and type_snapshot_uninitialized(state, field.value?)) return true
        }
    }
    return false
}

# initialization state is not a value: recreate it as storage and write only
# initialized subobjects before entering the interpreter's borrowed call.
@hide:file
type_restore_snapshot proc(
    state @mut State, target, input ast.NodeId, statements @mut arraylist.ArrayList(ast.NodeId),
) void ! Error {
    value := input
    if (ast.expr_kind(&state.tree, value) == .typed_constant) value = ast.typed_constant(&state.tree, value).value
    kind :: ast.expr_kind(&state.tree, value)
    if (kind == .literal_undefined) return
    if (!type_snapshot_uninitialized(state, value)) {
        assignment :: try ast.add_assignment_stmt(state.builder, ast.node_span(&state.tree, value), target, input)
        try arraylist.append(statements, assignment)
        try refresh(state)
        return
    }
    count :: if (kind == .array_literal) ast.array_element_count(&state.tree, value)
        else ast.record_field_count(&state.tree, value)
    for (0..count) |i| {
        child := no_node
        place := no_node
        span :: ast.node_span(&state.tree, value)
        if (kind == .array_literal) {
            child = ast.array_element(&state.tree, value, i)
            index :: try ast.add_integer(state.builder, span, u64(i))
            place = try ast.add_index(state.builder, span, target, index)
        } else {
            field :: ast.field(&state.tree, ast.record_field(&state.tree, value, i))
            child = field.value?
            member := no_node
            if (field.name) |name| member = name
            else member = try ast.add_integer(state.builder, span, u64(i))
            place = try ast.add_selection(state.builder, span, target, member)
        }
        try refresh(state)
        try type_restore_snapshot(state, place, child, statements)
    }
}

@hide:file
type_borrow_call proc(state @mut State, execution @mut TypeExecution, call ast.NodeId) ast.NodeId ! Error {
    saved_demand :: state.demand_depth
    state.demand_depth = 0
    defer state.demand_depth = saved_demand
    span :: ast.node_span(&state.tree, call)
    borrowed := arraylist.init(TypeBorrow, state.allocator)
    defer arraylist.deinit(&borrowed)
    statements := arraylist.init(ast.NodeId, state.allocator)
    defer arraylist.deinit(&statements)
    fields := arraylist.init(ast.NodeId, state.allocator)
    defer arraylist.deinit(&fields)
    values := arraylist.init(ast.NodeId, state.allocator)
    defer arraylist.deinit(&values)
    for (execution.locals.items) |local, i| {
        if (!type_borrowed_place(state, call, local.declaration, false)) continue
        if (type_record_storage(state, local.annotation, 0)) {
            state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .comptime_value_escape, span)
            return no_node
        }
        mutability :: if (ast.node_class(&state.tree, local.declaration) == .statement)
            ast.statement_decl(&state.tree, local.declaration).mutability else ast.Mutability.constant
        partial :: type_snapshot_uninitialized(state, local.value)
        initializer := local.value
        if (partial) initializer = try ast.add_literal(state.builder, .undefined, span)
        temporary :: try ast.add_statement_decl(state.builder, span, span, strpool.no_str,
            local.annotation, mutability, initializer)
        try refresh(state)
        try arraylist.append(&statements, temporary)
        if (partial) try type_restore_snapshot(state, try reference(state, call, temporary), local.value, &statements)
        try arraylist.append(&borrowed, TypeBorrow{ index = i, previous = local.value, temporary = temporary })
    }
    snapshot := no_node
    {
        saved_values :: execution.evaluate_values
        execution.evaluate_values = false
        defer execution.evaluate_values = saved_values
        defer for (borrowed.items) |entry| execution.locals.items[entry.index].value = entry.previous
        for (borrowed.items) |entry|
            execution.locals.items[entry.index].value = try reference(state, call, entry.temporary)
        snapshot = try type_snapshot(state, execution, call)
    }
    if (snapshot == no_node) return no_node
    try expand(state, snapshot)
    result_type :: try expression_type(state, snapshot, 0)
    if (result_type == no_node) return no_node
    resolved_result :: binding(state, try canonical_type(state, result_type))
    void_result :: resolved_result.kind == .builtin and resolved_result.data.builtin == .void
    result_offset :: if (void_result) usize(0) else usize(1)
    if (void_result) {
        discarded :: try ast.add_expression_stmt(state.builder, snapshot)
        try arraylist.append(&statements, discarded)
    } else {
        result_local :: try ast.add_statement_decl(state.builder, span, span, strpool.no_str,
            result_type, .constant, snapshot)
        try refresh(state)
        try arraylist.append(&statements, result_local)
        result_field :: try ast.add_field(state.builder, span, null, result_type, null)
        result_value :: try ast.add_field(state.builder, span, null, null, try reference(state, call, result_local))
        try arraylist.append(&fields, result_field)
        try arraylist.append(&values, result_value)
    }
    for (borrowed.items) |entry| {
        field :: try ast.add_field(state.builder, span, null, execution.locals.items[entry.index].annotation, null)
        value :: try ast.add_field(state.builder, span, null, null, try reference(state, call, entry.temporary))
        try arraylist.append(&fields, field)
        try arraylist.append(&values, value)
    }
    tuple :: try ast.add_record_type(state.builder, span, fields.items)
    literal :: try ast.add_record_literal(state.builder, span, null, values.items)
    returned :: try ast.add_return_stmt(state.builder, span, literal)
    try arraylist.append(&statements, returned)
    body :: try ast.add_block(state.builder, span, statements.items)
    try refresh(state)
    saved_uninitialized :: state.snapshot_uninitialized
    state.snapshot_uninitialized = true
    defer state.snapshot_uninitialized = saved_uninitialized
    result :: try evaluate_ir_body(state, call, body, tuple)
    if (result.kind != .aggregate) return no_node
    for (borrowed.items) |entry, i| {
        value :: ast.field(&state.tree, ast.record_field(&state.tree, result.node, i + result_offset)).value?
        owned :: try ast.add_typed_constant(state.builder, span,
            execution.locals.items[entry.index].annotation, value)
        try refresh(state)
        execution.locals.items[entry.index].value = owned
    }
    if (void_result) {
        value :: try ast.add_literal(state.builder, .void, span)
        try refresh(state)
        return value
    }
    value :: ast.field(&state.tree, ast.record_field(&state.tree, result.node, 0)).value?
    owned :: try ast.add_typed_constant(state.builder, span, result_type, value)
    try refresh(state)
    return owned
}

@hide:file
execute_type_block proc(state @mut State, execution @mut TypeExecution, block ast.NodeId) TypeFlow ! Error {
    if (execution.residual != null and !execution.evaluate_values) {
        block_value :: try residual_block(state, execution, block, execution.residual_boundary)
        if (block_value == no_node) return .invalid
        statement :: try ast.add_block_stmt(state.builder, block_value)
        try refresh(state)
        try arraylist.append(execution.residual?, statement)
        return execution.residual_flow
    }
    if (block == execution.inline_body) {
        saved_demand :: state.demand_depth
        state.demand_depth = 0
        defer state.demand_depth = saved_demand
        snapshot :: try type_snapshot(state, execution, block)
        if (snapshot == no_node) return .invalid
        flow :: try inline_block(state, snapshot)
        if (flow == .invalid) return flow
        try arraylist.append(execution.inline_blocks?, snapshot)
        return flow
    }
    saved :: execution.locals.items.len
    defer execution.locals.items = execution.locals.items[..saved]
    reached := usize(0)
    flow := TypeFlow.next
    for (0..ast.block_statement_count(&state.tree, block)) |i| {
        statement :: ast.block_statement(&state.tree, block, i)
        if (!try type_control_step(state, statement)) return .invalid
        reached = i + 1
        flow = try execute_type_statement(state, execution, statement)
        if (flow != .next) break
    }
    if (flow == .invalid) return flow
    # yielded/returned values already own their snapshots before scope cleanup runs.
    while (reached > 0) {
        reached -= 1
        statement :: ast.block_statement(&state.tree, block, reached)
        kind :: ast.stmt_kind(&state.tree, statement)
        if (kind != .defer_stmt and !(kind == .errdefer_stmt and execution.failed)) continue
        saved_depth :: execution.cleanup_yield_depth
        saved_loop :: execution.cleanup_loop_depth
        execution.cleanup_loop_depth = execution.loop_depth
        execution.cleanup_yield_depth = execution.yield_depth
        execution.cleanup_depth += 1
        cleanup_view :: ast.cleanup_stmt(&state.tree, statement)
        if (kind == .errdefer_stmt and cleanup_view.capture != null) {
            annotation :: ast.binary_expr(&state.tree, try canonical_type(state, execution.result_type)).right
            value :: ast.typed_constant(&state.tree, execution.returned).value
            try arraylist.append(&execution.locals, TypeLocal{
                declaration = cleanup_view.capture?, value = value, annotation = annotation,
            })
        }
        cleanup :: try execute_type_block(state, execution, cleanup_view.body)
        if (kind == .errdefer_stmt and cleanup_view.capture != null)
            execution.locals.items = execution.locals.items[..execution.locals.items.len - 1]
        execution.cleanup_depth -= 1
        execution.cleanup_yield_depth = saved_depth
        execution.cleanup_loop_depth = saved_loop
        if (cleanup != .next) return .invalid
    }
    return flow
}

# substitute selector names without snapshotting away the assignment's root place.
@hide:file
type_assignment_target proc(state @mut State, execution @mut TypeExecution, id ast.NodeId) ast.NodeId ! Error {
    kind :: ast.expr_kind(&state.tree, id)
    if (kind == .builtin_call) {
        name :: ast.builtin_call(&state.tree, id).name
        if (!mem.eql(ast.source_text(&state.tree, ast.node_span(&state.tree, name)), "field")) return id
        if (ast.call_arg_count(&state.tree, id) != 2) {
            try reject(state, id, .argument_count_mismatch)
            return no_node
        }
        base :: try type_assignment_target(state, execution, ast.call_arg(&state.tree, id, 0))
        if (base == no_node) return no_node
        argument :: try type_snapshot(state, execution, ast.call_arg(&state.tree, id, 1))
        if (argument == no_node) return no_node
        arguments [2]ast.NodeId :: [base, argument]
        result :: try ast.add_builtin_call(state.builder, ast.node_span(&state.tree, id), name, arguments[..])
        try refresh(state)
        try expand(state, result)
        if (binding(state, result).kind == .invalid) return no_node
        return result
    }
    if (kind != .selection and kind != .index) return id
    base :: if (kind == .selection) ast.selection_expr(&state.tree, id).base else ast.index_expr(&state.tree, id).base
    selected :: try type_assignment_target(state, execution, base)
    if (selected == no_node or selected == base) return if (selected == no_node) no_node else id
    result := no_node
    if (kind == .selection)
        result = try ast.add_selection(state.builder, ast.node_span(&state.tree, id),
            selected, ast.selection_expr(&state.tree, id).member)
    else result = try ast.add_index(state.builder, ast.node_span(&state.tree, id),
        selected, ast.index_expr(&state.tree, id).index)
    try refresh(state)
    return result
}

@hide:file
execute_type_statement proc(state @mut State, execution @mut TypeExecution, statement ast.NodeId) TypeFlow ! Error {
    if (execution.cleanup_depth > 0) {
        kind :: ast.stmt_kind(&state.tree, statement)
        if (kind == .return_stmt
            or ((kind == .break_stmt or kind == .continue_stmt) and execution.loop_depth <= execution.cleanup_loop_depth)) {
            state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
                .cleanup_control_flow, ast.node_span(&state.tree, statement))
            return .invalid
        }
    }
    flow :: try execute_type_statement_body(state, execution, statement)
    if (execution.pending_flow == .next) return flow
    pending :: execution.pending_flow
    execution.pending_flow = .next
    return pending
}

@hide:file
execute_type_statement_body proc(state @mut State, execution @mut TypeExecution, statement ast.NodeId) TypeFlow ! Error {
    match ast.stmt_kind(&state.tree, statement) {
        .unreachable_stmt: {
            state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
                .unreachable_executed, ast.node_span(&state.tree, statement))
            return .invalid
        }
        .defer_stmt: {}
        .errdefer_stmt: {
            result :: try canonical_type(state, execution.result_type)
            if (result == no_node or ast.expr_kind(&state.tree, result) != .fallible_type) {
                state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
                    .errdefer_outside_fallible, ast.node_span(&state.tree, statement))
                return .invalid
            }
        }
        .yield_stmt: {
            if (execution.yield_depth == 0) {
                state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
                    .yield_outside_block, ast.node_span(&state.tree, statement))
                return .invalid
            }
            if (execution.cleanup_depth > 0 and execution.yield_depth <= execution.cleanup_yield_depth) {
                state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
                    .cleanup_control_flow, ast.node_span(&state.tree, statement))
                return .invalid
            }
            value :: ast.yield_stmt(&state.tree, statement).value?
            expression :: try type_snapshot_expected(state, execution, value, execution.yield_type)
            if (expression == no_node) return .invalid
            annotation := execution.yield_type
            if (annotation == no_node) annotation = try expression_type(state, expression, 0)
            execution.yielded = try type_execution_value(state, expression, annotation)
            if (execution.yielded == no_node
                or !try type_array_initialized(state, execution.yielded, value)) return .invalid
            return .yielded
        }
        .return_stmt: {
            if (ast.return_stmt(&state.tree, statement).value) |value| {
                expression :: try type_snapshot_expected(state, execution, value, execution.result_type)
                if (expression == no_node) return .invalid
                execution.returned = try type_execution_value(state, expression, execution.result_type)
                if (execution.returned != no_node)
                    execution.returned = try metadata_own(state, execution.returned, value)
                if (execution.returned != no_node
                    and !try type_array_initialized(state, execution.returned, value)) return .invalid
                if (execution.returned != no_node) {
                    type :: try canonical_type(state, execution.result_type)
                    if (type != no_node and ast.expr_kind(&state.tree, type) == .fallible_type) {
                        failed :: try type_fallible_failed(state, execution.returned, type, value)
                        if (failed == null) return .invalid
                        execution.failed = failed?
                    }
                }
                if (execution.returned != no_node) return .returned
            } else {
                execution.returned = try type_void_completion(state, execution.result_type, statement)
                if (execution.returned != no_node) return .returned
            }
            return .invalid
        }
        .declaration: {
            declaration :: ast.statement_decl(&state.tree, statement)
            annotation := no_node
            if (declaration.type) |type| annotation = try type_snapshot(state, execution, type)
            snapshot :: try type_snapshot_expected(state, execution, declaration.initializer, annotation)
            expression :: try type_value_expression(state, snapshot)
            if (expression == no_node) return .invalid
            if (annotation == no_node and nominal_type_value(state, expression))
                annotation = try builtin(state, expression, .type)
            else if (annotation == no_node) {
                if (!try expand_type_matches(state, expression)) return .invalid
                try expand(state, expression)
                annotation = try expression_type(state, expression, 0)
                if (annotation == no_node) {
                    value :: try evaluate(state, expression)
                    if (value.kind == .type) annotation = try builtin(state, expression, .type)
                }
            }
            if (annotation == no_node) return .invalid
            value :: try type_execution_value(state, expression, annotation)
            if (value == no_node) return .invalid
            if (ast.expr_kind(&state.tree, value) == .typed_constant)
                annotation = ast.typed_constant(&state.tree, value).type
            try arraylist.append(&execution.locals, TypeLocal{
                declaration = statement, value = value, annotation = annotation,
                contextual = declaration.type == null and flexible(state, expression),
            })
        }
        .assignment_stmt: {
            assignment :: ast.assignment_stmt(&state.tree, statement)
            target :: try type_assignment_target(state, execution, assignment.target)
            if (target == no_node) return .invalid
            if (target != assignment.target) {
                normalized :: try ast.add_assignment_stmt(state.builder,
                    ast.node_span(&state.tree, statement), target, assignment.value)
                if (assignment.compound) ast.set_assignment_compound(state.builder, normalized)
                try refresh(state)
                # synthesized places still need local substitution in snapshots.
                previous :: execution.mapping.len
                execution.mapping = try mem.realloc(state.allocator, execution.mapping, ast.node_count(&state.tree))
                mem.set(execution.mapping[previous..], no_node)
                return try execute_type_statement(state, execution, normalized)
            }
            if (try metadata_assignment(state, execution, target, assignment.value)) {
                if (state.evaluation_diagnostic != diagnostics.no_diagnostic or execution.pending_flow != .next)
                    return .invalid
                return .next
            }
            root := assignment.target
            indexed := true
            while (true) {
                kind :: ast.expr_kind(&state.tree, root)
                if (kind == .selection and binding(state, root).kind == .none) {
                    indexed = false
                    root = ast.selection_expr(&state.tree, root).base
                }
                else if (kind == .index) root = ast.index_expr(&state.tree, root).base
                else break
            }
            resolved :: binding(state, root)
            index := no_index
            if (resolved.kind == .declaration) {
                for (execution.locals.items) |local, i| {
                    if (local.declaration == resolved.data.declaration) index = i
                }
            }
            if (
                index == no_index
                or (root == assignment.target
                    and (ast.node_class(&state.tree, execution.locals.items[index].declaration) != .statement
                        or ast.statement_decl(&state.tree, execution.locals.items[index].declaration).mutability != .variable))
            ) {
                state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
                    .invalid_assignment_target, ast.node_span(&state.tree, assignment.target))
                return .invalid
            }
            if (root != assignment.target) {
                if ((indexed and try execution_array_storage(state, execution.locals.items[index].annotation))
                    or type_record_storage(state, execution.locals.items[index].annotation, 0)) {
                    local :: execution.locals.items[index]
                    if (
                        ast.node_class(&state.tree, local.declaration) != .statement
                        or ast.statement_decl(&state.tree, local.declaration).mutability != .variable
                    ) {
                        state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
                            .invalid_index_assignment, ast.node_span(&state.tree, assignment.target))
                        return .invalid
                    }
                    input :: try type_snapshot(state, execution, assignment.value)
                    if (!try expand_type_matches(state, input)) return .invalid
                    value :: try type_array_update(state, execution, assignment.target, root, local.value, input)
                    if (value == no_node) return .invalid
                    execution.locals.items[index].value = value
                    return .next
                }
                value :: try type_assignment_value(state, execution, statement, index)
                if (value == no_node) return .invalid
                execution.locals.items[index].value = value
                return .next
            }
            expression :: try type_snapshot_expected(state, execution,
                assignment.value, execution.locals.items[index].annotation)
            if (expression == no_node) return .invalid
            if (execution.locals.items[index].contextual and !flexible(state, expression)) {
                if (!try expand_type_matches(state, expression)) return .invalid
                actual :: try expression_type(state, expression, 0)
                resolved_type :: binding(state, actual)
                numeric :: (try integer_type(state, actual)
                    or (resolved_type.kind == .builtin
                        and builtin_identity(resolved_type.data.builtin) == .float))
                if (numeric) execution.locals.items[index].annotation = actual
            }
            value :: try type_execution_value(state, expression, execution.locals.items[index].annotation)
            if (value == no_node) return .invalid
            execution.locals.items[index].value = value
            contextual :: execution.locals.items[index].contextual and flexible(state, expression)
            execution.locals.items[index].contextual = contextual
        }
        .if_stmt, .while_stmt: {
            looping :: ast.stmt_kind(&state.tree, statement) == .while_stmt
            condition := no_node
            body := no_node
            other := no_node
            step ?ast.NodeId := null
            capture ?ast.NodeId := null
            if (looping) {
                view :: ast.while_stmt(&state.tree, statement)
                capture = view.capture
                condition = view.condition
                body = view.body
                step = view.step
            } else {
                view :: ast.if_stmt(&state.tree, statement)
                capture = view.capture
                condition = view.condition
                body = view.then_block
                if (view.else_block) |branch| other = branch
            }
            if (looping) execution.loop_depth += 1
            defer if (looping) execution.loop_depth -= 1
            saved :: execution.locals.items.len
            defer execution.locals.items = execution.locals.items[..saved]
            invariant :: branch_constant(state, condition, 0)
            value := Value{}
            while (true) {
                if (!try type_control_step(state, condition)) return .invalid
                if (!invariant or value.kind == .invalid) {
                    expression :: try type_snapshot(state, execution, condition)
                    if (expression == no_node) return .invalid
                    if (capture) |name| value = try type_capture_guard(state, expression, name)
                    else {
                        boolean :: try builtin(state, expression, .bool)
                        value = try evaluate_ir(state, expression, boolean)
                    }
                }
                if (value.kind != .boolean) return .invalid
                if (!value.boolean) {
                    if (!looping and other != no_node) return try execute_type_block(state, execution, other)
                    return .next
                }
                execution.locals.items = execution.locals.items[..saved]
                if (capture) |name| {
                    expression :: try type_snapshot(state, execution, condition)
                    if (expression == no_node) return .invalid
                    unwrapped :: try ast.add_unary(state.builder,
                        ast.node_span(&state.tree, condition), .unwrap, expression)
                    try refresh(state)
                    annotation :: try expression_type(state, unwrapped, 0)
                    payload :: try type_execution_value(state, unwrapped, annotation)
                    if (payload == no_node) return .invalid
                    try arraylist.append(&execution.locals, TypeLocal{
                        declaration = name, value = payload, annotation = annotation,
                    })
                }
                flow :: try execute_type_block(state, execution, body)
                if (!looping or flow == .returned or flow == .yielded or flow == .invalid) return flow
                if (flow == .break) return .next
                if (step) |block| {
                    step_flow :: try execute_type_block(state, execution, block)
                    if (step_flow == .returned or step_flow == .yielded or step_flow == .invalid) return step_flow
                    if (step_flow == .break) return .next
                }
            }
        }
        .expression: {
            expression :: ast.statement_expr(&state.tree, statement)
            if (ast.expr_kind(&state.tree, expression) != .match_expr) {
                snapshot :: try type_snapshot(state, execution, expression)
                if (snapshot == no_node) return .invalid
                annotation :: try expression_type(state, snapshot, 0)
                if (try type_execution_value(state, snapshot, annotation) == no_node) return .invalid
                return .next
            }
            subject_type := no_node
            arms :: ast.match_arm_count(&state.tree, expression)
            if (arms > 0
                and ast.match_arm_view(&state.tree, ast.match_arm(&state.tree, expression, arms - 1)).is_inline) {
                subject :: try type_snapshot(state, execution, ast.match_expr(&state.tree, expression).subject)
                if (subject == no_node) return .invalid
                subject_type = try expression_type(state, subject, 0)
            }
            before :: ast.node_count(&state.tree)
            try expand_inline_match(state, expression, subject_type)
            if (ast.expr_kind(&state.tree, expression) != .match_expr) return .invalid
            if (ast.node_count(&state.tree) != before) {
                previous :: execution.mapping.len
                execution.mapping = try mem.realloc(state.allocator, execution.mapping, ast.node_count(&state.tree))
                mem.set(execution.mapping[previous..], no_node)
            }
            snapshot :: try type_dispatch_snapshot(state, execution, expression)
            if (snapshot == no_node) return .invalid
            index :: try type_match_arm(state, snapshot)
            if (index == no_index) return .invalid
            arm :: ast.match_arm_view(&state.tree, ast.match_arm(&state.tree, expression, index))
            saved :: execution.locals.items.len
            defer execution.locals.items = execution.locals.items[..saved]
            if (arm.capture) |capture| {
                value :: try type_match_capture(state, snapshot)
                if (value == no_node) return .invalid
                constant :: ast.typed_constant(&state.tree, value)
                captured :: if (is_type(state, constant.type)) constant.value else value
                try arraylist.append(&execution.locals, TypeLocal{
                    declaration = capture, value = captured,
                    annotation = constant.type,
                })
            }
            if (!arm.expression) {
                if (try execute_type_value_block(state, execution, arm.body, no_node) == no_node) return .invalid
                return .next
            }
            body :: try type_snapshot(state, execution, arm.body)
            value :: try type_value_expression(state, body)
            if (value == no_node) return .invalid
            annotation :: try expression_type(state, value, 0)
            if (try type_execution_value(state, value, annotation) == no_node) return .invalid
        }
        .for_stmt: return try execute_type_for(state, execution, statement)
        .block_stmt: return try execute_type_block(state, execution, ast.statement_block(&state.tree, statement))
        .break_stmt, .continue_stmt: {
            if (execution.loop_depth == 0) {
                code :: if (ast.stmt_kind(&state.tree, statement) == .break_stmt)
                    diagnostics.Code.break_outside_loop else diagnostics.Code.continue_outside_loop
                state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, code, ast.node_span(&state.tree, statement))
                return .invalid
            }
            return if (ast.stmt_kind(&state.tree, statement) == .break_stmt) TypeFlow.break else TypeFlow.continue
        }
        else: return .invalid
    }
    return .next
}

# retain a collection place, but freeze its indices at loop entry. snapshots then read
# the current owned root after body assignments without re-evaluating the place.
@hide:file
type_collection_place proc(state @mut State, execution @mut TypeExecution, id ast.NodeId) ast.NodeId ! Error {
    if (metadata_view_index(state, id) != no_index) return id
    if (ast.expr_kind(&state.tree, id) == .unary and ast.unary_expr(&state.tree, id).operator == .dereference)
        return id
    resolved :: binding(state, id)
    if (resolved.kind == .declaration) {
        for (execution.locals.items) |local| {
            if (local.declaration == resolved.data.declaration) return id
        }
        return no_node
    }
    kind :: ast.expr_kind(&state.tree, id)
    if (kind != .selection and kind != .index) return no_node
    base :: if (kind == .selection) ast.selection_expr(&state.tree, id).base else ast.index_expr(&state.tree, id).base
    place :: try type_collection_place(state, execution, base)
    if (place == no_node) return no_node
    result := no_node
    if (kind == .selection) {
        result = try ast.add_selection(state.builder, ast.node_span(&state.tree, id),
            place, ast.selection_expr(&state.tree, id).member)
    } else {
        index :: try type_snapshot(state, execution, ast.index_expr(&state.tree, id).index)
        if (index == no_node) return no_node
        offset :: try type_array_index(state, index, maxval!(usize), false)
        if (offset == no_index) return no_node
        literal :: try ast.add_integer(state.builder, ast.node_span(&state.tree, index), u64(offset))
        value :: try ast.add_typed_constant(state.builder, ast.node_span(&state.tree, index),
            try builtin(state, index, .usize), literal)
        try refresh(state)
        result = try ast.add_index(state.builder, ast.node_span(&state.tree, id), place, value)
    }
    try refresh(state)
    return result
}

@hide:file
type_collection_read proc(state @mut State, execution @mut TypeExecution, id ast.NodeId) ast.NodeId ! Error {
    if (metadata_view_index(state, id) != no_index) return id
    if (binding(state, id).kind == .declaration) return try type_snapshot(state, execution, id)
    kind :: ast.expr_kind(&state.tree, id)
    if (kind == .unary and ast.unary_expr(&state.tree, id).operator == .dereference)
        return try type_snapshot(state, execution, id)
    base :: if (kind == .selection) ast.selection_expr(&state.tree, id).base else ast.index_expr(&state.tree, id).base
    value :: try type_collection_read(state, execution, base)
    result := no_node
    if (kind == .selection)
        result = try ast.add_selection(state.builder, ast.node_span(&state.tree, id),
            value, ast.selection_expr(&state.tree, id).member)
    else result = try ast.add_index(state.builder, ast.node_span(&state.tree, id),
        value, ast.index_expr(&state.tree, id).index)
    try refresh(state)
    return result
}

@hide:file
execute_type_collection proc(state @mut State, execution @mut TypeExecution, statement ast.NodeId) TypeFlow ! Error {
    loop :: ast.for_stmt(&state.tree, statement)
    span :: ast.node_span(&state.tree, statement)
    if (loop.capture) |capture| {
        if (binding(state, capture).kind == .invalid) {
            state.evaluation_diagnostic = binding(state, capture).data.diagnostic
            return .invalid
        }
    }
    if (loop.index) |index| {
        if (binding(state, index).kind == .invalid) {
            state.evaluation_diagnostic = binding(state, index).data.diagnostic
            return .invalid
        }
    }
    snapshot := no_node
    if (loop.pointer_capture and loop.capture != null and !loop.is_inline) {
        view :: try ast.add_slice(state.builder, span, loop.iterable, null, null, null)
        try refresh(state)
        snapshot = try metadata_view_create(state, execution, view)
        if (snapshot == no_node and state.evaluation_diagnostic == diagnostics.no_diagnostic)
            snapshot = try type_snapshot(state, execution, loop.iterable)
    } else snapshot = try type_snapshot(state, execution, loop.iterable)
    if (snapshot == no_node) return .invalid
    if (!try expand_type_matches(state, snapshot)) return .invalid
    try expand(state, snapshot)
    annotation :: try expression_type(state, snapshot, 0)
    if (annotation == no_node) return .invalid
    tuple :: loop.is_inline and ast.expr_kind(&state.tree, annotation) == .record_type
    if tuple {
        for (0..ast.record_field_count(&state.tree, annotation)) |i| {
            if (ast.field(&state.tree, ast.record_field(&state.tree, annotation, i)).name != null) {
                state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .invalid_for_iterable, span)
                return .invalid
            }
        }
    }
    collection :: try type_execution_value(state, snapshot, annotation)
    if (collection == no_node) return .invalid
    count := Value{}
    borrowed :: metadata_view_index(state, collection)
    if (borrowed != no_index) {
        count = Value{ kind = .integer, magnitude = u64(state.metadata_views.items[borrowed].count) }
    } else if tuple {
        count = Value{ kind = .integer, magnitude = u64(ast.record_field_count(&state.tree, annotation)) }
    } else if (try execution_array_storage(state, annotation) or try metadata_sequence(state, annotation)) {
        count = Value{ kind = .integer,
            magnitude = u64(ast.array_element_count(&state.tree, ast.typed_constant(&state.tree, collection).value)) }
    } else {
        # validate the loop contract even for empty collections, without executing
        # its type-valued body. the synthetic body exits before reading an element.
        stop :: try ast.add_break_stmt(state.builder, span)
        stops [1]ast.NodeId :: [stop]
        body :: try ast.add_block(state.builder, span, stops[..])
        selector :: try ast.add_for_stmt(state.builder, span, collection, loop.capture, loop.index,
            loop.pointer_capture, loop.index_capture, body)
        try refresh(state)
        length := no_node
        if (ast.expr_kind(&state.tree, annotation) == .array_type) length = ast.array_type(&state.tree, annotation).count?
        else {
            value :: try evaluate(state, collection)
            if (value.kind == .string) {
                text :: ast.literal_text(&state.tree, value.node)
                cursor := usize(1)
                size := u64(0)
                while (cursor < text.len - 1) {
                    _ = ast.string_next(text, &cursor) catch { return .invalid }
                    size += 1
                }
                length = try ast.add_integer(state.builder, span, size)
            } else length = try ast.add_integer(state.builder, span, 0)
        }
        returned :: try ast.add_return_stmt(state.builder, span, length)
        statements [2]ast.NodeId :: [selector, returned]
        wrapper :: try ast.add_block(state.builder, span, statements[..])
        try refresh(state)
        count = try evaluate_ir_body(state, statement, wrapper, try builtin(state, statement, .usize))
        if (count.kind != .integer) return .invalid
    }
    if (loop.pointer_capture and loop.capture != null and borrowed == no_index) {
        state.evaluation_diagnostic = try diagnostics.add(state.diagnostics, .comptime_value_escape, span)
        return .invalid
    }
    place := no_node
    if (tuple or ast.expr_kind(&state.tree, annotation) == .array_type)
        place = try type_collection_place(state, execution, loop.iterable)
    if (state.evaluation_diagnostic != diagnostics.no_diagnostic) return .invalid
    saved :: execution.locals.items.len
    defer execution.locals.items = execution.locals.items[..saved]
    execution.loop_depth += 1
    defer execution.loop_depth -= 1
    for (0..usize(count.magnitude)) |i| {
        if (!try type_control_step(state, statement)) return .invalid
        execution.locals.items = execution.locals.items[..saved]
        index :: try ast.add_integer(state.builder, span, u64(i))
        try refresh(state)
        if loop.capture |capture| {
            current := collection
            if (place != no_node) current = try type_collection_read(state, execution, place)
            element :: if (tuple) try ast.add_selection(state.builder, span, current, index)
                else try ast.add_index(state.builder, span, current, index)
            try refresh(state)
            element_type := if (loop.pointer_capture)
                ast.slice_type(&state.tree, try canonical_type(state, annotation)).element
                else if (tuple)
                    ast.field(&state.tree, ast.record_field(&state.tree, annotation, i)).type?
                else try expression_type(state, element, 0)
            value := no_node
            if (loop.pointer_capture) {
                descriptor :: ast.slice_type(&state.tree, try canonical_type(state, annotation))
                element_type = try ast.add_pointer_type(state.builder, span, descriptor.element, descriptor.mutable, false)
                try refresh(state)
                view := state.metadata_views.items[borrowed]
                view.start += i
                view.count = 1
                value = try metadata_view_value(state, view, element_type, capture)
                hashmap.put(&state.capture_types, capture, element_type) catch |err| {
                    match err {
                        .key_exists: {}
                        else: return err
                    }
                }
            } else value = try type_execution_value(state, element, element_type)
            if (value == no_node) return .invalid
            try arraylist.append(&execution.locals, TypeLocal{
                declaration = capture, value = value, annotation = element_type,
            })
        }
        if (loop.index) |capture| {
            type :: try builtin(state, capture, .usize)
            value :: try type_execution_value(state, index, type)
            if (value == no_node) return .invalid
            try arraylist.append(&execution.locals, TypeLocal{
                declaration = capture, value = value, annotation = type,
            })
        }
        flow :: try execute_type_block(state, execution, loop.body)
        if (flow == .returned or flow == .yielded or flow == .invalid) return flow
        if (flow == .break) return .next
    }
    return .next
}

@hide:file
execute_type_for proc(state @mut State, execution @mut TypeExecution, statement ast.NodeId) TypeFlow ! Error {
    loop :: ast.for_stmt(&state.tree, statement)
    if (ast.expr_kind(&state.tree, loop.iterable) != .range)
        return try execute_type_collection(state, execution, statement)
    if (loop.pointer_capture or loop.index_capture) return .invalid
    bounds :: ast.range_expr(&state.tree, loop.iterable)
    start :: try type_snapshot(state, execution, bounds.start)
    end :: try type_snapshot(state, execution, bounds.end)
    if (start == no_node or end == no_node) return .invalid
    typed_bound :: if (flexible(state, start)) end else start
    annotation :: try expression_type(state, typed_bound, 0)
    if (annotation == no_node or !try integer_type(state, annotation)) return .invalid
    current := try type_execution_value(state, start, annotation)
    limit :: try type_execution_value(state, end, annotation)
    if (current == no_node or limit == no_node) return .invalid
    saved :: execution.locals.items.len
    defer execution.locals.items = execution.locals.items[..saved]
    if (loop.capture) |capture| try arraylist.append(&execution.locals, TypeLocal{
        declaration = capture, value = current, annotation = annotation,
    })
    execution.loop_depth += 1
    defer execution.loop_depth -= 1
    while (true) {
        if (!try type_control_step(state, statement)) return .invalid
        span :: ast.node_span(&state.tree, statement)
        operator ast.BinaryOperator :: if (bounds.inclusive) .less_equal else .less
        comparison :: try ast.add_binary(state.builder, span, operator, current, limit)
        try refresh(state)
        keep :: try evaluate(state, comparison)
        if (keep.kind != .boolean) return .invalid
        if (!keep.boolean) return .next
        if (loop.capture != null) execution.locals.items[saved].value = current
        flow :: try execute_type_block(state, execution, loop.body)
        if (flow == .returned or flow == .yielded or flow == .invalid) return flow
        if (flow == .break) return .next
        if (try value_equal(state, try evaluate(state, current), try evaluate(state, limit))) return .next
        one :: try ast.add_integer(state.builder, span, 1)
        increment :: try ast.add_binary(state.builder, span, .add, current, one)
        try refresh(state)
        current = try type_execution_value(state, increment, annotation)
        if (current == no_node) return .invalid
    }
}

@hide:file
mix proc(left, right usize) usize {
    return (left << 7) xor (left >> (sizeof!(usize) * 8 - 7)) xor right
}

@hide:file
evaluate proc(state @mut State, id ast.NodeId) Value ! Error {
    if (id == no_node) return Value{}
    if (state.depth >= 128) return Value{}
    state.depth += 1
    defer state.depth -= 1
    try expand(state, id)
    kind :: ast.expr_kind(&state.tree, id)
    resolved :: binding(state, id)
    if (resolved.kind == .invalid) {
        state.evaluation_diagnostic = resolved.data.diagnostic
        return Value{}
    }
    if (resolved.kind == .builtin and resolved.data.builtin != .type) return Value{ kind = .type, node = id }
    if (resolved.kind == .declaration) {
        target :: resolved.data.declaration
        class :: ast.node_class(&state.tree, target)
        if (class == .function) {
            if (template(state, target)) return Value{}
            return Value{ kind = .function, node = id }
        }
        if (class == .statement) {
            declaration :: ast.statement_decl(&state.tree, target)
            if (declaration.mutability != .constant) return Value{}
            value := try evaluate(state, declaration.initializer)
            if (declaration.type) |annotation| value.annotation = annotation
            return value
        }
        return Value{}
    }
    match kind {
        .slice_constant: {
            value :: ast.slice_constant(&state.tree, id)
            return Value{ kind = .aggregate, node = id, annotation = value.type }
        }
        .memory_constant, .address_constant: {
            value :: if (kind == .memory_constant) ast.memory_constant(&state.tree, id) else ast.address_constant(&state.tree, id)
            return Value{ kind = .aggregate, node = id, annotation = value.type }
        }
        .typed_constant: {
            view :: ast.typed_constant(&state.tree, id)
            if (!is_type(state, view.type) and type_record_storage(state, view.type, 0)) {
                if (!try type_array_initialized(state, id, id)) return Value{}
                return Value{ kind = .aggregate, node = view.value, annotation = view.type }
            }
            if (branch_constant(state, view.value, 0) and constant_addresses(state, view.value, 0)) {
                try arraylist.append(&state.rewrites.constraints, id)
                return Value{ kind = .aggregate, node = view.value, annotation = view.type }
            }
            value := try evaluate_expected(state, view.value, view.type)
            value.annotation = view.type
            return value
        }
        .literal_int: {
            if (strconv.parse_unsigned(ast.literal_text(&state.tree, id), maxval!(u64))) |value|
                return Value{ kind = .integer, node = id, magnitude = value }
            return Value{}
        }
        .literal_float: {
            if (ast.float_value(&state.tree, id)) |value| return Value{
                kind = .real, node = id, magnitude = ptrcast!(@u64, &value)^,
            }
            return try evaluate_ir(state, id, try builtin(state, id, .float))
        }
        .literal_bool: return Value{ kind = .boolean, node = id,
            boolean = mem.eql(ast.literal_text(&state.tree, id), "true") }
        .literal_string: {
            text :: ast.literal_text(&state.tree, id)
            cursor := usize(1)
            while (cursor < text.len - 1) {
                _ = ast.string_next(text, &cursor) catch {
                    try reject(state, id, .invalid_escape)
                    return Value{}
                }
            }
            return Value{ kind = .string, node = id }
        }
        .literal_null: return Value{ kind = .null, node = id }
        .literal_void: return Value{ kind = .aggregate, node = id, annotation = try builtin(state, id, .void) }
        .record_type, .array_type, .slice_type, .pointer_type, .function_type, .optional_type,
        .enum_type, .union_type, .union_tag_type, .distinct_type, .fallible_type, .sum_type:
            return Value{ kind = .type, node = id }
        .alias_expr: return try evaluate(state, ast.type_operand(&state.tree, id))
        .unary: {
            view :: ast.unary_expr(&state.tree, id)
            if (view.operator == .bit_not)
                return try evaluate_ir(state, id, try expression_type(state, id, 0))
            if (view.operator == .unwrap) {
                # source-owned payloads retain declaration/backing identities across unwraps.
                value := try evaluate(state, view.operand)
                annotation :: try expression_type(state, view.operand, 0)
                if (
                    value.kind == .aggregate and annotation != no_node
                    and ast.expr_kind(&state.tree, annotation) == .optional_type
                ) {
                    child :: ast.type_operand(&state.tree, annotation)
                    payload_kind :: ast.expr_kind(&state.tree, value.node)
                    if (
                        payload_kind == .builtin_call
                        and mem.eql(ast.literal_text(&state.tree, ast.builtin_call(&state.tree, value.node).name), "some")
                    ) return try evaluate_expected(state, ast.call_arg(&state.tree, value.node, 0), child)
                    if (payload_kind == .address_constant) return try evaluate_expected(state, value.node, child)
                }
                if (
                    value.kind == .function and annotation != no_node
                    and ast.expr_kind(&state.tree, annotation) == .optional_type
                ) {
                    try arraylist.append(&state.rewrites.constraints, id)
                    value.annotation = ast.type_operand(&state.tree, annotation)
                    return value
                }
                return try evaluate_ir(state, id, try expression_type(state, id, 0))
            }
            value := try evaluate(state, view.operand)
            if (view.operator == .negate and value.kind == .integer) value.negative = value.magnitude != 0 and !value.negative
            else if (view.operator == .negate and value.kind == .real) value.magnitude = value.magnitude xor (u64(1) << 63)
            else if (view.operator == .logical_not and value.kind == .boolean) value.boolean = !value.boolean
            else return Value{}
            value.node = id
            return value
        }
        .binary: return try evaluate_binary(state, id)
        .call: return try evaluate_call(state, id)
        .block_expr: {
            annotation :: try expression_type(state, id, 0)
            if (annotation == no_node) return Value{}
            if (is_type(state, annotation) or type_record_storage(state, annotation, 0)) {
                result :: try evaluate_type_value_block(state, id, annotation)
                if (result == no_node) return Value{}
                return try evaluate_expected(state, result, annotation)
            }
            return try evaluate_ir(state, id, annotation)
        }
        .match_expr: {
            annotation :: try expression_type(state, id, 0)
            if (annotation != no_node and (is_type(state, annotation) or type_record_storage(state, annotation, 0))) {
                begin_type_execution(state)
                defer state.type_execution_depth -= 1
                selected :: try type_value_expression(state, id)
                if (selected == no_node or selected == id) return Value{}
                return try evaluate_expected(state, selected, annotation)
            }
            return try evaluate_ir(state, id, annotation)
        }
        .record_literal, .array_literal, .selection, .index, .builtin_call, .catch_expr:
            return try evaluate_ir(state, id, try expression_type(state, id, 0))
        else: return Value{}
    }
}

@hide:file
evaluate_binary proc(state @mut State, id ast.NodeId) Value ! Error {
    view :: ast.binary_expr(&state.tree, id)
    if (view.operator == .divide) return try evaluate_ir(state, id, try builtin(state, id, .float))
    if (view.operator == .bit_and or view.operator == .bit_or or view.operator == .bit_xor
        or view.operator == .shift_left or view.operator == .shift_right or view.operator == .shift_left_saturating)
        return try evaluate_ir(state, id, try expression_type(state, id, 0))
    left :: try evaluate(state, view.left)
    if (left.kind == .invalid) return Value{}
    if (left.kind == .boolean) {
        if (view.operator == .logical_and and !left.boolean) return Value{ kind = .boolean, node = id, boolean = false }
        if (view.operator == .logical_or and left.boolean) return Value{ kind = .boolean, node = id, boolean = true }
    }
    right := try evaluate(state, view.right)
    if (left.kind == .invalid or right.kind == .invalid) return Value{}
    if (left.kind == .real or right.kind == .real) {
        boolean :: (
            view.operator == .equal or view.operator == .not_equal or view.operator == .less
            or view.operator == .less_equal or view.operator == .greater or view.operator == .greater_equal
        )
        kind sema.BuiltinType :: if (boolean) .bool else .float
        result_type :: try builtin(state, id, kind)
        return try evaluate_ir(state, id, result_type)
    }
    if (
        left.annotation != no_node and right.annotation != no_node
        and left.kind == .integer and right.kind == .integer
        and !try same_type(state, left.annotation, right.annotation)
    ) return Value{}
    if (view.operator == .equal or view.operator == .not_equal) {
        if (left.kind != right.kind) return Value{}
        equal :: try value_equal(state, left, right)
        if (left.kind == .type) {
            operands [2]ast.NodeId :: [view.left, view.right]
            for (operands) |operand| {
                if (type_record_storage(state, operand, 0)) continue
                constraint :: try ast.add_type_operand(state.builder,
                    ast.node_span(&state.tree, operand), operand, true)
                try refresh(state)
                try arraylist.append(&state.rewrites.constraints, constraint)
            }
            folded :: try ast.add_boolean(state.builder, ast.node_span(&state.tree, id),
                equal == (view.operator == .equal))
            try replace(state, id, folded)
            try refresh(state)
        }
        return Value{ kind = .boolean, node = id, boolean = equal == (view.operator == .equal) }
    }
    if (left.kind == .boolean and right.kind == .boolean) {
        if (view.operator == .logical_and) return Value{ kind = .boolean, node = id, boolean = left.boolean and right.boolean }
        if (view.operator == .logical_or) return Value{ kind = .boolean, node = id, boolean = left.boolean or right.boolean }
        return Value{}
    }
    if (left.kind != .integer or right.kind != .integer) return Value{}
    annotation :: if (left.annotation != no_node) left.annotation else right.annotation
    less :: if (left.negative != right.negative) left.negative
        else if (left.negative) left.magnitude > right.magnitude else left.magnitude < right.magnitude
    equal :: left.magnitude == right.magnitude and left.negative == right.negative
    match view.operator {
        .less: return Value{ kind = .boolean, node = id, boolean = less }
        .less_equal: return Value{ kind = .boolean, node = id, boolean = less or equal }
        .greater: return Value{ kind = .boolean, node = id, boolean = !less and !equal }
        .greater_equal: return Value{ kind = .boolean, node = id, boolean = !less }
        .multiply: {
            if (right.magnitude != 0 and left.magnitude > divtrunc!(maxval!(u64), right.magnitude)) return Value{}
            magnitude :: left.magnitude * right.magnitude
            return try integer_value(state, id, magnitude, magnitude != 0 and left.negative != right.negative, annotation)
        }
        .add, .subtract: {
            if (view.operator == .subtract and right.magnitude != 0) right.negative = !right.negative
            if (left.negative == right.negative) {
                if (left.magnitude > maxval!(u64) - right.magnitude) return Value{}
                return try integer_value(state, id, left.magnitude + right.magnitude, left.negative, annotation)
            }
            if (left.magnitude < right.magnitude) return try integer_value(state, id, right.magnitude - left.magnitude, right.negative, annotation)
            return try integer_value(state, id, left.magnitude - right.magnitude,
                left.magnitude != right.magnitude and left.negative, annotation)
        }
        else: return Value{}
    }
}

@hide:file
canonical_type proc(state @mut State, id ast.NodeId) ast.NodeId ! Error {
    if (is_type(state, id)) return id
    value :: try evaluate(state, id)
    return if (value.kind == .type) value.node else no_node
}

# metadata storage compares anonymous annotation shapes, including ordinary nested
# fields. named definitions and nominal type results retain their original identity.
@hide:file
# ponytail: scan declaration syntax for nominal identity; index record origins if metadata-heavy builds make this hot.
structural_type_record proc(state @State, id ast.NodeId) bool {
    for (state.instances.items) |instance| {
        if (instance.type == id) return false
    }
    for (0..ast.node_count(&state.tree)) |i| {
        declaration :: ast.NodeId(i)
        if (ast.node_class(&state.tree, declaration) != .statement
            or ast.stmt_kind(&state.tree, declaration) != .declaration) continue
        if (ast.statement_decl(&state.tree, declaration).initializer == id) return false
    }
    return true
}

@hide:file
same_type proc(state @mut State, left, right ast.NodeId) bool ! Error {
    return try same_type_context(state, left, right, false)
}

@hide:file
same_type_context proc(state @mut State, left, right ast.NodeId, metadata bool) bool ! Error {
    if (is_type(state, left) or is_type(state, right))
        return is_type(state, left) and is_type(state, right)
    a :: try canonical_type(state, left)
    b :: try canonical_type(state, right)
    if (a == no_node or b == no_node) return false
    if (a == b) return true
    x :: binding(state, a)
    y :: binding(state, b)
    if (x.kind == .builtin or y.kind == .builtin) return x.kind == .builtin and y.kind == .builtin and builtin_identity(x.data.builtin) == builtin_identity(y.data.builtin)
    kind :: ast.expr_kind(&state.tree, a)
    if (kind == .sum_type or ast.expr_kind(&state.tree, b) == .sum_type)
        return try type_subset(state, a, b) and try type_subset(state, b, a)
    if (kind != ast.expr_kind(&state.tree, b)) return false
    match kind {
        .union_tag_type: return try same_type_context(state,
            ast.type_operand(&state.tree, a), ast.type_operand(&state.tree, b), metadata)
        .record_type: {
            if (!metadata and (!type_record_storage(state, a, 0) or !type_record_storage(state, b, 0))) return false
            if (!structural_type_record(state, a) or !structural_type_record(state, b)) return false
            count :: ast.record_field_count(&state.tree, a)
            if (count != ast.record_field_count(&state.tree, b)) return false
            for (0..count) |i| {
                p :: ast.field(&state.tree, ast.record_field(&state.tree, a, i))
                q :: ast.field(&state.tree, ast.record_field(&state.tree, b, i))
                if ((p.name == null) != (q.name == null)) return false
                if (p.name != null and ast.name_id(&state.tree, p.name?) != ast.name_id(&state.tree, q.name?)) return false
                if (p.type == null or q.type == null or !try same_type_context(state, p.type?, q.type?, true)) return false
            }
            return true
        }
        .pointer_type: {
            p :: ast.pointer_type(&state.tree, a)
            q :: ast.pointer_type(&state.tree, b)
            return p.mutable == q.mutable and p.many == q.many and try same_type_context(state, p.element, q.element, metadata)
        }
        .array_type: {
            p :: ast.array_type(&state.tree, a)
            q :: ast.array_type(&state.tree, b)
            if (p.mutable != q.mutable or p.count == null or q.count == null) return false
            pv :: try evaluate(state, p.count?)
            qv :: try evaluate(state, q.count?)
            return try value_equal(state, pv, qv) and try same_type_context(state, p.element, q.element, metadata)
        }
        .slice_type: {
            p :: ast.slice_type(&state.tree, a)
            q :: ast.slice_type(&state.tree, b)
            if (p.mutable != q.mutable or (p.sentinel == null) != (q.sentinel == null)) return false
            if (p.sentinel) |sentinel| {
                if (!try value_equal(state, try evaluate(state, sentinel), try evaluate(state, q.sentinel?))) return false
            }
            return try same_type_context(state, p.element, q.element, metadata)
        }
        .optional_type: return try same_type_context(state, ast.type_operand(&state.tree, a), ast.type_operand(&state.tree, b), metadata)
        .fallible_type: {
            p :: ast.binary_expr(&state.tree, a)
            q :: ast.binary_expr(&state.tree, b)
            return try same_type_context(state, p.left, q.left, metadata) and try same_type_context(state, p.right, q.right, metadata)
        }
        .function_type: {
            count :: ast.function_param_count(&state.tree, a)
            if (count != ast.function_param_count(&state.tree, b)) return false
            if (!try same_type_context(state, ast.callable_result(&state.tree, a), ast.callable_result(&state.tree, b), metadata)) return false
            for (0..count) |i| {
                p :: ast.param(&state.tree, ast.function_param(&state.tree, a, i)).type
                q :: ast.param(&state.tree, ast.function_param(&state.tree, b, i)).type
                if (!try same_type_context(state, p, q, metadata)) return false
            }
            return true
        }
        else: return false
    }
}

@hide:file
type_subset proc(state @mut State, left, right ast.NodeId) bool ! Error {
    a :: try canonical_type(state, left)
    b :: try canonical_type(state, right)
    if (a == no_node or b == no_node) return false
    if (ast.expr_kind(&state.tree, a) == .sum_type) {
        view :: ast.binary_expr(&state.tree, a)
        return try type_subset(state, view.left, b) and try type_subset(state, view.right, b)
    }
    if (ast.expr_kind(&state.tree, b) == .sum_type) {
        view :: ast.binary_expr(&state.tree, b)
        return try type_subset(state, a, view.left) or try type_subset(state, a, view.right)
    }
    return try same_type(state, a, b)
}

@hide:file
value_equal proc(state @mut State, left, right Value) bool ! Error {
    if (left.kind != right.kind) return false
    return match left.kind {
        .invalid, .null: true
        .type: try same_type(state, left.node, right.node)
        .integer: left.magnitude == right.magnitude and left.negative == right.negative
        .boolean: left.boolean == right.boolean
        .function: binding(state, left.node).data.declaration == binding(state, right.node).data.declaration
        .real: left.magnitude == right.magnitude
        .aggregate: (
            try same_type(state, left.annotation, right.annotation)
            and try constant_equal(state, left.node, right.node)
        )
        .string: try same_string(state, left.node, right.node)
    }
}

@hide:file
value_hash proc(state @mut State, value Value) usize ! Error {
    hash :: enum_index(value.kind)
    negative :: if (value.negative) usize(1) else usize(0)
    boolean :: if (value.boolean) usize(1) else usize(0)
    return match value.kind {
        .type: mix(hash, try type_hash(state, value.node))
        .integer: mix(mix(hash, usize(value.magnitude)), negative)
        .boolean: mix(hash, boolean)
        .function: mix(hash, usize(binding(state, value.node).data.declaration))
        .string: string_hash(hash, ast.literal_text(&state.tree, value.node))
        .real: mix(hash, usize(value.magnitude))
        .aggregate: mix(mix(hash, try type_hash(state, value.annotation)), try constant_hash(state, value.node))
        .invalid, .null: hash
    }
}

@hide:file
string_hash proc(seed usize, text []u8) usize {
    result := seed
    cursor := usize(1)
    while (cursor < text.len - 1) {
        byte :: ast.string_next(text, &cursor) catch { return 0 }
        result = mix(result, usize(byte))
    }
    return result
}

@hide:file
type_hash proc(state @mut State, id ast.NodeId) usize ! Error {
    return try type_hash_context(state, id, false)
}

@hide:file
type_hash_context proc(state @mut State, id ast.NodeId, metadata bool) usize ! Error {
    node :: try canonical_type(state, id)
    if (node == no_node) return 0
    resolved :: binding(state, node)
    if (resolved.kind == .builtin) return mix(1, enum_index(builtin_identity(resolved.data.builtin)))
    kind :: ast.expr_kind(&state.tree, node)
    hash := enum_index(kind)
    match kind {
        .union_tag_type: return mix(hash,
            try type_hash_context(state, ast.type_operand(&state.tree, node), metadata))
        .record_type: {
            if ((!metadata and !type_record_storage(state, node, 0))
                or !structural_type_record(state, node)) return mix(hash, usize(node))
            for (0..ast.record_field_count(&state.tree, node)) |i| {
                field :: ast.field(&state.tree, ast.record_field(&state.tree, node, i))
                if (field.name) |name| hash = mix(hash, usize(ast.name_id(&state.tree, name)))
                if (field.type) |annotation| hash = mix(hash, try type_hash_context(state, annotation, true))
            }
            return hash
        }
        .pointer_type: {
            view :: ast.pointer_type(&state.tree, node)
            mutable :: if (view.mutable) usize(1) else usize(0)
            many :: if (view.many) usize(1) else usize(0)
            hash = mix(hash, mutable)
            hash = mix(hash, many)
            return mix(hash, try type_hash_context(state, view.element, metadata))
        }
        .array_type: {
            view :: ast.array_type(&state.tree, node)
            mutable :: if (view.mutable) usize(1) else usize(0)
            hash = mix(hash, mutable)
            if (view.count) |count| hash = mix(hash, try value_hash(state, try evaluate(state, count)))
            return mix(hash, try type_hash_context(state, view.element, metadata))
        }
        .slice_type: {
            view :: ast.slice_type(&state.tree, node)
            mutable :: if (view.mutable) usize(1) else usize(0)
            hash = mix(hash, mutable)
            if (view.sentinel) |sentinel| hash = mix(hash, try value_hash(state, try evaluate(state, sentinel)))
            return mix(hash, try type_hash_context(state, view.element, metadata))
        }
        .optional_type: return mix(hash, try type_hash_context(state, ast.type_operand(&state.tree, node), metadata))
        .sum_type: {
            view :: ast.binary_expr(&state.tree, node)
            # set fingerprints must ignore ordering, grouping and repeated members.
            # colliding fingerprints still use full type equality in the cache chain.
            return try type_hash_context(state, view.left, metadata) | try type_hash_context(state, view.right, metadata)
        }
        .fallible_type: {
            view :: ast.binary_expr(&state.tree, node)
            return mix(mix(hash, try type_hash_context(state, view.left, metadata)), try type_hash_context(state, view.right, metadata))
        }
        .function_type: {
            hash = mix(hash, try type_hash_context(state, ast.callable_result(&state.tree, node), metadata))
            for (0..ast.function_param_count(&state.tree, node)) |i| {
                parameter :: ast.function_param(&state.tree, node, i)
                hash = mix(hash, try type_hash_context(state, ast.param(&state.tree, parameter).type, metadata))
            }
            return hash
        }
        else: return mix(hash, usize(node))
    }
}

@hide:file
value_block_yield proc(state @mut State, id ast.NodeId, depth usize) ast.NodeId ! Error {
    if (depth >= 128) return no_node
    class :: ast.node_class(&state.tree, id)
    if (class != .block and class != .statement) return no_node
    if (class == .statement) {
        kind :: ast.stmt_kind(&state.tree, id)
        if (kind == .yield_stmt)
            return ast.yield_stmt(&state.tree, id).value?
        if (kind != .block_stmt and kind != .if_stmt and kind != .while_stmt and kind != .for_stmt)
            return no_node
    }
    result := no_node
    for (0..ast.child_count(&state.tree, id)) |i| {
        child :: ast.child(&state.tree, id, i)
        value :: try value_block_yield(state, child, depth + 1)
        if (value == no_node or try expression_type(state, value, depth + 1) == no_node) continue
        result = value
        if (!flexible(state, value)) return result
    }
    return result
}

@hide:file
value_block_type proc(state @mut State, block ast.NodeId, depth usize) ast.NodeId ! Error {
    value :: try value_block_yield(state, block, depth)
    return if (value != no_node) try expression_type(state, value, depth + 1)
        else try builtin(state, block, .void)
}

# inferred dimensions belong to the storage initializer, not to a generic caller.
@hide:file
storage_array_type proc(state @mut State, annotation, initializer ast.NodeId, depth usize) ast.NodeId ! Error {
    type :: try canonical_type(state, annotation)
    if (type == no_node or depth >= 128 or ast.expr_kind(&state.tree, type) != .array_type) return type
    array :: ast.array_type(&state.tree, type)
    count := array.count
    element := array.element
    if (ast.expr_kind(&state.tree, initializer) == .array_literal) {
        length :: ast.array_element_count(&state.tree, initializer)
        if (count == null) {
            count = try ast.add_integer(state.builder, ast.node_span(&state.tree, initializer), u64(length))
            try refresh(state)
        }
        if (length != 0) element = try storage_array_type(state, element, ast.array_element(&state.tree, initializer, 0), depth + 1)
    } else if (count == null) {
        actual :: try expression_type(state, initializer, depth + 1)
        if (actual != no_node and ast.expr_kind(&state.tree, actual) == .array_type)
            count = ast.array_type(&state.tree, actual).count
    }
    unchanged_count :: if (array.count) |length| count != null and count? == length else count == null
    if (unchanged_count and element == array.element) return type
    result :: try ast.add_array_type(state.builder, ast.node_span(&state.tree, type), count, element, array.mutable)
    try refresh(state)
    return result
}

@hide:file
expression_type proc(state @mut State, id ast.NodeId, depth usize) ast.NodeId ! Error {
    if (id == no_node) return no_node
    if (depth >= 128) return no_node
    try expand(state, id)
    resolved :: binding(state, id)
    if (resolved.kind == .builtin and resolved.data.builtin != .type) return try builtin(state, id, .type)
    if (resolved.kind == .declaration) {
        target :: resolved.data.declaration
        if (hashmap.get(&state.capture_types, target)) |annotation| return try canonical_type(state, annotation)
        class :: ast.node_class(&state.tree, target)
        if (class == .parameter) {
            annotation :: ast.param(&state.tree, target).type
            return try canonical_type(state, annotation)
        }
        if (class == .statement) {
            declaration :: ast.statement_decl(&state.tree, target)
            if (declaration.type) |annotation|
                return try storage_array_type(state, annotation, declaration.initializer, depth + 1)
            return try expression_type(state, declaration.initializer, depth + 1)
        }
        if (class == .function) {
            params := arraylist.init(ast.NodeId, state.allocator)
            defer arraylist.deinit(&params)
            for (0..ast.function_param_count(&state.tree, target)) |i|
                try arraylist.append(&params, ast.function_param(&state.tree, target, i))
            result :: try ast.add_function_type(state.builder, ast.node_span(&state.tree, id),
                ast.function_decl(&state.tree, target).return_type, params.items)
            try refresh(state)
            return result
        }
        return no_node
    }
    kind :: ast.expr_kind(&state.tree, id)
    match kind {
        .record_type, .array_type, .slice_type, .pointer_type, .function_type, .optional_type,
        .enum_type, .union_type, .union_tag_type, .distinct_type, .fallible_type, .sum_type, .alias_expr:
            return try builtin(state, id, .type)
        .typed_constant, .slice_constant: {
            annotation :: if (kind == .slice_constant) ast.slice_constant(&state.tree, id).type
                else ast.typed_constant(&state.tree, id).type
            return if (is_type(state, annotation)) annotation else try canonical_type(state, annotation)
        }
        .memory_constant, .address_constant: {
            annotation :: if (kind == .memory_constant) ast.memory_constant(&state.tree, id).type
                else ast.address_constant(&state.tree, id).type
            return if (is_type(state, annotation)) annotation else try canonical_type(state, annotation)
        }
        .literal_int: return try builtin(state, id, .i64)
        .literal_float: return try builtin(state, id, .f64)
        .literal_bool: return try builtin(state, id, .bool)
        .literal_string: return try builtin(state, id, .string)
        .literal_void: return try builtin(state, id, .void)
        .block_expr: return try value_block_type(state, ast.block_expr(&state.tree, id), depth + 1)
        .match_expr: {
            result := no_node
            for (0..ast.match_arm_count(&state.tree, id)) |i| {
                arm :: ast.match_arm_view(&state.tree, ast.match_arm(&state.tree, id, i))
                annotation :: if (arm.expression) try expression_type(state, arm.body, depth + 1)
                    else try value_block_type(state, arm.body, depth + 1)
                if (annotation == no_node) continue
                result = annotation
                if (!arm.expression or !flexible(state, arm.body)) return result
            }
            return result
        }
        .builtin_call: {
            name :: ast.literal_text(&state.tree, ast.builtin_call(&state.tree, id).name)
            count :: ast.call_arg_count(&state.tree, id)
            if ((mem.eql(name, "sizeof") or mem.eql(name, "alignof")) and count == 1)
                return try builtin(state, id, .usize)
            if ((mem.eql(name, "maxval") or mem.eql(name, "minval")) and count == 1)
                return try canonical_type(state, ast.call_arg(&state.tree, id, 0))
            if ((mem.eql(name, "ptrcast") or mem.eql(name, "constcast")) and count == 2)
                return try canonical_type(state, ast.call_arg(&state.tree, id, 0))
            if ((mem.eql(name, "divtrunc") or mem.eql(name, "rem")) and count == 2) {
                left :: ast.call_arg(&state.tree, id, 0)
                right :: ast.call_arg(&state.tree, id, 1)
                operand :: if (flexible(state, left)) right else left
                return try expression_type(state, operand, depth + 1)
            }
            return no_node
        }
        .catch_expr, .try_expr: {
            operand :: if (kind == .catch_expr) ast.catch_expr(&state.tree, id).operand
                else ast.type_operand(&state.tree, id)
            type :: try expression_type(state, operand, depth + 1)
            if (type == no_node or ast.expr_kind(&state.tree, type) != .fallible_type) return no_node
            return try canonical_type(state, ast.binary_expr(&state.tree, type).left)
        }
        .record_literal: {
            view :: ast.record_literal(&state.tree, id)
            if (view.type) |annotation| return try canonical_type(state, annotation)
            fields := arraylist.init(ast.NodeId, state.allocator)
            defer arraylist.deinit(&fields)
            for (0..ast.record_field_count(&state.tree, id)) |i| {
                field :: ast.field(&state.tree, ast.record_field(&state.tree, id, i))
                if (field.value == null) return no_node
                type :: try expression_type(state, field.value?, depth + 1)
                if (type == no_node) return no_node
                generated :: try ast.add_field(state.builder, field.span, field.name, type, null)
                try refresh(state)
                try arraylist.append(&fields, generated)
            }
            result :: try ast.add_record_type(state.builder, ast.node_span(&state.tree, id), fields.items)
            try refresh(state)
            return result
        }
        .array_literal: {
            count :: ast.array_element_count(&state.tree, id)
            if (count == 0) return no_node
            element := try expression_type(state, ast.array_element(&state.tree, id, 0), depth + 1)
            if (element == no_node) return no_node
            # inferred values have concrete default widths even when a cast or
            # procedure result used the int/float annotation shorthand.
            scalar :: binding(state, element)
            if (scalar.kind == .builtin) {
                if (scalar.data.builtin == .int) element = try builtin(state, element, .i64)
                if (scalar.data.builtin == .float) element = try builtin(state, element, .f64)
            }
            length :: try ast.add_integer(state.builder, ast.node_span(&state.tree, id), u64(count))
            try refresh(state)
            result :: try ast.add_array_type(state.builder, ast.node_span(&state.tree, id), length, element, false)
            try refresh(state)
            return result
        }
        .call: {
            callee :: ast.call_expr(&state.tree, id).callee
            destination :: binding(state, callee)
            if (destination.kind == .builtin) return callee
            if (destination.kind == .declaration and ast.node_class(&state.tree, destination.data.declaration) == .function) return try canonical_type(state, ast.function_decl(&state.tree, destination.data.declaration).return_type)
            signature :: try expression_type(state, callee, depth + 1)
            if (signature != no_node and is_type(state, signature)) return try canonical_type(state, callee)
            if (signature != no_node and ast.expr_kind(&state.tree, signature) == .function_type)
                return try canonical_type(state, ast.callable_result(&state.tree, signature))
            return no_node
        }
        .unary: {
            view :: ast.unary_expr(&state.tree, id)
            operand :: try expression_type(state, view.operand, depth + 1)
            if (operand == no_node) return no_node
            if (view.operator == .address_of) {
                mutable := false
                target :: binding(state, view.operand)
                if (target.kind == .declaration and ast.node_class(&state.tree, target.data.declaration) == .statement)
                    mutable = ast.statement_decl(&state.tree, target.data.declaration).mutability == .variable
                result :: try ast.add_pointer_type(state.builder, view.span, operand, mutable, false)
                try refresh(state)
                return result
            }
            if (view.operator == .dereference and ast.expr_kind(&state.tree, operand) == .pointer_type)
                return try canonical_type(state, ast.pointer_type(&state.tree, operand).element)
            if (view.operator == .unwrap and ast.expr_kind(&state.tree, operand) == .optional_type)
                return try canonical_type(state, ast.type_operand(&state.tree, operand))
            return operand
        }
        .binary: {
            view :: ast.binary_expr(&state.tree, id)
            if (
                view.operator == .equal or view.operator == .not_equal or view.operator == .less
                or view.operator == .less_equal or view.operator == .greater or view.operator == .greater_equal
                or view.operator == .logical_and or view.operator == .logical_or
            ) return try builtin(state, id, .bool)
            if ((view.operator == .bit_and or view.operator == .bit_or or view.operator == .bit_xor)
                and flexible(state, view.left)) return try expression_type(state, view.right, depth + 1)
            return try expression_type(state, view.left, depth + 1)
        }
        .selection: {
            view :: ast.selection_expr(&state.tree, id)
            base := try expression_type(state, view.base, depth + 1)
            if (base == no_node) return no_node
            if (is_type(state, base)) {
                selected :: try canonical_type(state, view.base)
                if (selected != no_node and ast.expr_kind(&state.tree, selected) == .enum_type) return selected
            }
            if (ast.expr_kind(&state.tree, base) == .pointer_type) base = try canonical_type(state, ast.pointer_type(&state.tree, base).element)
            if (base == no_node) return no_node
            member :: ast.literal_text(&state.tree, view.member)
            base_kind :: ast.expr_kind(&state.tree, base)
            if (
                mem.eql(member, "len") and (
                    base_kind == .array_type or base_kind == .slice_type
                    or (binding(state, base).kind == .builtin and binding(state, base).data.builtin == .string)
                )
            )
                return try builtin(state, id, .usize)
            if (mem.eql(member, "ptr")) {
                element := no_node
                mutable := false
                if (base_kind == .array_type) {
                    element = ast.array_type(&state.tree, base).element
                    mutable = ast.array_type(&state.tree, base).mutable
                }
                if (base_kind == .slice_type) {
                    element = ast.slice_type(&state.tree, base).element
                    mutable = ast.slice_type(&state.tree, base).mutable
                }
                if (binding(state, base).kind == .builtin and binding(state, base).data.builtin == .string)
                    element = try builtin(state, id, .u8)
                if (element != no_node) {
                    result :: try ast.add_pointer_type(state.builder, view.span, element, mutable, true)
                    try refresh(state)
                    return result
                }
            }
            if (base_kind != .record_type and base_kind != .union_type) return no_node
            slot :: type_record_slot(&state.tree, base, view.member)
            if (slot == no_index) return no_node
            return try canonical_type(state, ast.field(&state.tree, ast.record_field(&state.tree, base, slot)).type?)
        }
        .index: {
            view :: ast.index_expr(&state.tree, id)
            base :: try expression_type(state, view.base, depth + 1)
            if (base == no_node) return no_node
            base_kind :: ast.expr_kind(&state.tree, base)
            if (base_kind == .array_type) {
                element :: ast.array_type(&state.tree, base).element
                return if (is_type(state, element)) element else try canonical_type(state, element)
            }
            if (base_kind == .slice_type) return try canonical_type(state, ast.slice_type(&state.tree, base).element)
            if (base_kind == .pointer_type) return try canonical_type(state, ast.pointer_type(&state.tree, base).element)
            if (binding(state, base).kind == .builtin and binding(state, base).data.builtin == .string) return try builtin(state, id, .u8)
            return no_node
        }
        .slice: {
            view :: ast.slice_expr(&state.tree, id)
            base :: try expression_type(state, view.base, depth + 1)
            if (base == no_node) return no_node
            base_kind :: ast.expr_kind(&state.tree, base)
            element := no_node
            mutable := false
            if (base_kind == .array_type) {
                element = ast.array_type(&state.tree, base).element
                mutable = ast.array_type(&state.tree, base).mutable
            }
            if (base_kind == .pointer_type) {
                element = ast.pointer_type(&state.tree, base).element
                mutable = ast.pointer_type(&state.tree, base).mutable
            }
            if (base_kind == .slice_type) {
                element = ast.slice_type(&state.tree, base).element
                mutable = ast.slice_type(&state.tree, base).mutable
            }
            if (element == no_node) return no_node
            result :: try ast.add_slice_type(state.builder, ast.node_span(&state.tree, id), element, mutable, null)
            try refresh(state)
            return result
        }
        else: return no_node
    }
}

@hide:file
parameter_index proc(state @State, function, id ast.NodeId) usize {
    for (0..ast.function_param_count(&state.tree, function)) |i| {
        if (ast.function_param(&state.tree, function, i) == id and ast.param(&state.tree, id).comptime) return i
    }
    return no_index
}

@hide:file
infer_value proc(state @mut State, function, pattern ast.NodeId, actual Value, arguments []mut Value, contextual bool) bool ! Error {
    resolved :: binding(state, pattern)
    if (resolved.kind == .declaration) {
        index :: parameter_index(state, function, resolved.data.declaration)
        if (index != no_index) {
            if (arguments[index].kind == .invalid) {
                arguments[index] = actual
                return true
            }
            if (contextual and arguments[index].kind == .type and actual.kind == .type) return true
            return try value_equal(state, arguments[index], actual)
        }
    }
    return try value_equal(state, try evaluate(state, pattern), actual)
}

@hide:file
infer proc(state @mut State, function, pattern, actual ast.NodeId, arguments []mut Value, contextual bool) bool ! Error {
    resolved :: binding(state, pattern)
    if (resolved.kind == .builtin and resolved.data.builtin == .uint) return try unsigned_type(state, actual)
    if (resolved.kind == .declaration) {
        index :: parameter_index(state, function, resolved.data.declaration)
        if (index != no_index) {
            if (arguments[index].kind == .type) {
                expected :: try canonical_type(state, arguments[index].node)
                # a fixed slice type supplies borrowing/string context; ordinary
                # argument checking owns element, mutability and sentinel validation.
                if (expected != no_node and ast.expr_kind(&state.tree, expected) == .slice_type) return true
            }
            return try infer_value(state, function, pattern, Value{ kind = .type, node = actual }, arguments, contextual)
        }
    }
    # only normalize the actual type: the pattern may still contain unbound
    # parameters or a type-generator call whose arguments must be inferred.
    concrete :: try canonical_type(state, actual)
    if (concrete == no_node) return false
    kind :: ast.expr_kind(&state.tree, pattern)
    actual_kind :: ast.expr_kind(&state.tree, concrete)
    match kind {
        .pointer_type: {
            if (actual_kind != .pointer_type) return false
            return try infer(state, function, ast.pointer_type(&state.tree, pattern).element,
                ast.pointer_type(&state.tree, concrete).element, arguments, contextual)
        }
        .slice_type: {
            element := no_node
            if (actual_kind == .slice_type) element = ast.slice_type(&state.tree, concrete).element
            if (actual_kind == .array_type) element = ast.array_type(&state.tree, concrete).element
            scalar :: binding(state, concrete)
            if (scalar.kind == .builtin and scalar.data.builtin == .string)
                element = try builtin(state, concrete, .u8)
            if (element == no_node) return false
            return try infer(state, function, ast.slice_type(&state.tree, pattern).element, element, arguments, contextual)
        }
        .array_type: {
            if (actual_kind != .array_type) return false
            p :: ast.array_type(&state.tree, pattern)
            a :: ast.array_type(&state.tree, concrete)
            if (p.count) |count| {
                if (a.count == null or !try infer_value(state, function, count, try evaluate(state, a.count?), arguments, false)) return false
            }
            return try infer(state, function, p.element, a.element, arguments, contextual)
        }
        .optional_type: {
            element :: if (actual_kind == .optional_type) ast.type_operand(&state.tree, concrete) else concrete
            return try infer(state, function, ast.type_operand(&state.tree, pattern), element, arguments, contextual)
        }
        .fallible_type: {
            if (actual_kind != .fallible_type) return false
            p :: ast.binary_expr(&state.tree, pattern)
            a :: ast.binary_expr(&state.tree, concrete)
            return (try infer(state, function, p.left, a.left, arguments, contextual)
                and try infer(state, function, p.right, a.right, arguments, contextual))
        }
        .function_type: {
            if (actual_kind != .function_type) return false
            count :: ast.function_param_count(&state.tree, pattern)
            if (count != ast.function_param_count(&state.tree, concrete)) return false
            for (0..count) |i| {
                p :: ast.param(&state.tree, ast.function_param(&state.tree, pattern, i)).type
                a :: ast.param(&state.tree, ast.function_param(&state.tree, concrete, i)).type
                if (!try infer(state, function, p, a, arguments, contextual)) return false
            }
            return try infer(state, function, ast.callable_result(&state.tree, pattern),
                ast.callable_result(&state.tree, concrete), arguments, contextual)
        }
        .call: {
            callee :: binding(state, ast.call_expr(&state.tree, pattern).callee)
            if (callee.kind != .declaration) return false
            for (0..(state.instances.items.len)) |i| {
                instance :: state.instances.items[i]
                if (instance.type == no_node or instance.function != callee.data.declaration) continue
                if (try canonical_type(state, instance.type) != concrete) continue
                count :: ast.call_arg_count(&state.tree, pattern)
                if (count != instance.arguments.len) return false
                for (0..count) |j| {
                    if (!try infer_value(state, function, ast.call_arg(&state.tree, pattern, j), instance.arguments[j], arguments, contextual)) return false
                }
                return true
            }
            return false
        }
        else: return true
    }
}

@hide:file
infer_result proc(
    state @mut State,
    function, pattern, actual ast.NodeId,
    arguments []mut Value,
) bool ! Error {
    concrete :: try canonical_type(state, actual)
    if (concrete == no_node) return true
    if (
        ast.expr_kind(&state.tree, concrete) == .optional_type
        and ast.expr_kind(&state.tree, pattern) != .optional_type
    ) {
        resolved :: binding(state, pattern)
        if (resolved.kind == .declaration) {
            index :: parameter_index(state, function, resolved.data.declaration)
            if (index != no_index) {
                if (arguments[index].kind == .invalid)
                    return try infer(state, function, pattern, concrete, arguments, false)
                if (arguments[index].kind == .type and try same_type(state, arguments[index].node, concrete)) return true
            }
        }
        return try infer_result(state, function, pattern, ast.type_operand(&state.tree, concrete), arguments)
    }
    if (
        ast.expr_kind(&state.tree, concrete) == .fallible_type
        and ast.expr_kind(&state.tree, pattern) != .fallible_type
    ) return try infer_result(state, function, pattern, ast.binary_expr(&state.tree, concrete).left, arguments)
    if (ast.expr_kind(&state.tree, pattern) == .fallible_type) {
        view :: ast.binary_expr(&state.tree, pattern)
        if (ast.expr_kind(&state.tree, concrete) != .fallible_type)
            return try infer_result(state, function, view.left, concrete, arguments)
        channels :: ast.binary_expr(&state.tree, concrete)
        return (try infer_result(state, function, view.left, channels.left, arguments)
            and try infer_result(state, function, view.right, channels.right, arguments))
    }
    return try infer(state, function, pattern, concrete, arguments, false)
}

@hide:file
materialize proc(state @mut State, value Value) Value ! Error {
    result := value
    span :: ast.node_span(&state.tree, value.node)
    if (value.kind == .type and nominal_type_value(state, value.node)) {
        # refer to declared nominal types, rather than reusing their definition as
        # an annotation and turning its value-role checker cell into an annotation.
        for (state.declarations.items) |declaration| {
            if (
                ast.node_class(&state.tree, declaration) == .statement
                and ast.statement_decl(&state.tree, declaration).initializer == value.node
            ) {
                result.node = try reference(state, value.node, declaration)
                return result
            }
        }
    }
    if (value.kind == .integer) {
        result.node = try ast.add_integer(state.builder, span, value.magnitude)
        if (value.negative) result.node = try ast.add_unary(state.builder, span, .negate, result.node)
    } else if (value.kind == .boolean) {
        result.node = try ast.add_boolean(state.builder, span, value.boolean)
    } else if (value.kind == .real) {
        result.node = try ast.add_float(state.builder, span, ptrcast!(@f64, &value.magnitude)^)
    }
    try refresh(state)
    return result
}

@hide:file
valid_value proc(state @mut State, annotation ast.NodeId, value Value) bool ! Error {
    type :: try canonical_type(state, annotation)
    if (type == no_node) return false
    resolved :: binding(state, type)
    if (resolved.kind == .builtin) {
        kind :: resolved.data.builtin
        if (kind == .bool) return value.kind == .boolean
        if (kind == .string) return value.kind == .string
        if (kind == .float or kind == .f64) return value.kind == .real
        if (kind == .void) return (
            value.kind == .aggregate and value.annotation != no_node
            and try same_type(state, type, value.annotation)
        )
        if (value.kind != .integer) return false
        bits := u32(64)
        signed := false
        match kind {
            .i8, .c_char: {
                bits = 8
                signed = true
            }
            .i16, .c_short: {
                bits = 16
                signed = true
            }
            .i32, .c_int: {
                bits = 32
                signed = true
            }
            .int, .i64, .isize, .c_long, .c_longlong: signed = true
            .u8, .c_uchar: bits = 8
            .u16, .c_ushort: bits = 16
            .u32, .c_uint: bits = 32
            .u64, .uint, .usize, .c_ulong, .c_ulonglong: {}
            else: return false
        }
        limit := maxval!(u64)
        if (signed) {
            limit = u64(1) << (bits - 1)
            if (!value.negative) limit -= 1
        } else {
            if (value.negative) return false
            if (bits != 64) limit = (u64(1) << bits) - 1
        }
        return value.magnitude <= limit
    }
    kind :: ast.expr_kind(&state.tree, type)
    if (value.kind == .aggregate) return value.annotation != no_node and try same_type(state, type, value.annotation)
    if (kind == .optional_type) return value.kind == .null or try valid_value(state, ast.type_operand(&state.tree, type), value)
    if (kind == .slice_type and value.kind == .string) {
        view :: ast.slice_type(&state.tree, type)
        child :: try canonical_type(state, view.element)
        return (
            !view.mutable and child != no_node and binding(state, child).kind == .builtin
            and binding(state, child).data.builtin == .u8
        )
    }
    if (kind == .function_type and value.kind == .function) {
        actual :: try expression_type(state, value.node, 0)
        return actual != no_node and try same_type(state, type, actual)
    }
    if (kind == .distinct_type) return try valid_value(state, ast.type_operand(&state.tree, type), value)
    return false
}

@hide:file
enum_index proc($T type, value T) usize {
    match typeinfo!(T) {
        .enum |info|: {
            inline for (info.fields) |field| {
                if (value == field!(T, field.name)) return field.index
            }
            unreachable
        }
        else: unreachable
    }
}

@hide:file
remember proc(state @mut State, target ast.NodeId) void ! mem.AllocError {
    if (usize(target) >= state.original_count) return
    saved :: try ast.copy_node(state.builder, target)
    try arraylist.append(&state.rewrites.changes, Rewrite{ target = target, saved = saved })
}

@hide:file
replace proc(state @mut State, target, source ast.NodeId) void ! mem.AllocError {
    try remember(state, target)
    ast.replace_node(state.builder, target, source)
}

@hide:file
builtin_identities :: $enummap.init_default(
    sema.BuiltinType,
    sema.BuiltinType,
    sema.BuiltinType.type, {
    i64 = .int, c_long = .int, c_longlong = .int,
    f64 = .float,
    uint = .u64, c_ulong = .u64, c_ulonglong = .u64,
    c_char = .i8,
    c_uchar = .u8,
    c_short = .i16,
    c_ushort = .u16,
    c_int = .i32,
    c_uint = .u32,
})

@hide:file
builtin_identity proc(kind sema.BuiltinType) sema.BuiltinType {
    if (enummap.get(&builtin_identities, kind)) |identity| return identity
    return kind
}

@hide:file
integer_type proc(state @mut State, annotation ast.NodeId) bool ! Error {
    type :: try canonical_type(state, annotation)
    if (type == no_node) return false
    resolved :: binding(state, type)
    if (resolved.kind == .builtin) {
        return match builtin_identity(resolved.data.builtin) {
            .int, .i8, .i16, .i32, .isize, .u8, .u16, .u32, .u64, .usize: true
            else: false
        }
    }
    if (ast.expr_kind(&state.tree, type) == .distinct_type) return try integer_type(state, ast.type_operand(&state.tree, type))
    return false
}

@hide:file
integer_value proc(state @mut State, id ast.NodeId, magnitude u64, negative bool, annotation ast.NodeId) Value ! Error {
    result :: Value{ kind = .integer, node = id, magnitude = magnitude, negative = negative, annotation = annotation }
    if (annotation != no_node and !try valid_value(state, annotation, result)) return Value{}
    return result
}

@hide:file
same_string proc(state @State, left, right ast.NodeId) bool ! Error {
    a :: ast.literal_text(&state.tree, left)
    b :: ast.literal_text(&state.tree, right)
    ac := usize(1)
    bc := usize(1)
    while (ac < a.len - 1 and bc < b.len - 1) {
        av :: ast.string_next(a, &ac) catch { return false }
        bv :: ast.string_next(b, &bc) catch { return false }
        if (av != bv) return false
    }
    return ac == a.len - 1 and bc == b.len - 1
}

@hide:file
flexible proc(state @State, id ast.NodeId) bool {
    kind :: ast.expr_kind(&state.tree, id)
    if (kind == .literal_int or kind == .literal_float) return true
    if (kind == .unary) {
        view :: ast.unary_expr(&state.tree, id)
        return (view.operator == .negate or view.operator == .bit_not) and flexible(state, view.operand)
    }
    if (kind == .binary) {
        view :: ast.binary_expr(&state.tree, id)
        return (
            (view.operator == .add or view.operator == .subtract or view.operator == .multiply or view.operator == .divide
                or view.operator == .bit_and or view.operator == .bit_or or view.operator == .bit_xor
                or view.operator == .shift_left or view.operator == .shift_right or view.operator == .shift_left_saturating)
            and flexible(state, view.left) and flexible(state, view.right)
        )
    }
    return false
}

@hide:file
unsigned_parameter proc(state @State, parameter ast.NodeId) bool {
    view :: ast.param(&state.tree, parameter)
    resolved :: binding(state, view.type)
    return !view.comptime and resolved.kind == .builtin and resolved.data.builtin == .uint
}

@hide:file
unsigned_type proc(state @mut State, annotation ast.NodeId) bool ! Error {
    concrete :: try canonical_type(state, annotation)
    if (concrete == no_node) return false
    if (ast.expr_kind(&state.tree, concrete) == .distinct_type)
        return try unsigned_type(state, ast.type_operand(&state.tree, concrete))
    resolved :: binding(state, concrete)
    if (resolved.kind != .builtin) return false
    return match builtin_identity(resolved.data.builtin) {
        .u8, .u16, .u32, .u64, .usize: true
        else: false
    }
}

@hide:file
template proc(state @State, id ast.NodeId) bool {
    if (ast.function_generic(&state.tree, id) or compiletime_call(state, id)) return true
    for (0..ast.function_param_count(&state.tree, id)) |i| {
        if (unsigned_parameter(state, ast.function_param(&state.tree, id, i))) return true
    }
    return false
}
