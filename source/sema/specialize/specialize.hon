import "@std/mem"
import "@std/arraylist"
import "@std/hashmap"
import "@std/enummap"
import "@std/strconv"
import "@source/ast"
import "@source/diagnostics"
import "@source/strpool"
import "@source/lower"
import "@source/interpreter"
import "@source/ir"

sema :: import "@source/sema"
typecheck :: import "@source/sema/check"

@hide:file no_node :: maxval!(ast.NodeId)
@hide:file no_index :: maxval!(usize)
# metadata snapshots revisit complete field schemas; reflected compositions need
# the same finite step ceiling as ordinary checked evaluation.
@hide:file type_execution_limit :: usize(100000)
# ponytail: snapshot evaluation copies arena-sized bindings; compact it before raising control-flow fuel.
@hide:file type_control_limit :: usize(4096)

@hide:file
Error :: alias mem.AllocError | diagnostics.CapacityError | strpool.InternError

@hide:file
ValueKind :: enum {
    invalid
    type
    integer
    boolean
    string
    function
    null
    real
    aggregate
}

@hide:file
Value :: struct {
    kind ValueKind = .invalid
    node ast.NodeId = no_node
    magnitude u64 = 0
    negative bool = false
    boolean bool = false
    annotation ast.NodeId = no_node
}

@hide:file
Instance :: struct {
    function ast.NodeId
    arguments []mut Value
    declaration ast.NodeId = no_node
    type ast.NodeId = no_node
    next usize = no_index
    diagnostic diagnostics.DiagnosticId = diagnostics.no_diagnostic
    signature ast.NodeId = no_node
    value ast.NodeId = no_node
    demanded bool = false
}

@hide:file
Rewrite :: struct { target ast.NodeId, saved ast.NodeId }

#! owns an undo log and retained checking obligations; deinit releases them with their retained allocator.
#! borrows the caller's AST builder; call deinit before finishing or deinitializing that builder.
#! generated nodes remain arena-owned and are released with the AST.
Result :: struct {
    builder @mut ast.Builder
    changes arraylist.ArrayList(Rewrite)
    constraints arraylist.ArrayList(ast.NodeId)
}

#! restores rewritten source nodes in the borrowed builder and releases the undo log and checking obligations.
#! does not remove generated arena nodes or restore resolution bindings.
deinit proc(result @mut Result) void {
    index := result.changes.items.len
    while (index > 0) {
        index -= 1
        change :: result.changes.items[index]
        ast.replace_node_from_source(result.builder, change.target, change.saved)
    }
    arraylist.deinit(&result.changes)
    arraylist.deinit(&result.constraints)
}

@hide:file
State :: struct {
    allocator mem.Allocator
    builder @mut ast.Builder
    tree ast.Tree
    strings @mut strpool.StringPool
    bindings arraylist.ArrayList(sema.Binding)
    declarations arraylist.ArrayList(ast.NodeId)
    instances arraylist.ArrayList(Instance)
    cache hashmap.AutoHashMap(usize, usize)
    expanded arraylist.ArrayList(u8)
    capture_types hashmap.AutoHashMap(ast.NodeId, ast.NodeId)
    diagnostics @mut diagnostics.Store
    depth usize = 0
    original_count usize
    rewrites @mut Result
    mapping []mut ast.NodeId
    resolution @mut sema.Resolution
    evaluation_diagnostic diagnostics.DiagnosticId = diagnostics.no_diagnostic
    type_execution_depth usize = 0
    type_execution_remaining usize = 0
    type_control_remaining usize = 0
    value_expansion_depth usize = 0
    return_type ast.NodeId = no_node
    yield_type ast.NodeId = no_node
    demand_depth usize = 0
    snapshot_uninitialized bool = false
    demanded_functions []mut u8
    execution_functions []mut u8
    execution_visited arraylist.ArrayList(ast.NodeId)
    metadata_views arraylist.ArrayList(MetadataView)
    metadata_view_indices hashmap.AutoHashMap(ast.NodeId, usize)
    metadata_runtime_depth usize = 0
    snapshot_roots ?@mut arraylist.ArrayList(SnapshotRoot) = null
    snapshot_scan_remaining usize = 0
}

#! elaborates templates into cached concrete declarations in the caller-owned `builder` arena.
#! extends `resolution` to cover generated nodes; no template reaches checking or lowering.
#! `allocator` supplies returned logs, temporary storage released on every exit, and replacement resolution bindings.
#! use the allocator retained by `resolution`; the returned Result borrows `builder` until the caller calls deinit.
#! on failure, restores rewritten source nodes and releases logs; generated nodes remain arena-owned.
elaborate proc(
    allocator mem.Allocator,
    builder @mut ast.Builder,
    root ast.NodeId,
    resolution @mut sema.Resolution,
    strings @mut strpool.StringPool,
    diagnostic_store @mut diagnostics.Store,
) Result ! Error {
    result := Result{ builder = builder, changes = arraylist.init(allocator), constraints = arraylist.init(allocator) }
    errdefer deinit(&result)
    # explicit evaluation is useful even in packages without generic declarations.
    original :: ast.view(builder, root)
    needed := false
    for (0..ast.node_count(&original)) |i| {
        id :: ast.NodeId(i)
        class :: ast.node_class(&original, id)
        if (class == .expression
            and (ast.expr_kind(&original, id) == .comptime_expr or ast.expr_kind(&original, id) == .block_expr))
            needed = true
        if (class == .expression and ast.expr_kind(&original, id) == .binary
            and ast.binary_expr(&original, id).operator == .bit_or) needed = true
        if (class == .statement and ast.stmt_kind(&original, id) == .for_stmt
            and ast.for_stmt(&original, id).is_inline) needed = true
        if (class == .match_arm and ast.match_arm_view(&original, id).is_inline) needed = true
        if (class == .expression and ast.expr_kind(&original, id) == .builtin_call) {
            name :: ast.builtin_call(&original, id).name
            text :: ast.source_text(&original, ast.node_span(&original, name))
            if (mem.eql(text, "field") or mem.eql(text, "struct_type") or mem.eql(text, "typeinfo")
                or mem.eql(text, "compile_error")) needed = true
        }
        if (class == .function and ast.function_generic(&original, id)) needed = true
        if (class == .function) {
            if (type_storage_annotation(&original, resolution.storage.bindings,
                ast.function_decl(&original, id).return_type, 0)) needed = true
            for (0..ast.function_param_count(&original, id)) |position| {
                parameter :: ast.param(&original, ast.function_param(&original, id, position))
                resolved :: resolution.storage.bindings[usize(parameter.type)]
                if (!parameter.comptime and resolved.kind == .builtin and resolved.data.builtin == .uint) needed = true
                if (!parameter.comptime and type_storage_annotation(&original,
                    resolution.storage.bindings, parameter.type, 0)) needed = true
            }
            if (!ast.function_external(&original, id)
                and type_local_storage(&original, resolution.storage.bindings,
                    ast.function_decl(&original, id).body, 0)) needed = true
        }
        if (class == .statement and ast.stmt_kind(&original, id) == .declaration
            and type_storage_annotation(&original, resolution.storage.bindings,
                ast.statement_decl(&original, id).initializer, 0)) needed = true
        if (needed) break
    }
    if (!needed) return result
    mapping :: try mem.alloc(ast.NodeId, allocator, ast.node_count(&original))
    defer mem.free(allocator, mapping)
    demanded_functions :: try mem.alloc(u8, allocator, ast.node_count(&original))
    defer mem.free(allocator, demanded_functions)
    mem.set(demanded_functions, 0)
    execution_functions :: try mem.alloc(u8, allocator, ast.node_count(&original))
    defer mem.free(allocator, execution_functions)
    mem.set(execution_functions, 0)
    state := State{
        allocator = allocator, builder = builder, tree = ast.view(builder, root), strings = strings,
        bindings = arraylist.init(allocator), declarations = arraylist.init(allocator),
        instances = arraylist.init(allocator), cache = hashmap.init(allocator),
        capture_types = hashmap.init(allocator),
        expanded = arraylist.init(allocator), diagnostics = diagnostic_store,
        original_count = ast.node_count(&original),
        rewrites = &result,
        mapping = mapping,
        resolution = resolution,
        demanded_functions = demanded_functions,
        execution_functions = execution_functions,
        execution_visited = arraylist.init(allocator),
        metadata_views = arraylist.init(allocator),
        metadata_view_indices = hashmap.init(allocator),
    }
    defer arraylist.deinit(&state.bindings)
    defer arraylist.deinit(&state.declarations)
    defer arraylist.deinit(&state.expanded)
    defer hashmap.deinit(&state.cache)
    defer hashmap.deinit(&state.capture_types)
    defer arraylist.deinit(&state.execution_visited)
    defer arraylist.deinit(&state.metadata_views)
    defer hashmap.deinit(&state.metadata_view_indices)
    defer {
        for (state.instances.items) |instance| mem.free(allocator, instance.arguments)
        arraylist.deinit(&state.instances)
    }
    count :: ast.node_count(&state.tree)
    for (0..count) |i| try arraylist.append(&state.bindings, sema.binding(resolution, ast.NodeId(i)))
    try collect_demanded_functions(&state, root, false)
    for (0..ast.package_decl_count(&state.tree)) |i| {
        id :: ast.package_decl(&state.tree, i)
        if (ast.decl_kind(&state.tree, id) == .function
            and (template(&state, id) or state.demanded_functions[usize(id)] == 1)) continue
        try arraylist.append(&state.declarations, id)
    }
    index := 0
    while (index < state.declarations.items.len) {
        try expand(&state, state.declarations.items[index])
        index += 1
    }
    # metadata definitions have no runtime layout. retain their AST and bindings:
    # surviving runtime annotations still resolve the definition and are rejected.
    retained := usize(0)
    index = 0
    while (index < state.declarations.items.len) {
        declaration :: state.declarations.items[index]
        index += 1
        if (ast.node_class(&state.tree, declaration) == .statement
            and ast.stmt_kind(&state.tree, declaration) == .declaration) {
            view :: ast.statement_decl(&state.tree, declaration)
            if (view.mutability == .constant and type_record_storage(&state, view.initializer, 0)) {
                begin_type_execution(&state)
                defer state.type_execution_depth -= 1
                state.evaluation_diagnostic = diagnostics.no_diagnostic
                if (try type_record_check(&state, view.initializer)) continue
                try reject_evaluation(&state, view.initializer)
            }
        }
        state.declarations.items[retained] = declaration
        retained += 1
    }
    state.declarations.items = state.declarations.items[..retained]
    try remember(&state, root)
    try ast.set_package_declarations(builder, root, state.declarations.items)
    try refresh(&state)
    owned :: try mem.alloc(sema.Binding, allocator, state.bindings.items.len)
    memcopy!(owned, state.bindings.items)
    sema.replace_bindings(resolution, owned)
    return result
}

@hide:file
refresh proc(state @mut State) void ! mem.AllocError {
    state.tree = ast.view(state.builder, state.tree.root)
    count :: ast.node_count(&state.tree)
    while (state.bindings.items.len < count) try arraylist.append(&state.bindings, sema.Binding{})
    while (state.expanded.items.len < count) try arraylist.append(&state.expanded, u8(0))
}

@hide:file
binding proc(state @State, id ast.NodeId) sema.Binding {
    if (usize(id) >= state.bindings.items.len) return sema.Binding{}
    return state.bindings.items[usize(id)]
}

@hide:file
reject proc(state @mut State, id ast.NodeId, code diagnostics.Code) void ! Error {
    span :: ast.node_span(&state.tree, id)
    diagnostic :: try diagnostics.add(state.diagnostics, code, span)
    invalid :: try ast.add_invalid_expr(state.builder, span, diagnostic)
    try replace(state, id, invalid)
    try refresh(state)
    state.bindings.items[usize(id)] = sema.Binding{ kind = .invalid, data = sema.BindingData{ diagnostic = diagnostic } }
}

@hide:file
expand_compile_error proc(state @mut State, id ast.NodeId) void ! Error {
    if (ast.call_arg_count(&state.tree, id) != 1) {
        try reject(state, id, .invalid_compile_error)
        return
    }
    state.evaluation_diagnostic = diagnostics.no_diagnostic
    value :: try evaluate(state, ast.call_arg(&state.tree, id, 0))
    if (value.kind != .string) {
        if (state.evaluation_diagnostic != diagnostics.no_diagnostic) try reject_evaluation(state, id)
        else try reject(state, id, .invalid_compile_error)
        return
    }
    text :: ast.literal_text(&state.tree, value.node)
    bytes := arraylist.init(u8, state.allocator)
    defer arraylist.deinit(&bytes)
    cursor := usize(1)
    while (cursor < text.len - 1) {
        byte :: ast.string_next(text, &cursor) catch {
            try reject(state, id, .invalid_escape)
            return
        }
        try arraylist.append(&bytes, byte)
    }
    state.evaluation_diagnostic = try diagnostics.add_message(state.diagnostics,
        .compile_error, ast.node_span(&state.tree, id), bytes.items)
    try reject_evaluation(state, id)
}

# ordinary constant calls retain one interpreter frame and its aliases. only
# bodies whose type-control operations need value-dependent execution use snapshots.
@hide:file
metadata_capture proc(state @State, id, capture ast.NodeId) bool {
    if (ast.node_class(&state.tree, id) == .expression and ast.expr_kind(&state.tree, id) == .match_expr) {
        subject :: ast.match_expr(&state.tree, id).subject
        if (ast.expr_kind(&state.tree, subject) == .builtin_call
            and mem.eql(ast.literal_text(&state.tree, ast.builtin_call(&state.tree, subject).name), "typeinfo")) {
            for (0..ast.match_arm_count(&state.tree, id)) |i| {
                arm :: ast.match_arm_view(&state.tree, ast.match_arm(&state.tree, id, i))
                if (arm.capture != null and arm.capture? == capture) return true
            }
        }
    }
    for (0..ast.child_count(&state.tree, id)) |i|
        if (metadata_capture(state, ast.child(&state.tree, id, i), capture)) return true
    return false
}

@hide:file
runtime_dependency proc(state @State, id, body ast.NodeId, depth usize) bool {
    if (depth >= 128) return true
    resolved :: binding(state, id)
    if (resolved.kind == .declaration) {
        declaration :: resolved.data.declaration
        class :: ast.node_class(&state.tree, declaration)
        if (class == .parameter) return !ast.param(&state.tree, declaration).comptime
        if (class == .statement) {
            view :: ast.statement_decl(&state.tree, declaration)
            return view.mutability == .variable or runtime_dependency(state, view.initializer, body, depth + 1)
        }
        if (class == .expression) return !metadata_capture(state, body, declaration)
    }
    for (0..ast.child_count(&state.tree, id)) |i|
        if (runtime_dependency(state, ast.child(&state.tree, id, i), body, depth + 1)) return true
    return false
}

@hide:file
scan_demand_execution proc(state @mut State, id, body ast.NodeId, static_control bool) bool ! mem.AllocError {
    class :: ast.node_class(&state.tree, id)
    if (static_control and class == .statement and ast.stmt_kind(&state.tree, id) == .if_stmt) {
        conditional :: ast.if_stmt(&state.tree, id)
        if (try scan_demand_execution(state, conditional.condition, body, true)) return true
        selected_statically :: !runtime_dependency(state, conditional.condition, body, 0)
        if (try scan_demand_execution(state, conditional.then_block, body, selected_statically)) return true
        if (conditional.else_block) |other|
            if (try scan_demand_execution(state, other, body, selected_statically)) return true
        return false
    }
    if (class == .expression) {
        kind :: ast.expr_kind(&state.tree, id)
        if (!static_control and kind == .builtin_call
            and mem.eql(ast.literal_text(&state.tree, ast.builtin_call(&state.tree, id).name), "compile_error")) return true
        if (kind == .array_type) {
            if (ast.array_type(&state.tree, id).count) |count|
                if (runtime_dependency(state, count, body, 0)) return true
        }
        if (kind == .match_expr) {
            subject :: ast.match_expr(&state.tree, id).subject
            if (ast.expr_kind(&state.tree, subject) == .builtin_call
                and mem.eql(ast.literal_text(&state.tree, ast.builtin_call(&state.tree, subject).name), "typeinfo")) {
                for (0..ast.match_arm_count(&state.tree, id)) |i| {
                    arm :: ast.match_arm_view(&state.tree, ast.match_arm(&state.tree, id, i))
                    if (try scan_demand_execution(state, arm.body, body, true)) return true
                }
                return false
            }
        }
        if (kind == .index) {
            view :: ast.index_expr(&state.tree, id)
            root := view.base
            while (ast.expr_kind(&state.tree, root) == .selection)
                root = ast.selection_expr(&state.tree, root).base
            resolved :: binding(state, root)
            if (resolved.kind == .declaration and runtime_dependency(state, view.index, body, 0)
                and metadata_capture(state, body, resolved.data.declaration)) return true
        }
        if (kind == .call) {
            callee :: binding(state, ast.call_expr(&state.tree, id).callee)
            if (callee.kind == .declaration and usize(callee.data.declaration) < state.original_count
                and ast.node_class(&state.tree, callee.data.declaration) == .function
                and !ast.function_external(&state.tree, callee.data.declaration)
                and !compiletime_call(state, callee.data.declaration)) {
                function :: callee.data.declaration
                flag :: state.execution_functions[usize(function)]
                if (flag == 2) return true
                if (flag == 0) {
                    try arraylist.append(&state.execution_visited, function)
                    state.execution_functions[usize(function)] = 3
                    called_body :: ast.function_decl(&state.tree, function).body
                    if (try scan_demand_execution(state, called_body, called_body, false)) return true
                }
            }
        }
    }
    for (0..ast.child_count(&state.tree, id)) |i|
        if (try scan_demand_execution(state, ast.child(&state.tree, id, i), body, static_control)) return true
    return false
}

@hide:file
needs_demand_execution proc(state @mut State, function ast.NodeId) bool ! mem.AllocError {
    if (usize(function) >= state.original_count) return false
    flag :: state.execution_functions[usize(function)]
    if (flag == 1) return false
    if (flag == 2) return true
    defer {
        for (state.execution_visited.items) |visited| {
            if (state.execution_functions[usize(visited)] == 3) state.execution_functions[usize(visited)] = 0
        }
        state.execution_visited.items = state.execution_visited.items[..0]
    }
    try arraylist.append(&state.execution_visited, function)
    state.execution_functions[usize(function)] = 3
    body :: ast.function_decl(&state.tree, function).body
    required :: try scan_demand_execution(state, body, body, false)
    if (!required) {
        for (state.execution_visited.items) |visited| state.execution_functions[usize(visited)] = 1
    } else state.execution_functions[usize(function)] = 2
    return required
}

# optional zero-runtime execution only admits closed computations. in particular,
# writes through parameters, external calls, and mutable globals remain runtime.
# ponytail: a syntax proof rejects indirect calls and recursion; broaden only with
# an effect-aware speculative evaluator that can roll back all elaboration state.
@hide:file
closed_computation proc(state @State, id, body ast.NodeId, depth usize) bool {
    if (depth >= 128) return false
    resolved :: binding(state, id)
    if (resolved.kind == .declaration) {
        target :: resolved.data.declaration
        if (ast.node_class(&state.tree, target) == .statement and !subtree_has(state, body, target)) {
            declaration :: ast.statement_decl(&state.tree, target)
            if (declaration.mutability != .constant
                or !branch_constant(state, declaration.initializer, depth + 1)
                or !closed_computation(state, declaration.initializer, body, depth + 1)) return false
        }
    }
    class :: ast.node_class(&state.tree, id)
    if (class == .statement) {
        kind :: ast.stmt_kind(&state.tree, id)
        if (kind == .unreachable_stmt) return false
        if (kind == .assignment_stmt) {
            target :: ast.assignment_stmt(&state.tree, id).target
            root :: assignment_root(state, target)
            if (root == no_node or ast.node_class(&state.tree, root) != .statement
                or !subtree_has(state, body, root)) return false
            # a local pointer can still borrow caller-owned or global storage.
            place := target
            while (ast.expr_kind(&state.tree, place) == .selection or ast.expr_kind(&state.tree, place) == .index) {
                place = if (ast.expr_kind(&state.tree, place) == .selection)
                    ast.selection_expr(&state.tree, place).base else ast.index_expr(&state.tree, place).base
            }
            if (ast.expr_kind(&state.tree, place) == .unary) return false
            declaration :: ast.statement_decl(&state.tree, root)
            if (target != place and (ast.expr_kind(&state.tree, target) != .index
                or ast.index_expr(&state.tree, target).base != place
                or declaration.type == null
                or ast.expr_kind(&state.tree, declaration.type?) != .array_type)) return false
        }
    }
    if (class == .expression) {
        kind :: ast.expr_kind(&state.tree, id)
        if (kind == .address_constant or kind == .memory_constant or kind == .slice_constant) return false
        if (kind == .unary) {
            operator :: ast.unary_expr(&state.tree, id).operator
            if (operator == .address_of or operator == .dereference) return false
        }
    }
    if (class == .expression and ast.expr_kind(&state.tree, id) == .builtin_call) {
        name :: ast.literal_text(&state.tree, ast.builtin_call(&state.tree, id).name)
        if (!mem.eql(name, "compile_error") and !mem.eql(name, "maxval")
            and !mem.eql(name, "minval") and !mem.eql(name, "sizeof")
            and !mem.eql(name, "alignof") and !mem.eql(name, "typeinfo")
            and !mem.eql(name, "field") and !mem.eql(name, "struct_type")
            and !mem.eql(name, "some")) return false
    }
    if (class == .expression and ast.expr_kind(&state.tree, id) == .call) {
        callee :: binding(state, ast.call_expr(&state.tree, id).callee)
        if (callee.kind != .builtin) {
            if (callee.kind != .declaration) return false
            function :: callee.data.declaration
            if (ast.node_class(&state.tree, function) != .function
                or ast.function_external(&state.tree, function)) return false
            called_body :: ast.function_decl(&state.tree, function).body
            if (!closed_computation(state, called_body, called_body, depth + 1)) return false
        }
    }
    for (0..ast.child_count(&state.tree, id)) |i|
        if (!closed_computation(state, ast.child(&state.tree, id, i), body, depth + 1)) return false
    return true
}

@hide:file
closed_zero_runtime_call proc(state @State, function ast.NodeId) bool {
    if (ast.function_external(&state.tree, function)) return false
    # ordinary parameterless calls retain runtime traps and lazy-call semantics.
    if (ast.function_param_count(&state.tree, function) == 0) return false
    result :: binding(state, ast.function_decl(&state.tree, function).return_type)
    if (result.kind == .builtin and (result.data.builtin == .void or result.data.builtin == .type)) return false
    for (0..ast.function_param_count(&state.tree, function)) |i|
        if (!ast.param(&state.tree, ast.function_param(&state.tree, function, i)).comptime) return false
    body :: ast.function_decl(&state.tree, function).body
    return closed_computation(state, body, body, 0)
}

# find demanded callees before walking runtime declarations, independent of source
# order. a later runtime reference retains the original declaration as usual.
@hide:file
collect_demanded_functions proc(state @mut State, id ast.NodeId, demanded bool) void ! mem.AllocError {
    class :: ast.node_class(&state.tree, id)
    demand := demanded
    if (class == .statement and ast.stmt_kind(&state.tree, id) == .for_stmt
        and ast.for_stmt(&state.tree, id).is_inline) {
        loop :: ast.for_stmt(&state.tree, id)
        try collect_demanded_functions(state, loop.iterable, true)
        try collect_demanded_functions(state, loop.body, demanded)
        return
    }
    if (class == .expression) {
        kind :: ast.expr_kind(&state.tree, id)
        if (kind == .comptime_expr) demand = true
        if (kind == .call) {
            callee :: binding(state, ast.call_expr(&state.tree, id).callee)
            if (callee.kind == .declaration
                and ast.node_class(&state.tree, callee.data.declaration) == .function) {
                function :: callee.data.declaration
                if ((demand or closed_zero_runtime_call(state, function)) and !ast.function_external(&state.tree, function)
                    and state.demanded_functions[usize(function)] == 0
                    and try needs_demand_execution(state, function)) {
                    state.demanded_functions[usize(function)] = 1
                    try collect_demanded_functions(state, ast.function_decl(&state.tree, function).body, true)
                }
                if (ast.call_arg_count(&state.tree, id) == ast.function_param_count(&state.tree, function)) {
                    for (0..ast.call_arg_count(&state.tree, id)) |i| {
                        parameter :: ast.param(&state.tree, ast.function_param(&state.tree, function, i))
                        try collect_demanded_functions(state, ast.call_arg(&state.tree, id, i), demand or parameter.comptime)
                    }
                    return
                }
            }
        }
    }
    for (0..ast.child_count(&state.tree, id)) |i|
        try collect_demanded_functions(state, ast.child(&state.tree, id, i), demand)
}

@hide:file
expand proc(state @mut State, id ast.NodeId) void ! Error {
    try expand_expected(state, id, no_node)
}

@hide:file
expand_expected proc(state @mut State, id, expected ast.NodeId) void ! Error {
    try refresh(state)
    if (state.demand_depth == 0) {
        resolved :: binding(state, id)
        if (resolved.kind == .declaration and usize(resolved.data.declaration) < state.original_count) {
            declaration :: resolved.data.declaration
            if (state.demanded_functions[usize(declaration)] == 1 and !template(state, declaration)) {
                state.demanded_functions[usize(declaration)] = 2
                try arraylist.append(&state.declarations, declaration)
            }
        }
    }
    if (state.expanded.items[usize(id)] != 0) return
    state.expanded.items[usize(id)] = 1
    class :: ast.node_class(&state.tree, id)
    saved_return :: state.return_type
    saved_yield :: state.yield_type
    defer {
        state.return_type = saved_return
        state.yield_type = saved_yield
    }
    if (class == .function) {
        # dependent annotations and reflection bodies belong to concrete instances.
        if (usize(id) < state.original_count and template(state, id)) return
        state.return_type = ast.function_decl(&state.tree, id).return_type
        state.yield_type = no_node
        if (!ast.function_external(&state.tree, id)
            and type_local_storage(&state.tree, state.bindings.items,
                ast.function_decl(&state.tree, id).body, 0)
            and !compiletime_call(state, id)) {
            try expand_runtime_metadata(state, id)
            return
        }
    }
    if (class == .statement) {
        match ast.stmt_kind(&state.tree, id) {
            .declaration: {
                view :: ast.statement_decl(&state.tree, id)
                annotation := no_node
                if (view.type) |type| {
                    try expand(state, type)
                    annotation = type
                }
                try expand_expected(state, view.initializer, annotation)
                return
            }
            .assignment_stmt: {
                view :: ast.assignment_stmt(&state.tree, id)
                try expand(state, view.target)
                try expand_expected(state, view.value, try expression_type(state, view.target, 0))
                return
            }
            .return_stmt, .yield_stmt: {
                yielding :: ast.stmt_kind(&state.tree, id) == .yield_stmt
                value :: if (yielding) ast.yield_stmt(&state.tree, id).value else ast.return_stmt(&state.tree, id).value
                annotation :: if (yielding) state.yield_type else state.return_type
                if (value) |operand| try expand_expected(state, operand, annotation)
                return
            }
            else: {}
        }
    }
    if (class == .field) {
        view :: ast.field(&state.tree, id)
        annotation := no_node
        if (view.type) |type| {
            try expand(state, type)
            annotation = type
        }
        if (view.value) |value| try expand_expected(state, value, annotation)
        return
    }
    if (class == .expression and ast.expr_kind(&state.tree, id) == .block_expr) {
        body :: ast.block_expr(&state.tree, id)
        annotation :: if (expected != no_node) expected else try value_block_type(state, body, 0)
        if (is_type(state, annotation) or type_record_storage(state, annotation, 0)) {
            selected :: try evaluate_type_value_block(state, id, annotation)
            if (selected == no_node) {
                try reject_evaluation(state, id)
                return
            }
            try replace(state, id, selected)
            try refresh(state)
            state.bindings.items[usize(id)] = binding(state, selected)
            return
        }
        state.value_expansion_depth += 1
        defer state.value_expansion_depth -= 1
        state.yield_type = annotation
        try expand(state, body)
        return
    }
    if (class == .block and state.value_expansion_depth > 0) {
        statements := arraylist.init(ast.NodeId, state.allocator)
        defer arraylist.deinit(&statements)
        count :: ast.block_statement_count(&state.tree, id)
        for (0..count) |i| {
            statement :: ast.block_statement(&state.tree, id, i)
            try expand(state, statement)
            try arraylist.append(&statements, statement)
            if (value_block_terminal(state, statement)) break
        }
        if (statements.items.len != count) {
            replacement :: try ast.add_block(state.builder, ast.node_span(&state.tree, id), statements.items)
            try replace(state, id, replacement)
            try refresh(state)
        }
        return
    }
    if (class == .statement and ast.stmt_kind(&state.tree, id) == .for_stmt
        and ast.for_stmt(&state.tree, id).is_inline) {
        try expand_inline_for(state, id)
        return
    }
    if (class == .statement and ast.stmt_kind(&state.tree, id) == .for_stmt) {
        loop :: ast.for_stmt(&state.tree, id)
        try expand(state, loop.iterable)
        if (loop.index) |capture| {
            annotation :: try builtin(state, id, .usize)
            hashmap.put(&state.capture_types, capture, annotation) catch |err| {
                match err {
                    .key_exists: {}
                    else: return err
                }
            }
        }
        if (loop.capture != null) {
            iterable :: try expression_type(state, loop.iterable, 0)
            element := no_node
            mutable := false
            if (ast.expr_kind(&state.tree, loop.iterable) == .range) {
                bounds :: ast.range_expr(&state.tree, loop.iterable)
                bound :: if (flexible(state, bounds.start)) bounds.end else bounds.start
                element = try expression_type(state, bound, 0)
            } else if (iterable != no_node) {
                kind :: ast.expr_kind(&state.tree, iterable)
                if (kind == .array_type) {
                    element = ast.array_type(&state.tree, iterable).element
                    mutable = ast.array_type(&state.tree, iterable).mutable
                }
                if (kind == .slice_type) {
                    element = ast.slice_type(&state.tree, iterable).element
                    mutable = ast.slice_type(&state.tree, iterable).mutable
                }
                if (kind == .pointer_type) {
                    array :: try canonical_type(state, ast.pointer_type(&state.tree, iterable).element)
                    if (array != no_node and ast.expr_kind(&state.tree, array) == .array_type) {
                        element = ast.array_type(&state.tree, array).element
                        mutable = ast.pointer_type(&state.tree, iterable).mutable and ast.array_type(&state.tree, array).mutable
                    }
                }
                if (binding(state, iterable).kind == .builtin
                    and binding(state, iterable).data.builtin == .string)
                    element = try builtin(state, id, .u8)
            }
            if (element != no_node) {
                if (loop.pointer_capture) {
                    element = try ast.add_pointer_type(state.builder, loop.span, element, mutable, false)
                    try refresh(state)
                }
                hashmap.put(&state.capture_types, loop.capture?, element) catch |err| {
                    match err {
                        .key_exists: {}
                        else: return err
                    }
                }
            }
        }
    }
    if (class == .statement
        and (ast.stmt_kind(&state.tree, id) == .if_stmt or ast.stmt_kind(&state.tree, id) == .while_stmt)) {
        looping :: ast.stmt_kind(&state.tree, id) == .while_stmt
        capture :: if (looping) ast.while_stmt(&state.tree, id).capture else ast.if_stmt(&state.tree, id).capture
        condition :: if (looping) ast.while_stmt(&state.tree, id).condition else ast.if_stmt(&state.tree, id).condition
        if (capture) |name| {
            annotation :: try expression_type(state, condition, 0)
            if (annotation != no_node and ast.expr_kind(&state.tree, annotation) == .optional_type) {
                child :: ast.type_operand(&state.tree, annotation)
                hashmap.put(&state.capture_types, name, child) catch |err| {
                    match err {
                        .key_exists: {}
                        else: return err
                    }
                }
            }
        }
    }
    if (class == .expression and ast.expr_kind(&state.tree, id) == .catch_expr) {
        expression :: ast.catch_expr(&state.tree, id)
        try expand_expected(state, expression.operand, expected)
        operand_type :: try expression_type(state, expression.operand, 0)
        if (type_record_storage(state, operand_type, 0)
            and ast.expr_kind(&state.tree, operand_type) == .fallible_type) {
            try specialize_type_catch(state, id, operand_type, expected)
            return
        }
        if (expression.capture) |capture| {
            annotation :: try expression_type(state, expression.operand, 0)
            if (annotation != no_node and ast.expr_kind(&state.tree, annotation) == .fallible_type) {
                hashmap.put(&state.capture_types, capture, ast.binary_expr(&state.tree, annotation).right) catch |err| {
                    match err {
                        .key_exists: {}
                        else: return err
                    }
                }
            }
        }
        annotation :: if (expected != no_node) expected else try expression_type(state, id, 0)
        state.yield_type = annotation
        try expand_expected(state, expression.handler, annotation)
        return
    }
    if (class == .statement and ast.stmt_kind(&state.tree, id) == .expression) {
        expression :: ast.statement_expr(&state.tree, id)
        if (
            ast.expr_kind(&state.tree, expression) == .match_expr
            and try specialize_match(state, expression, id, no_node)
        ) return
    }
    if (
        class == .expression and ast.expr_kind(&state.tree, id) == .match_expr
        and try specialize_match(state, id, no_node, expected)
    ) return
    if (class == .statement and ast.stmt_kind(&state.tree, id) == .if_stmt) {
        conditional :: ast.if_stmt(&state.tree, id)
        explicit :: ast.expr_kind(&state.tree, conditional.condition) == .comptime_expr
        if (conditional.capture == null and (explicit or usize(id) >= state.original_count)) {
            condition :: if (explicit) ast.comptime_operand(&state.tree, conditional.condition) else conditional.condition
            try expand(state, condition)
            if (explicit or branch_constant(state, condition, 0)) {
                state.evaluation_diagnostic = diagnostics.no_diagnostic
                boolean :: try builtin(state, condition, .bool)
                value :: try evaluate_ir(state, condition, boolean)
                if (explicit and value.kind == .invalid and state.evaluation_diagnostic == diagnostics.no_diagnostic)
                    state.evaluation_diagnostic = try diagnostics.add(state.diagnostics,
                        .comptime_argument_required, ast.node_span(&state.tree, condition))
                if (state.evaluation_diagnostic != diagnostics.no_diagnostic) {
                    invalid :: try ast.add_invalid_stmt(state.builder, ast.node_span(&state.tree, id),
                        state.evaluation_diagnostic)
                    try replace(state, id, invalid)
                    try refresh(state)
                    return
                }
                if (value.kind == .boolean) {
                    branch := conditional.then_block
                    if (!value.boolean) {
                        if (conditional.else_block) |other| branch = other
                        else branch = try ast.add_block(state.builder, ast.node_span(&state.tree, id), &[])
                    }
                    replacement :: try ast.add_block_stmt(state.builder, branch)
                    try replace(state, id, replacement)
                    try refresh(state)
                    try expand(state, branch)
                    return
                }
            }
        }
    }
    if (class == .expression and ast.expr_kind(&state.tree, id) == .comptime_expr) {
        state.demand_depth += 1
        defer state.demand_depth -= 1
        operand :: ast.comptime_operand(&state.tree, id)
        try expand_expected(state, operand, expected)
        state.evaluation_diagnostic = diagnostics.no_diagnostic
        value :: try evaluate(state, operand)
        if (value.annotation == no_node or !type_record_storage(state, value.annotation, 0))
            try arraylist.append(&state.rewrites.constraints, operand)
        if (value.kind == .invalid) {
            try reject_evaluation(state, id)
            return
        }
        concrete :: try materialize(state, value)
        replacement := concrete.node
        if (value.annotation != no_node and value.kind != .type) {
            replacement = try ast.add_typed_constant(state.builder, ast.node_span(&state.tree, id),
                value.annotation, replacement)
            try refresh(state)
        }
        try replace(state, id, replacement)
        try refresh(state)
        return
    }
    if (class == .expression and ast.expr_kind(&state.tree, id) == .builtin_call) {
        name :: ast.builtin_call(&state.tree, id).name
        if (
            mem.eql(ast.source_text(&state.tree, ast.node_span(&state.tree, name)), "some")
            and expected != no_node and ast.call_arg_count(&state.tree, id) == 1
        ) {
            annotation := try canonical_type(state, expected)
            if (annotation != no_node and ast.expr_kind(&state.tree, annotation) == .fallible_type)
                annotation = try canonical_type(state, ast.binary_expr(&state.tree, annotation).left)
            if (annotation != no_node and ast.expr_kind(&state.tree, annotation) == .optional_type) {
                try expand_expected(state, ast.call_arg(&state.tree, id, 0), ast.type_operand(&state.tree, annotation))
                return
            }
        }
        if (mem.eql(ast.source_text(&state.tree, ast.node_span(&state.tree, name)), "compile_error")) {
            try expand_compile_error(state, id)
            return
        }
        if (mem.eql(ast.source_text(&state.tree, ast.node_span(&state.tree, name)), "field")) {
            try expand_field(state, id)
            return
        }
        if (mem.eql(ast.source_text(&state.tree, ast.node_span(&state.tree, name)), "struct_type")) {
            try expand_struct_type(state, id)
            return
        }
        if (mem.eql(ast.source_text(&state.tree, ast.node_span(&state.tree, name)), "typeinfo")) {
            try expand_typeinfo(state, id)
            return
        }
    }
    if (class == .expression and ast.expr_kind(&state.tree, id) == .call) {
        callee :: ast.call_expr(&state.tree, id).callee
        resolved_callee :: binding(state, callee)
        closed :: (resolved_callee.kind == .declaration
            and ast.node_class(&state.tree, resolved_callee.data.declaration) == .function
            and closed_zero_runtime_call(state, resolved_callee.data.declaration))
        saved_demand :: state.demand_depth
        if (closed) state.demand_depth += 1
        defer state.demand_depth = saved_demand
        try expand(state, callee)
        resolved :: binding(state, callee)
        if (
            resolved.kind == .declaration
            and ast.node_class(&state.tree, resolved.data.declaration) == .function
            and (template(state, resolved.data.declaration)
                or closed
                or (state.demand_depth > 0 and usize(resolved.data.declaration) < state.original_count
                    and !ast.function_external(&state.tree, resolved.data.declaration)
                    and try needs_demand_execution(state, resolved.data.declaration)))
        ) {
            try specialize_call(state, id, resolved.data.declaration, expected)
            return
        }
        signature := no_node
        if (resolved.kind == .declaration and ast.node_class(&state.tree, resolved.data.declaration) == .function)
            signature = resolved.data.declaration
        else signature = try expression_type(state, callee, 0)
        if (
            signature != no_node
            and (ast.node_class(&state.tree, signature) == .function
                or ast.expr_kind(&state.tree, signature) == .function_type)
            and ast.function_param_count(&state.tree, signature) == ast.call_arg_count(&state.tree, id)
        ) {
            for (0..ast.call_arg_count(&state.tree, id)) |i| {
                annotation :: ast.param(&state.tree, ast.function_param(&state.tree, signature, i)).type
                try expand_expected(state, ast.call_arg(&state.tree, id, i), annotation)
            }
            return
        }
    }
    if (class == .expression and ast.expr_kind(&state.tree, id) == .binary) {
        view :: ast.binary_expr(&state.tree, id)
        if (view.operator == .logical_and or view.operator == .logical_or) {
            boolean :: try builtin(state, id, .bool)
            try expand_expected(state, view.left, boolean)
            saved_demand :: state.demand_depth
            defer state.demand_depth = saved_demand
            if (state.demand_depth > 0 and branch_constant(state, view.left, 0)) {
                value :: try evaluate_ir(state, view.left, boolean)
                if (value.kind == .boolean and value.boolean == (view.operator == .logical_or))
                    state.demand_depth = 0
            }
            # retain ordinary checking, but never execute skipped runtime projections.
            try expand_expected(state, view.right, boolean)
            return
        }
    }
    if (class == .expression and expected != no_node) {
        kind :: ast.expr_kind(&state.tree, id)
        if (kind == .unary) {
            view :: ast.unary_expr(&state.tree, id)
            if (view.operator == .negate or view.operator == .bit_not or view.operator == .logical_not) {
                try expand_expected(state, view.operand, expected)
                return
            }
        }
        if (kind == .binary and !is_type(state, expected)) {
            view :: ast.binary_expr(&state.tree, id)
            match view.operator {
                .add, .subtract, .multiply, .divide, .bit_and, .bit_or, .bit_xor,
                .logical_and, .logical_or: {
                    try expand_expected(state, view.left, expected)
                    try expand_expected(state, view.right, expected)
                    return
                }
                .shift_left, .shift_right, .shift_left_saturating: {
                    try expand_expected(state, view.left, expected)
                    try expand(state, view.right)
                    return
                }
                else: {}
            }
        }
        if (kind == .try_expr) {
            try expand_expected(state, ast.type_operand(&state.tree, id), expected)
            return
        }
        if (kind == .match_expr) {
            try expand(state, ast.match_expr(&state.tree, id).subject)
            for (0..ast.match_arm_count(&state.tree, id)) |i| {
                arm_id :: ast.match_arm(&state.tree, id, i)
                arm :: ast.match_arm_view(&state.tree, arm_id)
                for (0..ast.match_pattern_count(&state.tree, arm_id)) |j|
                    try expand(state, ast.match_pattern(&state.tree, arm_id, j))
                state.yield_type = expected
                annotation :: if (arm.expression) expected else no_node
                try expand_expected(state, arm.body, annotation)
            }
            return
        }
    }
    if (class == .expression) {
        kind :: ast.expr_kind(&state.tree, id)
        if (kind == .record_literal or kind == .array_literal) {
            annotation := expected
            if (kind == .record_literal) {
                if (ast.record_literal(&state.tree, id).type) |type| {
                    try expand(state, type)
                    annotation = type
                }
            }
            shape := if (annotation != no_node) try canonical_type(state, annotation) else no_node
            if (shape != no_node and ast.expr_kind(&state.tree, shape) == .fallible_type)
                shape = try canonical_type(state, ast.binary_expr(&state.tree, shape).left)
            if (shape != no_node and ast.expr_kind(&state.tree, shape) == .optional_type)
                shape = try canonical_type(state, ast.type_operand(&state.tree, shape))
            if (
                kind == .array_literal and shape != no_node
                and (ast.expr_kind(&state.tree, shape) == .array_type or ast.expr_kind(&state.tree, shape) == .slice_type)
            ) {
                element :: if (ast.expr_kind(&state.tree, shape) == .array_type)
                    ast.array_type(&state.tree, shape).element else ast.slice_type(&state.tree, shape).element
                for (0..ast.array_element_count(&state.tree, id)) |i|
                    try expand_expected(state, ast.array_element(&state.tree, id, i), element)
                return
            }
            if (
                kind == .record_literal and shape != no_node
                and (ast.expr_kind(&state.tree, shape) == .record_type or ast.expr_kind(&state.tree, shape) == .union_type)
            ) {
                for (0..ast.record_field_count(&state.tree, id)) |i| {
                    field :: ast.field(&state.tree, ast.record_field(&state.tree, id, i))
                    slot :: if (field.name != null) type_record_slot(&state.tree, shape, field.name?) else i
                    field_type := no_node
                    if (slot < ast.record_field_count(&state.tree, shape)) {
                        if (ast.field(&state.tree, ast.record_field(&state.tree, shape, slot)).type) |type|
                            field_type = type
                    }
                    if (field.value) |value| try expand_expected(state, value, field_type)
                }
                return
            }
        }
    }
    count :: ast.child_count(&state.tree, id)
    for (0..count) |i| {
        child :: ast.child(&state.tree, id, i)
        try expand(state, child)
    }
    if (!try type_array_projection(state, id)) {
        try reject_evaluation(state, id)
        return
    }
    if (class == .expression and ast.expr_kind(&state.tree, id) == .binary) {
        view :: ast.binary_expr(&state.tree, id)
        if (view.operator == .bit_or
            and (is_type(state, try expression_type(state, view.left, 0))
                or is_type(state, try expression_type(state, view.right, 0)))) {
            composed :: try ast.add_binary_type(state.builder, view.span, view.left, view.right, false)
            try replace(state, id, composed)
            try refresh(state)
            return
        }
        if (view.operator == .equal or view.operator == .not_equal) {
            operand := no_node
            if (ast.expr_kind(&state.tree, view.left) == .literal_null) operand = view.right
            else if (ast.expr_kind(&state.tree, view.right) == .literal_null) operand = view.left
            if (operand != no_node) {
                annotation :: try expression_type(state, operand, 0)
                if (type_record_storage(state, annotation, 0)
                    and ast.expr_kind(&state.tree, annotation) == .optional_type) {
                    value :: try evaluate_expected(state, operand, annotation)
                    if (value.kind != .aggregate) {
                        try reject_evaluation(state, id)
                        return
                    }
                    absent :: ast.expr_kind(&state.tree, value.node) == .literal_null
                    folded :: try ast.add_boolean(state.builder, view.span,
                        absent == (view.operator == .equal))
                    try replace(state, id, folded)
                    try refresh(state)
                    return
                }
            }
        }
        if (
            (view.operator == .equal or view.operator == .not_equal)
            and branch_constant(state, view.left, 0) and branch_constant(state, view.right, 0)
            and is_type(state, try expression_type(state, view.left, 0))
            and is_type(state, try expression_type(state, view.right, 0))
        ) _ = try evaluate_binary(state, id)
    }
    if (usize(id) >= state.original_count and class == .expression and ast.expr_kind(&state.tree, id) == .array_type) {
        view :: ast.array_type(&state.tree, id)
        if (view.count) |count_node| {
            try arraylist.append(&state.rewrites.constraints, count_node)
            value :: try evaluate(state, count_node)
            if (value.kind == .integer) {
                folded :: try materialize(state, value)
                replacement :: try ast.add_array_type(state.builder, ast.node_span(&state.tree, id),
                    folded.node, view.element, view.mutable)
                try replace(state, id, replacement)
                try refresh(state)
            }
        }
    }
}

@hide:file
value_block_terminal proc(state @State, id ast.NodeId) bool {
    class :: ast.node_class(&state.tree, id)
    if (class == .block) {
        count :: ast.block_statement_count(&state.tree, id)
        return count > 0 and value_block_terminal(state, ast.block_statement(&state.tree, id, count - 1))
    }
    if (class != .statement) return false
    match ast.stmt_kind(&state.tree, id) {
        .yield_stmt, .return_stmt, .break_stmt, .continue_stmt, .unreachable_stmt: return true
        .block_stmt: return value_block_terminal(state, ast.statement_block(&state.tree, id))
        .if_stmt: {
            view :: ast.if_stmt(&state.tree, id)
            return (
                view.else_block != null
                and value_block_terminal(state, view.then_block)
                and value_block_terminal(state, view.else_block?)
            )
        }
        else: return false
    }
}

# reflection values are owned AST snapshots. only ordinary leaves and selected
# runtime bodies enter IR; metadata slices never retain interpreter addresses.
@hide:file
metadata_member proc(state @mut State, at ast.NodeId, text []u8) ast.NodeId ! Error {
    result :: try ast.add_generated_identifier(state.builder, ast.node_span(&state.tree, at),
        try strpool.intern(state.strings, text), text)
    try refresh(state)
    return result
}

@hide:file
metadata_tags proc(state @mut State, type ast.NodeId) ast.NodeId ! Error {
    if (ast.expr_kind(&state.tree, type) == .enum_type) return type
    if (ast.union_type(&state.tree, type).tag) |tag| return try canonical_type(state, tag)
    return try metadata_variant_tags(state, type)
}

# dispatch covers union variants, not unused members of an explicit tag enum.
@hide:file
metadata_variant_tags proc(state @mut State, type ast.NodeId) ast.NodeId ! Error {
    members := arraylist.init(ast.NodeId, state.allocator)
    defer arraylist.deinit(&members)
    for (0..ast.record_field_count(&state.tree, type)) |i| {
        field :: ast.field(&state.tree, ast.record_field(&state.tree, type, i))
        member :: try ast.add_field(state.builder, field.span, field.name, null, null)
        try arraylist.append(&members, member)
        try refresh(state)
    }
    result :: try ast.add_enum_type(state.builder, ast.node_span(&state.tree, type), null, members.items)
    try refresh(state)
    return result
}

@hide:file
metadata_import proc(state @State) ast.NodeId {
    # reflection uses the real metadata package loaded anywhere in this compilation.
    # generated helpers retain their source spans, not the importer's lexical scope.
    for (0..state.original_count) |i| {
        imported :: ast.NodeId(i)
        resolved :: binding(state, imported)
        if (ast.node_class(&state.tree, imported) != .import or resolved.kind != .namespace) continue
        if (mem.eql(ast.source_text(&state.tree, ast.import_decl(&state.tree, imported).path), "@std/meta"))
            return resolved.data.namespace
    }
    return no_node
}

@hide:file
metadata_type proc(state @mut State, package ast.NodeId, name []u8) ast.NodeId ! Error {
    for (0..ast.package_decl_count_at(&state.tree, package)) |i| {
        declaration :: ast.package_decl_at(&state.tree, package, i)
        if (ast.node_class(&state.tree, declaration) != .statement) continue
        if (mem.eql(strpool.get_str(state.strings, ast.name_id(&state.tree, declaration))?, name))
            return try canonical_type(state, ast.statement_decl(&state.tree, declaration).initializer)
    }
    return no_node
}

@hide:file
metadata_record proc(state @mut State, at, type ast.NodeId, values []ast.NodeId) ast.NodeId ! Error {
    try refresh(state)
    fields := arraylist.init(ast.NodeId, state.allocator)
    defer arraylist.deinit(&fields)
    span :: ast.node_span(&state.tree, at)
    for (values) |value, i| {
        field :: ast.field(&state.tree, ast.record_field(&state.tree, type, i))
        owned := value
