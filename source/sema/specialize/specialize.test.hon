        `identity proc($T type, value T) T { return value }
        `main proc() i16 { return $(identity(i16(42))) }
        , .cannot_infer_generic, 0,
    )
}

demanded_expression_inline_matches_bind_payloads_and_static_tags test {
    try expect_specialization(
        `Detail :: union(enum) { count usize, empty void }
        `score proc(input Detail) i16 {
        `    return match input {
        `        inline |payload, tag|: match tag { .count: i16(payload), else: 0 },
        `    }
        `}
        `main proc() i16 { return $(score(.count{42})) }
        , .invalid_match_capture, 0,
    )
}

keeps_borrowed_snapshots_owned_and_explicit_numeric_annotations_rigid test {
    try expect_specialization(
        `borrow proc(values []mut i16) []mut i16 { return values }
        `produce proc() []mut i16 {
        `    values [2]mut i16 := [19, 23]
        `    return borrow(values[..])
        `}
        `main proc() i16 { values :: $(produce())
        `    values[0] += 4
        `    return values[0] + values[1]
        `}
        , .comptime_value_escape, 0,
    )
    try expect_specialization(
        `produce proc() usize {
        `    value i16 := 1
        `    if value == 0 { compile_error!("unselected typed guard") }
        `    return value
        `}
        `main proc() void { value :: $(produce()) }
        , .type_mismatch, 1,
    )
}

keeps_inferred_compiletime_literals_contextual_until_a_rigid_source test {
    try expect_specialization(
        `produce proc() usize {
        `    width := 2
        `    width = 3
        `    cursor := 0
        `    cursor += width
        `    values [4]i16 :: [1, 2, 3, 42]
        `    if values[cursor] != 42 { compile_error!("wrong contextual index") }
        `    count := 0
        `    count = values.len
        `    return count
        `}
        `main proc() usize { return $(produce()) }
        , .compile_error, 0,
    )
    try expect_specialization(
        `produce proc() usize {
        `    width i16 := 2
        `    cursor usize := 0
        `    if cursor == 99 { compile_error!("unselected typed guard") }
        `    cursor += width
        `    return cursor
        `}
        `main proc() usize { return $(produce()) }
        , .invalid_operand, maxval!(usize),
    )
}

demanded_local_execution_retains_overflow_and_initialization_diagnostics test {
    try expect_specialization(
        `produce proc() u8 {
        `    value u8 := 255
        `    value += 1
        `    return value
        `}
        `main proc() u8 { return $(produce()) }
        , .integer_overflow, 1,
    )
    try expect_specialization(
        `initialize proc(values []mut i16) void { values[0] = 42 }
        `produce proc() i16 {
        `    values [2]mut i16 := undefined
        `    initialize(values[..])
        `    return values[1]
        `}
        `main proc() i16 { return $(produce()) }
        , .read_before_initialization, 1,
    )
}

infers_nested_nominal_pointer_parameters_and_readonly_slice_views test {
    try expect_specialization(
        `Storage proc($T type) type { return struct { items []mut T, capacity usize } }
        `make proc($T type, values []mut T) Storage(T) {
        `    return Storage(T) { items = values, capacity = values.len }
        `}
        `observe proc($T type, values []T) usize { return values.len }
        `reserve proc($T type, storage @mut Storage(T), count usize) void {
        `    observe(storage.items.ptr[..count])
        `}
        `append proc($T type, storage @mut Storage(T), value T) void {
        `    reserve(storage, storage.items.len)
        `    storage.items[0] = value
        `}
        `release proc($T type, storage @mut Storage(T)) void {
        `    allocation :: storage.items.ptr[..storage.capacity]
        `    observe(allocation)
        `}
        `forward proc(storage @mut Storage(i16)) void {
        `    append(storage, 7)
        `    release(storage)
        `}
        `main proc() i16 {
        `    values [2]mut i16 := [1, 2]
        `    storage := make(i16, values[..])
        `    forward(&storage)
        `    append(&storage, 9)
        `    release(&storage)
        `    return storage.items[0]
        `}
        , .cannot_infer_generic, 0,
    )
}

rejects_conflicting_rigid_types_and_unrelated_nominal_generators test {
    try expect_specialization(
        `same proc($T type, left, right T) void {}
        `main proc() void { same(i16(1), u8(2)) }
        , .cannot_infer_generic, 1,
    )
    try expect_specialization(
        `Box proc($T type) type { return struct { value T } }
        `Other proc($T type) type { return struct { value T } }
        `read proc($T type, value @Box(T)) void {}
        `main proc() void {
        `    value Other(i16) :: { value = 1 }
        `    read(&value)
        `}
        , .cannot_infer_generic, 1,
    )
    try expect_specialization(
        `unknown proc($T type, value usize) void {}
        `main proc() void { unknown(1) }
        , .cannot_infer_generic, 1,
    )
}

preserves_rigid_inference_before_contextual_literals test {
    try expect_specialization(
        `same proc($T type, left, right T) T { return right }
        `main proc() i16 { return same(i16(1), 2) }
        , .cannot_infer_generic, 0,
    )
}

infers_integer_builtin_results_from_their_type_or_rigid_operand test {
    try expect_specialization(
        `same proc($T type, left, right T) T { return right }
        `main proc() i16 {
        `    upper :: same(maxval!(i16), i16(1))
        `    lower :: same(minval!(i16), i16(2))
        `    left :: same(divtrunc!(i16(8), 2), i16(3))
        `    right :: same(divtrunc!(8, i16(2)), i16(4))
        `    return upper + lower + left + right
        `}
        , .cannot_infer_generic, 0,
    )
}

infers_direct_results_before_contextual_literal_defaults test {
    try expect_specialization(
        `make proc($T type) T { return T(7) }
        `identity proc($T type, value T) T { return value }
        `sized proc($N usize, values [N]i16) [N]i16 { return values }
        `consume proc(value i16) i16 { return value }
        `main proc() i16 {
        `    value i16 := identity(1)
        `    value = make()
        `    row [2]i16 :: sized([2, 3])
        `    return consume(make()) + value + row[0]
        `}
        , .cannot_infer_generic, 0,
    )
}

infers_type_and_value_arguments_from_generated_nominal_results test {
    try expect_specialization(
        `Fixed proc($T type, $N usize) type {
        `    return struct { value T = 0, count usize = N }
        `}
        `make proc($T type, $N usize) Fixed(T, N) { return {} }
        `identity proc($T type, $N usize, value T) Fixed(T, N) {
        `    return { value = value }
        `}
        `main proc() i16 {
        `    first Fixed(i16, 2) :: make()
        `    second Fixed(i16, 3) :: identity(i16(7))
        `    cached Fixed(i16, 2) :: make()
        `    return first.value + second.value + cached.value
        `}
        , .cannot_infer_generic, 0,
    )
}

propagates_expected_results_through_nested_aggregates_and_success_channels test {
    try expect_specialization(
        `Error :: enum { failed }
        `Record :: struct { value i16, rows [2]mut i16 }
        `make proc($T type) T { return 7 }
        `optional proc() ?i16 { return make() }
        `fallible proc() i16 ! Error { return make() }
        `main proc() Record {
        `    record Record := { value = make(), rows = [make(), make()] }
        `    record.value = make()
        `    record.rows[0] = make()
        `    maybe ?i16 :: make()
        `    result i16 ! Error :: make()
        `    return { value = make(), rows = [make(), make()] }
        `}
        , .cannot_infer_generic, 0,
    )
}

propagates_expected_results_through_match_arms_and_value_block_yields test {
    try expect_specialization(
        `make proc($T type) T { return T(7) }
        `choose proc(flag bool) i16 {
        `    return match flag {
        `        true: make(),
        `        false: { yield make() },
        `    }
        `}
        `main proc() i16 {
        `    value i16 :: { yield make() }
        `    return value + choose(true)
        `}
        , .cannot_infer_generic, 0,
    )
}

rejects_expected_results_that_conflict_with_rigid_runtime_arguments test {
    try expect_specialization(
        `identity proc($T type, value T) T { return value }
        `main proc() i16 { return identity(u8(7)) }
        , .cannot_infer_generic, 1,
    )
    try expect_specialization(
        `Box proc($T type) type { return struct { value T } }
        `make proc($T type, value T) Box(T) { return { value = value } }
        `main proc() Box(i16) { return make(u8(7)) }
        , .cannot_infer_generic, 1,
    )
}

rejects_unrelated_nominal_results_and_unresolved_compile_time_arguments test {
    try expect_specialization(
        `Box proc($T type) type { return struct { value T = 0 } }
        `Other proc($T type) type { return struct { value T = 0 } }
        `make proc($T type) Box(T) { return {} }
        `main proc() Other(i16) { return make() }
        , .cannot_infer_generic, 1,
    )
    try expect_specialization(
        `make proc($T type, $N usize) T { return T(7) }
        `main proc() i16 { return make() }
        , .cannot_infer_generic, 1,
    )
    try expect_specialization(
        `make proc($T type) T { return T(7) }
        `main proc() void { make() }
        , .cannot_infer_generic, 1,
    )
}

preserves_explicit_arguments_and_explicit_type_procedure_inputs test {
    try expect_specialization(
        `identity proc($T type, value T) T { return value }
        `main proc() i8 { return identity(i16, 7) }
        , .return_type_mismatch, 1,
    )
    try expect_specialization(
        `Box proc($T type) type { return struct { value T = 0 } }
        `make proc($T type) Box(T) { return {} }
        `main proc() Box(i16) { return make(u8) }
        , .return_type_mismatch, 1,
    )
    try expect_specialization(
        `Box proc($T type) type { return struct { value T } }
        `main proc() void { value Box() :: { value = 7 } }
        , .argument_count_mismatch, 1,
    )
}

rejects_integer_forged_and_incomplete_materialized_pointers test {
    try expect_specialization(
        `Overlay :: union { pointer @mut i16, bits u64 }
        `forge proc() @mut i16 {
        `    value Overlay :: { bits = 0 }
        `    return value.pointer
        `}
        `main proc() void { pointer :: $(forge()) }
        , .invalid_pointer_access, 1,
    )
    try expect_specialization(
        `produce proc() @mut [2]i16 {
        `    value i16 := 19
        `    return ptrcast!(@mut [2]i16, &value)
        `}
        `main proc() void { pointer :: $(produce()) }
        , .invalid_pointer_access, 1,
    )
}

promotes_owned_pointer_and_slice_defaults_into_optional_parameters test {
    try expect_specialization(
        `make_pointer proc() @mut i16 {
        `    value i16 := 19
        `    return &value
        `}
        `make_slice proc() []mut i16 {
        `    values [2]mut i16 := [19, 23]
        `    return values[..]
        `}
        `PointerBox proc($default ?@mut i16) type {
        `    return struct { left @mut i16 = default?, right @mut i16 = default? }
        `}
        `SliceBox proc($default ?[]mut i16) type {
        `    return struct { left []mut i16 = default?, right []mut i16 = default? }
        `}
        `Pointers :: alias PointerBox(make_pointer())
        `Slices :: alias SliceBox(make_slice())
        `main proc() i16 {
        `    pointers Pointers :: {}
        `    slices Slices :: {}
        `    pointers.left^ += 4
        `    slices.left[0] += 4
        `    if (pointers.right^ != 23 or slices.right[0] != 23) return -1
        `    return pointers.left^ + slices.left[1]
        `}
        , .type_mismatch, 0,
    )
}

infers_helpers_from_pointer_collection_and_catch_captures test {
    try expect_specialization(
        `Box proc($T type) type { return struct { value T, bytes []u8 } }
        `observe proc($T type, value T) void {}
        `release proc($T type, value @mut Box(T)) void { observe(value.bytes) }
        `Error :: union(enum) { failed struct { code i16 }, empty void }
        `fail proc() void ! Error { return .failed{code = 7} }
        `main proc() void {
        `    values [1]mut Box(i16) := [{value = 42, bytes = "ok"}]
        `    for values |@value| {
        `        release(value)
        `        observe(value.bytes)
        `    }
        `    fail() catch |err| {
        `        observe(err)
        `        match err { .failed |detail|: observe(detail.code), .empty: {} }
        `    }
        `}
        , .cannot_infer_generic, 0,
    )
}

infers_dependent_comptime_inputs_after_nominal_result_context test {
    try expect_specialization(
        `Kind :: enum { first, second }
        `Pair proc($V type) type { return struct { []u8, V } }
        `Map proc($V type) type { return struct { value V, len usize } }
        `init proc($V type, $N usize, $entries [N]Pair(V)) Map(V) {
        `    return {value = entries[0].1, len = N}
        `}
        `first Map(Kind) :: init([{"first", .first}, {"second", .second}])
        `second Map(Kind) :: init(Kind, [{"second", .second}])
        `main proc() usize { return first.len + second.len }
        , .cannot_infer_generic, 0,
    )
}

keeps_unbound_reflection_templates_unexpanded test {
    try expect_specialization(
        `unused proc($E type) usize {
        `    match typeinfo!(E) {
        `        .enum |info|: return info.fields.len
        `        else: compile_error!("not an enum")
        `    }
        `}
        `identity proc($T type, value T) T { return value }
        `main proc() i16 { return $(identity(i16(42))) }
        , .comptime_argument_required, 0,
    )
}

substitutes_generic_annotations_before_evaluating_comptime_values test {
    try expect_specialization(
        `Box proc($T type) type { return struct { value T } }
        `read proc($T type, $value Box(T)) T { return value.value }
        `consume proc($T type, value Box(T)) T {
        `    inline for ([usize(0)]) |_| {}
        `    return value.value
        `}
        `saved Box(i16) :: {value = 42}
        `main proc() i16 { return read(i16, saved) + read(saved) + $(consume(saved)) }
        , .comptime_argument_required, 0,
    )
}

infers_dependent_callbacks_from_nominal_inputs_and_results test {
    try expect_specialization(
        `Map proc($K, $V type, $hash ?proc(key K) usize, $equal ?proc(left, right K) bool) type {
        `    return struct { value V }
        `}
        `init proc($K, $V type, $hash ?proc(key K) usize, $equal ?proc(left, right K) bool) Map(K, V, hash, equal) {
        `    return {value = 42}
        `}
        `get proc($K, $V type, $hash ?proc(key K) usize, $equal ?proc(left, right K) bool, map @Map(K, V, hash, equal)) V {
        `    return map.value
        `}
        `hash_key proc(value i16) usize { return usize(value) }
        `keys_equal proc(left, right i16) bool { return left == right }
        `main proc() i16 {
        `    automatic Map(i16, i16, null, null) :: init()
        `    custom Map(i16, i16, hash_key, keys_equal) :: init()
        `    return get(&automatic) + get(&custom)
        `}
        , .cannot_infer_generic, 0,
    )
}

executes_closed_zero_runtime_calls_and_retains_returned_views test {
    try expect_specialization_guards(
        `Map proc($T type) type { return struct { values []T, indexes []usize } }
        `init proc($T type, $N usize, $entries [N]T) Map(T) {
        `    values [N]mut T := undefined
        `    for entries |entry, i| { values[i] = entry }
        `    if N == 0 {
        `        empty [0]usize :: undefined
        `        return {values = values[..], indexes = empty[..]}
        `    }
        `    if values[0] == 0 { compile_error!("unexpected zero") }
        `    length usize :: usize(values[0])
        `    indexes [length]mut usize := undefined
        `    for 0..length |i| { indexes[i] = i }
        `    return {values = values[..], indexes = indexes[..]}
        `}
        `main proc() i16 {
        `    map Map(i16) :: init([i16(19), i16(23)])
        `    empty Map(i16) :: init([])
        `    return map.values[0] + map.values[1]
        `}
        , .compile_error, 0, 0,
    )
    try expect_specialization(
        `produce proc() i16 {
        `    value i16 := 0
        `    if value == 0 { compile_error!("selected failure") }
        `    return value
        `}
        `main proc() i16 { return produce() }
        , .compile_error, 1,
    )
}

infers_array_lengths_from_contextually_typed_storage_initializers test {
    try expect_specialization(
        `Kind :: enum { first, second }
        `Entry :: struct { name []u8, kind Kind }
        `entries [_]Entry :: [{name = "a", kind = .first}, {name = "b", kind = .second}]
        `length proc($N usize, values @[N]Entry) usize { return N }
        `main proc() usize { return length(&entries) }
        , .cannot_infer_generic, 0,
    )
}

infers_byte_slices_from_nonliteral_string_bindings test {
    try expect_specialization(
        `same_length proc($T type, left, right []T) bool { return left.len == right.len }
        `main proc() bool {
        `    expected :: if (true) "auto" else "c"
        `    return same_length("auto", expected)
        `}
        , .cannot_infer_generic, 0,
    )
}

infers_range_capture_types_from_rigid_bounds_before_generic_calls test {
    try expect_specialization(
        `identity proc($T type, value T) T { return value }
        `main proc() usize {
        `    count usize :: 2
        `    total usize := 0
        `    for 0..count |index| { total += identity(index) }
        `    return total
        `}
        , .cannot_infer_generic, 0,
    )
}

executes_demanded_local_dependent_array_extents_before_checking_layout test {
    try expect_specialization(
        `make proc() []i16 {
        `    sizes [1]mut usize := [2]
        `    length usize :: sizes[0]
        `    values [length]mut i16 := undefined
        `    for 0..length |index| { values[index] = 42 }
        `    return values[..]
        `}
        `main proc() i16 { return $(make())[0] }
        , .invalid_array_length, 0,
    )
}
